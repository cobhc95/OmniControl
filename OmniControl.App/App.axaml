<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Pages"
             xmlns:hotkeys="using:OmniControl.App.Hotkeys"
             xmlns:displays="using:OmniControl.App.Pages.Displays"
             xmlns:shortcuts="using:OmniControl.App.Pages.Shortcuts"
             xmlns:osd="using:OmniControl.App.Pages.Osd"
             xmlns:volume="using:OmniControl.App.Pages.Volume"
             xmlns:fx="using:OmniControl.App.Fx"
             xmlns:appsettings="using:OmniControl.App.Pages.AppSettingsPage"
             x:Class="OmniControl.App.App"
             RequestedThemeVariant="Dark">

    <!-- Each page view-model maps to its view here. Adding a page = one line. -->
    <Application.DataTemplates>
        <DataTemplate DataType="displays:DisplaysPageViewModel"><displays:DisplaysPage /></DataTemplate>
        <DataTemplate DataType="shortcuts:ShortcutsPageViewModel"><shortcuts:ShortcutsPage /></DataTemplate>
        <DataTemplate DataType="osd:OsdPageViewModel"><osd:OsdPage /></DataTemplate>
        <DataTemplate DataType="appsettings:AppSettingsPageViewModel"><appsettings:AppSettingsPage /></DataTemplate>
        <DataTemplate DataType="volume:VolumePageViewModel"><volume:VolumePage /></DataTemplate>
        <DataTemplate DataType="volume:MixerItem"><volume:MixerRow /></DataTemplate>
        <DataTemplate DataType="fx:EqPanelItem"><fx:EqPanelRow /></DataTemplate>
        <DataTemplate DataType="fx:IrFileItem"><fx:IrFileRow /></DataTemplate>
        <DataTemplate DataType="volume:InputItem"><volume:InputRow /></DataTemplate>
        <DataTemplate DataType="volume:AddProgramItem"><volume:AddProgramRow /></DataTemplate>
        <DataTemplate DataType="pages:SliderItem"><pages:SliderRow /></DataTemplate>
        <DataTemplate DataType="pages:ChoiceItem"><pages:ChoiceRow /></DataTemplate>
        <DataTemplate DataType="pages:ToggleItem"><pages:ToggleRow /></DataTemplate>
        <DataTemplate DataType="pages:GalleryItem"><pages:GalleryRow /></DataTemplate>
        <DataTemplate DataType="hotkeys:HotkeyAction"><hotkeys:HotkeyRow /></DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/Theme.axaml" />
    </Application.Styles>
</Application>
