        <StyleInclude Source="/Shared/Ui/Styles/Graphs.axaml" />
        <StyleInclude Source="/Shared/Ui/Styles/Bars.axaml" />
        <StyleInclude Source="/Shared/Ui/Styles/Tables.axaml" />
        <StyleInclude Source="/Shared/Ui/Styles/Menus.axaml" />
        <StyleInclude Source="/Shared/Ui/Styles/Knobs.axaml" />
        <StyleInclude Source="/Shared/Ui/Styles/RowControls.axaml" />
