<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             x:Class="OmniControl.App.App"
             RequestedThemeVariant="Dark">

    <!-- The shared card rows' views; each feature module adds its own pages' and rows' templates at start-up (IFeatureModule.Templates). -->
    <Application.DataTemplates>
        <DataTemplate DataType="pages:SliderItem"><pages:SliderRow /></DataTemplate>
        <DataTemplate DataType="pages:ChoiceItem"><pages:ChoiceRow /></DataTemplate>
        <DataTemplate DataType="pages:ToggleItem"><pages:ToggleRow /></DataTemplate>
        <DataTemplate DataType="pages:ButtonItem"><pages:ButtonRow /></DataTemplate>
        <DataTemplate DataType="pages:FactItem"><pages:FactRow /></DataTemplate>
        <DataTemplate DataType="pages:ScopeItem"><pages:ScopeRow /></DataTemplate>
        <DataTemplate DataType="pages:FileItem"><pages:FileRow /></DataTemplate>
        <DataTemplate DataType="pages:GalleryItem"><pages:GalleryRow /></DataTemplate>
        <DataTemplate DataType="pages:MenuChoiceItem"><pages:MenuChoiceRow /></DataTemplate>
        <DataTemplate DataType="pages:AnchorItem"><pages:AnchorRow /></DataTemplate>
        <DataTemplate DataType="pages:TextItem"><pages:TextRow /></DataTemplate>
        <DataTemplate DataType="pages:ChoiceChipsItem"><pages:ChoiceChipsRow /></DataTemplate>
    </Application.DataTemplates>

    <!-- The app's base text size (Fluent's default is 14); windows and controls take it from here -->
    <Application.Resources>
        <x:Double x:Key="ControlContentThemeFontSize">11.5</x:Double>
        <x:Double x:Key="TextControlThemeMinHeight">26</x:Double>
        <!-- Least width of the editor column in the search results; the title column gets the rest -->
        <x:Double x:Key="SearchEditorMinWidth">300</x:Double>
        <!-- The search results' editor column: a fixed share of the row, never sized from its content (an Auto column shared by every result looped layout forever) -->
        <GridLength x:Key="SearchEditorShare">1.6*</GridLength>
        <!-- The hotkey capture box (Hotkeys/HotkeyBox): the Actions and hotkeys window's keys and the preset manager's shortcut column -->
        <x:Double x:Key="HotkeyBoxWidth">150</x:Double>
        <!-- The master path field (Controls/PathField) where it sits in a pop-down's settings page: text box and Browse -->
        <x:Double x:Key="OptionMenuWidth">400</x:Double>
        <!-- The accent colour editor (Settings/Pages/AccentEditor, an optionmenu pop-down): its saturation square and hue bar (Controls/ColorSquare,
             HueBar; each holds 6 px room around its field for the handle) and the swatch of the colour beside the hex box -->
        <x:Double x:Key="ColorSquareWidth">156</x:Double>
        <x:Double x:Key="ColorSquareHeight">120</x:Double>
        <x:Double x:Key="HueBarHeight">24</x:Double>
        <x:Double x:Key="ColorSwatchSize">22</x:Double>
        <!-- The Choose-the-action / Actions and hotkeys window: its size, and the least width of each pane (the window's minimum is their sum plus the dividers) -->
        <x:Double x:Key="PickerWindowWidth">1000</x:Double>
        <x:Double x:Key="PickerWindowHeight">680</x:Double>
        <x:Double x:Key="PickerWindowMinWidth">760</x:Double>
        <x:Double x:Key="PickerSectionsMinWidth">170</x:Double>
        <x:Double x:Key="PickerEntriesMinWidth">260</x:Double>
        <x:Double x:Key="PickerSettingsMinWidth">300</x:Double>
        <!-- Width of the FX window's effect list (FxChainPanel): fixed and narrow, so the editor beside it gets the rest of the window -->
        <x:Double x:Key="FxChainListWidth">170</x:Double>
        <!-- The FX window's panes inside the window (between the toolbar and the status strip) -->
        <Thickness x:Key="FxPanesMargin">8,2,8,6</Thickness>
        <!-- A window's toolbar row (Styles/Bars.axaml, Border.toolrow): its height and inset, its type, its controls' height, the gap
             between its controls and inside a control group (label, slider, value), a pill's and a drop-down's inset, and the inset
             that fits Fluent's 32 px switch into the control height (32 - 2 x 5 = 22) -->
        <x:Double x:Key="ToolRowHeight">30</x:Double>
        <Thickness x:Key="ToolRowPadding">8,4</Thickness>
        <x:Double x:Key="ToolFontSize">11</x:Double>
    <!-- A group header's summary and badge, a subgroup's summary, a search result's heading: one size -->
    <x:Double x:Key="SummaryFontSize">12</x:Double>
        <x:Double x:Key="EqFontSize">13</x:Double>
        <x:Double x:Key="BandListWidth">104</x:Double>
        <x:Double x:Key="EqGainColumnWidth">56</x:Double>
        <!-- THE slider (Styles/Sliders.axaml, Controls/SliderBar), both orientations: the control's height (no taller than a toolbar
             control, so a card keeps its height), the track, the round knob and its accent dot at rest, under the pointer and while dragged,
             how fast the dot changes, the focus ring around the knob (3 px out: a 1 px gap and the 2 px ring), the centre mark, and the
             least width of a vertical slider's column (the knob with its ring). Track, knob, edge and dot are Windows 11's own (4, 20 with a
             1 px edge, a 12 px dot scaled 0.86 / 1.167 / 0.71 at rest, under the pointer and pressed) -->
        <x:Double x:Key="SliderHeight">22</x:Double>
        <x:Double x:Key="SliderTrackHeight">4</x:Double>
        <x:Double x:Key="SliderKnobSize">20</x:Double>
        <x:Double x:Key="SliderDotSize">10</x:Double>
        <x:Double x:Key="SliderDotHover">14</x:Double>
        <x:Double x:Key="SliderDotPressed">8</x:Double>
        <x:TimeSpan x:Key="SliderDotTime">0:0:0.1</x:TimeSpan>
        <Thickness x:Key="SliderRingInset">-3</Thickness>
        <x:Double x:Key="SliderRingThickness">2</x:Double>
        <x:Double x:Key="SliderKnobEdge">1</x:Double>
        <!-- The bar and its travel start this far in from a horizontal slider's ends, so the knob's focus ring stays inside it and a host's clip never cuts it -->
        <Thickness x:Key="SliderEndInset">3,0</Thickness>
        <x:Double x:Key="SliderMarkWidth">2</x:Double>
        <x:Double x:Key="SliderMarkHeight">12</x:Double>
        <x:Double x:Key="SliderColumnWidth">26</x:Double>
        <!-- A typeable value's field box (Pages/NumberText): the space between its frame and the value, and its corners -->
        <Thickness x:Key="TypeableInset">8,2</Thickness>
        <CornerRadius x:Key="TypeableCornerRadius">4</CornerRadius>
        <!-- The parametric equaliser graph: a band's circle (diameter, a ring of the selected one), and the bandwidth handles of the selected band -->
        <x:Double x:Key="EqBandCircle">11</x:Double>
        <x:Double x:Key="EqWidthHandleWidth">8</x:Double>
        <x:Double x:Key="EqWidthHandleHeight">12</x:Double>
        <!-- The pane splitter (Styles/Splitters.axaml, GridSplitter.pane): its grab width -->
        <x:Double x:Key="PaneSplitterWidth">10</x:Double>
        <x:Double x:Key="FxChainListMinWidth">120</x:Double>
        <x:Double x:Key="FxEditorMinWidth">320</x:Double>
        <!-- How long the Easy page's confirmation line takes to fade out (how long it stays first is Timing.EasyConfirmation) -->
        <x:TimeSpan x:Key="EasyFadeTime">0:0:0.6</x:TimeSpan>
        <x:Double x:Key="ToolControlHeight">22</x:Double>
        <x:Double x:Key="ToolRowGap">6</x:Double>
        <x:Double x:Key="ToolRowInnerGap">4</x:Double>
        <Thickness x:Key="ToolPillPadding">9,0</Thickness>
        <Thickness x:Key="ToolComboPadding">8,0</Thickness>
        <Thickness x:Key="ToolSwitchInset">0,-5</Thickness>
        <!-- The screenshot overlay (Styles/Bars.axaml): a floating bar's rounding and inset, its square icon buttons and their glyphs, a colour
             swatch and its inset, the selection's handles and how close a press grabs one, the gap between the selection and its bars, the text box's least width -->
        <CornerRadius x:Key="FloatBarRadius">10</CornerRadius>
        <Thickness x:Key="FloatBarPadding">4</Thickness>
        <x:Double x:Key="ToolIconSize">30</x:Double>
        <x:Double x:Key="ToolIconGlyph">17</x:Double>
        <CornerRadius x:Key="ToolIconRadius">6</CornerRadius>
        <x:Double x:Key="FloatBarGap">2</x:Double>
        <Thickness x:Key="FloatSepAcross">4,3</Thickness>
        <Thickness x:Key="FloatSepAlong">3,4</Thickness>
        <x:Double x:Key="SwatchSize">18</x:Double>
        <Thickness x:Key="SwatchPadding">4</Thickness>
        <!-- THE colour dot (Controls/SwatchDot): the chosen dot's accent ring (outside the dot, inside SwatchPadding) and its width; the dot
             before the words of a swatch chip (c|ChipMenu.Swatch) and the words' inset after it (the dot plus a gap) -->
        <Thickness x:Key="SwatchRingInset">-3</Thickness>
        <x:Double x:Key="SwatchRingThickness">2</x:Double>
        <x:Double x:Key="ChipSwatchSize">14</x:Double>
        <Thickness x:Key="ChipSwatchInset">20,0,0,0</Thickness>
        <x:Double x:Key="CaptureHandleSize">8</x:Double>
        <x:Double x:Key="CaptureHandleReach">8</x:Double>
        <x:Double x:Key="CaptureBarGap">6</x:Double>
        <x:Double x:Key="CaptureTextMinWidth">120</x:Double>
        <!-- Screen recording: a red glyph's size (Record, Stop), the bar's red dot, the gap around the dot and timer, the dashed frame's line -->
        <x:Double x:Key="ToolIconDangerGlyph">13</x:Double>
        <x:Double x:Key="ToolIconOutlineGlyph">17</x:Double>
        <x:Double x:Key="RecordDotSize">8</x:Double>
        <Thickness x:Key="RecordClockInset">6,0</Thickness>
        <x:Double x:Key="RecordClockGap">6</x:Double>
        <x:Double x:Key="RecordFrameThickness">2</x:Double>
        <!-- The OSD placement window (docs/mockups/osd-custom-position.html): the preview's dashed accent edge, the anchor picker's 3 x 3 squares, the window's width -->
        <x:Double x:Key="OsdFrameThickness">1.5</x:Double>
        <x:Double x:Key="OsdFrameRadius">14</x:Double>
        <x:Double x:Key="AnchorCellSize">16</x:Double>
        <Thickness x:Key="AnchorCellGap">2</Thickness>
        <CornerRadius x:Key="AnchorCellCornerRadius">3</CornerRadius>
        <Thickness x:Key="AnchorFramePadding">3</Thickness>
        <CornerRadius x:Key="AnchorFrameCornerRadius">6</CornerRadius>
        <x:Double x:Key="OsdPlacementWidth">460</x:Double>
        <!-- A window's status strip (Border.statusstrip): its inset, type, the gap between its parts, and the widest the caution gets -->
        <Thickness x:Key="StatusStripPadding">8,2</Thickness>
        <!-- A window's foot (Border.footer) and the one width of its Close button (Button.primary.close) -->
        <Thickness x:Key="FooterPadding">16,8</Thickness>
        <x:Double x:Key="DialogCloseWidth">84</x:Double>
        <x:Double x:Key="StatusFontSize">10</x:Double>
        <x:Double x:Key="StatusStripGap">12</x:Double>
        <!-- The FX window toolbar's controls for the selected effect: the preset drop-down, the Wet slider and its value -->
        <x:Double x:Key="FxToolWetWidth">56</x:Double>
        <x:Double x:Key="FxToolValueWidth">22</x:Double>
        <!-- The FX window toolbar's analysis (Fx/FxAnalysisBar, owner-approved "Design A"): the response thumbnail, the tiny stacked Peak
             and Latency beside it, the larger graph's pop-up (FlyoutPresenter.graphmenu: 440 wide = 1 + 9 + 420 graph + 9 + 1), its
             graph's height and the gap between its parts -->
        <x:Double x:Key="FxThumbWidth">120</x:Double>
        <x:Double x:Key="FxThumbHeight">24</x:Double>
        <x:Double x:Key="FxStatsSmallFontSize">10</x:Double>
        <x:Double x:Key="FxStatsSmallLineHeight">12</x:Double>
        <x:Double x:Key="FxGraphPanelWidth">440</x:Double>
        <Thickness x:Key="FxGraphPanelPadding">9</Thickness>
        <x:Double x:Key="FxGraphHeight">170</x:Double>
        <x:Double x:Key="FxGraphPanelSpacing">4</x:Double>
        <!-- The Resources page: a card's sparkline (c|Sparkline) height and line; the taskbar gadget's inset (g|GadgetCells); on its
             Taskbar gadget tab the least and most width of a reading's label field (the most keeps a long label from widening the table's
             shared column past the page, which never settles), the preview strip's and a layout tile's preview height -->
        <x:Double x:Key="SparklineHeight">18</x:Double>
        <x:Double x:Key="SparklineThickness">1.5</x:Double>
        <Thickness x:Key="GadgetInset">6,2,0,2</Thickness>
        <x:Double x:Key="GadgetLabelWidth">64</x:Double>
        <x:Double x:Key="GadgetLabelMaxWidth">120</x:Double>
        <x:Double x:Key="GadgetThumbHeight">34</x:Double>
        <!-- The room under a section of the unfolded Layouts gallery -->
        <Thickness x:Key="GadgetSectionInset">0,0,0,6</Thickness>
        <!-- A choice card's inner space and corners (Button.optioncard, and the dashed Button.blockadd.card that ends a gallery of them) -->
        <Thickness x:Key="OptionCardPadding">8,4</Thickness>
        <CornerRadius x:Key="OptionCardCornerRadius">8</CornerRadius>
        <!-- The Resources views' spaces: between the parts of a line, between lines of a group, between groups and columns -->
        <x:Double x:Key="GapSmall">4</x:Double>
        <x:Double x:Key="Gap">6</x:Double>
        <x:Double x:Key="GapLarge">8</x:Double>
        <!-- The Compressor's transfer curve (Fx/DynamicsRow): the side of its square plot, with its axis labels -->
        <x:Double x:Key="DynamicsGraphSize">240</x:Double>
        <!-- The IR Loader's picture (Fx/IrFileRow): its height -->
        <x:Double x:Key="IrGraphHeight">150</x:Double>
        <!-- A plug-in's plain settings list: the widest a setting's value text gets before it ends in "..." -->
        <x:Double x:Key="ParamValueMaxWidth">110</x:Double>
        <!-- A graphic equaliser (Fx/GraphicEqRow): the height of the response curve above the sliders and of the sliders (the dB scale
             beside them reads SliderKnobSize to line its marks up with the knobs' travel) -->
        <GridLength x:Key="GraphicEqCurveHeight">96</GridLength>
        <GridLength x:Key="GraphicEqSliderHeight">170</GridLength>
        <!-- The longest a word-control in a row's sentence ("Speakers + Headphones") gets before it ends in "..." -->
        <x:Double x:Key="SentenceLinkMaxWidth">220</x:Double>
        <!-- The tallest an option list (Controls/OptionList) grows before it scrolls -->
        <x:Double x:Key="OptionListMaxHeight">320</x:Double>
        <!-- The longest a chip's words get before they end in "..." -->
        <x:Double x:Key="ChipMaxWidth">150</x:Double>
        <!-- Narrow cards (Controls/LeadFitPanel): a leading chip trims its words down to ChipMinWidth first, then the slider with its value
             shrinks down to SliderFieldMinWidth (the slider's least width + the typed value + their gap); the value and the label never clip -->
        <x:Double x:Key="ChipMinWidth">72</x:Double>
        <x:Double x:Key="SliderBarMinWidth">60</x:Double>
        <x:Double x:Key="SliderValueMinWidth">48</x:Double>
        <x:Double x:Key="SliderValueGap">8</x:Double>
        <!-- = SliderBarMinWidth + SliderValueGap + SliderValueMinWidth -->
        <x:Double x:Key="SliderFieldMinWidth">116</x:Double>
        <!-- A card's name (TextBlock.cardname): the least width of the label column that the cards of a page share so their controls line up, and the widest a name gets
             before it wraps; CardLabelMinWidth = the least width of a half-width card's name (wrapped to two lines). ChoiceMaxWidth and GalleryMaxWidth = the widest a card's
             drop-down or gallery gets; narrower, it shrinks inside the room right of the label and never covers it -->
        <x:Double x:Key="CardLabelMaxWidth">170</x:Double>
        <x:Double x:Key="CardLabelColumnMinWidth">110</x:Double>
        <x:Double x:Key="CardLabelMinWidth">56</x:Double>
        <x:Double x:Key="ChoiceMaxWidth">220</x:Double>
        <x:Double x:Key="GalleryMaxWidth">300</x:Double>
        <!-- Pages/FixedColumnsPanel (a PC's groups on Other PCs): the least width of a column and the gap between columns -->
        <x:Double x:Key="FixedColumnMinWidth">250</x:Double>
        <x:Double x:Key="FixedColumnGap">10</x:Double>
        <!-- The narrow list pop-down (FlyoutPresenter.listmenu) sizes to its content between these -->
        <x:Double x:Key="ListMenuMinWidth">260</x:Double>
        <x:Double x:Key="ListMenuMaxWidth">300</x:Double>
        <!-- Menu-like pop-downs (Styles/Menus.axaml): the pop-down's inner padding, its rows (Controls/OptionList's list and
             Button.menurow) and their inset, the gap between a row's mark or glyph and its words, the glyph, the small text (base - 1) -->
        <Thickness x:Key="MenuPadding">4</Thickness>
        <x:Double x:Key="CaptureMenuWidth">250</x:Double>
        <x:Double x:Key="MenuRowHeight">32</x:Double>
        <Thickness x:Key="MenuRowPadding">12,0</Thickness>
        <CornerRadius x:Key="MenuRowCornerRadius">4</CornerRadius>
        <!-- A menu's surface (Windows 11 style): its corners, and the see-through room around it where its shadow (MenuShadow) is drawn;
             ListMenuFlyout and the ComboBox list shift by that room (MenuShadowShift* = minus its left and top) so the visible menu sits on its opener -->
        <CornerRadius x:Key="MenuCornerRadius">8</CornerRadius>
        <Thickness x:Key="MenuShadowRoom">8,4,8,12</Thickness>
        <x:Double x:Key="MenuShadowShiftX">-8</x:Double>
        <x:Double x:Key="MenuShadowShiftY">-4</x:Double>
        <!-- The chosen row's accent bar at its left (single-choice menus), and a menu's thin line between parts -->
        <x:Double x:Key="MenuBarWidth">3</x:Double>
        <x:Double x:Key="MenuBarHeight">16</x:Double>
        <CornerRadius x:Key="MenuBarCornerRadius">1.5</CornerRadius>
        <Thickness x:Key="MenuRuleMargin">4</Thickness>
        <!-- A Controls/MenuRowList row: its inset above and below (rows of two or three lines), the height of its first line (the tick sits
             there), the gap between its tags and the space above a line of tags -->
        <Thickness x:Key="MenuRowInset">0,4</Thickness>
        <!-- A set-up stage's inner space (Border.stage); a device's icon square (Pages/Devices/DeviceIconView) and its glyph -->
        <Thickness x:Key="StagePadding">4,2</Thickness>
        <!-- The Smart Devices page's pane: the device list's width range and inner space, the detail's inner space -->
        <x:Double x:Key="DeviceListMinWidth">140</x:Double>
        <x:Double x:Key="DeviceListMaxWidth">190</x:Double>
        <Thickness x:Key="DeviceListPadding">6</Thickness>
        <Thickness x:Key="NavCompactPadding">6,5</Thickness>
        <!-- The sidebar's one left inset (8 px to the text; items take 7 plus their 1 px outline): item padding, heading padding and the title above them line up on it -->
        <Thickness x:Key="NavPadding">7,7,16,7</Thickness>
        <Thickness x:Key="NavHeadingPadding">7,10,16,2</Thickness>
        <x:Double x:Key="NavIconBox">18</x:Double>
        <Thickness x:Key="NavTitleMargin">8,0,0,10</Thickness>
        <Thickness x:Key="NavPillMargin">8,0,8,6</Thickness>
        <Thickness x:Key="NavRuleMargin">8,6,8,6</Thickness>
        <Thickness x:Key="DeviceDetailPadding">10,8</Thickness>
        <x:Double x:Key="DeviceIconSize">26</x:Double>
        <x:Double x:Key="DeviceIconGlyph">15</x:Double>
        <CornerRadius x:Key="DeviceIconCorner">6</CornerRadius>
        <!-- The icon library (Controls/IconGlyph, Icons/IconPickerWindow, docs/mockups/icon-library.html): a glyph's size where nothing sets it,
             the picker window, its 34 px cells and the glyph in them -->
        <x:Double x:Key="IconGlyphSize">16</x:Double>
        <!-- The optional icon before a card's label or a chip's words (Controls/IconText): a little under the base text so a card keeps its height -->
        <x:Double x:Key="CardIconSize">14</x:Double>
    <!-- A search box (SearchClear): its magnifier, and the quiet pill naming the key that focuses it -->
    <x:Double x:Key="SearchIconSize">13</x:Double>
    <x:Double x:Key="SearchPillFontSize">10</x:Double>
    <CornerRadius x:Key="SearchPillRadius">12</CornerRadius>
    <Thickness x:Key="SearchPillPadding">8,1</Thickness>
        <x:Double x:Key="IconPickerWidth">384</x:Double>
        <x:Double x:Key="IconPickerHeight">520</x:Double>
        <x:Double x:Key="IconCellSize">34</x:Double>
        <x:Double x:Key="IconCellGlyph">20</x:Double>
        <x:Double x:Key="MenuRowLine">18</x:Double>
        <x:Double x:Key="MenuBigListHeight">320</x:Double>
        <x:Double x:Key="MenuTagGap">4</x:Double>
        <Thickness x:Key="MenuTagLineMargin">0,3,0,0</Thickness>
        <Thickness x:Key="MenuTextInset">12,4,12,2</Thickness>
        <x:Double x:Key="MenuGap">8</x:Double>
        <x:Double x:Key="MenuGlyphSize">12</x:Double>
        <!-- The gap after a menu row's glyph column (MenuGap) -->
        <Thickness x:Key="MenuGlyphMargin">0,0,8,0</Thickness>
        <x:Double x:Key="MenuSmallFontSize">10.5</x:Double>
        <!-- An option list's tick: a 14 px box, its check 9 px (14 - 2 x 2.5) -->
        <x:Double x:Key="TickBoxSize">14</x:Double>
        <CornerRadius x:Key="TickBoxCornerRadius">3</CornerRadius>
        <Thickness x:Key="TickMargin">2.5</Thickness>
        <!-- A chip (Button.chipx): 22 px pill, its x 8 px in a 14 px slot (8 + 2 x 3), 2 px after the words; 8 px visible space on
             both sides (the right padding is 5 because the x's slot adds 3) -->
        <x:Double x:Key="ChipHeight">22</x:Double>
        <Thickness x:Key="ChipPadding">8,0,5,0</Thickness>
        <CornerRadius x:Key="ChipCornerRadius">11</CornerRadius>
        <x:Double x:Key="ChipDashRadius">11</x:Double>
        <x:Double x:Key="ChipGlyphSize">8</x:Double>
        <Thickness x:Key="ChipGlyphMargin">3</Thickness>
        <x:Double x:Key="ChipGap">2</x:Double>
        <!-- The dashed "+ add" chip (Button.blockadd.small): the chip's 8 px on both sides; the gap between the chips of a row -->
        <Thickness x:Key="ChipAddPadding">8,0</Thickness>
        <x:Double x:Key="ChipSpacing">4</x:Double>
        <!-- A Volume row's program picture inside its 24 px icon tile (Border.rowicon) -->
        <x:Double x:Key="RowPictureSize">18</x:Double>
        <!-- A row's pin (Button.pin, Styles/RowControls.axaml): the button, its glyph, and how faint the glyph is while not pinned and the row not hovered -->
        <x:Double x:Key="PinSize">20</x:Double>
        <x:Double x:Key="PinGlyphSize">12</x:Double>
        <x:Double x:Key="PinFaintOpacity">0.35</x:Double>
        <CornerRadius x:Key="PinCornerRadius">4</CornerRadius>
        <!-- The gap between a control and the menu pop-down it opens -->
        <x:Double x:Key="MenuOffset">2</x:Double>
        <!-- A small drop-down arrow beside words (a Wiring row's one-device choice, a Mixer row's pickers) -->
        <x:Double x:Key="ChevronSize">8</x:Double>
        <!-- A page's tabs (Button.tab, Pages/PageTabsView): the words' inset, the rounded top of the hover wash, the line under the open
             tab, the gap between tabs -->
        <Thickness x:Key="TabPadding">10,4</Thickness>
        <CornerRadius x:Key="TabCornerRadius">6,6,0,0</CornerRadius>
        <x:Double x:Key="TabUnderlineHeight">2</x:Double>
        <x:Double x:Key="TabGap">4</x:Double>
        <!-- Browser-style tabs (Styles/BrowserTabs.axaml, Controls/BrowserTabStrip): a tab's inner space, its widest and least width (names trim between), the gap between tabs, the status dot, the rounded top -->
        <Thickness x:Key="BrowserTabPadding">10,5</Thickness>
        <x:Double x:Key="BrowserTabMaxWidth">210</x:Double>
        <x:Double x:Key="BrowserTabMinWidth">90</x:Double>
        <x:Double x:Key="BrowserTabGap">2</x:Double>
        <x:Double x:Key="BrowserTabDotSize">7</x:Double>
        <!-- A chip's status dot (c|StatusDot, Controls/ChipMenu): the words' inset when the chip has a dot (the dot's size plus a gap) -->
        <Thickness x:Key="ChipDotInset">11,0,0,0</Thickness>
        <CornerRadius x:Key="BrowserTabCornerRadius">7,7,0,0</CornerRadius>
        <!-- The Volume Wiring tables: the widest a source's name gets (then "..."), the widest the Cable column's words get (then they
             wrap), the gap between the columns, and the column titles' inset (a compact row's padding 10 plus its 1 px border) -->
        <x:Double x:Key="WiringSourceMaxWidth">150</x:Double>
        <x:Double x:Key="WiringCableMaxWidth">120</x:Double>
        <x:Double x:Key="WiringColumnGap">10</x:Double>
        <Thickness x:Key="RowHeadingInset">11,0,11,0</Thickness>
        <!-- The master knob (Controls/Knob, Styles/Knobs.axaml): the drawn face's size, its arc and pointer line, the gap to the value
             words under it and their size, and the knob's column (the face plus room for "L 100"), which the typing box takes too -->
        <x:Double x:Key="KnobSize">32</x:Double>
        <x:Double x:Key="KnobArcThickness">3</x:Double>
        <x:Double x:Key="KnobPointerThickness">2</x:Double>
        <x:Double x:Key="KnobTextGap">0</x:Double>
        <x:Double x:Key="KnobFontSize">10</x:Double>
        <x:Double x:Key="KnobColumnWidth">38</x:Double>
        <!-- A chip-shaped picker (Button.selector / Border.selector, Styles/RowControls.axaml): the words' inset (its height and rounding are the chip's) -->
        <Thickness x:Key="SelectorPadding">8,0,6,0</Thickness>
        <!-- The same picker drawn as a Windows drop-down box (c|ChipMenu.dropbox, Styles/RowControls.axaml): its height and rounding -->
        <x:Double x:Key="DropBoxHeight">26</x:Double>
        <CornerRadius x:Key="DropBoxCornerRadius">4</CornerRadius>
        <!-- The Mixer rows' columns (Pages/Volume/VolumeRowView, MixerHeadings): the gap between them -->
        <x:Double x:Key="MixerColumnGap">6</x:Double>
        <!-- The tray flyout (Tray/TrayFlyoutWindow, Styles/Tray.axaml): its panel's width and rounding (outer, and inner for the bands it
             clips), the room kept for its drop shadow (which is also its gap to the screen's working area, so TrayFlyoutGap adds nothing),
             the insets of its three bands (tiles, sliders, foot), a slider row's name (or drop-down) column, value column and the gap between
             its columns, the tiles per row, a tile button's height (its width is the row's share), rounding, the gap between tiles and the gap
             to the name under it, their glyph, and the foot's buttons (gap, inset, rounding, glyph) -->
        <x:Double x:Key="TrayFlyoutWidth">360</x:Double>
        <CornerRadius x:Key="TrayFlyoutCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="TrayFlyoutInnerRadius">7</CornerRadius>
        <Thickness x:Key="TrayShadowInset">12</Thickness>
        <x:Double x:Key="TrayFlyoutGap">0</x:Double>
        <Thickness x:Key="TrayTilesPadding">16,16</Thickness>
        <Thickness x:Key="TraySlidersPadding">16,14</Thickness>
        <x:Double x:Key="TraySliderRowHeight">36</x:Double>
        <x:Double x:Key="TraySliderRowGap">8</x:Double>
        <Thickness x:Key="TrayFootPadding">12,8</Thickness>
        <x:Double x:Key="TrayNameWidth">112</x:Double>
        <x:Double x:Key="TrayValueWidth">26</x:Double>
        <x:Double x:Key="TrayColumnGap">8</x:Double>
        <x:Int32 x:Key="TrayTileColumns">4</x:Int32>
        <x:Double x:Key="TrayTileHeight">56</x:Double>
        <x:Double x:Key="TrayTileFitFontSize">9</x:Double>
        <CornerRadius x:Key="TrayTileCornerRadius">5</CornerRadius>
        <x:Double x:Key="TrayTileGap">10</x:Double>
        <x:Double x:Key="TrayTileRowGap">12</x:Double>
        <x:Double x:Key="TrayTileNameGap">7</x:Double>
        <x:Double x:Key="TrayFootGap">4</x:Double>
        <Thickness x:Key="TrayFootButtonPadding">8,5</Thickness>
        <CornerRadius x:Key="TrayFootButtonRadius">4</CornerRadius>
        <x:Double x:Key="TrayGlyphSize">16</x:Double>
        <Thickness x:Key="TrayTileCross">0,-5,-5,0</Thickness>
        <!-- The remove badge (Button.removebadge, Styles/Tray.axaml, docs/mockups/remove-badge.html): round chip, its drawn cross, the clickable square around it -->
        <x:Double x:Key="RemoveBadgeSize">16</x:Double>
        <x:Double x:Key="RemoveBadgeCross">9</x:Double>
        <x:Double x:Key="RemoveBadgeHit">20</x:Double>
        <CornerRadius x:Key="RemoveBadgeRadius">8</CornerRadius>
        <x:Double x:Key="PillIconWidth">32</x:Double>
        <x:Double x:Key="PillGlyphSize">17</x:Double>
        <x:Double x:Key="DialogButtonHeight">28</x:Double>
        <!-- The round X pill (Button.pill.closex, Styles/ThemeButtons.axaml, docs/mockups/device-close-x.html) -->
        <x:Double x:Key="CloseXSize">18</x:Double>
        <!-- Tooltip timing for the whole app, ms (owner, 18 Nov): the wait before the first tooltip, and before the next while one shows -->
        <x:Int32 x:Key="TooltipShowDelay">1000</x:Int32>
        <x:Int32 x:Key="TooltipBetweenDelay">250</x:Int32>
        <x:Double x:Key="CloseXCross">9</x:Double>
        <x:Double x:Key="TrayFadedOpacity">0.55</x:Double>
        <x:Double x:Key="StatePowerSize">20</x:Double>
        <x:Double x:Key="StatePowerGlyph">12</x:Double>
        <x:Double x:Key="StatePowerStop">8</x:Double>
        <CornerRadius x:Key="StatePowerRadius">10</CornerRadius>
        <x:Double x:Key="TrayMarkSize">11</x:Double>
        <x:Double x:Key="TrayMarkDot">7</x:Double>
        <x:Double x:Key="TrayMarkStroke">1.5</x:Double>
        <Thickness x:Key="TrayMarkMargin">5</Thickness>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Shared/Ui/Styles/Brushes.axaml" />
        <StyleInclude Source="/Shared/Ui/Styles/Icons.axaml" />
