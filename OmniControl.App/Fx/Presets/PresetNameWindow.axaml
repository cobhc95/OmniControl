<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OmniControl.App.Fx.Presets.PresetNameWindow"
        Title="Save as preset" Width="380" SizeToContent="Height" CanResize="False"
        Background="{DynamicResource BrushBackground}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <!-- Save current: the preset's name, one note under it (why it cannot be used, or that it replaces a preset), Save and Cancel. -->
    <StackPanel Margin="16,12" Spacing="8">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" />
        <TextBox x:Name="NameBox" Classes="field" MaxLength="64" />
        <TextBlock x:Name="Note" Classes="statusline" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Classes="usebtn scope" Tag="scope" Content="Save" Click="OnSaveClick" />
            <Button Classes="primary" Content="Cancel" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
