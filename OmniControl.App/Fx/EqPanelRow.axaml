<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Fx"
             x:Class="OmniControl.App.Fx.EqPanelRow"
             x:DataType="vm:EqPanelItem">
    <!-- ReaEQ-style equaliser: graph, band tabs, the selected band's controls, band buttons and view switches -->
    <StackPanel Spacing="8" Margin="0,4">
        <vm:EqGraph Height="230" />

        <ItemsControl ItemsSource="{Binding Bands}" IsVisible="{Binding ShowTabs}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:EqBandItem">
                    <Button Classes="scope band" Classes.on="{Binding IsSelected}" Command="{Binding SelectCommand}"
                            Focusable="False" Margin="0,0,4,4" HorizontalContentAlignment="Center" ToolTip.Tip="{Binding TypeName}">
                        <StackPanel>
                            <TextBlock Text="{Binding Number}" FontSize="11" HorizontalAlignment="Center" Classes="muted" />
                            <TextBlock Text="{Binding TabText}" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="hint" Text="No bands: the sound passes unchanged. Use Add band to start." IsVisible="{Binding !HasBands}" />

        <!-- The selected band's controls -->
        <StackPanel IsVisible="{Binding HasBands}">
            <vm:EqBandRow DataContext="{Binding Selected}" />
        </StackPanel>

        <WrapPanel Orientation="Horizontal">
            <Button Classes="pill" Tag="scope" Content="Add band" Command="{Binding AddBandCommand}" Margin="0,0,6,4" VerticalAlignment="Center" />
            <Button Classes="pill" Tag="scope" Content="Remove band" Command="{Binding RemoveBandCommand}" Margin="0,0,6,4" VerticalAlignment="Center"
                    ToolTip.Tip="Removes the selected band" />
            <Button Classes="pill" Tag="scope" Content="Reset defaults" Command="{Binding ResetDefaultsCommand}" Margin="0,0,16,4" VerticalAlignment="Center"
                    ToolTip.Tip="Back to four flat bands" />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,4">
                <TextBlock Text="Show tabs" VerticalAlignment="Center" />
                <ToggleSwitch IsChecked="{Binding ShowTabs}" OnContent="On" OffContent="Off" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,4">
                <TextBlock Text="Show grid" VerticalAlignment="Center" />
                <ToggleSwitch IsChecked="{Binding ShowGrid}" OnContent="On" OffContent="Off" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,4">
                <TextBlock Text="Show phase" VerticalAlignment="Center" />
                <ToggleSwitch IsChecked="{Binding ShowPhase}" OnContent="On" OffContent="Off" VerticalAlignment="Center" />
            </StackPanel>
        </WrapPanel>

        <TextBlock Classes="hint"
                   Text="Left/Right pick a band; Up/Down move between the controls; Enter on a slider adjusts it with Left/Right. Drag a point on the graph; the wheel over a point changes its bandwidth; double-click a value to type it." />
    </StackPanel>
</UserControl>
