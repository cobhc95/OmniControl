<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Fx"
             x:Class="OmniControl.App.Fx.EqPanelRow"
             x:DataType="vm:EqPanelItem">
    <StackPanel Spacing="10" Margin="0,4">
        <vm:EqGraph Height="230" />

        <ItemsControl ItemsSource="{Binding Bands}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:EqBandItem">
                    <Button Classes="scope band" Classes.on="{Binding IsSelected}" Command="{Binding SelectCommand}"
                            Focusable="False" Margin="2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding Number}" FontSize="11" HorizontalAlignment="Center" Classes="muted" />
                            <TextBlock Text="{Binding GainText}" FontSize="11" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid DataContext="{Binding Selected}" x:DataType="vm:EqBandItem" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="EditorLabel" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="72" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Type" VerticalAlignment="Center" Margin="0,0,24,0" />
            <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:EqBandItem.TypeNames}" SelectedItem="{Binding TypeName}" Width="180" HorizontalAlignment="Left" />

            <TextBlock Grid.Row="1" Text="Frequency" VerticalAlignment="Center" Margin="0,0,24,0" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1000" Value="{Binding FreqPos}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding FreqText}" Classes="muted" TextAlignment="Right" Margin="8,0,0,0" VerticalAlignment="Center" />

            <TextBlock Grid.Row="2" Text="Gain" VerticalAlignment="Center" Margin="0,0,24,0" />
            <Slider Grid.Row="2" Grid.Column="1" Minimum="-24" Maximum="24" Value="{Binding GainSteps}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding GainTextDb}" Classes="muted" TextAlignment="Right" Margin="8,0,0,0" VerticalAlignment="Center" />

            <TextBlock Grid.Row="3" Text="Q (width)" VerticalAlignment="Center" Margin="0,0,24,0" />
            <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1000" Value="{Binding QPos}" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding QText}" Classes="muted" TextAlignment="Right" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                   Text="Left/Right pick a band; Up/Down move between Type, Frequency, Gain and Q; Enter on a slider adjusts it with Left/Right (Enter or Esc finishes). With the mouse, drag a node on the graph or scroll over it to change Q." />
    </StackPanel>
</UserControl>
