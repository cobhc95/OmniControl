<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Fx"
             xmlns:c="using:OmniControl.App.Controls"
             x:Class="OmniControl.App.Fx.IrFileRow"
             x:DataType="vm:IrFileItem">
    <!-- The IR Loader's file card, after TabForge's window: the file row (name, its path trimmed at the start, Browse), the picture of the
         impulse response (waveform above, frequency response below; also the place to drop a file) and the file's facts under it. -->
    <StackPanel Spacing="6" Margin="0,4">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <TextBlock Text="IR file" VerticalAlignment="Center" />
            <c:PathField Grid.Column="1" Grid.ColumnSpan="2" x:Name="PathBox" Text="{Binding Path, Mode=OneWay}" Hint="(none)" Kind="File"
                         PickerTitle="Choose an impulse response" Chosen="OnChosen" />
        </Grid>
        <vm:IrGraph Height="{StaticResource IrGraphHeight}" />
        <TextBlock Text="{Binding Facts}" Classes="hint" />
    </StackPanel>
</UserControl>
