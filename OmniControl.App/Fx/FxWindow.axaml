<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fx="using:OmniControl.App.Fx"
        x:Class="OmniControl.App.Fx.FxWindow"
        x:DataType="fx:FxChainViewModel"
        Title="{Binding Title}" Topmost="{Binding KeepOnTop}" Width="860" Height="540" MinWidth="560" MinHeight="380"
        Background="{DynamicResource BrushBackground}" WindowStartupLocation="CenterScreen">
    <fx:FxChainView x:Name="FxView" />
</Window>
