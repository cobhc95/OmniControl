<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Fx"
             x:Class="OmniControl.App.Fx.EffectEditorView"
             x:DataType="vm:FxSlotViewModel" Grid.IsSharedSizeScope="True">
    <!-- An effect's editor as OmniControl draws it (in the FX window and in its own window): the cards (the equaliser, sliders) or
         the plain settings list, scaled as a whole by the effect's Scale; one scroll bar beside it (the master style), never scaled -->
    <Grid RowDefinitions="Auto,*" RowSpacing="6">
        <TextBox Classes="field" Text="{Binding PluginParameters.Search}" Watermark="Find a setting"
                 IsVisible="{Binding PluginParameters.HasSearch, FallbackValue=False}" />
        <ScrollViewer Grid.Row="1">
            <LayoutTransformControl LayoutTransform="{Binding ScaleFactor, Converter={x:Static vm:EffectEditorView.ToScale}}">
                <ListBox x:Name="Cards" Classes="rows compact" ItemsSource="{Binding ShownItems}">
                    <!-- Not virtualised: the scroll viewer around it scrolls, so the list takes its whole height -->
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                </ListBox>
            </LayoutTransformControl>
        </ScrollViewer>
    </Grid>
</UserControl>
