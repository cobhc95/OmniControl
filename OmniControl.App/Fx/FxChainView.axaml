<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Fx"
             x:Class="OmniControl.App.Fx.FxChainView"
             x:DataType="vm:FxChainViewModel" FontSize="12">
    <UserControl.Styles>
        <Style Selector="CheckBox"><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector="CheckBox /template/ ContentPresenter"><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector="Button.scope"><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector="MenuItem"><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector="Border.pane"><Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" /></Style>
    </UserControl.Styles>
    <!-- TabForge-style FX chain window: menu bar, options row, chain list on the left, the selected effect on the right. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Grid.IsSharedSizeScope="True">

        <Border Background="{DynamicResource BrushSidebar}" BorderBrush="{DynamicResource BrushDivider}" BorderThickness="0,0,0,1">
            <Menu FontSize="12">
                <MenuItem Header="_FX">
                    <MenuItem Header="Add effect..." Click="OnAddClick" InputGesture="Ctrl+N" />
                    <MenuItem Header="Remove" Command="{Binding RemoveCommand}" />
                    <MenuItem Header="Move up" Command="{Binding MoveUpCommand}" InputGesture="Alt+Up" />
                    <MenuItem Header="Move down" Command="{Binding MoveDownCommand}" InputGesture="Alt+Down" />
                    <Separator />
                    <MenuItem Header="Close" Command="{Binding CloseWindowCommand}" InputGesture="Escape" />
                </MenuItem>
                <MenuItem Header="_Options">
                    <MenuItem Header="Chain on" ToggleType="CheckBox" IsChecked="{Binding FxOn}" />
                    <MenuItem Header="Keep on top" ToggleType="CheckBox" IsChecked="{Binding KeepOnTop}" />
                </MenuItem>
            </Menu>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding Output}" IsVisible="{Binding IsProgram}" Margin="12,10,12,0" />

        <Grid Grid.Row="2" ColumnDefinitions="0.85*,2*" ColumnSpacing="10" Margin="12,10,12,8">
            <!-- Left: the chain in signal order -->
            <Grid RowDefinitions="*,Auto" RowSpacing="8" MinWidth="170">
                <Border Grid.Row="0" Classes="pane" BorderThickness="1" CornerRadius="6" Background="{DynamicResource BrushSidebar}">
                    <Grid>
                        <ListBox x:Name="SlotList" Classes="fxlist" SelectionMode="Multiple" ItemsSource="{Binding Slots}" SelectedItem="{Binding Selected}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:FxSlotViewModel">
                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding Enabled}" ToolTip.Tip="On or bypassed" MinWidth="0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Tag}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border x:Name="SelectionBand" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1">
                            <Border Background="{DynamicResource BrushAccent}" Opacity="0.15" />
                        </Border>
                        <TextBlock Text="Empty chain. Use Add... to load an effect." Classes="muted" TextWrapping="Wrap"
                                   IsVisible="{Binding IsEmpty}" Margin="10" VerticalAlignment="Top" />
                    </Grid>
                </Border>

                <WrapPanel Grid.Row="1" Orientation="Horizontal" MinHeight="30">
                    <Button x:Name="AddButton" Tag="scope" Classes="scope fxbtn" Click="OnAddClick" HorizontalContentAlignment="Center" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Add..." /><TextBlock Text="Ctrl+N" Classes="muted" FontSize="10" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Tag="scope" Classes="scope fxbtn" Command="{Binding RemoveCommand}" HorizontalContentAlignment="Center" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Remove" /><TextBlock Text="Del" Classes="muted" FontSize="10" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Tag="scope" Classes="scope fxbtn" Content="Forget program" Command="{Binding ForgetCommand}" IsVisible="{Binding CanForget}"
                            HorizontalContentAlignment="Center" Margin="0,0,6,0" />
                </WrapPanel>
            </Grid>

            <!-- Right: preset / wet / on for the selected effect, then its editor -->
            <Grid Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="8">
                <Grid Grid.Row="1" MinHeight="30">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding HasSelection}">
                        <ComboBox ItemsSource="{Binding Selected.PresetChoice.Options}" SelectedItem="{Binding Selected.PresetChoice.Selected}"
                                  IsVisible="{Binding Selected.HasPresets}" Width="170" Margin="0,0,14,0" VerticalAlignment="Center" />
                        <TextBlock Text="Wet" VerticalAlignment="Center" Margin="0,0,8,0" Classes="muted" />
                        <Slider Minimum="0" Maximum="100" Value="{Binding Selected.Wet}" Width="130" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Selected.Wet}" Classes="muted" MinWidth="30" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,14,0" />
                        <CheckBox Content="On" IsChecked="{Binding Selected.Enabled}" VerticalAlignment="Center" />
                    </WrapPanel>
                </Grid>

                <Border Grid.Row="0" Classes="pane" BorderThickness="1" CornerRadius="6" Background="{DynamicResource BrushSidebar}" Padding="6">
                    <Grid>
                        <ListBox x:Name="EditorList" Classes="rows compact" ItemsSource="{Binding Editor}" />
                        <TextBlock Text="{Binding Hint}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" IsVisible="{Binding HasHint}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Shortcut bar -->
        <Border Grid.Row="3" Background="{DynamicResource BrushSidebar}" BorderBrush="{DynamicResource BrushDivider}" BorderThickness="0,1,0,0" Padding="12,6">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{Binding EffectCount}" Classes="muted" FontSize="11" Margin="0,0,16,0" />
                <TextBlock Text="Tab switch list / editor" Classes="muted" FontSize="11" Margin="0,0,16,0" />
                <TextBlock Text="Up/Down choose · Shift+arrows, Ctrl+click, Ctrl+A select several" Classes="muted" FontSize="11" Margin="0,0,16,0" />
                <TextBlock Text="Enter edit" Classes="muted" FontSize="11" Margin="0,0,16,0" />
                <TextBlock Text="Space on/off" Classes="muted" FontSize="11" Margin="0,0,16,0" />
                <TextBlock Text="Alt+Up/Down move" Classes="muted" FontSize="11" Margin="0,0,16,0" />
                <TextBlock Text="Esc close" Classes="muted" FontSize="11" />
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
