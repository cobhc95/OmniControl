<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Pages"
             xmlns:vm="using:OmniControl.App.Fx"
             x:Class="OmniControl.App.Fx.EqBandRow"
             x:DataType="vm:EqBandItem">
    <!-- One equaliser band's controls: title, Type and On; Frequency (Hz and note); Gain; Bandwidth (octaves and Q). Shown for the
         selected band under the graph (EqPanelRow) and as one card per band in the equaliser's plain settings list. Every row is its
         own grid (so Ctrl+Enter on a slider types the value beside it) on shared columns. -->
    <StackPanel Spacing="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="EditorLabel" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="64" SharedSizeGroup="EqValue" />
                <ColumnDefinition Width="Auto" MinWidth="48" SharedSizeGroup="EqExtra" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,24,0" />
            <ComboBox Grid.Column="1" Classes="choice" ItemsSource="{x:Static vm:EqBandItem.TypeNames}" SelectedItem="{Binding TypeName}"
                      ToolTip.Tip="Filter type" />
            <ToggleSwitch Grid.Column="3" IsChecked="{Binding Enabled}" OnContent="On" OffContent="Off" HorizontalAlignment="Right"
                          Margin="8,0,0,0" ToolTip.Tip="Band on or bypassed" />
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="EditorLabel" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="64" SharedSizeGroup="EqValue" />
                <ColumnDefinition Width="Auto" MinWidth="48" SharedSizeGroup="EqExtra" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Frequency" VerticalAlignment="Center" Margin="0,0,24,0" />
            <Slider Grid.Column="1" Minimum="0" Maximum="{x:Static vm:EqBandItem.LogSteps}" Value="{Binding FreqPos}"
                    pages:SliderReset.Value="{Binding DefaultFreqPos}" />
            <pages:NumberText Grid.Column="2" Value="{Binding Freq}" Minimum="{x:Static vm:EqBandItem.MinFreq}"
                              Maximum="{x:Static vm:EqBandItem.MaxFreq}" Decimals="1" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                              ToolTip.Tip="Double-click to type the frequency in Hz">
                <TextBlock Text="{Binding FreqText}" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </pages:NumberText>
            <TextBlock Grid.Column="3" Text="{Binding NoteText}" Classes="muted" Margin="8,0,0,0" HorizontalAlignment="Right"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="Nearest note" />
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="EditorLabel" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="64" SharedSizeGroup="EqValue" />
                <ColumnDefinition Width="Auto" MinWidth="48" SharedSizeGroup="EqExtra" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Gain" VerticalAlignment="Center" Margin="0,0,24,0" />
            <Slider Grid.Column="1" Minimum="{x:Static vm:EqBandItem.MinGainSteps}" Maximum="{x:Static vm:EqBandItem.MaxGainSteps}"
                    Value="{Binding GainSteps}" pages:SliderReset.Value="{Binding DefaultGainSteps}" IsEnabled="{Binding UsesGain}"
                    ToolTip.Tip="This type has no gain" ToolTip.IsEnabled="{Binding !UsesGain}" ToolTip.ShowOnDisabled="True" />
            <pages:NumberText Grid.Column="2" Value="{Binding Gain}" Minimum="{x:Static vm:EqBandItem.MinGain}"
                              Maximum="{x:Static vm:EqBandItem.MaxGain}" Decimals="1" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsEnabled="{Binding UsesGain}">
                <TextBlock Text="{Binding GainTextDb}" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </pages:NumberText>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="EditorLabel" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="64" SharedSizeGroup="EqValue" />
                <ColumnDefinition Width="Auto" MinWidth="48" SharedSizeGroup="EqExtra" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Bandwidth" VerticalAlignment="Center" Margin="0,0,24,0" />
            <Slider Grid.Column="1" Minimum="0" Maximum="{x:Static vm:EqBandItem.LogSteps}" Value="{Binding WidthPos}"
                    pages:SliderReset.Value="{Binding DefaultWidthPos}" />
            <pages:NumberText Grid.Column="2" Value="{Binding Bandwidth}" Minimum="{x:Static vm:EqBandItem.MinBandwidth}"
                              Maximum="{x:Static vm:EqBandItem.MaxBandwidth}" Decimals="2" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                              ToolTip.Tip="Double-click to type the bandwidth in octaves">
                <TextBlock Text="{Binding BandwidthText}" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </pages:NumberText>
            <pages:NumberText Grid.Column="3" Value="{Binding Q}" Minimum="{x:Static vm:EqBandItem.MinQ}"
                              Maximum="{x:Static vm:EqBandItem.MaxQ}" Decimals="2" Margin="8,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                              ToolTip.Tip="The same width as Q; double-click to type it">
                <TextBlock Text="{Binding QText}" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </pages:NumberText>
        </Grid>
    </StackPanel>
</UserControl>
