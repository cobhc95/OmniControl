<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OmniControl.App.Fx.MessageWindow"
        Icon="avares://OmniControl/Assets/OmniControl.ico" Width="460" MinWidth="360" SizeToContent="Height"
        Background="{DynamicResource BrushBackground}" WindowStartupLocation="CenterScreen">
    <!-- A short message about effects setup: two or three plain lines, an optional confirm button, and the technical detail,
         copied with "Copy details" or shown in the box below for a preview. Esc, Close or Cancel = no; the confirm button = yes. -->
    <StackPanel Margin="12" Spacing="10">
        <TextBlock x:Name="Heading" Classes="title" TextWrapping="Wrap" />
        <TextBlock x:Name="Message" TextWrapping="Wrap" />
        <TextBox x:Name="DetailsBox" Classes="field" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="320"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
        <Grid ColumnDefinitions="Auto,*,Auto">
            <Button x:Name="CopyButton" Classes="pill" Content="Copy details" VerticalAlignment="Center" Click="OnCopyClick" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ConfirmButton" Classes="usebtn scope" Tag="scope" Click="OnConfirmClick" />
                <Button x:Name="CloseButton" Classes="primary" Content="Close" Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
