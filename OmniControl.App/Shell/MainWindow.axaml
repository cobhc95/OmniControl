<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:OmniControl.App.Shell"
        xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
        xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
        xmlns:restore="using:OmniControl.App.Shared.Ui.Restore"
        x:Class="OmniControl.App.Shell.MainWindow"
        x:DataType="shell:ShellViewModel"
        Title="OmniControl" ShowInTaskbar="True" Width="860" Height="620" MinWidth="680" MinHeight="460"
       
        WindowStartupLocation="CenterScreen">


    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Classes="footer">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <!-- App-level pages (App settings) as pills at the footer's left; the open one takes the pill's accent look -->
                <ItemsControl x:Name="FooterNav" ItemsSource="{Binding FooterPages}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="{StaticResource GapLarge}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="pill" Classes.custom="{Binding IsOpen}" Tag="footernav" HorizontalAlignment="Left"
                                    Command="{Binding $parent[ItemsControl].DataContext.OpenFooterPageCommand}" CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}">
                                    <PathIcon Data="{Binding Icon}" Width="12" Height="12" />
                                    <TextBlock Text="{Binding Title}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- How groups start when a page opens (docs/mockups/groups-open-setting.html); the main window's keys are listed by F1 -->
                <c:GroupsOpenChip Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" />
                <TextBlock Grid.Column="2" Text="{Binding Status}" Classes="muted" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,16,0" ToolTip.Tip="{Binding StatusTip}" />
                <TextBlock Grid.Column="3" Text="{Binding CurrentPage.FooterStatus}" Classes="muted" VerticalAlignment="Center" Margin="0,0,14,0"
                           IsVisible="{Binding CurrentPage.FooterStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}, FallbackValue=False}" />
                <Button Grid.Column="4" Content="Close" Classes="primary close"
                        Click="OnCloseClick" />
            </Grid>
        </Border>

        <!-- Sidebar -->
        <!-- No fixed width: the sidebar is as wide as its longest page name, so no empty strip sits before the divider -->
        <Border x:Name="Sidebar" DockPanel.Dock="Left" Classes="sidebarpanel" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,14,0,8">
                <StackPanel DockPanel.Dock="Top" Margin="{StaticResource NavTitleMargin}" Spacing="2">
                    <TextBlock Text="OmniControl" Classes="title" />
                    <TextBlock Text="{Binding VersionText}" Classes="muted" />
                </StackPanel>

                <!-- Entries pinned to the bottom under a thin divider that open a window, not a page (Actions and hotkeys); the same item look
                     as the list above; a click or Enter opens the window (MainWindow.axaml.cs) -->
                <StackPanel DockPanel.Dock="Bottom">
                    <!-- Only while a newer version exists (the update check): a click opens App settings at the Updates group -->
                    <Button Classes="pill accentline" Command="{Binding OpenUpdatesCommand}" IsVisible="{Binding HasUpdate}" HorizontalAlignment="Left"
                            Margin="{StaticResource NavPillMargin}" ToolTip.Tip="Open the Updates group in App settings">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}">
                            <c:IconGlyph LibraryId="download" />
                            <TextBlock Text="{Binding UpdateNotice}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                    <Border Classes="hrule" Margin="{StaticResource NavRuleMargin}" />
                    <c:NavList x:Name="PinnedNav" Classes="nav" ItemsSource="{Binding PinnedEntries}">
                        <c:NavList.DataTemplates>
                            <DataTemplate DataType="shell:NavLauncher">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Panel Classes="navicon"><PathIcon Classes="navicon" Data="{Binding Icon}" /></Panel>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </c:NavList.DataTemplates>
                    </c:NavList>
                </StackPanel>

                <!-- Pages and the group headings above them (NavList: a heading cannot be clicked, focused or stepped onto) -->
                <c:NavList x:Name="MainNav" Classes="nav" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedMainPage}">
                    <c:NavList.DataTemplates>
                        <DataTemplate DataType="pages:NavHeading">
                            <TextBlock Classes="navheading" Text="{Binding Text}" />
                        </DataTemplate>
                        <DataTemplate DataType="shell:PageSlot">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Panel Classes="navicon"><PathIcon Classes="navicon" Data="{Binding Icon}" /></Panel>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </c:NavList.DataTemplates>
                </c:NavList>
            </DockPanel>
        </Border>

        <!-- Page content -->
        <DockPanel>
            <!-- Top bar: global search on the right -->
            <Border DockPanel.Dock="Top" Padding="12,12,12,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox x:Name="SearchBox" Classes="bar search" Text="{Binding SearchText}" pages:SearchClear.Shortcut="{Binding SearchShortcut}" Watermark="Search settings…" ToolTip.Tip="Search (Ctrl+F)" />
                    <ComboBox Grid.Column="1" Classes="bar" ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}" Width="200" />
                </Grid>
            </Border>
            <ScrollViewer x:Name="ContentHost">
                <StackPanel Margin="12,12,12,24">
                    <StackPanel IsVisible="{Binding !IsSearching}">
                        <!-- The title line of a page without its own: the name, and the page's "Restore defaults" at the far right -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,0,0,8" IsVisible="{Binding !CurrentPage.ShowsOwnHeader}">
                            <TextBlock Text="{Binding CurrentPage.Title}" Classes="title" VerticalAlignment="Center" />
                            <restore:RestoreBar Grid.Column="1" DataContext="{Binding CurrentPage.Restorer}" />
                        </Grid>
                        <shell:PageHost Page="{Binding ShownPage}" Kept="{Binding KeptPages}" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsSearching}" Spacing="12">
                        <TextBlock Text="Search results" Classes="title" />
                        <TextBlock Text="No settings match." Classes="muted"
                                   IsVisible="{Binding !SearchResults.Count}" />
                        <StackPanel IsVisible="{Binding ShowsSimilar}" Spacing="2">
                            <TextBlock Text="{Binding NoExactText}" Classes="muted" TextWrapping="Wrap" />
                            <TextBlock Text="Similar matches" Classes="section muted" />
                        </StackPanel>
                        <ListBox x:Name="ResultList" Grid.IsSharedSizeScope="True" Classes="rows results" ItemsSource="{Binding SearchResults}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="pages:SearchEntry">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="{StaticResource SearchEditorShare}" MinWidth="{StaticResource SearchEditorMinWidth}" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Classes="strong" pages:SearchHighlight.Text="{Binding Title}" pages:SearchHighlight.Query="{Binding $parent[Window].DataContext.ResultQuery}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                            <TextBlock pages:SearchHighlight.Text="{Binding Heading}" pages:SearchHighlight.Query="{Binding $parent[Window].DataContext.ResultQuery}" Classes="muted" FontSize="{StaticResource SummaryFontSize}" TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowsHeading}" />
                                            <TextBlock pages:SearchHighlight.Entry="{Binding}" pages:SearchHighlight.Query="{Binding $parent[Window].DataContext.ResultQuery}" Classes="muted" FontSize="{StaticResource SummaryFontSize}" TextTrimming="CharacterEllipsis" />
                                            <c:RemoteSectionTag Label="{Binding RemotePc}" />
                                        </StackPanel>
                                        <ContentControl Grid.Column="1" Content="{Binding Editor}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</Window>
