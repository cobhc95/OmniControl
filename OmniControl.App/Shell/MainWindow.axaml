<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:OmniControl.App.Shell"
        xmlns:pages="using:OmniControl.App.Pages"
        x:Class="OmniControl.App.Shell.MainWindow"
        x:DataType="shell:ShellViewModel"
        Icon="avares://OmniControl/Assets/OmniControl.ico" Title="OmniControl" Width="900" Height="620" MinWidth="720" MinHeight="460"
        Background="{DynamicResource BrushBackground}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate x:Key="NavItemTemplate">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <PathIcon Data="{Binding Icon}" Width="18" Height="18" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BrushDivider}" BorderThickness="0,1,0,0" Padding="24,8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <TextBlock Text="{Binding Version}" Classes="muted" VerticalAlignment="Center" />
                <!-- The one place the main window's keyboard shortcuts are listed (principle 12: no key instructions on the pages) -->
                <Button Grid.Column="1" Classes="pill" Content="Keyboard shortcuts" Command="{Binding ShowKeyboardShortcutsCommand}"
                        VerticalAlignment="Center" Margin="14,0,0,0" ToolTip.Tip="The keys of the open page and of the whole window (F1)" />
                <TextBlock Grid.Column="2" Text="{Binding Status}" Classes="muted" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,16,0" ToolTip.Tip="{Binding Status}" />
                <TextBlock Grid.Column="3" Text="{Binding ActiveLayer}" Classes="muted" VerticalAlignment="Center" Margin="0,0,14,0" IsVisible="{Binding ShowsActiveLayer}" />
                <Button Grid.Column="4" Content="Close" Classes="primary" Width="96"
                        HorizontalContentAlignment="Center" Click="OnCloseClick" />
            </Grid>
        </Border>

        <!-- Sidebar -->
        <Border x:Name="Sidebar" DockPanel.Dock="Left" Width="220" Background="{DynamicResource BrushSidebar}"
                BorderBrush="{DynamicResource BrushDivider}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,14,0,8">
                <StackPanel DockPanel.Dock="Top" Margin="24,0,0,10" Spacing="2">
                    <TextBlock Text="OmniControl" Classes="title" />
                    <TextBlock Text="Browse by category" Classes="muted" />
                </StackPanel>

                <!-- App-level pages, pinned to the bottom -->
                <ListBox x:Name="FooterNav" DockPanel.Dock="Bottom" Classes="nav" ItemsSource="{Binding FooterPages}"
                         SelectedItem="{Binding SelectedFooterPage}"
                         ItemTemplate="{StaticResource NavItemTemplate}" />

                <ListBox x:Name="MainNav" Classes="nav" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedMainPage}"
                         ItemTemplate="{StaticResource NavItemTemplate}" />
            </DockPanel>
        </Border>

        <!-- Page content -->
        <DockPanel>
            <!-- Top bar: global search on the right -->
            <Border DockPanel.Dock="Top" Padding="24,12,24,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox x:Name="SearchBox" Classes="bar" Text="{Binding SearchText}" Watermark="Search settings...  (Ctrl+F)" />
                    <ComboBox Grid.Column="1" Classes="bar" ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}" Width="200" />
                </Grid>
            </Border>
            <ScrollViewer x:Name="ContentHost">
                <StackPanel Margin="32,12,32,24">
                    <StackPanel IsVisible="{Binding !IsSearching}">
                        <TextBlock Text="{Binding CurrentPage.Title}" Classes="title" Margin="0,0,0,8"
                                   IsVisible="{Binding !CurrentPage.ShowsOwnHeader}" />
                        <ContentControl Content="{Binding CurrentPage}" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsSearching}" Spacing="12">
                        <TextBlock Text="Search results" Classes="title" />
                        <TextBlock Text="No settings match." Classes="muted"
                                   IsVisible="{Binding !SearchResults.Count}" />
                        <ListBox x:Name="ResultList" Grid.IsSharedSizeScope="True" Classes="rows results" ItemsSource="{Binding SearchResults}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="pages:SearchEntry">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="{StaticResource SearchEditorMinWidth}" SharedSizeGroup="SearchEditor" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Heading}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <ContentControl Grid.Column="1" Content="{Binding Editor}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</Window>
