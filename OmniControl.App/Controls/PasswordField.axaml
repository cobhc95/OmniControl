<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmniControl.App.Controls.PasswordField">
    <!-- THE password field: a TextBox.field showing dots, with an eye (Button.reveal) inside its right edge, then a "Save" pill; one tag
         (saved in Windows · HH:mm, or "not saved" while typed text is waiting) on its own line under them, so the box and the pill keep their
         room at the narrowest window. Holding the eye with the mouse, or holding Space or Enter
         while it has focus, shows the password; letting go, leaving it or Esc hides it again, so it never stays shown. -->
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
        <TextBox x:Name="Box" Classes="field" PasswordChar="•" HorizontalAlignment="Stretch" MinWidth="0">
            <TextBox.InnerRightContent>
                <Button x:Name="Eye" Classes="reveal" ToolTip.Tip="Hold to show the password">
                    <Path Classes="glyph" Data="{StaticResource EyeIcon}" />
                </Button>
            </TextBox.InnerRightContent>
        </TextBox>
        <Button x:Name="SaveButton" Grid.Column="1" Classes="pill" Content="Save" VerticalAlignment="Center" Click="OnSaveClick"
                ToolTip.Tip="Save the password in the Windows Credential Manager (Enter does the same)." />
        <Border x:Name="SavedTag" Grid.Row="1" Grid.ColumnSpan="2" Classes="tag good" HorizontalAlignment="Left" Margin="0,4,0,0" IsVisible="False"><TextBlock x:Name="SavedText" /></Border>
        <Border x:Name="UnsavedTag" Grid.Row="1" Grid.ColumnSpan="2" Classes="tag caution" HorizontalAlignment="Left" Margin="0,4,0,0" IsVisible="False"><TextBlock Text="not saved" /></Border>
    </Grid>
</UserControl>
