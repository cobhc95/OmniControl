<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OmniControl.App.Controls"
             x:Class="OmniControl.App.Controls.GroupsOpenChip">
    <!-- The sidebar foot's "Groups: ..." chip (docs/mockups/groups-open-setting.html): the shared ChipMenu opening a menu of how groups start when a
         page opens. Wiring in the code-behind; the setting itself is Services/GroupsOpen. -->
    <c:ChipMenu x:Name="Chip" MenuOpened="OnOpened" MenuClosed="OnClosed">
        <c:ChipMenu.Menu>
            <c:MenuRowList x:Name="Rows" Title="Groups when a page opens" Picked="OnPicked" />
        </c:ChipMenu.Menu>
    </c:ChipMenu>
</UserControl>
