<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmniControl.App.Controls.AnchorPicker"
             Focusable="True" HorizontalAlignment="Center">
    <!-- THE 3 x 3 grid picker (docs/mockups/osd-custom-position.html): nine small squares, the chosen one in the accent. A click picks a square;
         the arrow keys walk the grid while the picker has the keyboard (its frame turns accent). Sizes AnchorCell* in App.axaml, looks
         Button.anchorcell and Border.anchorframe in Styles/RowControls.axaml. -->
    <Border x:Name="Frame" Classes="anchorframe">
        <UniformGrid x:Name="Cells" Rows="3" Columns="3" />
    </Border>
</UserControl>
