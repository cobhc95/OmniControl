<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OmniControl.App.Controls"
             x:Class="OmniControl.App.Controls.IconText">
    <!-- THE optional icon before a name (a card's label, a chip's words): the icon is drawn only when one is given, so a name without one looks as it always did.
         The glyph's size is CardIconSize (App.axaml); the name wraps or trims in the room left, never under the glyph. -->
    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
        <c:IconGlyph x:Name="Glyph" Classes="cardicon" Margin="0,0,6,0" IsVisible="False" />
        <TextBlock x:Name="Words" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" />
    </Grid>
</UserControl>
