<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             x:Class="OmniControl.App.Shared.Ui.Controls.OptionList"
             x:DataType="c:OptionListModel">
    <!-- A list of options with ticks (the Combine devices window's members). The highlighted entry is the list's selection
         (ListBox.pick) and follows the pointer, so one row is lit at a time. -->
    <ListBox x:Name="Entries" Classes="pick compact" ItemsSource="{Binding Shown}" SelectedIndex="{Binding Highlight}" AutoScrollToSelectedItem="False"
             MaxHeight="{StaticResource OptionListMaxHeight}">
        <ListBox.ItemTemplate>
            <DataTemplate x:DataType="c:OptionEntry">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource MenuGap}" Background="Transparent"
                      Tapped="OnEntryTapped" PointerEntered="OnEntryPointerEntered">
                    <Border Classes="tickbox" Classes.checked="{Binding IsChecked}" VerticalAlignment="Center">
                        <Path Classes="tick" Data="{StaticResource TickIcon}" IsVisible="{Binding IsChecked}" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</UserControl>
