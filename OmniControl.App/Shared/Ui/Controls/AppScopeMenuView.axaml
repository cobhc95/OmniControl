<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             xmlns:apps="using:OmniControl.App.Features.AppLists"
             x:Class="OmniControl.App.Shared.Ui.Controls.AppScopeMenuView"
             x:DataType="apps:AppScopeModel">
    <!-- The one "Works in" menu, the content of a FlyoutPresenter.listmenu: the group header's Apps chip and a card's cogwheel both open it.
         Page one: All apps, Only in..., All except... (and "Same as the group" on a card); the last two turn to a page of the app lists in
         place. "Manage app lists..." opens the manager. Mouse first (AGENTS.md rule 5). -->
    <c:MenuRowList Title="{Binding MenuTitle}" ItemsSource="{Binding Rows}" />
</UserControl>
