<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:apps="using:OmniControl.App.Features.AppLists"
             x:Class="OmniControl.App.Shared.Ui.Controls.AppScopeMenuView"
             x:DataType="apps:AppScopeModel">
    <!-- The one "Works in" menu (docs/mockups/app-scope-and-lists.html), the content of a FlyoutPresenter.listmenu: the group header's
         Apps chip and a card's cogwheel both open it. Page one: All apps, Only in..., All except... (and "Same as the group" on a card);
         the last two open a page of the app lists. "Manage app lists..." opens the manager. Mouse first (AGENTS.md rule 5). -->
    <StackPanel>
        <TextBlock Classes="menutext" Text="{Binding MenuTitle}" />
        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="apps:ScopeMenuRow">
                    <Button Classes="menurow" Classes.chosen="{Binding IsCurrent}" Command="{Binding Command}">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource MenuGap}">
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding Hint}" IsVisible="{Binding HasHint}" TextTrimming="CharacterEllipsis" />
                            <PathIcon Grid.Column="2" Data="{DynamicResource ChevronRightIcon}" Width="{StaticResource ChevronSize}" Height="{StaticResource ChevronSize}" Foreground="{DynamicResource BrushMuted}" IsVisible="{Binding Opens}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="menutext" Text="No app lists yet." IsVisible="{Binding HasNoLists}" />
        <Border Classes="hrule" Margin="{StaticResource MenuRuleMargin}" />
        <Button Classes="menurow" Click="OnManageClick">
            <TextBlock Text="Manage app lists…" />
        </Button>
    </StackPanel>
</UserControl>
