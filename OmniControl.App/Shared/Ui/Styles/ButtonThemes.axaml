<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Button variants as control themes: a global style per variant class is tried on every Button of every window, so each variant's
         looks live in its ControlTheme and one style per class only picks the theme. A button keeps its class (Classes="pill"), which still
         carries the variant's child selectors (Button.pill TextBlock, in the master style files) and the later pill variants there.
         A theme's styles rank below every global style: only variants whose styles all came before the master hover in ThemeButtons.axaml
         (or that it leaves out) are here, in their old order, so the master hover and the later variant styles still win as before. -->
    <Styles.Resources>
        <!-- Button.pill (Styles/ThemeButtons.axaml has its child selectors) -->
        <ControlTheme x:Key="PillButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="13" />
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushControlEdge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
                <Setter Property="CornerRadius" Value="13" />
            </Style>
            <Style Selector="^.custom /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentEdge}" />
                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
            </Style>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            </Style>
            <!-- The cogwheel beside an action: a round version of the pill; lit while the keyboard is on it -->
            <Style Selector="^.cog"><Setter Property="Padding" Value="7,0" /><Setter Property="MinWidth" Value="24" /></Style>
            <!-- A one-character pill (the - and + arrows of a number setting) -->
            <Style Selector="^.glyph"><Setter Property="Padding" Value="9,0" /></Style>
            <!-- The round X pill (remove / delete beside a row or name box): an 18 px circle holding a 9 px drawn cross; after .glyph so it wins -->
            <Style Selector="^.closex">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="{StaticResource CloseXSize}" />
                <Setter Property="Height" Value="{StaticResource CloseXSize}" />
            </Style>
            <Style Selector="^.cog.active /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
            </Style>
            <Style Selector="^.custom:pointerover /template/ ContentPresenter#PART_ContentPresenter, ^.cog.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
            </Style>
            <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter, ^:focus-visible:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                <Setter Property="BorderThickness" Value="2" />
            </Style>
            <!-- A pill whose action runs (.counting, Controls/ChoiceChips): accent edge and words, see-through so the ProgressFill behind it shows; hover thickens the edge instead of hiding the fill -->
            <Style Selector="^.counting /template/ ContentPresenter#PART_ContentPresenter, ^.counting:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
            </Style>
            <Style Selector="^.counting:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderThickness" Value="2" /></Style>
            <!-- A destructive action pill (.danger: Wipe all...): red words and edge, so it never looks like a routine action; hover and focus as every pill -->
            <Style Selector="^.danger /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
                <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
            </Style>
            <Style Selector="^.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
            </Style>
            <!-- Action inside a pop-down card (.cardaction: Install, Remove, Preview changes, Test): the quiet pill is too faint on a tinted
                 card, so the text takes the normal colour and the edge a clear grey; .main (the one action that does the job, Install) is outlined in the accent -->
            <Style Selector="^.cardaction /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushControlEdge}" />
            </Style>
            <Style Selector="^.cardaction.main /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
            </Style>
            <Style Selector="^.cardaction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            </Style>
            <Style Selector="^.cardaction.main:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
            </Style>
            <Style Selector="^.cardaction:focus-visible /template/ ContentPresenter#PART_ContentPresenter, ^.cardaction:focus-visible:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                <Setter Property="BorderThickness" Value="2" />
            </Style>
        </ControlTheme>

        <!-- Button.statetoggle (Pages/StateButtonItem): an on/off state shown as its icon and words on a card's extras line, filling its share
             of the line; the plain control fill and edge while live; .muted = red words, edge and a faint red wash. Hover and focus as every
             pill (the edge only, so nothing moves); its child selectors are in Styles/ThemeButtons.axaml -->
        <ControlTheme x:Key="StateToggleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="6" />
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushControlFill}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushControlEdge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style Selector="^.muted /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushTagRiskSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
                <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
            </Style>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            </Style>
            <Style Selector="^.muted:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
                <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
            </Style>
            <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter, ^:focus-visible:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            </Style>
        </ControlTheme>

        <!-- Button.optioncard: a selectable card of a wide pop-down (the Method menu); .selected = the one in force -->
        <ControlTheme x:Key="OptionCardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="{StaticResource OptionCardPadding}" />
            <Setter Property="CornerRadius" Value="{StaticResource OptionCardCornerRadius}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
                <Setter Property="BorderThickness" Value="2" />
            </Style>
            <Style Selector="^.selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentEdge}" />
            </Style>
            <Style Selector="^.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            </Style>
            <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            </Style>
        </ControlTheme>

        <!-- Button.scope: a field-like picker or action button (device picker, Add program, Choose...); .mute = the Volume row's small square
             mute button ("M", lit in the accent while .on), .usebtn = the confirm of a window's foot (its hover and .danger stay in
             Styles/ThemeLists.axaml, as a confirm without .scope uses them too). The master hover leaves it out. -->
        <ControlTheme x:Key="ScopeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter, ^:focus-visible:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Background" Value="{DynamicResource BrushBackground}" />
            </Style>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushControlFill}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushControlEdge}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                <Setter Property="BorderThickness" Value="2" />
            </Style>
            <Style Selector="^.mute">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Height" Value="26" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="MinWidth" Value="26" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <!-- The window foot's two buttons (this confirm and Button.primary.close) share one height, font and minimum width -->
            <Style Selector="^.usebtn"><Setter Property="Padding" Value="12,0" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Height" Value="{StaticResource DialogButtonHeight}" /><Setter Property="MinWidth" Value="{StaticResource DialogCloseWidth}" /></Style>
            <Style Selector="^.mute.on /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            </Style>
            <!-- Lit (on) buttons keep their lit look but still react to the mouse -->
            <Style Selector="^.mute.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            </Style>
        </ControlTheme>

        <!-- Button.bandrow: a Parametric EQ band row (a tab-like row of the band list), outlined and flat; .on = the selected band (its
             accent bar and .off's dimming are child selectors in Styles/ThemeLists.axaml) -->
        <ControlTheme x:Key="BandRowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHoverEdge}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Style Selector="^.on /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushHoverEdge}" />
            </Style>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter, ^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            </Style>
        </ControlTheme>

        <!-- Button.step: a flat arrow beside a gallery; .chainchevron = the FX chain list's folder chevron. The master hover leaves it out. -->
        <ControlTheme x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
            </Style>
            <Style Selector="^.chainchevron"><Setter Property="Padding" Value="2" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /></Style>
        </ControlTheme>

        <!-- Button.groupHeader: the clickable header of a group panel (a subgroup's hover is a child selector in Styles/ThemeLists.axaml). The master hover leaves it out. -->
        <ControlTheme x:Key="GroupHeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushHover}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
            <Style Selector="^:focus /template/ ContentPresenter#PART_ContentPresenter, ^:focus:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="Button.pill"><Setter Property="Theme" Value="{StaticResource PillButton}" /></Style>
    <Style Selector="Button.statetoggle"><Setter Property="Theme" Value="{StaticResource StateToggleButton}" /></Style>
    <Style Selector="Button.optioncard"><Setter Property="Theme" Value="{StaticResource OptionCardButton}" /></Style>
    <Style Selector="Button.scope"><Setter Property="Theme" Value="{StaticResource ScopeButton}" /></Style>
    <Style Selector="Button.bandrow"><Setter Property="Theme" Value="{StaticResource BandRowButton}" /></Style>
    <Style Selector="Button.step"><Setter Property="Theme" Value="{StaticResource StepButton}" /></Style>
    <Style Selector="Button.groupHeader"><Setter Property="Theme" Value="{StaticResource GroupHeaderButton}" /></Style>
</Styles>
