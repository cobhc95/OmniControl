<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OmniControl.App.Shared.Ui.Controls">
    <!-- MASTER designs of a row's pickers and its lit button (docs/mockups/mixer-rows-knobs.html; MAP.md "Master UI pieces"),
         included after Theme.axaml and Menus.axaml so these win (Avalonia has no specificity: the later style wins). Sizes: Chip* and
         Selector* in App.axaml.
         Button.selector  a chip-shaped picker that opens a menu: its value, trimmed, and a small chevron at the right (a Mixer row's Plays
                          on and Method); outlined 1 px, the master button hover; keyboard focus = accent wash and edge (the edge never
                          thickens, so the words never move).
         Border.selector  the same chip shape when there is nothing to pick (a microphone's own device, a row whose method has no menu).
         .method          the Method chip's colour, one class per method: .apo (Equalizer APO, green), .cable (a cable or the cable bus,
                          blue BrushCable), .recording (the accent), none = direct (muted words, a plain edge).
         Button.selector.running  a chip whose thing is running now (the Simulation row's emulator chip): accent words and edge.
         Button.pill.glow the FX button while effects run: accent words, accent edge, accent wash and a soft accent glow (AccentGlow,
                          made from the accent by AccentService).
         Button.reveal    the eye inside a password field's right edge (Controls/PasswordField): flat, muted glyph, hover wash; accent wash and
                          accent glyph on keyboard focus or while held (no border change, nothing moves). -->
    <Style Selector="Button.selector">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="{DynamicResource ChipHeight}" />
        <Setter Property="Padding" Value="{DynamicResource SelectorPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ChipCornerRadius}" />
        <Setter Property="FontSize" Value="{DynamicResource MenuSmallFontSize}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.selector /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlEdge}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- c|ChipMenu.dropbox: the same chip drawn as a Windows drop-down box (the tray panel's display and speaker pickers): square-ish
         corners and the control's own fill; hover and focus stay the chip's (declared before them, so they win) -->
    <Style Selector="c|ChipMenu.dropbox > Button.selector">
        <Setter Property="Height" Value="{DynamicResource DropBoxHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DropBoxCornerRadius}" />
    </Style>
    <Style Selector="c|ChipMenu.dropbox > Button.selector /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushControlFill}" />
    </Style>
    <Style Selector="Button.selector:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Border.selector">
        <Setter Property="Height" Value="{DynamicResource ChipHeight}" />
        <Setter Property="Padding" Value="{DynamicResource SelectorPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ChipCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlEdge}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The words of either: one line, trimmed; the chevron after them -->
    <Style Selector="Button.selector > Grid > TextBlock, Border.selector > TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.selector > TextBlock"><Setter Property="FontSize" Value="{DynamicResource MenuSmallFontSize}" /></Style>
    <Style Selector="Button.selector > Grid > PathIcon">
        <Setter Property="Width" Value="{DynamicResource ChevronSize}" />
        <Setter Property="Height" Value="{DynamicResource ChevronSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The Method chip's colours (direct = the plain look above with muted words) -->
    <Style Selector="Button.selector.method /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource BrushMuted}" /></Style>
    <Style Selector="Border.selector.method > TextBlock"><Setter Property="Foreground" Value="{DynamicResource BrushMuted}" /></Style>
    <Style Selector="Button.selector.method.apo /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource BrushOn}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushTagGood}" />
    </Style>
    <Style Selector="Border.selector.method.apo"><Setter Property="BorderBrush" Value="{DynamicResource BrushTagGood}" /></Style>
    <Style Selector="Border.selector.method.apo > TextBlock"><Setter Property="Foreground" Value="{DynamicResource BrushOn}" /></Style>
    <Style Selector="Button.selector.method.cable /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource BrushCable}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushTagCable}" />
    </Style>
    <Style Selector="Border.selector.method.cable"><Setter Property="BorderBrush" Value="{DynamicResource BrushTagCable}" /></Style>
    <Style Selector="Border.selector.method.cable > TextBlock"><Setter Property="Foreground" Value="{DynamicResource BrushCable}" /></Style>
    <Style Selector="Button.selector.method.recording /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentEdge}" />
    </Style>
    <Style Selector="Button.selector.running /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentEdge}" />
    </Style>
    <Style Selector="Border.selector.method.recording"><Setter Property="BorderBrush" Value="{DynamicResource BrushAccentEdge}" /></Style>
    <Style Selector="Border.selector.method.recording > TextBlock"><Setter Property="Foreground" Value="{DynamicResource BrushAccent}" /></Style>
    <!-- A chip with a status dot (Controls/ChipMenu.Tone, docs/mockups/pc-header-tidy.html): .good = green words and edge (connected), .caution = yellow edge; the dot is c|StatusDot -->
    <Style Selector="Button.selector.good /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource BrushOn}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushTagGood}" />
    </Style>
    <Style Selector="Button.selector.caution /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource BrushTagCaution}" /></Style>
    <Style Selector="Button.selector > Grid > TextBlock.withdot"><Setter Property="Margin" Value="{DynamicResource ChipDotInset}" /></Style>
    <Style Selector="c|StatusDot">
        <Setter Property="Width" Value="{DynamicResource BrowserTabDotSize}" />
        <Setter Property="Height" Value="{DynamicResource BrowserTabDotSize}" />
        <Setter Property="Fill" Value="{DynamicResource BrushMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="c|StatusDot.good"><Setter Property="Fill" Value="{DynamicResource BrushOn}" /></Style>
    <Style Selector="c|StatusDot.caution"><Setter Property="Fill" Value="{DynamicResource BrushCaution}" /></Style>
    <Style Selector="c|StatusDot.risk"><Setter Property="Fill" Value="{DynamicResource BrushDanger}" /></Style>
    <!-- A pill in two halves (the Wake split button): Button.pill.splitleft + Button.pill.splitright side by side with the right one's Margin -1,0,0,0 so the shared edge is one line -->
    <Style Selector="Button.pill.splitleft"><Setter Property="CornerRadius" Value="13,0,0,13" /></Style>
    <Style Selector="Button.pill.splitleft /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="CornerRadius" Value="13,0,0,13" /></Style>
    <Style Selector="Button.pill.splitright"><Setter Property="CornerRadius" Value="0,13,13,0" /></Style>
    <Style Selector="Button.pill.splitright /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="CornerRadius" Value="0,13,13,0" /></Style>
    <Style Selector="Button.pill.splitleft:pointerover, Button.pill.splitright:pointerover, Button.pill.splitleft:focus-visible, Button.pill.splitright:focus-visible"><Setter Property="ZIndex" Value="1" /></Style>
    <!-- Hover and focus keep the chip's colour words; only the wash and the edge take the master hover and focus -->
    <Style Selector="Button.selector:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>

    <!-- The lit FX button: the pill's look in the accent, with a soft glow; hover keeps the glow -->
    <Style Selector="Button.pill.glow /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BoxShadow" Value="{DynamicResource AccentGlow}" />
    </Style>
    <Style Selector="Button.pill.glow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.reveal">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.reveal > Path.glyph">
        <Setter Property="Width" Value="{DynamicResource MenuGlyphSize}" />
        <Setter Property="Height" Value="{DynamicResource MenuGlyphSize}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Stroke" Value="{DynamicResource BrushMuted}" />
    </Style>
    <Style Selector="Button.reveal:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
    </Style>
    <Style Selector="Button.reveal:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
    </Style>
    <Style Selector="Button.reveal:focus-visible > Path.glyph, Button.reveal:pressed > Path.glyph"><Setter Property="Stroke" Value="{DynamicResource BrushAccent}" /></Style>
    <!-- Button.pin: a row's pin (Network by app) holding a Path.glyph of Icon.pinned. Not pinned = a faint muted outline that brightens
         while its row is hovered; .on = the pin filled in the accent. Hover wash BrushHoverStrong (differs from the row's hover), focus =
         accent wash; nothing moves. Sizes Pin* in App.axaml. -->
    <Style Selector="Button.pin">
        <Setter Property="Width" Value="{DynamicResource PinSize}" />
        <Setter Property="Height" Value="{DynamicResource PinSize}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource PinCornerRadius}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pin /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.pin:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" /></Style>
    <Style Selector="Button.pin:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" /></Style>
    <Style Selector="Button.pin > Path.glyph">
        <Setter Property="Width" Value="{DynamicResource PinGlyphSize}" />
        <Setter Property="Height" Value="{DynamicResource PinGlyphSize}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="Stroke" Value="{DynamicResource BrushMuted}" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Opacity" Value="{DynamicResource PinFaintOpacity}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Button.pin > Path.glyph, Button.pin:pointerover > Path.glyph, Button.pin:focus-visible > Path.glyph"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Button.pin.on > Path.glyph">
        <Setter Property="Stroke" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Fill" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- Controls/AnchorPicker (docs/mockups/osd-custom-position.html): Border.anchorframe = its frame (an invisible 1 px edge that turns accent
         while it has the keyboard, so nothing moves); Button.anchorcell = one small square of its 3 x 3 grid (raised and quiet; the chosen one
         .selected = accent; hover = the master hover edge). Sizes AnchorCell* in App.axaml. -->
    <Style Selector="Border.anchorframe">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource AnchorFrameCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource AnchorFramePadding}" />
    </Style>
    <Style Selector="Border.anchorframe.focused"><Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" /></Style>
    <Style Selector="Button.anchorcell">
        <Setter Property="Width" Value="{DynamicResource AnchorCellSize}" />
        <Setter Property="Height" Value="{DynamicResource AnchorCellSize}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="{DynamicResource AnchorCellGap}" />
        <Setter Property="CornerRadius" Value="{DynamicResource AnchorCellCornerRadius}" />
    </Style>
    <Style Selector="Button.anchorcell /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.anchorcell:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource BrushHoverEdge}" /></Style>
    <Style Selector="Button.anchorcell.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.anchorcell.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
</Styles>
