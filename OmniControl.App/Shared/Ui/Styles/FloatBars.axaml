<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- MASTER designs of a bar floating over a picture (the screenshot overlay's bars, the recording bar, the screen point picker): Border.floatbar
         = a small bar (.label = the selection's size), Button.toolicon = a square icon button of such a bar (.selected = the tool in use: accent wash and
         accent glyph; hover and press only change the wash, nothing moves). Included only by the windows that show them, so no control of another
         window is matched against these. Sizes FloatBar*, ToolIcon* in App.axaml. -->
    <Style Selector="Border.floatbar">
        <Setter Property="Background" Value="{DynamicResource BrushSidebar}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FloatBarRadius}" />
        <Setter Property="Padding" Value="{StaticResource FloatBarPadding}" />
    </Style>
    <Style Selector="Border.floatbar > StackPanel"><Setter Property="Spacing" Value="{StaticResource FloatBarGap}" /></Style>
    <Style Selector="Border.floatsep"><Setter Property="Background" Value="{DynamicResource BrushDivider}" /></Style>
    <Style Selector="Border.floatsep.across">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="{StaticResource FloatSepAcross}" />
    </Style>
    <Style Selector="Border.floatsep.along">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="{StaticResource FloatSepAlong}" />
    </Style>
    <Style Selector="Border.floatbar.label > TextBlock"><Setter Property="FontSize" Value="{StaticResource ToolFontSize}" /></Style>
    <Style Selector="Button.toolicon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ToolIconRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- mouse first (AGENTS rule 5): the overlay keeps the keyboard, so its shortcuts and the arrow-key nudge always work (its tool buttons,
         and the dots of its colour pop-down, c:SwatchList IsMouseOnly) -->
    <Style Selector="Button.toolicon, ItemsControl.swatches.mouseonly Button.swatch"><Setter Property="Focusable" Value="False" /></Style>
    <Style Selector="Button.toolicon">
        <Setter Property="Width" Value="{StaticResource ToolIconSize}" />
        <Setter Property="Height" Value="{StaticResource ToolIconSize}" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.toolicon:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.toolicon:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
    </Style>
    <Style Selector="Button.toolicon.selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" /></Style>
    <Style Selector="Button.toolicon.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.toolicon.selected:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushAccentHover}" /></Style>
    <Style Selector="Button.toolicon:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.toolicon > Path.glyph">
        <Setter Property="Width" Value="{StaticResource ToolIconGlyph}" />
        <Setter Property="Height" Value="{StaticResource ToolIconGlyph}" />
    </Style>
    <Style Selector="Button.toolicon.selected > Path.glyph"><Setter Property="Stroke" Value="{DynamicResource BrushAccent}" /></Style>
    <Style Selector="Button.toolicon:disabled > Path.glyph"><Setter Property="Opacity" Value="0.4" /></Style>
</Styles>
