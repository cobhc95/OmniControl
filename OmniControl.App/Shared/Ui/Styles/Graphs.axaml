<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fx="using:OmniControl.App.Features.Volume.Fx"
        xmlns:c="using:OmniControl.App.Shared.Ui.Controls">
    <!-- MASTER designs of a small graph that is a control and of the live numbers beside it (the FX window toolbar's analysis,
         Fx/FxAnalysisBar and Fx/FxAnalysisNumbers). Included after Theme.axaml, so the thumbnail's own hover wins over the master button
         hover there. Sizes in App.axaml (FxThumb*, FxStats*); the larger graph's pop-down is FlyoutPresenter.graphmenu in Menus.axaml. -->

    <!-- Button.graphthumb: a drawn graph that opens a larger one (the response thumbnail). A quiet frame on the card surface; hover and
         keyboard focus change only the frame's colour (never its thickness), so the graph inside never moves -->
    <Style Selector="Button.graphthumb">
        <Setter Property="Width" Value="{DynamicResource FxThumbWidth}" />
        <Setter Property="Height" Value="{DynamicResource FxThumbHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource BrushSidebar}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlEdge}" />
    </Style>
    <Style Selector="Button.graphthumb /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushSidebar}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlEdge}" />
    </Style>
    <Style Selector="Button.graphthumb:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushSidebar}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushHoverEdge}" />
    </Style>
    <Style Selector="Button.graphthumb:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.graphthumb:focus-visible /template/ ContentPresenter#PART_ContentPresenter, Button.graphthumb:focus-visible:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushSidebar}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>

    <!-- Live numbers (StackPanel.stats of StackPanel.stat): a muted label, then the value in the normal colour and a little heavier;
         TextBlock.statvalue.caution = a value past a warning point (the Peak above the default scale) -->
    <Style Selector="StackPanel.stats"><Setter Property="Orientation" Value="Horizontal" /><Setter Property="Spacing" Value="10" /></Style>
    <Style Selector="StackPanel.stat"><Setter Property="Orientation" Value="Horizontal" /><Setter Property="Spacing" Value="3" /></Style>
    <Style Selector="TextBlock.statlabel">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.statvalue">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.statvalue.caution"><Setter Property="Foreground" Value="{DynamicResource BrushCaution}" /></Style>
    <!-- fx|FxAnalysisNumbers.stacked: the numbers as tiny stacked lines beside the thumbnail in a toolbar (the larger graph keeps them in a row) -->
    <Style Selector="fx|FxAnalysisNumbers.stacked StackPanel.stats"><Setter Property="Orientation" Value="Vertical" /><Setter Property="Spacing" Value="0" /></Style>
    <Style Selector="fx|FxAnalysisNumbers.stacked TextBlock.statlabel, fx|FxAnalysisNumbers.stacked TextBlock.statvalue">
        <Setter Property="FontSize" Value="{DynamicResource FxStatsSmallFontSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource FxStatsSmallLineHeight}" />
    </Style>

    <!-- c|Sparkline: THE small line of recent values (Controls/Sparkline; a Resources card's history), in the accent; SparklineHeight and
         SparklineThickness in App.axaml. It stretches across the room its card gives it -->
    <Style Selector="c|Sparkline">
        <Setter Property="Stroke" Value="{DynamicResource BrushAccent}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource SparklineThickness}" />
        <Setter Property="Height" Value="{DynamicResource SparklineHeight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
