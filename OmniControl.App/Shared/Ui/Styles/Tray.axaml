<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OmniControl.App.Shared.Ui.Controls">
    <!-- MASTER designs of the tray flyout (Tray/TrayFlyoutWindow). Sizes: Tray* in App.axaml. Included last. -->

    <!-- The flyout's window: no frame of its own and see-through, so only the rounded panel inside it shows -->
    <!-- Window.taskbargadget = the Resources taskbar gadget (Features/Resources/Gadget/GadgetWindow): borderless and see-through like the tray
         flyout; its Panel.gadgethit is all but invisible so a click between the numbers still reaches it, Grid.gadgetcells holds the lines -->
    <Style Selector="Window.trayflyout, Window.taskbargadget">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TransparencyLevelHint" Value="Transparent" />
        <Setter Property="SystemDecorations" Value="None" />
        <Setter Property="Topmost" Value="True" />
        <Setter Property="CanResize" Value="False" />
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
    </Style>

    <!-- The remove badge: THE small remove cross of a tile or a row. A round raised chip with a thin edge
         (RemoveBadgeSize) inside a clickable square (RemoveBadgeHit); the drawn cross (RemoveBadgeCross) is muted and turns red on hover. -->
    <Style Selector="Button.removebadge">
        <Setter Property="Width" Value="{DynamicResource RemoveBadgeHit}" />
        <Setter Property="Height" Value="{DynamicResource RemoveBadgeHit}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <Border Name="PART_Badge" Width="{DynamicResource RemoveBadgeSize}" Height="{DynamicResource RemoveBadgeSize}"
                            CornerRadius="{DynamicResource RemoveBadgeRadius}" BorderThickness="1"
                            Background="{DynamicResource BrushControlFill}" BorderBrush="{DynamicResource BrushControlEdge}" />
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.removebadge > Path.glyph">
        <Setter Property="Width" Value="{DynamicResource RemoveBadgeCross}" />
        <Setter Property="Height" Value="{DynamicResource RemoveBadgeCross}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button.removebadge:pointerover, Button.removebadge:focus-visible"><Setter Property="Foreground" Value="{DynamicResource BrushDanger}" /></Style>
    <Style Selector="Button.removebadge:pointerover /template/ Border#PART_Badge"><Setter Property="BorderBrush" Value="{DynamicResource BrushHoverEdge}" /></Style>
    <Style Selector="Button.removebadge:focus-visible /template/ Border#PART_Badge"><Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" /></Style>

    <!-- The flyout's panel, with a Windows 11 finish: a fixed width, rounded, one soft edge and a soft drop shadow (TrayShadowInset keeps
         room for the shadow inside the see-through window). Border.flyoutbody clips its bands to the rounded corners; the bands are
         Border.traytiles (the panel's own surface, the card colour), Border.traysliders (BrushCardShade, a step towards the page, a line above) and
         Border.trayfoot (the page colour, a line above): the background colour choice's surfaces (SurfaceService). -->
    <Style Selector="Border.flyoutpanel">
        <Setter Property="Width" Value="{DynamicResource TrayFlyoutWidth}" />
        <Setter Property="Margin" Value="{DynamicResource TrayShadowInset}" />
        <Setter Property="CornerRadius" Value="{DynamicResource TrayFlyoutCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="Background" Value="{DynamicResource BrushSidebar}" />
        <Setter Property="BoxShadow" Value="{DynamicResource TrayPanelShadow}" />
    </Style>
    <Style Selector="Border.flyoutbody">
        <Setter Property="CornerRadius" Value="{DynamicResource TrayFlyoutInnerRadius}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.traytiles"><Setter Property="Padding" Value="{DynamicResource TrayTilesPadding}" /></Style>
    <Style Selector="Border.traysliders, Border.trayfoot">
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
    </Style>
    <Style Selector="Border.traysliders">
        <Setter Property="Padding" Value="{DynamicResource TraySlidersPadding}" />
        <Setter Property="Background" Value="{DynamicResource BrushCardShade}" />
    </Style>
    <Style Selector="Border.trayfoot">
        <Setter Property="Padding" Value="{DynamicResource TrayFootPadding}" />
        <Setter Property="Background" Value="{DynamicResource BrushBackground}" />
    </Style>

    <!-- A tile: a Windows-style button (TrayTileHeight high, as wide as its cell of the tile grid: TrayTileColumns, even TrayTileGap gaps)
         holding its glyph, with its name UNDER it (StackPanel.traytile > TextBlock.wordtext). The 1 px edge is always there, so lighting, hover and
         focus change colours only. .on = its state is on (filled accent, the glyph in BrushOnAccent) -->
    <Style Selector="StackPanel.traytile"><Setter Property="Spacing" Value="{DynamicResource TrayTileNameGap}" /></Style>
    <Style Selector="Button.tile">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="{DynamicResource TrayTileHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="{DynamicResource TrayTileCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlEdge}" />
        <Setter Property="Background" Value="{DynamicResource BrushControlFill}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tile > c|IconGlyph">
        <Setter Property="Width" Value="{DynamicResource TrayGlyphSize}" />
        <Setter Property="Height" Value="{DynamicResource TrayGlyphSize}" />
    </Style>
    <Style Selector="StackPanel.traytile > TextBlock.wordtext">
        <Setter Property="FontSize" Value="{DynamicResource MenuSmallFontSize}" />
        <Setter Property="(c:WordText.FitFontSize)" Value="{DynamicResource TrayTileFitFontSize}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushHoverEdge}" />
    </Style>
    <Style Selector="Button.tile.on /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.tile.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentBright}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentBright}" />
    </Style>
    <Style Selector="Button.tile.on > c|IconGlyph"><Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" /></Style>
    <!-- .faded = its state is only the last one known: the button and its name are dimmed, lit or not -->
    <Style Selector="Button.tile.faded, StackPanel.traytile > TextBlock.wordtext.faded"><Setter Property="Opacity" Value="{DynamicResource TrayFadedOpacity}" /></Style>
    <!-- The tile's corner mark (top-right, TrayMarkSize): holds ONE of a spinning ring (an action runs), a pulsing grey dot (the state is read),
         a clock (only the last known value) or a red warning (the last action or read failed). It never takes the mouse. -->
    <Style Selector="Panel.tilemark">
        <Setter Property="Width" Value="{DynamicResource TrayMarkSize}" />
        <Setter Property="Height" Value="{DynamicResource TrayMarkSize}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="{DynamicResource TrayMarkMargin}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Panel.tilemark > Ellipse.markring, Button.statepower > Panel > Panel > Ellipse.markring">
        <Setter Property="Stroke" Value="{DynamicResource BrushMuted}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource TrayMarkStroke}" />
    </Style>
    <Style Selector="Panel.tilemark > Path.markarc, Button.statepower > Panel > Panel > Path.markarc">
        <Setter Property="Stroke" Value="{DynamicResource BrushAccent}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource TrayMarkStroke}" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="Width" Value="{DynamicResource TrayMarkSize}" />
        <Setter Property="Height" Value="{DynamicResource TrayMarkSize}" />
        <Setter Property="Data" Value="M5.5,0.75 A4.75,4.75 0 0 1 10.25,5.5" />
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <!-- The spin and the pulse run only while the mark is shown (.spinning, bound to the same state as its visibility), so a hidden mark never keeps the render clock awake -->
    <Style Selector="Panel.tilemark > Path.markarc.spinning, Button.statepower > Panel > Panel > Path.markarc.spinning">
        <Style.Animations>
            <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Panel.tilemark > Ellipse.markdot">
        <Setter Property="Width" Value="{DynamicResource TrayMarkDot}" />
        <Setter Property="Height" Value="{DynamicResource TrayMarkDot}" />
        <Setter Property="Fill" Value="{DynamicResource BrushMuted}" />
    </Style>
    <Style Selector="Panel.tilemark > Ellipse.markdot.spinning">
        <Style.Animations>
            <Animation Duration="0:0:0.8" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Panel.tilemark > c|IconGlyph.marknotsure"><Setter Property="Foreground" Value="{DynamicResource BrushMuted}" /></Style>
    <Style Selector="Panel.tilemark > c|IconGlyph.markfailed, Button.statepower > Panel > c|IconGlyph.markfailed"><Setter Property="Foreground" Value="{DynamicResource BrushDanger}" /></Style>
    <!-- Button.statepower: the small round power button at the right of a Smart Devices method row. It shows the
         device's state (grey = off, accent edge and wash = on); its Panel holds ONE of the power glyph, the spinner (an inner Panel with the tile
         mark's Ellipse.markring + Path.markarc) while this method runs, or the red warning glyph (.markfailed) when this method failed.
         Sizes: StatePower* in App.axaml. -->
    <Style Selector="Button.statepower">
        <Setter Property="Width" Value="{DynamicResource StatePowerSize}" />
        <Setter Property="Height" Value="{DynamicResource StatePowerSize}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource StatePowerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
    </Style>
    <Style Selector="Button.statepower /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlEdge}" />
        <Setter Property="CornerRadius" Value="{DynamicResource StatePowerRadius}" />
    </Style>
    <Style Selector="Button.statepower:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.statepower.on"><Setter Property="Foreground" Value="{DynamicResource BrushAccent}" /></Style>
    <Style Selector="Button.statepower.on /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentEdge}" />
    </Style>
    <Style Selector="Button.statepower.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.statepower:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <!-- Hover or keyboard focus on a running method's button turns the spinner into a stop square (a click stops that method). -->
    <Style Selector="Button.statepower > Panel > Panel > Path.markstop">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Fill" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="{DynamicResource StatePowerStop}" />
        <Setter Property="Height" Value="{DynamicResource StatePowerStop}" />
    </Style>
    <Style Selector="Button.statepower:pointerover > Panel > Panel > Path.markstop, Button.statepower:focus-visible > Panel > Panel > Path.markstop"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="Button.statepower:pointerover > Panel > Panel > Ellipse.markring, Button.statepower:focus-visible > Panel > Panel > Ellipse.markring, Button.statepower:pointerover > Panel > Panel > Path.markarc, Button.statepower:focus-visible > Panel > Panel > Path.markarc">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.statepower > Panel"><Setter Property="IsHitTestVisible" Value="False" /></Style>
    <Style Selector="Button.statepower > Panel > c|IconGlyph">
        <Setter Property="Width" Value="{DynamicResource StatePowerGlyph}" />
        <Setter Property="Height" Value="{DynamicResource StatePowerGlyph}" />
    </Style>

    <Style Selector="Button.tile:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.tile.on:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushOnAccent}" />
    </Style>
    <!-- On a lit tile the corner mark is drawn in the glyph's colour, so it shows on the accent fill (a failure stays red) -->
    <Style Selector="Panel.tilemark.on > Ellipse.markring, Panel.tilemark.on > Path.markarc"><Setter Property="Stroke" Value="{DynamicResource BrushOnAccent}" /></Style>
    <Style Selector="Panel.tilemark.on > Ellipse.markdot"><Setter Property="Fill" Value="{DynamicResource BrushOnAccent}" /></Style>
    <Style Selector="Panel.tilemark.on > c|IconGlyph.marknotsure"><Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" /></Style>

    <!-- Button.trayfootbutton: a plain button of the flyout's foot (+ Tile, + Slider, Edit, Open OmniControl): a glyph and optional words, no
         edge, a hover square. .on = its mode is on (Edit while editing: accent glyph and wash); .quiet = a quiet link (accent words, no wash
         until hovered). -->
    <Style Selector="Button.trayfootbutton">
        <Setter Property="Padding" Value="{DynamicResource TrayFootButtonPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource TrayFootButtonRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource MenuSmallFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- The edge is always there (transparent) so keyboard focus only colours it -->
    <Style Selector="Button.trayfootbutton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.trayfootbutton.quiet /template/ ContentPresenter#PART_ContentPresenter, Button.trayfootbutton.on /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.trayfootbutton.on /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" /></Style>
    <Style Selector="Button.trayfootbutton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
    </Style>
    <Style Selector="Button.trayfootbutton.on:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushAccentHover}" /></Style>
    <!-- Accent words keep their contrast: the subtle wash, never the stronger grey -->
    <Style Selector="Button.trayfootbutton.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHoverSubtle}" /></Style>
    <Style Selector="Button.trayfootbutton.quiet:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushPressedSubtle}" /></Style>
    <Style Selector="Button.trayfootbutton:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" /></Style>
    <Style Selector="Button.trayfootbutton > StackPanel"><Setter Property="Orientation" Value="Horizontal" /><Setter Property="Spacing" Value="{DynamicResource TrayFootGap}" /></Style>
    <Style Selector="Button.trayfootbutton c|IconGlyph">
        <Setter Property="Width" Value="{DynamicResource TrayGlyphSize}" />
        <Setter Property="Height" Value="{DynamicResource TrayGlyphSize}" />
    </Style>
    <Style Selector="Button.trayfootbutton > StackPanel > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Shared pill variants (any Button.pill): .icon = a square-ish pill holding only a drawn glyph; .accentline = accent words and edge.
         A glyph in either takes the button's own text colour (so it hovers and focuses with it). -->
    <Style Selector="Button.pill.icon"><Setter Property="Padding" Value="0" /><Setter Property="Width" Value="{DynamicResource PillIconWidth}" /></Style>
    <Style Selector="Button.pill.icon > c|IconGlyph, Button.pill.icon > Panel > c|IconGlyph, Button.pill.accentline > StackPanel > c|IconGlyph">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="Button.pill.accentline /template/ ContentPresenter#PART_ContentPresenter, Button.pill.accentline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
    </Style>
    <!-- Accent words keep their contrast on hover and press: the subtle wash (a .custom pill keeps its accent wash) -->
    <Style Selector="Button.pill.accentline:not(.custom):pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHoverSubtle}" /></Style>
    <Style Selector="Button.pill.accentline:not(.custom):pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushPressedSubtle}" /></Style>

    <!-- A slider row of the flyout: shared columns for the icon, the name or chip, the slider and the value, so every slider starts and ends
         at the same x whatever the names. The name and the chip are one fixed width (TrayNameWidth) and trim with an ellipsis (the chip
         fills it, its chevron at the right); the value is a fixed column, right aligned in tabular figures (TextBlock.slidervalue). -->
    <Style Selector="Grid.trayslider">
        <Setter Property="ColumnSpacing" Value="{DynamicResource TrayColumnGap}" />
        <Setter Property="MinHeight" Value="{DynamicResource TraySliderRowHeight}" />    </Style>
    <Style Selector="Grid.trayslider > Control"><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="Grid.trayslider > TextBlock.trayname">
        <Setter Property="Width" Value="{DynamicResource TrayNameWidth}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.trayslider > TextBlock.trayvalue">
        <Setter Property="Width" Value="{DynamicResource TrayValueWidth}" />
    </Style>
    <Style Selector="Grid.trayslider > c|IconGlyph">
        <Setter Property="Width" Value="{DynamicResource TrayGlyphSize}" />
        <Setter Property="Height" Value="{DynamicResource TrayGlyphSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.trayslider > c|ChipMenu"><Setter Property="Width" Value="{DynamicResource TrayNameWidth}" /></Style>
    <Style Selector="Panel.gadgethit"><Setter Property="Background" Value="{DynamicResource BrushHitTest}" /></Style>
    <!-- Grid.gadgetcells = THE gadget's cells (Resources/Gadget/GadgetCells: the taskbar gadget, the settings preview, the layout cards); its gaps are settings -->
    <Style Selector="Grid.gadgetcells">
        <Setter Property="Margin" Value="{DynamicResource GadgetInset}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Its numbers keep one width per digit (tabular), and TextBlock.reserve is the unseen widest words that keep a value's width -->
    <Style Selector="Grid.gadgetcells TextBlock"><Setter Property="FontFeatures" Value="+tnum" /></Style>
    <Style Selector="Grid.gadgetcells TextBlock.reserve">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
</Styles>
