<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
        xmlns:g="using:OmniControl.App.Features.Resources.Gadget">
    <!-- MASTER designs the tray flyout (Tray/TrayFlyoutWindow) shares with other windows: its tile, corner mark and remove badge, the gadget's
         cells. The panel's own pieces are in Features/Tray/TrayFlyoutStyles.axaml, styled only in its window. Sizes: Tray* in App.axaml. Included last. -->

    <!-- The flyout's window: no frame of its own and see-through, so only the rounded panel inside it shows -->
    <!-- Window.taskbargadget = the Resources taskbar gadget (Features/Resources/Gadget/GadgetWindow): borderless and see-through like the tray
         flyout; its Panel.gadgethit is all but invisible so a click between the numbers still reaches it, g|GadgetCells holds the lines -->
    <Style Selector="Window.trayflyout, Window.taskbargadget">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TransparencyLevelHint" Value="Transparent" />
        <Setter Property="SystemDecorations" Value="None" />
        <Setter Property="Topmost" Value="True" />
        <Setter Property="CanResize" Value="False" />
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
    </Style>

    <!-- The remove badge: THE small remove cross of a tile or a row. A round raised chip with a thin edge
         (RemoveBadgeSize) inside a clickable square (RemoveBadgeHit); the drawn cross (RemoveBadgeCross) is muted and turns red on hover. -->
    <Style Selector="Button.removebadge">
        <Setter Property="Width" Value="{StaticResource RemoveBadgeHit}" />
        <Setter Property="Height" Value="{StaticResource RemoveBadgeHit}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <Border Name="PART_Badge" Width="{StaticResource RemoveBadgeSize}" Height="{StaticResource RemoveBadgeSize}"
                            CornerRadius="{StaticResource RemoveBadgeRadius}" BorderThickness="1"
                            Background="{DynamicResource BrushControlFill}" BorderBrush="{DynamicResource BrushControlEdge}" />
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.removebadge > Path.glyph">
        <Setter Property="Width" Value="{StaticResource RemoveBadgeCross}" />
        <Setter Property="Height" Value="{StaticResource RemoveBadgeCross}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button.removebadge:pointerover, Button.removebadge:focus-visible"><Setter Property="Foreground" Value="{DynamicResource BrushDanger}" /></Style>
    <Style Selector="Button.removebadge:pointerover /template/ Border#PART_Badge"><Setter Property="BorderBrush" Value="{DynamicResource BrushHoverEdge}" /></Style>
    <Style Selector="Button.removebadge:focus-visible /template/ Border#PART_Badge"><Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" /></Style>


    <!-- A tile: a Windows-style button (TrayTileHeight high, as wide as its cell of the tile grid: TrayTileColumns, even TrayTileGap gaps)
         holding its glyph, with its name UNDER it (StackPanel.traytile > TextBlock.wordtext). The 1 px edge is always there, so lighting, hover and
         focus change colours only. .on = its state is on (filled accent, the glyph in BrushOnAccent) -->
    <Style Selector="Button.tile">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="{StaticResource TrayTileHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="{StaticResource TrayTileCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlEdge}" />
        <Setter Property="Background" Value="{DynamicResource BrushControlFill}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tile > c|IconGlyph">
        <Setter Property="Width" Value="{StaticResource TrayGlyphSize}" />
        <Setter Property="Height" Value="{StaticResource TrayGlyphSize}" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushHoverEdge}" />
    </Style>
    <Style Selector="Button.tile.on /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.tile.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentBright}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentBright}" />
    </Style>
    <Style Selector="Button.tile.on > c|IconGlyph"><Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" /></Style>
    <!-- The tile's corner mark (top-right, TrayMarkSize): holds ONE of a spinning ring (an action runs), a pulsing grey dot (the state is read),
         a clock (only the last known value) or a red warning (the last action or read failed). It never takes the mouse. -->
    <Style Selector="Panel.tilemark">
        <Setter Property="Width" Value="{StaticResource TrayMarkSize}" />
        <Setter Property="Height" Value="{StaticResource TrayMarkSize}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="{StaticResource TrayMarkMargin}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Panel.tilemark > Ellipse.markring, Button.statepower > Panel > Panel > Ellipse.markring">
        <Setter Property="Stroke" Value="{DynamicResource BrushMuted}" />
        <Setter Property="StrokeThickness" Value="{StaticResource TrayMarkStroke}" />
    </Style>
    <Style Selector="Panel.tilemark > Path.markarc, Button.statepower > Panel > Panel > Path.markarc">
        <Setter Property="Stroke" Value="{DynamicResource BrushAccent}" />
        <Setter Property="StrokeThickness" Value="{StaticResource TrayMarkStroke}" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="Width" Value="{StaticResource TrayMarkSize}" />
        <Setter Property="Height" Value="{StaticResource TrayMarkSize}" />
        <Setter Property="Data" Value="M5.5,0.75 A4.75,4.75 0 0 1 10.25,5.5" />
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <!-- The spin and the pulse run only while the mark is shown (.spinning, bound to the same state as its visibility), so a hidden mark never keeps the render clock awake -->
    <Style Selector="Panel.tilemark > Path.markarc.spinning, Button.statepower > Panel > Panel > Path.markarc.spinning">
        <Style.Animations>
            <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Panel.tilemark > c|IconGlyph.markfailed, Button.statepower > Panel > c|IconGlyph.markfailed"><Setter Property="Foreground" Value="{DynamicResource BrushDanger}" /></Style>
    <!-- Button.statepower: the small round power button at the right of a Smart Devices method row. It shows the
         device's state (grey = off, accent edge and wash = on); its Panel holds ONE of the power glyph, the spinner (an inner Panel with the tile
         mark's Ellipse.markring + Path.markarc) while this method runs, or the red warning glyph (.markfailed) when this method failed.
         Sizes: StatePower* in App.axaml. -->
    <Style Selector="Button.statepower">
        <Setter Property="Width" Value="{StaticResource StatePowerSize}" />
        <Setter Property="Height" Value="{StaticResource StatePowerSize}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource StatePowerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
    </Style>
    <Style Selector="Button.statepower /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlEdge}" />
        <Setter Property="CornerRadius" Value="{StaticResource StatePowerRadius}" />
    </Style>
    <Style Selector="Button.statepower:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.statepower.on"><Setter Property="Foreground" Value="{DynamicResource BrushAccent}" /></Style>
    <Style Selector="Button.statepower.on /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentEdge}" />
    </Style>
    <Style Selector="Button.statepower.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.statepower:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <!-- Hover or keyboard focus on a running method's button turns the spinner into a stop square (a click stops that method). -->
    <Style Selector="Button.statepower > Panel > Panel > Path.markstop">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Fill" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="{StaticResource StatePowerStop}" />
        <Setter Property="Height" Value="{StaticResource StatePowerStop}" />
    </Style>
    <Style Selector="Button.statepower:pointerover > Panel > Panel > Path.markstop, Button.statepower:focus-visible > Panel > Panel > Path.markstop"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="Button.statepower:pointerover > Panel > Panel > Ellipse.markring, Button.statepower:focus-visible > Panel > Panel > Ellipse.markring, Button.statepower:pointerover > Panel > Panel > Path.markarc, Button.statepower:focus-visible > Panel > Panel > Path.markarc">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.statepower > Panel"><Setter Property="IsHitTestVisible" Value="False" /></Style>
    <Style Selector="Button.statepower > Panel > c|IconGlyph">
        <Setter Property="Width" Value="{StaticResource StatePowerGlyph}" />
        <Setter Property="Height" Value="{StaticResource StatePowerGlyph}" />
    </Style>

    <Style Selector="Button.tile:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.tile.on:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushOnAccent}" />
    </Style>

    <!-- The glyph of a Button.pill.icon or .accentline (their looks are in the pill's theme, Styles/ButtonThemes.axaml); it takes the button's
         own text colour (so it hovers and focuses with it) -->
    <Style Selector="Button.pill.icon > c|IconGlyph, Button.pill.icon > Panel > c|IconGlyph, Button.pill.accentline > StackPanel > c|IconGlyph">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>

    <Style Selector="Panel.gadgethit"><Setter Property="Background" Value="{StaticResource BrushHitTest}" /></Style>
    <!-- g|GadgetCells = THE gadget's cells (the taskbar gadget, the layout tiles, the label editor's line); its gaps are settings. Selected by its
         type, not a class: a type-only ancestor costs other text nothing, where a class ancestor is watched on every text in every grid. -->
    <Style Selector="g|GadgetCells">
        <Setter Property="Margin" Value="{StaticResource GadgetInset}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Its numbers keep one width per digit (tabular), and TextBlock.reserve is the unseen widest words that keep a value's width -->
    <Style Selector="g|GadgetCells TextBlock"><Setter Property="FontFeatures" Value="+tnum" /></Style>
    <Style Selector="g|GadgetCells TextBlock.reserve">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
</Styles>
