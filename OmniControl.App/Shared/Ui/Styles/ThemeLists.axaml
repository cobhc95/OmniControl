<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:OmniControl.App.Shared.Services"
        xmlns:pages="using:OmniControl.App.Shared.Ui.Pages">
    <!-- Lists, rows and cards of the pages, moved out of Theme.axaml (700-line limit); included straight after it, so the later-wins order is unchanged. -->

    <Styles.Resources>
        <!-- The page lists as control themes: each list kind's ListBox theme gives its rows their ListBoxItem theme (ItemContainerTheme), so
             no global "ListBox.x > ListBoxItem ... /template/ ContentPresenter" style is tried on every item and presenter of the app. The
             styles keep the order they had as global styles (later wins). Child selectors (a selected nav item's icon, a row's pin) stay global. -->
        <!-- Sidebar navigation items; .navheading = a sidebar group heading (NavHeading): its container is neither clickable nor focusable, so
             no hover or focus look applies; disabled = a section with no presets in the preset manager's left pane -->
        <ControlTheme x:Key="NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Style Selector="^:pointerover:not(:selected) /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHover}" /></Style>
            <Style Selector="^:selected:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushAccentHover}" /></Style>
            <Setter Property="Padding" Value="{StaticResource NavPadding}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style Selector="^.navheading">
                <Setter Property="Padding" Value="{StaticResource NavHeadingPadding}" />
                <Setter Property="Margin" Value="0" />
            </Style>
            <Style Selector="^:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
            </Style>
            <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
        </ControlTheme>
        <!-- ListBox.nav.compact = the same list inside a page's pane (the Smart Devices list): tighter rows, no sidebar indent -->
        <ControlTheme x:Key="NavCompactItem" TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
            <Setter Property="Padding" Value="{StaticResource NavCompactPadding}" />
        </ControlTheme>
        <!-- Display rows (keyboard friendly). The card that holds the keyboard, which includes the control whose list is open, is drawn above
             its neighbours, so a pop-down draws above the cards below it; hover for the mouse, the accent border for keyboard focus.
             ListBox.rows.compact takes the same rows: its own sizes always lost to these. -->
        <ControlTheme x:Key="RowItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Style Selector="^:focus-within"><Setter Property="ZIndex" Value="1" /></Style>
            <Style Selector="^:pointerover:not(:focus-within) /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushHoverEdge}" />
            </Style>
            <Style Selector="^:focus-within:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushAccentHover}" /></Style>
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource BrushCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushCardEdge}" />
            <Style Selector="^:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushCardSelected}" /></Style>
            <Style Selector="^:focus-within /template/ ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" /><Setter Property="Background" Value="{DynamicResource BrushCardFocusFill}" /></Style>
        </ControlTheme>
        <!-- FX chain list (TabForge style): flat rows inside a bordered box, the selected effect filled with the accent -->
        <ControlTheme x:Key="FxListItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Style Selector="^:pointerover:not(:selected) /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHover}" /></Style>
            <Style Selector="^:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" /></Style>
            <Style Selector="^:selected:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushAccentHover}" /></Style>
        </ControlTheme>
        <!-- Action picker lists: focus stays in the search box, so the highlight is the selection (.active, the side the keys act on, is a
             global style below: the class changes while the list is shown) -->
        <ControlTheme x:Key="PickItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="12,2" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="CornerRadius" Value="0" />
            <Style Selector="^:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHover}" /></Style>
            <Style Selector="^:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHover}" /></Style>
        </ControlTheme>
        <!-- Compact rows (Controls/OptionList): flat menu rows (MenuRow* in App.axaml), the same as Button.menurow; hover and the
             highlighted entry share one wash (the list moves the highlight to the row under the pointer), no border, so nothing moves -->
        <ControlTheme x:Key="PickCompactItem" TargetType="ListBoxItem" BasedOn="{StaticResource PickItem}">
            <Setter Property="Padding" Value="{StaticResource MenuRowPadding}" />
            <Setter Property="MinHeight" Value="{StaticResource MenuRowHeight}" />
            <Setter Property="CornerRadius" Value="{StaticResource MenuRowCornerRadius}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style Selector="^:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" /></Style>
        </ControlTheme>
        <ControlTheme x:Key="PageList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Style Selector="^.nav, ^.rows, ^.fxlist, ^.pick"><Setter Property="Background" Value="Transparent" /></Style>
            <Style Selector="^.pick"><Setter Property="BorderThickness" Value="0" /><Setter Property="ItemContainerTheme" Value="{StaticResource PickItem}" /></Style>
            <Style Selector="^.pick.compact"><Setter Property="ItemContainerTheme" Value="{StaticResource PickCompactItem}" /></Style>
            <Style Selector="^.nav"><Setter Property="ItemContainerTheme" Value="{StaticResource NavItem}" /></Style>
            <Style Selector="^.nav.compact"><Setter Property="ItemContainerTheme" Value="{StaticResource NavCompactItem}" /></Style>
            <Style Selector="^.rows"><Setter Property="ItemContainerTheme" Value="{StaticResource RowItem}" /></Style>
            <Style Selector="^.fxlist"><Setter Property="ItemContainerTheme" Value="{StaticResource FxListItem}" /></Style>
        </ControlTheme>
    </Styles.Resources>
    <Style Selector="ListBox.nav, ListBox.rows, ListBox.fxlist, ListBox.pick"><Setter Property="Theme" Value="{StaticResource PageList}" /></Style>
    <!-- ListBox.rows.lead: its first row stands for the whole list (Network Traffic Control's "All apps"): a step lighter fill and a stronger
         edge (BrushCardLead, BrushCardLeadEdge from SurfaceService); hover and focus stay the rows' own -->
    <Style Selector="ListBox.rows.lead > ListBoxItem:nth-child(1)">
        <Setter Property="Background" Value="{DynamicResource BrushCardLead}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushCardLeadEdge}" />
    </Style>
    <!-- A nav item's icon: a fixed box (NavIconBox) so names line up, the drawing itself flush left in it, so its left edge sits on the heading's first letter -->
    <Style Selector="Panel.navicon">
        <Setter Property="Width" Value="{StaticResource NavIconBox}" />
        <Setter Property="Height" Value="{StaticResource NavIconBox}" />
    </Style>
    <Style Selector="PathIcon.navicon">
        <Setter Property="Height" Value="{StaticResource NavIconBox}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="TextBlock.navheading">
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LetterSpacing" Value="0.7" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem:selected PathIcon"><Setter Property="Foreground" Value="{DynamicResource BrushAccent}" /></Style>

    <!-- A card that cannot be used right now (a monitor that does not report the control): greyed out; its tooltip says why -->
    <Style Selector="UserControl.card:disabled"><Setter Property="Opacity" Value="0.45" /></Style>

    <!-- A group inside a group (a monitor inside "Hardware"): a panel one step darker than its group on the dark theme (its cards darker again), set in from the left -->
    <Style Selector="Border.subgroupPanel">
        <Setter Property="Background" Value="{DynamicResource BrushSubgroup}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="6,2,6,2" />
        <Setter Property="Margin" Value="14,0,0,4" />
    </Style>
    <!-- The panel's own fill is close to the hover brush, so its header's hover needs the stronger one to show -->
    <Style Selector="Border.subgroupPanel Button.groupHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
    </Style>


    <!-- The preset manager (Pages/Presets): the group card it was opened at is outlined in the accent (Border.groupPanel.target, its theme
         in Theme.axaml); a section with no presets is dimmed in its left pane; a row's drag grip is muted -->
    <Style Selector="PathIcon.grip"><Setter Property="Foreground" Value="{DynamicResource BrushMuted}" /><Setter Property="Width" Value="10" /><Setter Property="Height" Value="14" /></Style>
    <Style Selector="TextBlock.accenttext"><Setter Property="Foreground" Value="{DynamicResource BrushAccent}" /></Style>

    <!-- A mouse button card lights for a moment when the real button is pressed -->
    <Style Selector="Border.flash.lit">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>

    <!-- Button.scope's looks (.mute, .usebtn and its hover and .danger) are a control theme (Styles/ButtonThemes.axaml); a .usebtn without
         .scope is a plain button -->
    <Style Selector="Button.scope.usebtn TextBlock"><Setter Property="VerticalAlignment" Value="Center" /></Style>

    <!-- A lit row button holding a glyph (a microphone's Listen) draws it in the accent -->
    <Style Selector="Button.scope.mute.on > Path.glyph"><Setter Property="Stroke" Value="{DynamicResource BrushAccent}" /></Style>

    <!-- Parametric equaliser band row (Button.bandrow, a tab-like row of the band list): outlined, flat; the selected one is raised with a 3 px accent
         bar at its left edge (an inner Border.bandbar, so the text never moves); a bypassed band is dimmed and struck through (.off) -->
    <!-- Its looks are a control theme (Styles/ButtonThemes.axaml); the bar and .off are child selectors, which a theme cannot hold -->
    <Style Selector="Border.bandbar"><Setter Property="Width" Value="3" /><Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="2" /></Style>
    <Style Selector="Button.bandrow.on Border.bandbar"><Setter Property="Background" Value="{DynamicResource BrushAccent}" /></Style>
    <Style Selector="Button.bandrow.off > Grid"><Setter Property="Opacity" Value="0.45" /></Style>
    <Style Selector="Button.bandrow.off TextBlock"><Setter Property="TextDecorations" Value="Strikethrough" /></Style>

    <Style Selector="ListBox.pick.active > ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>
    <Style Selector="ListBox.pick.active > ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
    </Style>

    <!-- Label of a compact (one-line, half-width) card: wraps to a second line rather than being cut off, and the tight line
         height keeps two lines inside the card's normal height. Use it instead of a plain trimmed label on such cards. -->
    <Style Selector="TextBlock.cardlabel">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="LineHeight" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</Styles>
