<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OmniControl.App.Shared.Ui.Controls">
    <!-- MASTER designs of a window's thin bars (the FX window): Border.toolrow = ONE toolbar row of small controls (about 30 px high,
         ToolFontSize type, ToolControlHeight controls); Border.statusstrip = ONE thin status line at the bottom (StatusFontSize, muted,
         single line, trimmed; TextBlock.statusline, .caution in the caution colour, .failed in red for a command that really failed). Sizes in App.axaml (Tool*, Status*). Included after
         Theme.axaml, Sliders.axaml and Graphs.axaml, so the toolbar sizes win over the controls' own masters (pill, ComboBox.tool)
         while their colours, hover and focus stay theirs (the master slider needs nothing here: it is already SliderHeight high). The selectors name control types only (no TextBlock), so they
         never reach into a pop-down that hangs under a toolbar control. -->
    <Styles.Resources>
        <!-- Button.swatch: one colour of every colour pop-down (notes below) -->
        <ControlTheme x:Key="SwatchButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Style Selector="^.swatch">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource ToolIconRadius}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="{StaticResource SwatchPadding}" />
            </Style>
            <Style Selector="^.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter, ^.swatch:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
            </Style>
            <!-- A dot keyed to by the arrows in a colour pop-down shows the accent wash behind it -->
            <Style Selector="^.swatch:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" /></Style>
        </ControlTheme>
        <!-- TextBlock.statusline: the one thin status line (notes above) -->
        <ControlTheme x:Key="StatusLineText" TargetType="TextBlock">
            <Style Selector="^.statusline">
                <Setter Property="FontSize" Value="{StaticResource StatusFontSize}" />
                <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style Selector="^.statusline.caution"><Setter Property="Foreground" Value="{DynamicResource BrushCaution}" /></Style>
            <Style Selector="^.statusline.failed"><Setter Property="Foreground" Value="{DynamicResource BrushDanger}" /></Style>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector="Border.toolrow">
        <Setter Property="MinHeight" Value="{StaticResource ToolRowHeight}" />
        <Setter Property="Padding" Value="{StaticResource ToolRowPadding}" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource ToolFontSize}" />
    </Style>
    <!-- Fluent's switch is drawn 32 px high around its 20 px knob; the inset lets it take the toolbar's control height with the knob centred
         ToggleSwitch.tool = the same small switch outside a toolbar (a group header's "Show closed"); .plain and .master: ToggleSwitchTheme in Theme.axaml -->
    <Style Selector="Border.toolrow ToggleSwitch, ToggleSwitch.tool">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource ToolFontSize}" />
        <Setter Property="Margin" Value="{StaticResource ToolSwitchInset}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.masterdash">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="2" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.toolrow ComboBox">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource ToolControlHeight}" />
        <Setter Property="Height" Value="{StaticResource ToolControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource ToolComboPadding}" />
        <Setter Property="FontSize" Value="{StaticResource ToolFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.toolrow CheckBox">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="{StaticResource ToolControlHeight}" />
        <Setter Property="FontSize" Value="{StaticResource ToolFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.toolrow Button.pill">
        <Setter Property="MinHeight" Value="{StaticResource ToolControlHeight}" />
        <Setter Property="Height" Value="{StaticResource ToolControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource ToolPillPadding}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The foot of a window: a thin divider above its status line and Close/confirm buttons -->
    <Style Selector="Border.footer">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="{StaticResource FooterPadding}" />
    </Style>
    <Style Selector="Border.statusstrip">
        <Setter Property="Background" Value="{DynamicResource BrushSidebar}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="{StaticResource StatusStripPadding}" />
    </Style>
    <Style Selector="TextBlock.statusline"><Setter Property="Theme" Value="{StaticResource StatusLineText}" /></Style>

    <!-- Button.swatch + c:SwatchDot = one colour of every colour pop-down (the dot is also the screenshot overlay's colour button's). The
         floating bars over a picture (Border.floatbar, Button.toolicon) are in FloatBars.axaml, the screenshot overlay's own pieces in
         Features/Screenshot/ScreenshotStyles.axaml, each included only by the windows that show them. Sizes Swatch* in App.axaml. -->
    <Style Selector="Button.swatch"><Setter Property="Theme" Value="{StaticResource SwatchButton}" /></Style>
    <!-- c:SwatchDot = THE colour dot (SwatchSize; a Button.selector chip's is ChipSwatchSize, RowControls.axaml); TextBlock.swatchletter =
         the A of its "follow the text colour" dot; ItemsControl.swatches = THE grid of colour dots (c:SwatchList gives itself the class: a
         type selector would match its style key, ItemsControl, not SwatchList), each a Button.swatch holding the dot of a SwatchItem
         (a null brush is the follow dot; the chosen one is ringed in the accent; its name is the tooltip) -->
    <Style Selector="c|SwatchDot"><Setter Property="Size" Value="{StaticResource SwatchSize}" /></Style>
    <Style Selector="TextBlock.swatchletter">
        <Setter Property="FontSize" Value="{StaticResource ToolFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ItemsControl.swatches">
        <Setter Property="ItemTemplate">
            <DataTemplate x:DataType="c:SwatchItem">
                <Button Classes="swatch" Command="{Binding Pick}" ToolTip.Tip="{Binding Tip}">
                    <c:SwatchDot Fill="{Binding Brush}" Mark="{Binding Mark}" IsChosen="{Binding IsSelected}" />
                </Button>
            </DataTemplate>
        </Setter>
    </Style>
    <!-- Rectangle.osdframe = the dashed accent edge of the OSD placement preview (Osd/OsdPreview); OsdFrameThickness / OsdFrameRadius in App.axaml -->
    <Style Selector="Rectangle.osdframe">
        <Setter Property="Stroke" Value="{DynamicResource BrushAccent}" />
        <Setter Property="StrokeThickness" Value="{StaticResource OsdFrameThickness}" />
        <Setter Property="StrokeDashArray" Value="3,2" />
        <Setter Property="RadiusX" Value="{StaticResource OsdFrameRadius}" />
        <Setter Property="RadiusY" Value="{StaticResource OsdFrameRadius}" />
    </Style>
    <!-- Search boxes (Pages/SearchClear): the magnifier at the left and the pill naming the key that focuses the box (shown only while it is empty and unfocused) -->
    <Style Selector="Path.glyph.searchicon">
        <Setter Property="Width" Value="{StaticResource SearchIconSize}" />
        <Setter Property="Height" Value="{StaticResource SearchIconSize}" />
        <Setter Property="Margin" Value="9,0,0,0" />
        <Setter Property="Stroke" Value="{DynamicResource BrushMuted}" />
        <Setter Property="StrokeThickness" Value="1.8" />
    </Style>
    <Style Selector="Border.shortcutpill">
        <Setter Property="Background" Value="{DynamicResource BrushControlFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SearchPillRadius}" />
        <Setter Property="Padding" Value="{StaticResource SearchPillPadding}" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.shortcutpill > TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SearchPillFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
    </Style>
</Styles>

