<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shot="using:OmniControl.App.Features.Screenshot"
        xmlns:c="using:OmniControl.App.Shared.Ui.Controls">
    <!-- MASTER designs of a window's thin bars (the FX window): Border.toolrow = ONE toolbar row of small controls (about 30 px high,
         ToolFontSize type, ToolControlHeight controls); Border.statusstrip = ONE thin status line at the bottom (StatusFontSize, muted,
         single line, trimmed; TextBlock.statusline, .caution in the caution colour, .failed in red for a command that really failed). Sizes in App.axaml (Tool*, Status*). Included after
         Theme.axaml, Sliders.axaml and Graphs.axaml, so the toolbar sizes win over the controls' own masters (pill, ComboBox.tool)
         while their colours, hover and focus stay theirs (the master slider needs nothing here: it is already SliderHeight high). The selectors name control types only (no TextBlock), so they
         never reach into a pop-down that hangs under a toolbar control. -->

    <Style Selector="Border.toolrow">
        <Setter Property="MinHeight" Value="{DynamicResource ToolRowHeight}" />
        <Setter Property="Padding" Value="{DynamicResource ToolRowPadding}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource ToolFontSize}" />
    </Style>
    <!-- Fluent's switch is drawn 32 px high around its 20 px knob; the inset lets it take the toolbar's control height with the knob centred.
         ToggleSwitch.tool = the same small switch outside a toolbar (a group header's "Show closed") -->
    <Style Selector="Border.toolrow ToggleSwitch, ToggleSwitch.tool">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource ToolFontSize}" />
        <Setter Property="Margin" Value="{DynamicResource ToolSwitchInset}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- ToggleSwitch.plain = a switch with no On/Off words (a row's own switch, a table's allow switch) -->
    <Style Selector="ToggleSwitch.plain">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="0" />
    </Style>
    <!-- ToggleSwitch.master = a group header's master switch (Pages/GroupMasterSwitch). All on / all off look like any switch; the mixed state
         (IsChecked null) is an accent outline with no knob and Border.masterdash, the accent dash drawn in its middle. -->
    <Style Selector="ToggleSwitch.master:indeterminate /template/ Border#OuterBorder">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ToggleSwitch.master:indeterminate /template/ Grid#PART_SwitchKnob">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.masterdash">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="2" />
        <Setter Property="CornerRadius" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.toolrow ComboBox">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="{DynamicResource ToolControlHeight}" />
        <Setter Property="Height" Value="{DynamicResource ToolControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource ToolComboPadding}" />
        <Setter Property="FontSize" Value="{DynamicResource ToolFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.toolrow CheckBox">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="{DynamicResource ToolControlHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource ToolFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.toolrow Button.selector">
        <Setter Property="MinHeight" Value="{DynamicResource ToolControlHeight}" />
        <Setter Property="Height" Value="{DynamicResource ToolControlHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource ToolFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.toolrow Button.pill">
        <Setter Property="MinHeight" Value="{DynamicResource ToolControlHeight}" />
        <Setter Property="Height" Value="{DynamicResource ToolControlHeight}" />
        <Setter Property="Padding" Value="{DynamicResource ToolPillPadding}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The foot of a window: a thin divider above its status line and Close/confirm buttons -->
    <Style Selector="Border.footer">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="{DynamicResource FooterPadding}" />
    </Style>
    <Style Selector="Button.primary.close">
        <Setter Property="Width" Value="{DynamicResource DialogCloseWidth}" />
        <Setter Property="Height" Value="{DynamicResource DialogButtonHeight}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.statusstrip">
        <Setter Property="Background" Value="{DynamicResource BrushSidebar}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="{DynamicResource StatusStripPadding}" />
    </Style>
    <Style Selector="TextBlock.statusline">
        <Setter Property="FontSize" Value="{DynamicResource StatusFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.statusline.caution"><Setter Property="Foreground" Value="{DynamicResource BrushCaution}" /></Style>
    <Style Selector="TextBlock.statusline.failed"><Setter Property="Foreground" Value="{DynamicResource BrushDanger}" /></Style>

    <!-- MASTER designs of the screenshot overlay (Screenshot/CaptureOverlay): Border.floatbar = a small bar floating over a picture (the
         drawing toolbar, the action bar; .label = the selection's size), Button.toolicon = a square icon button of such a bar (.selected =
         the tool in use: accent wash and accent glyph; hover and press only change the wash, nothing moves), Button.swatch + c:SwatchDot =
         one colour of every colour pop-down (the dot is also the overlay's colour button's), shot|CaptureCanvas = the overlay's dim, frame and
         handles (drawn natively by Core's PictureSurface from these values), TextBox.shottext = the text tool's box, StackPanel.qrcode = one code of the QR pop-down. Sizes Capture*, ToolIcon*, Swatch*
         in App.axaml. -->
    <Style Selector="Border.floatbar">
        <Setter Property="Background" Value="{DynamicResource BrushSidebar}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource FloatBarRadius}" />
        <Setter Property="Padding" Value="{DynamicResource FloatBarPadding}" />
    </Style>
    <Style Selector="Border.floatbar > StackPanel"><Setter Property="Spacing" Value="{DynamicResource FloatBarGap}" /></Style>
    <Style Selector="Border.floatsep"><Setter Property="Background" Value="{DynamicResource BrushDivider}" /></Style>
    <Style Selector="Border.floatsep.across">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="{DynamicResource FloatSepAcross}" />
    </Style>
    <Style Selector="Border.floatsep.along">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="{DynamicResource FloatSepAlong}" />
    </Style>
    <Style Selector="Border.floatbar.label > TextBlock"><Setter Property="FontSize" Value="{DynamicResource ToolFontSize}" /></Style>
    <Style Selector="Button.toolicon, Button.swatch">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource ToolIconRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- mouse first (AGENTS rule 5): the overlay keeps the keyboard, so its shortcuts and the arrow-key nudge always work (its tool buttons,
         and the dots of its colour pop-down, c:SwatchList IsMouseOnly) -->
    <Style Selector="Button.toolicon, ItemsControl.swatches.mouseonly Button.swatch"><Setter Property="Focusable" Value="False" /></Style>
    <Style Selector="Button.toolicon">
        <Setter Property="Width" Value="{DynamicResource ToolIconSize}" />
        <Setter Property="Height" Value="{DynamicResource ToolIconSize}" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.swatch"><Setter Property="Padding" Value="{DynamicResource SwatchPadding}" /></Style>
    <Style Selector="Button.toolicon:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.toolicon:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.swatch:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
    </Style>
    <Style Selector="Button.toolicon.selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" /></Style>
    <Style Selector="Button.toolicon.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.toolicon.selected:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushAccentHover}" /></Style>
    <Style Selector="Button.toolicon:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.toolicon > Path.glyph">
        <Setter Property="Width" Value="{DynamicResource ToolIconGlyph}" />
        <Setter Property="Height" Value="{DynamicResource ToolIconGlyph}" />
    </Style>
    <Style Selector="Button.toolicon.selected > Path.glyph"><Setter Property="Stroke" Value="{DynamicResource BrushAccent}" /></Style>
    <Style Selector="Button.toolicon:disabled > Path.glyph"><Setter Property="Opacity" Value="0.4" /></Style>
    <!-- A dot keyed to by the arrows in a colour pop-down shows the accent wash behind it -->
    <Style Selector="Button.swatch:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" /></Style>
    <!-- c:SwatchDot = THE colour dot (SwatchSize; a Button.selector chip's is ChipSwatchSize, RowControls.axaml); TextBlock.swatchletter =
         the A of its "follow the text colour" dot; ItemsControl.swatches = THE grid of colour dots (c:SwatchList gives itself the class: a
         type selector would match its style key, ItemsControl, not SwatchList), each a Button.swatch holding the dot of a SwatchItem
         (a null brush is the follow dot; the chosen one is ringed in the accent; its name is the tooltip) -->
    <Style Selector="c|SwatchDot"><Setter Property="Size" Value="{DynamicResource SwatchSize}" /></Style>
    <Style Selector="TextBlock.swatchletter">
        <Setter Property="FontSize" Value="{DynamicResource ToolFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ItemsControl.swatches">
        <Setter Property="ItemTemplate">
            <DataTemplate x:DataType="c:SwatchItem">
                <Button Classes="swatch" Command="{Binding Pick}" ToolTip.Tip="{Binding Tip}">
                    <c:SwatchDot Fill="{Binding Brush}" Mark="{Binding Mark}" IsChosen="{Binding IsSelected}" />
                </Button>
            </DataTemplate>
        </Setter>
    </Style>
    <!-- Popup.floating = a pop-up placed at a point of its window by its HorizontalOffset/VerticalOffset (from the window's top-left),
         never slid or flipped by Avalonia, never closed by a click elsewhere and without a window shadow: the overlay's size label, bars
         and text box, which float above its picture (a native window, see shot:CaptureCanvas) and are placed by CaptureOverlay. -->
    <Style Selector="Popup.floating">
        <Setter Property="Placement" Value="AnchorAndGravity" />
        <Setter Property="PlacementAnchor" Value="TopLeft" />
        <Setter Property="PlacementGravity" Value="BottomRight" />
        <Setter Property="PlacementConstraintAdjustment" Value="None" />
        <Setter Property="IsLightDismissEnabled" Value="False" />
        <Setter Property="WindowManagerAddShadowHint" Value="False" />
    </Style>
    <Style Selector="shot|CaptureCanvas">
        <Setter Property="Dim" Value="{DynamicResource BrushCaptureDim}" />
        <Setter Property="Edge" Value="{DynamicResource BrushAccent}" />
        <Setter Property="HandleSize" Value="{DynamicResource CaptureHandleSize}" />
        <Setter Property="HandleReach" Value="{DynamicResource CaptureHandleReach}" />
    </Style>
    <!-- The text tool's box: quiet (see-through, a 1 px accent edge in every state, no thicker focus edge), its words in the drawing's
         colour and size (bound in CaptureOverlay), and selected words on the theme's selection wash in the same colour -->
    <Style Selector="TextBox.shottext">
        <Setter Property="MinWidth" Value="{DynamicResource CaptureTextMinWidth}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="SelectionForegroundBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
        <Setter Property="CaretBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style Selector="TextBox.shottext /template/ Border#PART_BorderElement, TextBox.shottext:pointerover /template/ Border#PART_BorderElement, TextBox.shottext:focus /template/ Border#PART_BorderElement, TextBox.shottext:focus:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Screen recording (docs/mockups/area-video-recording.html): Button.toolicon.danger = a red action of a floating bar (Record, Stop:
         a smaller glyph, drawn and filled in BrushDanger); the recording bar's StackPanel.recclock holds Ellipse.recdot (the red dot) and
         TextBlock.rectimer (the timer, figures of one width so the bar never jiggles); Rectangle.recordframe = the dashed red frame around
         the recorded area (Screenshot/RecordingFrame). Sizes ToolIconDangerGlyph, RecordDotSize, RecordClock*, RecordFrameThickness in App.axaml. -->
    <Style Selector="Button.toolicon.danger > Path.glyph">
        <Setter Property="Width" Value="{DynamicResource ToolIconDangerGlyph}" />
        <Setter Property="Height" Value="{DynamicResource ToolIconDangerGlyph}" />
        <Setter Property="Stroke" Value="{DynamicResource BrushDanger}" />
        <Setter Property="Fill" Value="{DynamicResource BrushDanger}" />
    </Style>
    <!-- .outline = a stroked glyph (the video camera of Record): no fill, larger -->
    <Style Selector="Button.toolicon.danger.outline > Path.glyph">
        <Setter Property="Width" Value="{DynamicResource ToolIconOutlineGlyph}" />
        <Setter Property="Height" Value="{DynamicResource ToolIconOutlineGlyph}" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="StackPanel.recclock">
        <Setter Property="Margin" Value="{DynamicResource RecordClockInset}" />
        <Setter Property="Spacing" Value="{DynamicResource RecordClockGap}" />
    </Style>
    <Style Selector="Ellipse.recdot">
        <Setter Property="Width" Value="{DynamicResource RecordDotSize}" />
        <Setter Property="Height" Value="{DynamicResource RecordDotSize}" />
        <Setter Property="Fill" Value="{DynamicResource BrushDanger}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.rectimer">
        <Setter Property="FontSize" Value="{DynamicResource ToolFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFeatures">
            <FontFeatureCollection>
                <FontFeature Tag="tnum" Value="1" />
            </FontFeatureCollection>
        </Setter>
    </Style>
    <Style Selector="Rectangle.recordframe">
        <Setter Property="Stroke" Value="{DynamicResource BrushDanger}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource RecordFrameThickness}" />
        <Setter Property="StrokeDashArray" Value="3,2" />
    </Style>
    <!-- Rectangle.osdframe = the dashed accent edge of the OSD placement preview (Osd/OsdPreview); OsdFrameThickness / OsdFrameRadius in App.axaml -->
    <Style Selector="Rectangle.osdframe">
        <Setter Property="Stroke" Value="{DynamicResource BrushAccent}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource OsdFrameThickness}" />
        <Setter Property="StrokeDashArray" Value="3,2" />
        <Setter Property="RadiusX" Value="{DynamicResource OsdFrameRadius}" />
        <Setter Property="RadiusY" Value="{DynamicResource OsdFrameRadius}" />
    </Style>
    <Style Selector="StackPanel.qrcode">
        <Setter Property="Spacing" Value="{DynamicResource MenuTagGap}" />
        <Setter Property="Margin" Value="{DynamicResource MenuRowInset}" />
    </Style>
    <!-- Search boxes (Pages/SearchClear): the magnifier at the left and the pill naming the key that focuses the box (shown only while it is empty and unfocused) -->
    <Style Selector="Path.glyph.searchicon">
        <Setter Property="Width" Value="{DynamicResource SearchIconSize}" />
        <Setter Property="Height" Value="{DynamicResource SearchIconSize}" />
        <Setter Property="Margin" Value="9,0,0,0" />
        <Setter Property="Stroke" Value="{DynamicResource BrushMuted}" />
        <Setter Property="StrokeThickness" Value="1.8" />
    </Style>
    <Style Selector="Border.shortcutpill">
        <Setter Property="Background" Value="{DynamicResource BrushControlFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushControlEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource SearchPillRadius}" />
        <Setter Property="Padding" Value="{DynamicResource SearchPillPadding}" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="Border.shortcutpill > TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource SearchPillFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
    </Style>
</Styles>

