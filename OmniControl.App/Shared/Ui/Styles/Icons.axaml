<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Direct XAML resource icons only (used via StaticResource/TryFindResource in views). All 545 library icon drawings live in
         Assets/icons.txt and are parsed on demand with weak caching by Features/Icons/IconResources.cs, avoiding eager startup RAM. -->
    <Styles.Resources>
        <ResourceDictionary>
            <StreamGeometry x:Key="Icon.headphones">M4 13m0 2a2 2 0 0 1 2 -2h1a2 2 0 0 1 2 2v3a2 2 0 0 1 -2 2h-1a2 2 0 0 1 -2 -2z M15 13m0 2a2 2 0 0 1 2 -2h1a2 2 0 0 1 2 2v3a2 2 0 0 1 -2 2h-1a2 2 0 0 1 -2 -2z M4 15v-3a8 8 0 0 1 16 0v3</StreamGeometry>
            <StreamGeometry x:Key="Icon.pinned">M9 4v6l-2 4v2h10v-2l-2 -4v-6 M12 16l0 5 M8 4l8 0</StreamGeometry>
            <StreamGeometry x:Key="Icon.search">M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0 M21 21l-6 -6</StreamGeometry>
            <StreamGeometry x:Key="Icon.star">M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873z</StreamGeometry>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
