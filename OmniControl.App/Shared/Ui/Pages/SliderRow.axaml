<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             x:Class="OmniControl.App.Shared.Ui.Pages.SliderRow"
             x:DataType="pages:SliderItem"
             Classes="card" IsEnabled="{Binding Availability.IsAvailable}"
             ToolTip.Tip="{Binding Availability.Reason}" ToolTip.ShowOnDisabled="True">
    <Grid RowDefinitions="Auto,Auto,Auto">
    <Panel>
        <!-- Slider alone: label, [leading chip], slider, value, [cogwheel] -->
        <Grid Margin="0,1" IsVisible="{Binding IsPlain}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="{StaticResource CardLabelColumnMinWidth}" SharedSizeGroup="EditorLabel" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:IconText Classes="cardname" Icon="{Binding Icon}" Text="{Binding Label}" Margin="0,0,24,0" />
            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <c:LeadFitPanel Spacing="8" LeadMinWidth="{DynamicResource ChipMinWidth}" MainMinWidth="{DynamicResource SliderFieldMinWidth}">
                    <c:ChoiceChip DataContext="{Binding Lead}" IsVisible="{Binding $parent[UserControl].DataContext.HasLead}" />
                    <c:SliderField Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" ResetValue="{Binding ResetValue}"
                                   Decimals="{Binding Decimals}" Text="{Binding ValueText}" />
                </c:LeadFitPanel>
                <Button Grid.Column="1" Classes="pill cog" Tag="scope" IsVisible="{Binding HasCog}" Command="{Binding Cog}" ToolTip.Tip="{Binding CogTip}" VerticalAlignment="Center">
                    <PathIcon Data="{DynamicResource CogIcon}" />
                </Button>
            </Grid>
        </Grid>

        <!-- Slider with a companion switch on the same line: label, slider, value | switch name, switch.
             The switch name shares the room left with the slider and wraps (then trims) when the card is narrow; the switch never shrinks. -->
        <Grid Margin="0,1" IsVisible="{Binding HasCompanionLine}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="{StaticResource CardLabelColumnMinWidth}" SharedSizeGroup="EditorLabel" />
                <ColumnDefinition Width="3*" MinWidth="{StaticResource SliderFieldMinWidth}" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <c:IconText Classes="cardname" Icon="{Binding Icon}" Text="{Binding Label}" Margin="0,0,24,0" />
            <c:SliderField Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" ResetValue="{Binding ResetValue}"
                           Decimals="{Binding Decimals}" Text="{Binding ValueText}" />
            <Grid Grid.Column="2" ColumnDefinitions="Auto,*" HorizontalAlignment="Right">
                <Border Classes="divider" Margin="12,4" />
                <TextBlock Grid.Column="1" Classes="cardlabel" Text="{Binding Companion.Label}" />
            </Grid>
            <ToggleSwitch Grid.Column="3" IsChecked="{Binding Companion.IsOn}" OnContent="On" OffContent="Off" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <!-- Half-width card (Controls/LabelFitPanel): the label (wraps to two lines) beside the shared narrow-card row (chip trims first, then the slider with its value
             shrinks to SliderFieldMinWidth, the value never clips; the optional cogwheel after the value); when even that does not fit, the slider and value wrap under the label inside the same card -->
        <c:LabelFitPanel Margin="0,1" Spacing="8" LabelMinWidth="{DynamicResource CardLabelMinWidth}" MainMinWidth="{DynamicResource SliderFieldMinWidth}" IsVisible="{Binding IsHalfSlider}">
            <c:IconText Compact="True" Icon="{Binding Icon}" Text="{Binding Label}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <c:LeadFitPanel Spacing="8" LeadMinWidth="{DynamicResource ChipMinWidth}" MainMinWidth="{DynamicResource SliderFieldMinWidth}">
                    <c:ChoiceChip DataContext="{Binding Lead}" IsVisible="{Binding $parent[UserControl].DataContext.HasLead}" />
                    <c:SliderField Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" ResetValue="{Binding ResetValue}"
                                   Decimals="{Binding Decimals}" Text="{Binding ValueText}" />
                </c:LeadFitPanel>
                <Button Grid.Column="1" Classes="pill cog" Tag="scope" IsVisible="{Binding HasCog}" Command="{Binding Cog}" ToolTip.Tip="{Binding CogTip}" VerticalAlignment="Center">
                    <PathIcon Data="{DynamicResource CogIcon}" />
                </Button>
            </Grid>
        </c:LabelFitPanel>

        <!-- Knob (SliderItem.AsKnob): the two-line label beside the rest (Controls/LabelFitPanel); the optional chip takes the room between the name and the
             knob (its words trim with ... when they do not fit; the name keeps its whole width first, LabelFirst), the master knob at the right; the value words are under the knob -->
        <c:LabelFitPanel Margin="0,1" Spacing="8" LabelFirst="True" LabelMinWidth="{DynamicResource CardLabelMinWidth}" MainMinWidth="{DynamicResource SliderFieldMinWidth}" IsVisible="{Binding AsKnob}">
            <c:IconText Compact="True" Icon="{Binding Icon}" Text="{Binding Label}" VerticalAlignment="Center" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <c:ChoiceChip DataContext="{Binding Lead}" IsVisible="{Binding $parent[UserControl].DataContext.HasLead}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <c:Knob Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" Text="{Binding ValueText}"
                        pages:SliderReset.Value="{Binding ResetValue}" />
            </Grid>
        </c:LabelFitPanel>
    </Panel>

    <!-- The extras line (SliderItem.Extras): a thin line, then the card's state buttons side by side at equal width (Button.statetoggle, .muted while on) -->
    <StackPanel Grid.Row="1" IsVisible="{Binding HasExtras}">
        <Border Classes="hrule" Margin="0,6" />
        <ItemsControl ItemsSource="{Binding Extras}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pages:StateButtonItem">
                    <Button Classes="statetoggle" Classes.muted="{Binding IsOn}" Command="{Binding ToggleCommand}" ToolTip.Tip="{Binding Tip}">
                        <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Center">
                            <c:IconGlyph LibraryId="{Binding Icon}" />
                            <TextBlock Grid.Column="1" Text="{Binding Words}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
    <TextBlock Grid.Row="2" Classes="muted small" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" />
    </Grid>
</UserControl>
