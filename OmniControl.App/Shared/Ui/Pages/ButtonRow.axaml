<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             x:Class="OmniControl.App.Shared.Ui.Pages.ButtonRow"
             x:DataType="pages:ButtonItem"
             Classes="card" IsEnabled="{Binding Availability.IsAvailable}"
             ToolTip.Tip="{Binding Availability.Reason}" ToolTip.ShowOnDisabled="True">
    <Panel>
    <!-- Label, then what the button does (wraps to a second line, then trims), then the button (and any more after it) -->
    <pages:CardLayout IsVisible="{Binding !Half}">
        <DataTemplate x:DataType="pages:ButtonItem">
            <Grid Margin="0,1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource CardLabelColumnMinWidth}" SharedSizeGroup="EditorLabel" />
                    <ColumnDefinition Width="*" MinWidth="{StaticResource CardLabelMinWidth}" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Classes="cardname" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Classes="cardlabel muted" Text="{Binding Description}" ToolTip.Tip="{Binding Description}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="pill" Tag="scope" Content="{Binding ButtonText}" Command="{Binding Command}" VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding Extra}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pages:CardAction">
                                <Button Classes="pill" Classes.danger="{Binding Danger}" Tag="scope" Content="{Binding Text}" Command="{Binding Command}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </pages:CardLayout>

    <!-- Half-width card: the label (wraps to two lines) and the button; what the button does is the tooltip -->
    <pages:CardLayout IsVisible="{Binding Half}">
        <DataTemplate x:DataType="pages:ButtonItem">
            <Grid Margin="0,1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Classes="cardlabel" Text="{Binding Label}" ToolTip.Tip="{Binding Description}" />
                <Button Grid.Column="1" Classes="pill" Tag="scope" Content="{Binding ButtonText}" Command="{Binding Command}" VerticalAlignment="Center"
                        ToolTip.Tip="{Binding Description}" />
            </Grid>
        </DataTemplate>
    </pages:CardLayout>
    </Panel>
</UserControl>
