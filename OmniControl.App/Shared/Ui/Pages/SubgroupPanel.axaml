<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             x:Class="OmniControl.App.Shared.Ui.Pages.SubgroupPanel"
             x:DataType="pages:ItemGroup">
    <!-- A group inside a group: its own header (chevron, name, count) and cards, collapsed like any other group -->
    <Border Classes="subgroupPanel">
        <StackPanel Spacing="{StaticResource GapSmall}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <pages:GroupHeader ShowsSummary="False" />
                <pages:GroupRestorePill Grid.Column="1" Margin="6,0,8,0" />
                <pages:GroupMasterSwitch Grid.Column="2" Margin="0,0,8,0" />
                <TextBlock Grid.Column="3" Text="{Binding ShownSummary}" Classes="muted" FontSize="{StaticResource SummaryFontSize}" Margin="0,0,8,0" VerticalAlignment="Center" />
            </Grid>
            <!-- Its cards are built when it opens and let go when it closes (Pages/CardLayout) -->
            <pages:CardLayout IsVisible="{Binding IsExpanded}">
                <DataTemplate x:DataType="pages:ItemGroup"><ListBox Classes="rows compact cards" pages:CardFill.Items="{Binding Items}"></ListBox></DataTemplate>
            </pages:CardLayout>
        </StackPanel>
    </Border>
</UserControl>
