<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             x:Class="OmniControl.App.Shared.Ui.Pages.ChoiceChipsRow"
             x:DataType="pages:ChoiceChipsItem"
             Classes="card">
    <!-- A card of choice pills (Pages/ChoiceChipsItem): the name (two lines at most) beside the wrapping pills and the optional chip menu after
         them (a pick among a few, Controls/ChoiceChip), the optional muted note under them. The pills are the card's parts for Left/Right and Enter. -->
    <c:LabelFitPanel Margin="0,1" Spacing="{StaticResource GapLarge}" LabelMinWidth="{StaticResource CardLabelMinWidth}" MainMinWidth="{StaticResource ChipMinWidth}">
        <TextBlock Classes="cardlabel" Text="{Binding Label}" />
        <StackPanel VerticalAlignment="Center">
            <WrapPanel HorizontalAlignment="Right">
                <c:ChoiceChips ChipTag="scope" ItemsSource="{Binding Chips}" />
                <c:ChoiceChip DataContext="{Binding Menu}" IsVisible="{Binding $parent[UserControl].DataContext.HasMenu}" VerticalAlignment="Top" />
            </WrapPanel>
            <TextBlock Classes="muted small" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" HorizontalAlignment="Right" />
        </StackPanel>
    </c:LabelFitPanel>
</UserControl>
