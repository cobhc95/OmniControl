<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             x:Class="OmniControl.App.Shared.Ui.Pages.MenuChoiceRow"
             x:DataType="pages:MenuChoiceItem"
             Classes="card">
    <!-- A choice card whose pop-down is the shared menu: the label and the chip, placed like a drop-down card (centred at the master width
         when full, filling the room when half). The menu's rows are made by the card's view-model; each chip is linked to it by MenuChoiceLink.Item. -->
    <Panel>
        <pages:CardLayout IsVisible="{Binding !Half}">
            <DataTemplate x:DataType="pages:MenuChoiceItem">
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="{StaticResource CardLabelColumnMinWidth}" SharedSizeGroup="EditorLabel" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Classes="cardname" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,24,0" />
                    <c:ChipMenu Classes="choice" ChipTag="scope" ChipAlignment="Stretch" Text="{Binding Text}" ChipToolTip="{Binding Tip}"
                                pages:MenuChoiceLink.Item="{Binding}" />
                </Grid>
            </DataTemplate>
        </pages:CardLayout>

        <pages:CardLayout IsVisible="{Binding Half}">
            <DataTemplate x:DataType="pages:MenuChoiceItem">
                <Grid Margin="0,1" ColumnSpacing="{StaticResource GapLarge}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="{StaticResource CardLabelMinWidth}" />
                        <ColumnDefinition Width="1.6*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Classes="cardlabel" Text="{Binding Label}" />
                    <c:ChipMenu Grid.Column="1" Classes="choice half" ChipTag="scope" ChipAlignment="Stretch" Text="{Binding Text}" ChipToolTip="{Binding Tip}"
                                pages:MenuChoiceLink.Item="{Binding}" />
                </Grid>
            </DataTemplate>
        </pages:CardLayout>
    </Panel>
</UserControl>
