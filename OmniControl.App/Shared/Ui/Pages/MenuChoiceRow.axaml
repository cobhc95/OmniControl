<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             x:Class="OmniControl.App.Shared.Ui.Pages.MenuChoiceRow"
             x:DataType="pages:MenuChoiceItem"
             Classes="card">
    <!-- A choice card whose pop-down is the shared menu (docs/mockups/osd-custom-position.html): the label and the chip, placed like a drop-down
         card (centred at the master width when full, filling the room when half). The menu's rows are made by the card's view-model. -->
    <Panel>
        <Grid Margin="0,1" IsVisible="{Binding !Half}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="{StaticResource CardLabelColumnMinWidth}" SharedSizeGroup="EditorLabel" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Classes="cardname" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,24,0" />
            <c:ChipMenu x:Name="FullChip" Classes="choice" ChipTag="scope" ChipAlignment="Stretch" Text="{Binding Text}" ChipToolTip="{Binding Tip}" />
        </Grid>

        <Grid Margin="0,1" ColumnSpacing="{StaticResource GapLarge}" IsVisible="{Binding Half}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="{StaticResource CardLabelMinWidth}" />
                <ColumnDefinition Width="1.6*" />
            </Grid.ColumnDefinitions>
            <TextBlock Classes="cardlabel" Text="{Binding Label}" />
            <c:ChipMenu x:Name="HalfChip" Grid.Column="1" Classes="choice half" ChipTag="scope" ChipAlignment="Stretch" Text="{Binding Text}" ChipToolTip="{Binding Tip}" />
        </Grid>
    </Panel>
</UserControl>
