<Window Classes="dialog" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OmniControl.App.Shared.Dialogs.MessageWindow"
        Width="460" MinWidth="360" SizeToContent="Height"
        WindowStartupLocation="CenterScreen">
    <!-- A short message about effects setup: two or three plain lines, an optional confirm button (and a second answer beside it), and the technical detail,
         copied with "Copy details" or shown in the box below for a preview. Esc, Close or Cancel = no; the confirm button = yes. -->
    <StackPanel Margin="12" Spacing="10">
        <TextBlock x:Name="Heading" Classes="title" TextWrapping="Wrap" />
        <TextBox x:Name="InputBox" Classes="field" IsVisible="False" KeyDown="OnInputKey" />
        <TextBlock x:Name="Message" TextWrapping="Wrap" />
        <TextBox x:Name="DetailsBox" Classes="field" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="320"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
        <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Name="CopyButton" Classes="pill" Content="Copy details" VerticalAlignment="Center" Click="OnCopyClick" />
                <CheckBox x:Name="DontAsk" Content="Don't ask again" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="OtherButton" Classes="usebtn scope" Tag="scope" Click="OnOtherClick" />
                <Button x:Name="NoButton" Classes="usebtn scope" Tag="scope" IsVisible="False" Click="OnCloseClick" />
                <Button x:Name="ConfirmButton" Classes="usebtn scope" Tag="scope" Click="OnConfirmClick" />
                <Button x:Name="CloseButton" Classes="primary" Content="Close" Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
