<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OmniControl.App.Shared.Presets.Manager"
        xmlns:presets="using:OmniControl.App.Shared.Presets"
        xmlns:hk="using:OmniControl.App.Features.Hotkeys"
        xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
        xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
        x:Class="OmniControl.App.Shared.Presets.Manager.PresetManagerWindow"
        x:DataType="vm:PresetManagerViewModel"
        Title="Presets" Width="900" Height="600" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <!-- The one preset manager (docs/mockups/unified-preset-manager.html). Left: the app's sidebar sections with their icons (a section
         without presets dimmed, "none"). Right: the search, the section's name, one card per preset group (Border.groupPanel; the card
         it was opened at outlined, .target), each preset a row: drag grip, name (renamed in place) with its tags, its trigger chips (the
         shortcut, then states and actions joined by "or" / "and", Button.chipx; the dashed "+ Add" opens Hotkey / State… / Action…; the
         chips wrap inside the row), the Apply pill, where offered a "more" menu (Duplicate, Export), Rename and Delete icon pills. The card's foot: the dashed add button, the
         group's switch, Import. Foot of the window: "Changes apply at once.", a message or the Undo of a delete, Close. Mouse first
         (AGENTS.md rule 5): Tab reaches everything, Esc closes. -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="footer">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                <TextBlock Classes="statusline" Text="{x:Static vm:PresetManagerViewModel.ApplyNote}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="statusline caution" Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="statusline" Text="{Binding UndoText}" IsVisible="{Binding HasUndo}" VerticalAlignment="Center" />
                <Button Grid.Column="3" Classes="link small" Content="Undo" Command="{Binding UndoCommand}" IsVisible="{Binding HasUndo}" VerticalAlignment="Center" />
                <Button Grid.Column="4" Classes="primary close" Content="Close" Click="OnCloseClick" />
            </Grid>
        </Border>

        <!-- The sections: the main window's sidebar look (ListBox.nav), as wide as its longest name -->
        <Border DockPanel.Dock="Left" Classes="sidebarpanel" BorderThickness="0,0,1,0">
            <ListBox Classes="nav" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Margin="0,12,0,8">
                <ListBox.Styles>
                    <Style Selector="ListBox.nav > ListBoxItem" x:DataType="vm:PresetSectionItem"><Setter Property="IsEnabled" Value="{Binding HasPresets}" /></Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PresetSectionItem">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <PathIcon Data="{Binding Icon}" Width="18" Height="18" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" />
                                <TextBlock Classes="hint" Text="{Binding CountText}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Margin="16,12,16,0">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="0,0,0,10">
                <TextBlock Classes="title" Text="{Binding Heading}" VerticalAlignment="Center" />
                <TextBox x:Name="SearchBox" Grid.Column="1" Classes="bar search" Text="{Binding Search}" Watermark="Search presets and shortcuts…"
                         ToolTip.Tip="Search every section's presets by name or shortcut (Ctrl+F; Esc clears)" />
            </Grid>
            <TextBlock DockPanel.Dock="Top" Classes="hint" Text="No preset matches." IsVisible="{Binding NothingFound}" Margin="4,0,0,8" />
            <ScrollViewer>
                <ItemsControl x:Name="CardList" ItemsSource="{Binding Cards}" Grid.IsSharedSizeScope="True" Margin="0,0,0,12">
                    <!-- Cards are built only near the screen; a screen more each way, so Tab always finds the next card built -->
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel CacheLength="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PresetCardViewModel">
                            <Border Classes="groupPanel" Classes.target="{Binding IsTarget}">
                                <StackPanel Spacing="{StaticResource GapSmall}" Margin="4">
                                    <TextBlock Classes="strong" Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="6,2,0,0" />
                                    <pages:EmptyListRow Text="No presets yet." IsVisible="{Binding IsEmpty}" />
                                    <ListBox Classes="rows compact" ItemsSource="{Binding Rows}" IsVisible="{Binding !IsEmpty}" Loaded="OnCardListLoaded">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PresetRowViewModel">
                                                <Grid ColumnSpacing="{StaticResource GapLarge}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="PresetGrip" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="PresetName" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="PresetActions" />
                                                    </Grid.ColumnDefinitions>
                                                    <PathIcon Classes="grip" Data="{StaticResource GripIcon}" VerticalAlignment="Center" IsVisible="{Binding CanMove}"
                                                              ToolTip.Tip="Drag to move (or Alt+Up / Alt+Down)" />
                                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Gap}" VerticalAlignment="Center">
                                                        <Panel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsEditing}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                       ToolTip.Tip="{Binding NameTip}" DoubleTapped="OnNameDoubleTapped" />
                                                            <TextBox Classes="field" Text="{Binding EditText}" IsVisible="{Binding IsEditing}" MaxLength="{Binding NameMaxLength}"
                                                                     KeyDown="OnRenameKey" LostFocus="OnRenameLostFocus" />
                                                        </Panel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource GapSmall}" VerticalAlignment="Center">
                                                            <Border Classes="tag selected" IsVisible="{Binding InUse}" VerticalAlignment="Center"><TextBlock Text="in use" /></Border>
                                                            <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="{StaticResource GapSmall}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <c:TagView VerticalAlignment="Center" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Grid>
                                                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Chips}" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel ItemSpacing="{StaticResource ChipSpacing}" LineSpacing="{StaticResource ChipSpacing}" /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.DataTemplates>
                                                            <DataTemplate DataType="vm:PresetChip">
                                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource ChipSpacing}">
                                                                    <Button Classes="blockjoin" Tag="scope" Margin="0" Content="{Binding Join}" Command="{Binding Flip}" IsVisible="{Binding HasJoin}"
                                                                            ToolTip.Tip="Click to switch between or and and" />
                                                                    <TextBlock Classes="blockword" Margin="0" Text="{Binding Join}" IsVisible="{Binding HasFixedJoin}" />
                                                                    <Button Classes="chipx" Tag="scope" Command="{Binding Remove}" ToolTip.Tip="{Binding Tip}">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Text}" />
                                                                            <Path Classes="glyph" Data="{StaticResource CrossIcon}" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                            <DataTemplate DataType="vm:PresetCaptureChip">
                                                                <hk:HotkeyBox DataContext="{Binding Shortcut}" Loaded="OnCaptureLoaded"
                                                                              ToolTip.Tip="Press the keys that switch to this preset; Esc keeps the old ones" />
                                                            </DataTemplate>
                                                            <DataTemplate DataType="vm:PresetAddChip">
                                                                <!-- The pop-down hangs on a Panel, not on the button, so the button's styles do not reach into it -->
                                                                <Panel>
                                                                    <FlyoutBase.AttachedFlyout>
                                                                        <c:ListMenuFlyout Placement="BottomEdgeAlignedLeft">
                                                                            <c:MenuRowList ItemsSource="{Binding Rows}" Picked="OnMenuRowPicked" />
                                                                        </c:ListMenuFlyout>
                                                                    </FlyoutBase.AttachedFlyout>
                                                                    <Button Classes="blockadd small" Tag="scope" Content="+ Add" Click="OnMenuButtonClick"
                                                                            ToolTip.Tip="Switch to this preset by a hotkey, while a state holds, or when an action runs" />
                                                                </Panel>
                                                            </DataTemplate>
                                                        </ItemsControl.DataTemplates>
                                                    </ItemsControl>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="{StaticResource GapSmall}" VerticalAlignment="Center">
                                                        <Button Classes="pill" Tag="scope" Content="{Binding ApplyText}" Command="{Binding ApplyCommand}" IsVisible="{Binding CanApply}" />
                                                        <!-- The "more" menu hangs on a Panel, not on the pill, so the pill's styles do not reach into it -->
                                                        <Panel IsVisible="{Binding HasMore}">
                                                            <FlyoutBase.AttachedFlyout>
                                                                <c:ListMenuFlyout Placement="BottomEdgeAlignedRight">
                                                                    <c:MenuRowList ItemsSource="{Binding MoreRows}" Picked="OnMenuRowPicked" />
                                                                </c:ListMenuFlyout>
                                                            </FlyoutBase.AttachedFlyout>
                                                            <Button Classes="pill glyph" Tag="scope" Content="…" Click="OnMenuButtonClick" ToolTip.Tip="Duplicate, export" />
                                                        </Panel>
                                                        <Button Classes="pill icon" Tag="scope" Command="{Binding BeginRenameCommand}" IsVisible="{Binding CanRename}" ToolTip.Tip="Rename">
                                                            <c:IconGlyph LibraryId="pencil" />
                                                        </Button>
                                                        <Button Classes="pill icon" Tag="scope" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" ToolTip.Tip="{Binding DeleteText}">
                                                            <c:IconGlyph LibraryId="trash" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapLarge}" Margin="6,2,0,4">
                                        <Button Classes="blockadd small" Content="{Binding AddText}" Command="{Binding AddCommand}" IsEnabled="{Binding CanAdd}"
                                                IsVisible="{Binding !IsFiltering}" ToolTip.Tip="{Binding AddTip}" ToolTip.ShowOnDisabled="True" />
                                        <Button Classes="pill" Tag="scope" Content="Import…" Command="{Binding ImportCommand}" IsVisible="{Binding CanImport}"
                                                ToolTip.Tip="Add presets from files" />
                                        <ToggleSwitch IsChecked="{Binding SwitchOn}" OnContent="{Binding SwitchLabel}" OffContent="{Binding SwitchLabel}"
                                                      IsVisible="{Binding HasSwitch}" ToolTip.Tip="{Binding SwitchTip}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</Window>
