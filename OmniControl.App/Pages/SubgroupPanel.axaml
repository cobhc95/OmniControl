<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Pages"
             x:Class="OmniControl.App.Pages.SubgroupPanel"
             x:DataType="pages:ItemGroup">
    <!-- A group inside a group: its own header (chevron, name, count) and cards, collapsed like any other group -->
    <Border Classes="subgroupPanel">
        <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <pages:GroupHeader ShowsSummary="False" />
                <pages:GroupRestorePill Grid.Column="1" Margin="6,0,8,0" />
                <pages:GroupMasterSwitch Grid.Column="2" Margin="0,0,8,0" />
                <TextBlock Grid.Column="3" Text="{Binding ShownSummary}" Classes="muted" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
            </Grid>
            <ListBox Classes="rows compact cards" ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}"></ListBox>
        </StackPanel>
    </Border>
</UserControl>
