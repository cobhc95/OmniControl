<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Pages"
             x:Class="OmniControl.App.Pages.GalleryRow"
             x:DataType="pages:GalleryItem">
    <Grid x:Name="Layout" Margin="0,1" IsEnabled="{Binding Availability.IsAvailable}" ToolTip.Tip="{Binding Hint}" ToolTip.ShowOnDisabled="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="EditorLabel" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="LabelText" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,24,0" />
        <Border Classes="gallery" Classes.half="{Binding Half}" Tag="gallery" Focusable="True" pages:ValueWheel.Selector="True" PointerPressed="OnPressed" PointerWheelChanged="OnWheel">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Classes="step" Focusable="False" Click="OnPrevious">
                    <PathIcon Data="{StaticResource ChevronLeftIcon}" Width="10" Height="10" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ContentControl Content="{Binding Preview}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" Classes="muted small" HorizontalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="2" Classes="step" Focusable="False" Click="OnNext">
                    <PathIcon Data="{StaticResource ChevronRightIcon}" Width="10" Height="10" />
                </Button>
            </Grid>
        </Border>
        <ContentControl Grid.Column="2" Content="{Binding Extra}" Margin="12,0,0,0" VerticalAlignment="Center" />
    </Grid>
</UserControl>
