<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Pages.Displays"
             xmlns:pages="using:OmniControl.App.Pages"
             x:Class="OmniControl.App.Pages.Displays.DisplaysPage"
             x:DataType="vm:DisplaysPageViewModel">
    <StackPanel Spacing="6">
        <StackPanel x:Name="CardsHost" Grid.IsSharedSizeScope="True">
            <!-- Hardware: what each monitor itself can do. The count follows the title; Refresh sits at the right end of the same line (a header tool, like the Mouse layer picker). -->
            <Border Classes="groupPanel">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <pages:GroupHeader x:DataType="pages:ParentGroup" DataContext="{Binding Hardware}" />
                        <Button Grid.Column="1" Classes="pill" Tag="grouptool" Content="Refresh" VerticalAlignment="Center" Margin="6,0,8,0"
                                Click="OnRefresh" ToolTip.Tip="Look at the monitors again and ask each what it supports (F5)" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Hardware.Subgroups}" IsVisible="{Binding Hardware.IsExpanded}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pages:ItemGroup"><pages:SubgroupPanel /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Software: what OmniControl does to the picture itself, on any display -->
            <Border Classes="groupPanel">
                <StackPanel Spacing="6">
                    <pages:GroupHeader x:DataType="pages:ParentGroup" DataContext="{Binding Software}" />
                    <StackPanel Spacing="4" IsVisible="{Binding Software.IsExpanded}">
                        <ListBox Classes="rows compact" ItemsSource="{Binding Software.Items}">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><pages:HalfPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        </ListBox>
                        <ItemsControl ItemsSource="{Binding Software.Subgroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pages:ItemGroup"><pages:SubgroupPanel /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
