<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Pages"
             x:Class="OmniControl.App.Pages.ButtonRow"
             x:DataType="pages:ButtonItem"
             Classes="card" IsEnabled="{Binding Availability.IsAvailable}"
             ToolTip.Tip="{Binding Availability.Reason}" ToolTip.ShowOnDisabled="True">
    <Panel>
    <!-- Label, then what the button does (wraps to a second line, then trims), then the button -->
    <Grid Margin="0,1" ColumnSpacing="12" IsVisible="{Binding !Half}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="EditorLabel" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <TextBlock Grid.Column="1" Classes="cardlabel muted" Text="{Binding Description}" ToolTip.Tip="{Binding Description}" />
        <Button Grid.Column="2" Classes="pill" Tag="scope" Content="{Binding ButtonText}" Command="{Binding Command}" VerticalAlignment="Center" />
    </Grid>

    <!-- Half-width card: the label (wraps to two lines) and the button; what the button does is the tooltip -->
    <Grid Margin="0,1" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding Half}">
        <TextBlock Classes="cardlabel" Text="{Binding Label}" ToolTip.Tip="{Binding Description}" />
        <Button Grid.Column="1" Classes="pill" Tag="scope" Content="{Binding ButtonText}" Command="{Binding Command}" VerticalAlignment="Center"
                ToolTip.Tip="{Binding Description}" />
    </Grid>
    </Panel>
</UserControl>
