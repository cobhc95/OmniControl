<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Pages"
             xmlns:c="using:OmniControl.App.Controls"
             x:Class="OmniControl.App.Pages.SliderRow"
             x:DataType="pages:SliderItem"
             Classes="card" IsEnabled="{Binding Availability.IsAvailable}"
             ToolTip.Tip="{Binding Availability.Reason}" ToolTip.ShowOnDisabled="True">
    <Panel>
        <!-- Slider alone: label, [leading chip], slider, value -->
        <Grid Margin="0,1" IsVisible="{Binding IsPlain}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="EditorLabel" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:IconText Icon="{Binding Icon}" Text="{Binding Label}" Margin="0,0,24,0" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <c:ChoiceChip DataContext="{Binding Lead}" IsVisible="{Binding $parent[UserControl].DataContext.HasLead}" />
                <c:SliderField Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" ResetValue="{Binding ResetValue}"
                               Thick="{Binding Thick}" Text="{Binding ValueText}" ValueMinWidth="48" />
            </Grid>
        </Grid>

        <!-- Slider with a companion switch on the same line: label, slider, value | switch name, switch.
             The switch name shares the room left with the slider and wraps (then trims) when the card is narrow; the switch never shrinks. -->
        <Grid Margin="0,1" IsVisible="{Binding HasCompanionLine}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="EditorLabel" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <c:IconText Icon="{Binding Icon}" Text="{Binding Label}" Margin="0,0,24,0" />
            <c:SliderField Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" ResetValue="{Binding ResetValue}"
                           Thick="{Binding Thick}" Text="{Binding ValueText}" ValueMinWidth="48" />
            <Grid Grid.Column="2" ColumnDefinitions="Auto,*" HorizontalAlignment="Right">
                <Border Classes="divider" Margin="12,4" />
                <TextBlock Grid.Column="1" Classes="cardlabel" Text="{Binding Companion.Label}" />
            </Grid>
            <ToggleSwitch Grid.Column="3" IsChecked="{Binding Companion.IsOn}" OnContent="On" OffContent="Off" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <!-- Half-width card: the label (wraps to two lines at the card's height) takes a share, the slider the larger share (never below its least width), the value sits at the right -->
        <Grid Margin="0,1" ColumnSpacing="8" IsVisible="{Binding Half}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="56" />
                <ColumnDefinition Width="1.6*" MinWidth="64" />
            </Grid.ColumnDefinitions>
            <c:IconText Compact="True" Icon="{Binding Icon}" Text="{Binding Label}" />
            <c:SliderField Grid.Column="1" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}" ResetValue="{Binding ResetValue}"
                           Thick="{Binding Thick}" Text="{Binding ValueText}" ValueMinWidth="32" />
        </Grid>
    </Panel>
</UserControl>
