<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmniControl.App.Pages.EmptyListRow">
    <!-- The one empty-list row (master look: Rectangle.emptydash in Styles/Blocks.axaml): one sentence and a link that does what the group's header pill does -->
    <Panel>
        <Rectangle Classes="emptydash" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="10,8">
            <TextBlock Classes="cardlabel" Foreground="{DynamicResource BrushMuted}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Button Classes="link small" VerticalAlignment="Center" Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    IsVisible="{Binding LinkText, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding LinkText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </Button>
        </StackPanel>
    </Panel>
</UserControl>
