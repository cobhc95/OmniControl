<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mouse="using:OmniControl.App.Pages.Mouse"
             x:Class="OmniControl.App.Pages.Mouse.MouseButtonRow"
             x:DataType="mouse:MouseButtonItem"
             Classes="card" IsEnabled="{Binding Availability.IsAvailable}"
             ToolTip.Tip="{Binding Availability.Reason}" ToolTip.ShowOnDisabled="True">
    <!-- Half-width card, one line: the input's name, and at the right a pill showing its action (quiet "Default", or accent when remapped)
         with a cogwheel when the action has settings. The pill opens the action window; the cogwheel opens it on the settings page.
         The shortcut or program box appears underneath only when the chosen action needs one; a trackpad gesture with an action that
         Windows also runs shows one plain tag underneath. Greyed out with the reason when the input can't be seen (no precision touchpad). -->
    <Border Classes="flash" Classes.lit="{Binding IsFlashing}" CornerRadius="8" BorderThickness="1" Padding="0">
    <Grid RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,1">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
            <TextBlock Classes="cardlabel" Text="{Binding Label}" FontSize="11.5" LineHeight="12" Margin="0,0,4,0" />
            <Button x:Name="Picker" Grid.Column="1" Classes="pill" Classes.custom="{Binding IsCustom}" Tag="scope" Click="OnPickerClick">
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" />
            </Button>
            <Button x:Name="Cog" Grid.Column="2" Classes="pill cog" Tag="scope" IsVisible="{Binding HasOptions}" Click="OnCogClick"
                    ToolTip.Tip="Settings for this action">
                <PathIcon Data="{DynamicResource CogIcon}" Width="12" Height="12" />
            </Button>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="4">
            <TextBox x:Name="ParameterBox" Classes="field" Text="{Binding Parameter, UpdateSourceTrigger=LostFocus}"
                     Watermark="{Binding Hint}" IsVisible="{Binding NeedsParameter}" />
            <Border Classes="tag" HorizontalAlignment="Left" IsVisible="{Binding ShowsWindowsAlso}"
                    ToolTip.Tip="{x:Static mouse:MouseButtonItem.WindowsAlsoDetail}">
                <TextBlock Text="{x:Static mouse:MouseButtonItem.WindowsAlsoText}" />
            </Border>
        </StackPanel>
    </Grid>
    </Border>
</UserControl>
