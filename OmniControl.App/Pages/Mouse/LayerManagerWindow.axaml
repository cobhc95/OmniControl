<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mouse="using:OmniControl.App.Pages.Mouse"
        x:Class="OmniControl.App.Pages.Mouse.LayerManagerWindow"
        x:DataType="mouse:LayerManagerModel"
        Title="{Binding Title}" Width="520" Height="560" MinWidth="420" MinHeight="320"
        Background="{DynamicResource BrushBackground}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <!-- Footer: the switch that trims the layer list, and Done -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BrushDivider}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <ToggleSwitch IsChecked="{Binding OnlyUsed}" OnContent="Only named or used layers"
                              OffContent="Only named or used layers" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Done" Classes="primary" Width="84" HorizontalContentAlignment="Center" Click="OnDoneClick" />
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="16,12" Spacing="6">
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Name a layer, switch to it, or clear its mappings. The layer in force is marked." />
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="mouse:LayerRow">
                            <Border Classes="layerrow" Classes.active="{Binding IsActive}" Margin="0,0,0,4">
                                <Grid ColumnDefinitions="16,*,Auto,Auto,Auto" ColumnSpacing="8">
                                    <Ellipse Classes="layerdot" Classes.active="{Binding IsActive}" Width="8" Height="8" VerticalAlignment="Center" />
                                    <TextBox Classes="field" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Watermark="{Binding DefaultName}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Mappings}" Classes="muted" VerticalAlignment="Center" MinWidth="56" />
                                    <Button Grid.Column="3" Classes="pill" Command="{Binding SwitchToCommand}" Content="Switch to" Tag="scope"
                                            IsVisible="{Binding !IsActive}" />
                                    <TextBlock Grid.Column="3" Text="Active" Classes="accenttext" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               IsVisible="{Binding IsActive}" />
                                    <Button Grid.Column="4" Classes="pill" Command="{Binding ClearCommand}" Content="Clear" Tag="scope"
                                            IsEnabled="{Binding CanClear}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
