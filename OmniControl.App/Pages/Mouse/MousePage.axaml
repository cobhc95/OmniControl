<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Pages.Mouse"
             xmlns:pages="using:OmniControl.App.Pages"
             xmlns:c="using:OmniControl.App.Controls"
             x:Class="OmniControl.App.Pages.Mouse.MousePage"
             x:DataType="vm:MousePageViewModel">
    <StackPanel Spacing="6">
        <StackPanel x:Name="CardsHost" Grid.IsSharedSizeScope="True">
            <!-- Mouse Buttons group: the Apps chip and the mouse layer picker sit on the title line, hidden with the rest while the group is collapsed -->
            <pages:GroupCard Group="{Binding ButtonsGroup}">
                <pages:GroupCard.Tools>
                    <c:AppScopeChip DataContext="{Binding ButtonsScope}" />
                    <c:PresetPicker DataContext="{Binding MouseLayer}" />
                </pages:GroupCard.Tools>
                <ListBox Classes="rows compact cards" ItemsSource="{Binding ButtonsGroup.Items}"></ListBox>
            </pages:GroupCard>

            <!-- Trackpad group: the trackpad's own layer picker on the title line (same markup as Mouse Buttons), then
                 Windows' touchpad settings and one card per gesture -->
            <pages:GroupCard Group="{Binding TrackpadGroup}">
                <pages:GroupCard.Tools>
                    <c:PresetPicker DataContext="{Binding TrackpadLayer}" />
                </pages:GroupCard.Tools>
                <ListBox Classes="rows compact cards" ItemsSource="{Binding TrackpadGroup.Items}"></ListBox>
            </pages:GroupCard>

            <!-- Where mouse features work: pause in full-screen games and the apps to never act in (half-width pair), run as administrator, then one muted line -->
            <pages:GroupCard Group="{Binding WhereGroup}">
                <pages:GroupCard.Tools>
                    <pages:GroupRestorePill DataContext="{Binding WhereGroup}" />
                </pages:GroupCard.Tools>
                <StackPanel Spacing="4">
                    <ListBox Classes="rows compact cards" ItemsSource="{Binding WhereGroup.Items}"></ListBox>
                    <TextBlock Classes="muted" Text="{Binding WhereNote}" TextWrapping="Wrap" />
                </StackPanel>
            </pages:GroupCard>

            <!-- Pointer settings: Windows' own mouse settings, changed live; the pointers of the scheme as an inner group; reset and restore last -->
            <pages:GroupCard Group="{Binding PointerGroup}">
                <StackPanel Spacing="4">
                    <ListBox Classes="rows compact cards" ItemsSource="{Binding PointerGroup.Items}"></ListBox>
                    <ItemsControl ItemsSource="{Binding PointerGroup.Subgroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="pages:ItemGroup"><pages:SubgroupPanel /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ListBox Classes="rows compact cards" ItemsSource="{Binding PointerFooter}"></ListBox>
                </StackPanel>
            </pages:GroupCard>

        </StackPanel>
    </StackPanel>
</UserControl>
