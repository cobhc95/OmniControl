<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Pages.Devices"
             x:Class="OmniControl.App.Pages.Devices.MethodList"
             x:DataType="vm:DeviceItem">
    <!-- A device's methods in the Ready view (docs/mockups/device-multiple-methods.html): the muted title, then a boxed list (Border.pane.edged),
         one row per method in the order they are tried: grip (drag to reorder, ListDragReorder), number, "Scripts · Tapo", a "ready" or
         "set-up" tag and the "Edit setup…" link (wrapping together in the middle), and how fast and where it works in small muted words at the
         right. A click on the row (or Enter) opens that method's set-up. Under the box the dashed "+ add method" opens the list of methods. -->
    <StackPanel Spacing="4">
        <TextBlock Classes="hint small" Text="Methods (drag to order; first that works is used)" TextWrapping="Wrap" />
        <Border Classes="pane edged">
            <ListBox x:Name="MethodRows" Classes="rows compact" ItemsSource="{Binding Methods}" KeyDown="OnRowKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MethodItem">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" ToolTip.Tip="{Binding RowTip}">
                            <PathIcon Classes="grip" Data="{DynamicResource GripIcon}" VerticalAlignment="Center" ToolTip.Tip="Drag to change the order" />
                            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding NumberText}" VerticalAlignment="Center" />
                            <WrapPanel Grid.Column="2" ItemSpacing="6" LineSpacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RowTitle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Border Classes="tag good" IsVisible="{Binding IsReady}" VerticalAlignment="Center"><TextBlock Text="ready" /></Border>
                                <Border Classes="tag caution" IsVisible="{Binding !IsReady}" VerticalAlignment="Center"><TextBlock Text="set-up" /></Border>
                                <Button Classes="link small" Command="{Binding EditSetupCommand}" VerticalAlignment="Center" ToolTip.Tip="Opens this method's set-up stages.">
                                    <TextBlock Text="Edit setup…" />
                                </Button>
                            </WrapPanel>
                            <TextBlock Grid.Column="3" Classes="hint small" Text="{Binding RowNote}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Button x:Name="AddButton" Classes="blockadd small" Content="+ add method" HorizontalAlignment="Left" Click="OnAddClick"
                ToolTip.Tip="Adds another way to reach this device; it is tried after the others." />
    </StackPanel>
</UserControl>
