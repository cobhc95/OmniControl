<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Pages.Devices"
             x:Class="OmniControl.App.Pages.Devices.SetupView"
             x:DataType="vm:MethodItem">
    <!-- The set-up's numbered stages (docs/mockups/smart-devices-setup-vs-ready.html part 2), one open at a time (SetupStage).
         Simulation: 1 Emulator and connection, 2 App ready, 3 Steps, 4 Teach on and off, 5 Test.
         Scripts (docs/mockups/script-templates.html): generated from the template: Python, python-kasa, Fixed address, the template's own stages, Sign-in (only if it needs one), Test;
         then the Template row with Advanced… (moved here from the Ready view, which now lists the device's methods: device-multiple-methods.html).
         The data context is the method being set up (MethodItem). -->
    <StackPanel>
        <StackPanel IsVisible="{Binding IsSimulation}">
            <vm:SetupStage Stage="{Binding SimulationStageItems[0]}">
                <vm:SetupStage.Body>
                    <StackPanel Spacing="6">
                        <vm:SimulationFields DataContext="{Binding Simulation}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding NeedsAdb}">
                            <TextBlock Classes="cautiontext" Text="adb (the Android platform-tools) isn't installed." TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="pill" Content="Get adb" Command="{Binding GetAdbCommand}"
                                    ToolTip.Tip="Opens the official Android page for platform-tools. Unpack it and add its folder to the PATH, or put it in your Android SDK folder." />
                        </Grid>
                    </StackPanel>
                </vm:SetupStage.Body>
            </vm:SetupStage>
            <vm:SetupStage Stage="{Binding SimulationStageItems[1]}">
                <vm:SetupStage.Body>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Classes="hint small" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Install the device's app in the emulator (for example Tapo) and sign in there. OmniControl never sees that password." />
                        <Button Grid.Column="1" Classes="pill" Content="Mark done" Command="{Binding MarkAppReadyCommand}" VerticalAlignment="Center" />
                    </Grid>
                </vm:SetupStage.Body>
            </vm:SetupStage>
            <vm:SetupStage Stage="{Binding SimulationStageItems[2]}">
                <vm:SetupStage.Body>
                    <vm:SimulationSteps DataContext="{Binding Simulation}" />
                </vm:SetupStage.Body>
            </vm:SetupStage>
            <vm:SetupStage Stage="{Binding SimulationStageItems[3]}">
                <vm:SetupStage.Body>
                    <StackPanel Spacing="6" DataContext="{Binding Simulation}">
                        <TextBlock Classes="hint small" TextWrapping="Wrap"
                                   Text="Turn the device on in the emulator, then press &quot;It's on now&quot;. Then off, and &quot;It's off now&quot;." />
                        <WrapPanel ItemSpacing="6" LineSpacing="4">
                            <Button Classes="pill" Command="{Binding TeachOnCommand}" ToolTip.ShowOnDisabled="True" ToolTip.Tip="Looks at the device's card a few times while it is on.">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="It's on now" />
                                    <Path Classes="glyph tickmark" Data="{StaticResource TickIcon}" IsVisible="{Binding OnTaught}" />
                                </StackPanel>
                            </Button>
                            <Button Classes="pill" Command="{Binding TeachOffCommand}" ToolTip.ShowOnDisabled="True" ToolTip.Tip="Looks at the device's card a few times while it is off.">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="It's off now" />
                                    <Path Classes="glyph tickmark" Data="{StaticResource TickIcon}" IsVisible="{Binding OffTaught}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Classes="hint small" Classes.cautiontext="{Binding TeachNoteIsProblem}" Text="{Binding TeachNote}" TextWrapping="Wrap" IsVisible="{Binding HasTeachNote}" />
                    </StackPanel>
                </vm:SetupStage.Body>
            </vm:SetupStage>
            <vm:SetupStage Stage="{Binding SimulationStageItems[4]}">
                <vm:SetupStage.Body>
                    <StackPanel Spacing="6">
                        <WrapPanel ItemSpacing="6" LineSpacing="4">
                            <Button Classes="pill" Command="{Binding TestOnCommand}" ToolTip.Tip="Turns it on (only taps when it reads off) and checks it reads on afterwards.">
                                <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="On" /><Path Classes="glyph tickmark" Data="{StaticResource TickIcon}" IsVisible="{Binding OnPassed}" /></StackPanel>
                            </Button>
                            <Button Classes="pill" Command="{Binding TestOffCommand}" ToolTip.Tip="Turns it off (only taps when it reads on) and checks it reads off afterwards.">
                                <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="Off" /><Path Classes="glyph tickmark" Data="{StaticResource TickIcon}" IsVisible="{Binding OffPassed}" /></StackPanel>
                            </Button>
                            <Button Classes="pill" Command="{Binding TestToggleCommand}" ToolTip.Tip="Taps the switch and checks the state changed.">
                                <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="Toggle" /><Path Classes="glyph tickmark" Data="{StaticResource TickIcon}" IsVisible="{Binding TogglePassed}" /></StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Classes="cautiontext" Text="{Binding TestNote}" TextWrapping="Wrap" IsVisible="{Binding HasTestNote}" />
                    </StackPanel>
                </vm:SetupStage.Body>
            </vm:SetupStage>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsScripts}">
            <vm:SetupStage Stage="{Binding PythonStage}">
                <vm:SetupStage.Body>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Classes="hint small" TextWrapping="Wrap" VerticalAlignment="Center" Text="OmniControl runs python-kasa, which needs Python on this PC." />
                        <Button Grid.Column="1" Classes="pill" Content="Get Python" Command="{Binding OpenPythonPageCommand}" IsVisible="{Binding !PythonStage.IsDone}"
                                ToolTip.Tip="Opens the page where Python can be downloaded. Install it, then come back." VerticalAlignment="Center" />
                    </Grid>
                </vm:SetupStage.Body>
            </vm:SetupStage>
            <vm:SetupStage Stage="{Binding KasaStage}">
                <vm:SetupStage.Body>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Classes="hint small" TextWrapping="Wrap" VerticalAlignment="Center" Text="python-kasa is the program that talks to Tapo and Kasa devices." />
                        <Button Grid.Column="1" Classes="pill" Content="{Binding InstallLabel}" Command="{Binding InstallCommand}" IsVisible="{Binding !KasaStage.IsDone}"
                                ToolTip.Tip="Installs python-kasa for you with pip (no administrator needed). The output goes to the devices log." VerticalAlignment="Center" />
                    </Grid>
                </vm:SetupStage.Body>
            </vm:SetupStage>
            <vm:SetupStage Stage="{Binding AddressStage}">
                <vm:SetupStage.Body>
                    <vm:ScriptFields ShowSignIn="False" ShowProfile="False" />
                </vm:SetupStage.Body>
            </vm:SetupStage>
            <ItemsControl ItemsSource="{Binding TemplateStageItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <vm:SetupStage Stage="{Binding}">
                            <vm:SetupStage.Body>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Classes="hint small" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Text}" />
                                    <Button Grid.Column="1" Classes="pill" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" IsVisible="{Binding !IsDone}" VerticalAlignment="Center" />
                                </Grid>
                            </vm:SetupStage.Body>
                        </vm:SetupStage>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <vm:SetupStage Stage="{Binding SignInStage}" IsVisible="{Binding SignInStage, Converter={x:Static ObjectConverters.IsNotNull}}">
                <vm:SetupStage.Body>
                    <vm:ScriptFields ShowAddress="False" ShowProfile="False" />
                </vm:SetupStage.Body>
            </vm:SetupStage>
            <vm:SetupStage Stage="{Binding TestStage}">
                <vm:SetupStage.Body>
                    <StackPanel Spacing="6">
                        <WrapPanel ItemSpacing="6" LineSpacing="4">
                            <Button Classes="pill" Command="{Binding TestScriptCommand}" ToolTip.Tip="Turns the device off, then on again.">
                                <StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="Test" /><Path Classes="glyph tickmark" Data="{StaticResource TickIcon}" IsVisible="{Binding ScriptPassed}" /></StackPanel>
                            </Button>
                            <TextBlock Text="Did it switch?" VerticalAlignment="Center" IsVisible="{Binding AsksIfSwitched}" />
                            <Button Classes="pill" Content="Yes" Command="{Binding SwitchedYesCommand}" IsVisible="{Binding AsksIfSwitched}" />
                            <Button Classes="pill" Content="No" Command="{Binding SwitchedNoCommand}" IsVisible="{Binding AsksIfSwitched}" />
                        </WrapPanel>
                        <TextBlock Classes="cautiontext" Text="{Binding TestNote}" TextWrapping="Wrap" IsVisible="{Binding HasTestNote}" />
                    </StackPanel>
                </vm:SetupStage.Body>
            </vm:SetupStage>
            <vm:ScriptFields ShowAddress="False" ShowSignIn="False" Margin="0,6,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
