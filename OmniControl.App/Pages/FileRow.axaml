<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Pages"
             x:Class="OmniControl.App.Pages.FileRow"
             x:DataType="pages:FileItem"
             Classes="card" IsEnabled="{Binding Availability.IsAvailable}"
             ToolTip.Tip="{Binding Availability.Reason}" ToolTip.ShowOnDisabled="True">
    <Panel>
        <!-- Full width: label, the file in use (trims; full path as tooltip), Choose…, and the optional Default -->
        <Grid Margin="0,1" ColumnSpacing="8" IsVisible="{Binding !Half}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="EditorLabel" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       ToolTip.Tip="{Binding Path}" />
            <Button Grid.Column="2" Classes="pill" Tag="scope" Content="Choose…" VerticalAlignment="Center" Click="OnChooseClick" />
            <Button Grid.Column="3" Classes="pill" Tag="scope" Content="{Binding ResetText}" Command="{Binding ResetCommand}"
                    IsVisible="{Binding HasReset}" VerticalAlignment="Center" />
        </Grid>

        <!-- Half width: the label (wraps to two lines), the file name (trims), then the buttons -->
        <Grid Margin="0,1" ColumnSpacing="6" IsVisible="{Binding Half}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Classes="cardlabel" Text="{Binding Label}" />
            <TextBlock Grid.Column="1" Classes="muted" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       ToolTip.Tip="{Binding Path}" />
            <Button Grid.Column="2" Classes="pill" Tag="scope" Content="Choose…" VerticalAlignment="Center" Click="OnChooseClick" />
            <Button Grid.Column="3" Classes="pill" Tag="scope" Content="{Binding ResetText}" Command="{Binding ResetCommand}"
                    IsVisible="{Binding HasReset}" VerticalAlignment="Center" />
        </Grid>
    </Panel>
</UserControl>
