<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Pages.OtherPcs"
             xmlns:c="using:OmniControl.App.Controls"
             xmlns:svc="using:OmniControl.App.Services"
             x:Class="OmniControl.App.Pages.OtherPcs.TailscaleChecklist">
    <!-- THE Tailscale checklist (docs/mockups/other-pcs-tailscale.html, other-pcs-tailscale-connect.html): one row per check with its mark, words, right-side tag
         and its one fix. Used by the Pair a PC panel and by a paired PC's "Set up Tailscale for this PC" stage; Items are TailscaleCheckItems. -->
    <ItemsControl x:Name="List">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TailscaleCheckItem">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6" MinHeight="24">
                    <Panel Width="{DynamicResource MenuGlyphSize}" VerticalAlignment="Center">
                        <Path Classes="glyph tickmark" Data="{StaticResource TickIcon}" IsVisible="{Binding IsOk}" />
                        <c:IconGlyph Classes="cautionmark" LibraryId="alert" IsVisible="{Binding IsFailed}" />
                        <Ellipse Classes="pendingdot" IsVisible="{Binding IsPending}" />
                    </Panel>
                    <TextBlock Grid.Column="1" Text="{Binding Words}" TextWrapping="Wrap" ToolTip.Tip="{Binding Tip}" VerticalAlignment="Center" />
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Tags}" VerticalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:TagItem"><c:TagView /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Column="3" Classes="link" Command="{Binding FixCommand}" IsVisible="{Binding FixIsLink}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FixText}" />
                    </Button>
                    <Button Grid.Column="3" Classes="pill" Content="{Binding FixText}" Command="{Binding FixCommand}" IsVisible="{Binding FixIsPill}" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
