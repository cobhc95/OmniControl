<Window Classes="dialog" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OmniControl.App.Pages.OtherPcs"
        xmlns:c="using:OmniControl.App.Controls"
        x:Class="OmniControl.App.Pages.OtherPcs.WakeSetupWindow"
        x:DataType="vm:WakeSetupViewModel"
        Title="{Binding Heading}" Width="520" MinWidth="380" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner">
    <!-- Set up wake (docs/mockups/set-up-wake.html): one row per thing a wake needs, each with its mark, words, muted detail and note and a Fix pill
         (accent-outlined when needed, plain when optional); the BIOS row is the person's own job (no button); the dashed Test wake row starts only on a click;
         the foot: Check again, Fix all (one prompt on that PC), Close. Fixes run on the other PC behind its own prompt. While it is off the last report shows, read-only. -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="12" RowSpacing="8">
        <TextBlock Classes="title" Text="{Binding Heading}" />
        <TextBlock Grid.Row="1" Classes="hint" TextWrapping="Wrap" Text="{Binding OfflineNote}" IsVisible="{Binding IsOffline}" />
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WakeRowItem">
                    <Panel ToolTip.Tip="{Binding Tip}" Margin="0,2">
                        <Rectangle Classes="emptydash" IsVisible="{Binding IsTest}" />
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6" MinHeight="24" Margin="6,2">
                            <Panel Width="{DynamicResource MenuGlyphSize}" VerticalAlignment="Top" Margin="0,4,0,0">
                                <Path Classes="glyph tickmark" Data="{StaticResource TickIcon}" IsVisible="{Binding IsDone}" />
                                <c:IconGlyph Classes="cautionmark" LibraryId="circle" IsVisible="{Binding IsNeeded}" />
                                <c:IconGlyph LibraryId="circle" Opacity="0.5" IsVisible="{Binding IsOptional}" />
                                <c:IconGlyph LibraryId="user" IsVisible="{Binding IsYou}" />
                                <c:IconGlyph LibraryId="player-play" IsVisible="{Binding IsTest}" />
                            </Panel>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                <TextBlock Classes="hint small" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" />
                                <TextBlock Classes="cautiontext" Text="{Binding Result}" IsVisible="{Binding HasResult}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Classes="hint small" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" MaxWidth="170" VerticalAlignment="Center" />
                            <Grid Grid.Column="3" VerticalAlignment="Center" MinWidth="64">
                                <Button Classes="pill" Classes.accentline="{Binding ButtonAccent}" Content="{Binding ButtonText}" Command="{Binding Command}" IsVisible="{Binding ButtonVisible}" HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>
                    </Panel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Row="3" Classes="statusline" Text="{Binding Status}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" />
        <Border Grid.Row="4" Classes="footer">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <Button Classes="pill" Content="Check again" Command="{Binding CheckAgainCommand}" IsVisible="{Binding IsOnline}" ToolTip.Tip="Asks that PC to read its network card again." />
                <Button Grid.Column="1" Classes="pill accentline" Content="Fix all" Command="{Binding FixAllCommand}" IsVisible="{Binding IsOnline}" ToolTip.Tip="Turns on every needed row with one prompt on that PC." />
                <Button Grid.Column="3" Classes="primary close" Content="Close" Click="OnCloseClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
