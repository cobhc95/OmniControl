<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Pages.OtherPcs"
             xmlns:c="using:OmniControl.App.Controls"
             xmlns:pages="using:OmniControl.App.Pages"
             xmlns:svc="using:OmniControl.App.Services"
             x:Class="OmniControl.App.Pages.OtherPcs.PcDetail"
             x:DataType="vm:PcItem">
    <!-- One paired PC (docs/mockups/other-pcs.html, basic only; template in App.axaml): the title line (its name, the Connect chip, Unpair), the address
         box when it is reached by address, then, while it is connected, its basic set as groups (Screens, Sound, Now playing, Smart devices, Power)
         with real controls and action pills. While it is offline one sentence says so. -->
    <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Classes="strong" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <c:ChipMenu Grid.Column="1" Text="{Binding ConnectText}" ChipToolTip="How this PC is reached." MenuOpened="OnConnectMenuOpened" VerticalAlignment="Center">
                <c:ChipMenu.Menu>
                    <c:MenuRowList x:Name="ConnectRows" Title="Connect" />
                </c:ChipMenu.Menu>
            </c:ChipMenu>
            <Button Grid.Column="2" Classes="pill danger" Content="Unpair" Command="{Binding UnpairCommand}" ToolTip.Tip="Forget this PC. It keeps its side until it is unpaired there too." VerticalAlignment="Center" />
        </Grid>
        <TextBox Classes="field" Text="{Binding Address}" Watermark="Its address, such as 100.64.0.7" IsVisible="{Binding ShowsAddress}"
                 LostFocus="OnAddressLeft" KeyDown="OnAddressKey" />
        <ItemsControl ItemsSource="{Binding SetupTags}" IsVisible="{Binding NeedsTailscale}" HorizontalAlignment="Left">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="svc:TagItem"><c:TagView /></DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="stage open" IsVisible="{Binding NeedsTailscale}">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Classes="strong" Text="Set up Tailscale for this PC" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="pill" Content="Check again" Command="{Binding CheckAgainCommand}" IsEnabled="{Binding CanCheckAgain}" VerticalAlignment="Center" />
                </Grid>
                <vm:TailscaleChecklist Items="{Binding Checks}" />
                <TextBlock Classes="cautiontext" TextWrapping="Wrap" Text="{Binding SwitchProblem}" IsVisible="{Binding HasSwitchProblem}" />
                <TextBlock Classes="hint small" TextWrapping="Wrap" Text="No new pairing code: this PC is already paired. Once every row is ticked it switches to Tailscale by itself and shows via Tailscale." />
            </StackPanel>
        </Border>
        <TextBlock Classes="hint" Text="{Binding Note}" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />

        <StackPanel Spacing="6" IsVisible="{Binding IsOnline}" DataContext="{Binding Mirror}" x:DataType="vm:PcMirror">
            <TextBlock Classes="hint" Text="This PC shares nothing with you yet." IsVisible="{Binding IsEmpty}" />
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MirrorGroup">
                        <pages:GroupCard Group="{Binding Group}" Margin="0,0,0,6">
                            <StackPanel Spacing="4">
                                <ListBox Classes="rows compact cards" ItemsSource="{Binding Group.Items}" />
                                <c:ChoiceChips ItemsSource="{Binding Actions}" IsVisible="{Binding HasActions}" />
                            </StackPanel>
                        </pages:GroupCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
