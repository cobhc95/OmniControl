<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Pages.OtherPcs"
             xmlns:pages="using:OmniControl.App.Pages"
             xmlns:c="using:OmniControl.App.Controls"
             xmlns:svc="using:OmniControl.App.Services"
             x:Class="OmniControl.App.Pages.OtherPcs.OtherPcsPage"
             x:DataType="vm:OtherPcsPageViewModel">
    <!-- The Other PCs page (docs/mockups/other-pcs.html, basic only): the title line; the paired PCs as browser-style tabs (Controls/BrowserTabStrip,
         docs/mockups/other-pcs-browser-tabs.html: icon, name, status dot, route word) followed by the unfinished "New PC" tabs (docs/mockups/pair-pc-in-tab.html:
         plus icon, name, a small x); the "+" opens a New PC tab. They are joined to one boxed pane (Border.pane.edged.tabbed) with the chosen tab: a PC (PcDetail)
         or the pairing flow of a New PC tab (PairPcPanel), templates in App.axaml. With no tab, one dashed row says so. -->
    <StackPanel Spacing="6">
        <pages:PageTitleLine Title="{Binding Title}" />

        <StackPanel IsVisible="{Binding HasTabs}" Spacing="0">
            <c:BrowserTabStrip x:Name="PcTabs" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                               AddCommand="{Binding NewPcCommand}" AddToolTip="Pair another PC (opens a New PC tab)" Moved="OnTabMoved">
                <c:BrowserTabStrip.TabContent>
                    <DataTemplate>
                        <ContentControl Content="{Binding}">
                            <ContentControl.DataTemplates>
                                <DataTemplate DataType="vm:PcItem">
                                    <Grid Classes="tabcontent" Classes.dim="{Binding !IsOnline}" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6" ToolTip.Tip="{Binding TabTip}">
                                        <c:IconGlyph LibraryId="device-desktop" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="tabname" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Ellipse Grid.Column="2" Classes="tabdot" Classes.online="{Binding IsOnline}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Classes="hint small" Text="{Binding TabRoute}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                                <DataTemplate DataType="vm:SetupTabItem">
                                    <Grid Classes="tabcontent" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" ToolTip.Tip="{Binding TabTip}">
                                        <c:IconGlyph LibraryId="plus" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="tabname" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Classes="removebadge" Focusable="False" Command="{Binding CloseCommand}" ToolTip.Tip="Close this tab" VerticalAlignment="Center">
                                            <Path Classes="glyph" Data="{StaticResource CrossIcon}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>
                    </DataTemplate>
                </c:BrowserTabStrip.TabContent>
            </c:BrowserTabStrip>
            <Border Classes="pane edged tabbed">
                <ContentControl Content="{Binding Selected}" IsVisible="{Binding HasSelected}" Margin="{StaticResource DeviceDetailPadding}" />
            </Border>
        </StackPanel>
        <pages:EmptyListRow IsVisible="{Binding NoTabs}" Text="No PCs paired yet. Pair another PC to see what it shares and run its actions from here." LinkText="Pair a PC" Command="{Binding NewPcCommand}" />

    </StackPanel>
</UserControl>
