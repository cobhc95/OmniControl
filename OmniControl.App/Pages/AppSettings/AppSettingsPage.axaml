<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Pages.AppSettingsPage"
             xmlns:pages="using:OmniControl.App.Pages"
             xmlns:restore="using:OmniControl.App.Pages.Restore"
             x:Class="OmniControl.App.Pages.AppSettingsPage.AppSettingsPage"
             x:DataType="vm:AppSettingsPageViewModel">
    <StackPanel Spacing="6">
        <ListBox x:Name="SettingsList" Grid.IsSharedSizeScope="True" Classes="rows compact cards" ItemsSource="{Binding Items}"></ListBox>
        <restore:RestoreLine DataContext="{Binding RestoreAll}" HorizontalAlignment="Left" />
        <TextBlock Classes="hint" Text="{Binding StartupNote}" IsVisible="{Binding StartupNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
