<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:OmniControl.App.Pages.Gestures"
             x:Class="OmniControl.App.Pages.Gestures.RuleRow"
             x:DataType="g:RuleItem">
    <!-- One rule, one line: the switch (an incomplete rule can be switched on but does nothing; its tags say what is missing), the rule as a sentence (muted while off;
         two lines at most, then "..."), its facts as tags (the full sentence in each tooltip), and the Edit pill that opens the editor. -->
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,1">
        <ToggleSwitch IsChecked="{Binding IsOn}" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="cardlabel" Classes.muted="{Binding !IsOn}" Text="{Binding Line}" />
        <ItemsControl Grid.Column="2" ItemsSource="{Binding Tags}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="g:RuleTag">
                    <Border Classes="tag" Classes.caution="{Binding IsCaution}" Classes.risk="{Binding IsRisk}" ToolTip.Tip="{Binding Detail}">
                        <TextBlock Text="{Binding Text}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="Edit" Grid.Column="3" Classes="pill" Tag="scope" Click="OnEditClick">
            <TextBlock Text="Edit" />
        </Button>
    </Grid>
</UserControl>
