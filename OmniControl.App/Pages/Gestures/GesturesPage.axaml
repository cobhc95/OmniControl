<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Pages.Gestures"
             xmlns:pages="using:OmniControl.App.Pages"
             xmlns:c="using:OmniControl.App.Controls"
             xmlns:restore="using:OmniControl.App.Pages.Restore"
             x:Class="OmniControl.App.Pages.Gestures.GesturesPage"
             x:DataType="vm:GesturesPageViewModel">
    <StackPanel Spacing="6">
        <StackPanel x:Name="CardsHost" Grid.IsSharedSizeScope="True">
            <!-- The title line: the page's name, with the on/off switch as a half-width card beside it -->
            <pages:PageTitleLine Title="{Binding Title}">
                <pages:PageTitleLine.Middle>
                    <ListBox Classes="rows compact" ItemsSource="{Binding Primary}" MinWidth="280" />
                </pages:PageTitleLine.Middle>
                <pages:PageTitleLine.Right>
                    <restore:RestoreBar DataContext="{Binding Restorer}" />
                </pages:PageTitleLine.Right>
            </pages:PageTitleLine>

            <!-- Scroll over a screen area: the Apps chip sits on the title line (hidden with the rest while the group is collapsed) -->
            <pages:GroupCard Group="{Binding Areas}">
                <pages:GroupCard.Tools>
                    <c:AppScopeChip DataContext="{Binding AreasScope}" />
                </pages:GroupCard.Tools>
                <ListBox Classes="rows compact cards" ItemsSource="{Binding Areas.Items}"></ListBox>
            </pages:GroupCard>

            <pages:GroupCard Group="{Binding Middle}">
                <ListBox Classes="rows compact cards" ItemsSource="{Binding Middle.Items}"></ListBox>
            </pages:GroupCard>

            <pages:GroupCard Group="{Binding Keys}">
                <ListBox Classes="rows compact cards" ItemsSource="{Binding Keys.Items}"></ListBox>
            </pages:GroupCard>

            <!-- Custom rules: one line per rule; "Add rule" sits at the right end of the header line (a header tool, like Displays' Refresh) -->
            <pages:GroupCard Group="{Binding Rules}">
                <pages:GroupCard.Tools>
                    <Button Classes="pill" Tag="grouptool" Content="Add rule" Click="OnAddRule"
                            ToolTip.Tip="A new rule: If something happens (where, with which keys), then do one or more things" />
                </pages:GroupCard.Tools>
                <ListBox Classes="rows compact" ItemsSource="{Binding Rules.Rules}" />
            </pages:GroupCard>
        </StackPanel>
    </StackPanel>
</UserControl>
