<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Pages"
             xmlns:c="using:OmniControl.App.Controls"
             x:Class="OmniControl.App.Pages.ToggleRow"
             x:DataType="pages:ToggleItem">
    <Panel ToolTip.Tip="{Binding Tip}">
        <!-- Full-width card: label column shared with the other cards so the switches line up -->
        <Grid Margin="0,1" IsVisible="{Binding !Half}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="EditorLabel" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                <c:IconText Icon="{Binding Icon}" Text="{Binding Label}" />
                <TextBlock Classes="muted" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOn}" OnContent="On" OffContent="Off" />
        </Grid>

        <!-- Half-width card: the label takes what is left (and wraps), the switch sits at the right -->
        <Grid Margin="0,1" ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding Half}">
            <c:IconText Icon="{Binding Icon}" Text="{Binding Label}" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOn}" OnContent="On" OffContent="Off" VerticalAlignment="Center" />
        </Grid>
    </Panel>
</UserControl>
