<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:easy="using:OmniControl.App.Pages.Volume.Easy"
             xmlns:flow="using:OmniControl.App.Pages.Volume.Easy.Flow"
             x:Class="OmniControl.App.Pages.Volume.Easy.EasyWelcomeView"
             x:DataType="easy:EasyViewModel">
    <!-- First launch and "Set up again" (docs/mockups/easy-cards-multiselect.html): the five goal cards, 3 + 2, from the one list of goals
         (EasyGoals.All). Each card is a tick card (the master Button.optioncard, .selected = ticked; the tick box at its top right is Border.tickbox):
         title, a tiny flow picture, one muted fact line; clicking anywhere on it ticks it. Under them the "What you will need" box (worked out
         from the ticks and the PC by EasyNeeds), then "Skip, just show my volume" at the left and Next at the right (off until a goal is ticked). -->
    <StackPanel Spacing="8">
        <WrapPanel>
            <TextBlock Classes="strong" Text="What do you want to do?" Margin="0,0,8,0" />
            <TextBlock Text="Pick as many as you like." Classes="hint" />
        </WrapPanel>
        <ItemsControl ItemsSource="{Binding Goals}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="easy:GoalCard">
                    <Button Tag="grouptool" Classes="optioncard" Classes.selected="{Binding IsSelected}" Command="{Binding ToggleCommand}"
                            VerticalAlignment="Stretch" Margin="0,0,6,6">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="6">
                            <TextBlock Classes="strong" Text="{Binding Goal.Title}" TextWrapping="Wrap" />
                            <Border Grid.Column="1" Classes="tickbox" Classes.checked="{Binding IsSelected}" VerticalAlignment="Top">
                                <Path Classes="tick" Data="{StaticResource TickIcon}" IsVisible="{Binding IsSelected}" />
                            </Border>
                            <easy:EasyPictureView Grid.Row="1" Grid.ColumnSpan="2" DataContext="{Binding Steps}" />
                            <WrapPanel Grid.Row="2" Grid.ColumnSpan="2">
                                <TextBlock Text="{Binding Goal.Fact}" Classes="hint small" Margin="0,0,6,0" />
                                <TextBlock Text="✓ on" Classes="accenttext small" IsVisible="{Binding IsOn}" />
                            </WrapPanel>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="groupPanel">
            <StackPanel Spacing="4">
                <TextBlock Classes="strong" Text="What you will need" />
                <ItemsControl ItemsSource="{Binding Needs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="flow:EasyCheckItem"><flow:EasyCheckLineView /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Grid ColumnDefinitions="*,Auto">
            <Button Tag="grouptool" Classes="link" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding SkipCommand}">
                <TextBlock Text="Skip, just show my volume" />
            </Button>
            <Button Grid.Column="1" Tag="grouptool" Classes="usebtn scope" Content="Next" Command="{Binding StartCommand}" />
        </Grid>
    </StackPanel>
</UserControl>
