<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OmniControl.App.Controls"
             x:Class="OmniControl.App.Pages.Volume.Easy.SoundChip">
    <!-- A row's Sound chip ("Sound: Bass boost", docs/audit-unify.md #27): the shared chip and menu (ChipMenu + PresetMenuView), the sound
         presets as its rows and "Show the sliders" at its foot, which opens or closes the row's drawer of five sliders. Its data context is the EasyRow. -->
    <c:ChipMenu x:Name="Chip" MenuOpened="OnOpened" MenuClosed="OnClosed">
        <c:ChipMenu.Menu>
            <c:PresetMenuView x:Name="Menu" Title="Sound" />
        </c:ChipMenu.Menu>
    </c:ChipMenu>
</UserControl>
