<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OmniControl.App.Controls"
             xmlns:pages="using:OmniControl.App.Pages"
             xmlns:fx="using:OmniControl.App.Fx"
             xmlns:easy="using:OmniControl.App.Pages.Volume.Easy"
             x:Class="OmniControl.App.Pages.Volume.Easy.EasySoundView"
             x:DataType="easy:EasySound">
    <!-- The sound controls of one row: preset chips, the small live response curve (the FX window's own drawing) and five friendly sliders.
         Greyed as a whole while the sound cannot be applied (the drawer above it says why); the five sliders alone are greyed while the effect was shaped in the full effects window (the line says so). Sliders: double-click resets to 0 dB, the value
         can be typed, the wheel and keys work as on every slider. -->
    <StackPanel Spacing="6" IsEnabled="{Binding Availability.IsAvailable}" Grid.IsSharedSizeScope="True">
        <c:ChoiceChips ItemsSource="{Binding Chips}" IsVisible="{Binding $parent[UserControl].ShowsChips}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding IsCustom}">
            <TextBlock Classes="hint small" Text="Shaped in the full effects window" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       ToolTip.Tip="{Binding CustomWhy}" />
            <Button Grid.Column="1" Tag="grouptool" Classes="link small" Command="{Binding BackToSimpleCommand}" VerticalAlignment="Center">
                <TextBlock Text="Back to simple sliders" />
            </Button>
        </Grid>
        <Button Tag="grouptool" Classes="graphthumb" Width="NaN" Height="56" HorizontalAlignment="Stretch" Command="{Binding OpenFullCommand}"
                IsVisible="{Binding IsOpen}" ToolTip.Tip="The sound as it will be heard. Click for the full effects window.">
            <fx:ResponseThumb DataContext="{Binding Curve}" />
        </Button>
        <ItemsControl ItemsSource="{Binding Bands}" IsEnabled="{Binding SlidersAvailability.IsAvailable}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="easy:EasyBandItem">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="EasyBandName" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        <c:SliderField Grid.Column="1" Thick="True" Minimum="{Binding Floor}" Maximum="{Binding Reach}" Value="{Binding Value}" ResetValue="0"
                                       Text="{Binding Text}" ToolTip.Tip="Double-click the number to type a number of dB" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
