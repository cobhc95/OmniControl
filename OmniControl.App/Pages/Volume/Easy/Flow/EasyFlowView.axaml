<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OmniControl.App.Controls"
             xmlns:vm="using:OmniControl.App.Pages.Volume"
             xmlns:easy="using:OmniControl.App.Pages.Volume.Easy"
             xmlns:flow="using:OmniControl.App.Pages.Volume.Easy.Flow"
             x:Class="OmniControl.App.Pages.Volume.Easy.Flow.EasyFlowView"
             x:DataType="flow:EasyFlowViewModel">
    <!-- One goal's guided setup, a small window-like page inside the Easy host: a progress strip (Goal · questions · Setup · Done, ticking as
         it goes), then the screen of the current step. Question screens ask (a ticked list, look chips, a name, or the Sound drawer); the
         Setup screen is a checklist that ticks by itself; "All set" says what was done. Back and Next under every screen but the last. -->
    <UserControl.Resources>
        <!-- One line of a checklist (also used for the extra lines of the All set screen): its mark, words and an optional fix button -->
        <DataTemplate x:Key="CheckLine" x:DataType="flow:EasyCheckItem">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,2">
                <TextBlock Text="{Binding Mark}" Classes.accenttext="{Binding IsDone}" Classes.cautiontext="{Binding IsTodo}" Classes.muted="{Binding IsBlocked}"
                           FontWeight="SemiBold" MinWidth="12" TextAlignment="Center" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Classes.muted="{Binding IsOptional}" />
                    <TextBlock Text="{Binding Subtitle}" Classes="hint small" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Tag="grouptool" Classes="pill" Classes.custom="{Binding IsTodo}" IsVisible="{Binding HasFix}" Content="{Binding FixLabel}"
                        Command="{Binding FixCommand}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Border Classes="groupPanel">
        <StackPanel Spacing="8" Margin="0,4">
            <ItemsControl ItemsSource="{Binding Strip}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="flow:EasyStripItem">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,6,0">
                            <TextBlock Text="✓" Classes="accenttext small" IsVisible="{Binding IsDone}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" Classes="small" Classes.accenttext="{Binding IsCurrent}" Classes.muted="{Binding !IsCurrent}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="·" Classes="muted small" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- A question screen -->
            <StackPanel Spacing="6" IsVisible="{Binding IsQuestion}">
                <StackPanel Spacing="6" DataContext="{Binding Question}" x:DataType="flow:EasyQuestionViewModel">
                    <TextBlock Text="{Binding Prompt}" FontWeight="SemiBold" />
                    <TextBlock Classes="hint" Text="{Binding Hint}" TextWrapping="Wrap" />
                    <Panel IsVisible="{Binding ShowsChoices}"><c:OptionList DataContext="{Binding Choices}" /></Panel>
                    <Panel IsVisible="{Binding ShowsAddProgram}" HorizontalAlignment="Left"><vm:AddProgramButton DataContext="{Binding AddProgram}" /></Panel>
                    <ItemsControl ItemsSource="{Binding Looks}" IsVisible="{Binding ShowsLooks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="easy:EasyChip">
                                <Button Tag="grouptool" Classes="pill" Classes.custom="{Binding IsSelected}" Content="{Binding Name}" Command="{Binding PickCommand}"
                                        Margin="0,0,4,4" HorizontalAlignment="Left" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Classes="field" IsVisible="{Binding ShowsName}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="{Binding NamePlaceholder}" MaxLength="64" />
                    <Panel IsVisible="{Binding ShowsSound}"><easy:EasySoundView DataContext="{Binding Sound}" /></Panel>
                    <TextBlock Classes="hint small" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <!-- The setup checklist -->
            <StackPanel Spacing="6" IsVisible="{Binding IsSetup}">
                <TextBlock Text="Setting it up" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Pictures}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="flow:EasyPictureRow">
                            <easy:EasyPictureView DataContext="{Binding Steps}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource CheckLine}" />
            </StackPanel>

            <!-- All set -->
            <StackPanel Spacing="6" IsVisible="{Binding IsDone}">
                <TextBlock Text="{Binding DoneHeadline}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding DoneLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Extras}" ItemTemplate="{StaticResource CheckLine}" />
            </StackPanel>

            <TextBlock Classes="hint small" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" />

            <WrapPanel IsVisible="{Binding !IsDone}">
                <Button Tag="grouptool" Classes="pill" Content="Back" Command="{Binding BackCommand}" Margin="0,0,6,0" />
                <Button Tag="grouptool" Classes="usebtn scope" Content="Next" Command="{Binding NextCommand}" ToolTip.Tip="{Binding NextTip}" />
            </WrapPanel>
            <WrapPanel IsVisible="{Binding IsDone}">
                <Button Tag="grouptool" Classes="pill" Content="Set up something else" Command="{Binding SetUpSomethingElseCommand}" Margin="0,0,6,0" />
                <Button Tag="grouptool" Classes="usebtn scope" Content="Go to Volume" Command="{Binding GoToVolumeCommand}" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
