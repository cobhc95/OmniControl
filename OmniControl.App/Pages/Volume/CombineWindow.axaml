<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OmniControl.App.Pages.Volume"
        xmlns:c="using:OmniControl.App.Controls"
        x:Class="OmniControl.App.Pages.Volume.CombineWindow"
        x:DataType="vm:CombineDeviceViewModel"
        Title="{Binding Heading}" Icon="avares://OmniControl/Assets/OmniControl.ico" Width="460" MinWidth="360" SizeToContent="Height"
        CanResize="False" Background="{DynamicResource BrushBackground}" WindowStartupLocation="CenterOwner">
    <!-- Name, kind (only for a new device opened for either kind), what the kind does, member devices (with a note while too few are
         ticked), the cable it gets or uses, or why a new device can't be made now (with the Switch that allows it and the step that gets
         what is missing; Create is dimmed then), Cancel / Create or Save. Esc = Cancel. -->
    <StackPanel Margin="12" Spacing="10">
        <TextBlock Classes="title" Text="{Binding Heading}" />
        <TextBox x:Name="NameBox" Classes="field" Watermark="Name (e.g. Living room)" Text="{Binding Name}" />
        <WrapPanel IsVisible="{Binding ShowsKind}">
            <ToggleButton Classes="chip" Content="Speakers" IsChecked="{Binding IsSpeakers, Mode=OneWay}" Command="{Binding ChooseSpeakersCommand}"
                          IsEnabled="{Binding CanChooseSpeakers}" ToolTip.Tip="{Binding SpeakersReason}" ToolTip.ShowOnDisabled="True" />
            <ToggleButton Classes="chip" Content="Microphones" IsChecked="{Binding IsMicrophones, Mode=OneWay}" Command="{Binding ChooseMicrophonesCommand}"
                          IsEnabled="{Binding CanChooseMicrophones}" ToolTip.Tip="{Binding MicrophonesReason}" ToolTip.ShowOnDisabled="True" />
        </WrapPanel>
        <TextBlock Classes="hint" Text="{Binding Hint}" TextWrapping="Wrap" />
        <TextBlock Classes="hint" Text="{Binding TickNote}" IsVisible="{Binding HasTickNote}" />
        <c:OptionList x:Name="MemberList" DataContext="{Binding Members}" />
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding Cable.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="link small" IsVisible="{Binding HasCableSwitch}" Command="{Binding Cable.Switch.SwitchCommand}"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding Cable.Switch.SwitchLabel}" />
            </Button>
            <Button Grid.Column="2" Classes="pill cardaction" Classes.main="{Binding Cable.Setup.Main}" Content="{Binding Cable.Setup.Label}"
                    Command="{Binding Cable.Setup.Command}" ToolTip.Tip="{Binding Cable.Setup.Tip}" IsVisible="{Binding HasCableSetup}" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="usebtn scope" Tag="scope" Content="{Binding ConfirmText}" IsEnabled="{Binding CanCreate}" Click="OnCreateClick" />
            <Button Classes="primary" Content="Cancel" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
