<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Pages.Volume"
             x:Class="OmniControl.App.Pages.Volume.CombinedCardView"
             x:DataType="vm:CombinedCard">
    <!-- One combined device: name = members | cable | the step that gets a cable, Edit, remove. The name and cable columns are the
         Wiring table's (WiringSource, WiringCable), so the cards line up under it. -->
    <Grid ColumnSpacing="{StaticResource WiringColumnGap}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="WiringSource" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="WiringCable" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="WiringCardTools" />
        </Grid.ColumnDefinitions>

        <vm:SourceName DataContext="{Binding Source}" />

        <TextBlock Grid.Column="1" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center">
            <Run Text="= " /><Run Text="{Binding MembersText}" />
        </TextBlock>

        <vm:CableView Grid.Column="2" DataContext="{Binding Cable}" />

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="{StaticResource MenuGap}" VerticalAlignment="Center">
            <Button Tag="scope" Classes="pill" Content="{Binding CableAction.Label}" Command="{Binding CableAction.Command}"
                    ToolTip.Tip="{Binding CableAction.Tip}" IsVisible="{Binding HasCableAction}" />
            <Button Tag="scope" Classes="pill" Content="Edit" Command="{Binding EditCommand}" ToolTip.Tip="Change its name and devices" />
            <Button Tag="scope" Classes="pill glyph" Content="×" Command="{Binding Source.RemoveCommand}"
                    ToolTip.Tip="Remove this combined device (asks first)" />
        </StackPanel>
    </Grid>
</UserControl>
