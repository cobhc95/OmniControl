<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Pages.Volume"
             x:Class="OmniControl.App.Pages.Volume.CableRowView"
             x:DataType="vm:CableRow">
    <!-- One Virtual cables row (docs/mockups/virtual-cables-group.html): switch (OmniControl may use it) | name | ends tag
         ("Input + Output") | state tag ("Free" good, "In use") | at the right "Use for: ..." or "Not used: ..." (muted; the row
         dimmed) | x on a pair the user marked. Name and tags share columns across rows (CableName, CableEnds, CableState). -->
    <Grid ColumnSpacing="{StaticResource WiringColumnGap}" Opacity="{Binding RowOpacity}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="CableName" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="CableEnds" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="CableState" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="WiringRemove" />
        </Grid.ColumnDefinitions>
        <ToggleSwitch Classes="tool" IsChecked="{Binding IsAllowed}" IsEnabled="{Binding CanSwitch}" OnContent="" OffContent="" VerticalAlignment="Center"
                      ToolTip.Tip="{Binding SwitchTip}" ToolTip.ShowOnDisabled="True" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   MaxWidth="{StaticResource WiringSourceMaxWidth}" ToolTip.Tip="{Binding Tip}" />
        <Border Grid.Column="2" Classes="tag" VerticalAlignment="Center" HorizontalAlignment="Left">
            <TextBlock Text="{Binding EndsTag}" />
        </Border>
        <Border Grid.Column="3" Classes="tag" Classes.good="{Binding IsFree}" IsVisible="{Binding HasState}" VerticalAlignment="Center" HorizontalAlignment="Left">
            <TextBlock Text="{Binding State}" />
        </Border>
        <TextBlock Grid.Column="4" Classes="muted small" Text="{Binding Use}" ToolTip.Tip="{Binding UseTip}" HorizontalAlignment="Right"
                   VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Right" />
        <Button Grid.Column="5" Tag="scope" Classes="pill glyph" Content="×" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}"
                ToolTip.Tip="Forget this marked cable" VerticalAlignment="Center" />
    </Grid>
</UserControl>
