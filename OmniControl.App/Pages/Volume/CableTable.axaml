<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OmniControl.App.Controls"
             xmlns:vm="using:OmniControl.App.Pages.Volume"
             xmlns:pages="using:OmniControl.App.Pages"
             x:Class="OmniControl.App.Pages.Volume.CableTable"
             x:DataType="vm:CableGroup">
    <!-- The Wiring tab's Virtual cables group (docs/mockups/virtual-cables-group.html), under Microphones: the group's header with
         "N found", one CableRowView per virtual device, the dashed "+ This device is a cable..." chip (Button.blockadd.small) whose
         pop-down marks a pair by hand, then one muted hint line with "Get more cables" (Button.link.small) and, while no cable is
         installed, Install VB-CABLE. The pop-down is mouse first (AGENTS.md rule 5): the chip is keyboard reachable, Esc closes it. -->
    <Border Classes="groupPanel">
        <StackPanel Spacing="6">
            <pages:GroupHeader />
            <StackPanel Spacing="6" IsVisible="{Binding IsExpanded}">
                <ListBox Classes="rows compact" ItemsSource="{Binding Items}" />
                <Button x:Name="MarkChip" Classes="blockadd small" Tag="grouptool" HorizontalAlignment="Left" Content="{x:Static vm:CableMarkMenu.Label}"
                        ToolTip.Tip="{x:Static vm:CableMarkMenu.LabelTip}" Click="OnMarkClick">
                    <FlyoutBase.AttachedFlyout>
                        <c:ListMenuFlyout Placement="BottomEdgeAlignedLeft" Opened="OnMarkOpened">
                            <StackPanel x:DataType="vm:CableMarkMenu" Spacing="{StaticResource ChipSpacing}" KeyDown="OnMarkKeyDown">
                                <TextBlock Classes="menutext" Text="Mark two devices that carry the same sound as one cable" TextWrapping="Wrap" />
                                <StackPanel Spacing="{StaticResource ChipSpacing}" IsVisible="{Binding HasDevices}">
                                    <ContentControl Content="{Binding Playback}" />
                                    <ContentControl Content="{Binding Recording}" />
                                    <TextBox Classes="field" Text="{Binding Name}" Watermark="Name" />
                                    <Button Classes="pill cardaction main" HorizontalAlignment="Right" Content="Add" Command="{Binding AddCommand}" Click="OnAddClick" />
                                </StackPanel>
                                <TextBlock Classes="menutext" Text="All devices are already known." IsVisible="{Binding !HasDevices}" />
                            </StackPanel>
                        </c:ListMenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                </Button>
                <WrapPanel ItemSpacing="{StaticResource MenuGap}" LineSpacing="{StaticResource ChipSpacing}">
                    <TextBlock Classes="muted small" Text="{x:Static vm:CableGroup.Hint}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Button Tag="grouptool" Classes="link small" Command="{Binding MoreCables.Command}" ToolTip.Tip="{Binding MoreCables.Tip}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MoreCables.Label}" />
                    </Button>
                    <Button Tag="grouptool" Classes="pill cardaction main" IsVisible="{Binding HasInstall}" Content="{Binding Install.Label}"
                            Command="{Binding Install.Command}" ToolTip.Tip="{Binding Install.Tip}" VerticalAlignment="Center" />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
