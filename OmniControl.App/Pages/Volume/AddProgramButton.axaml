<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OmniControl.App.Controls"
             xmlns:vm="using:OmniControl.App.Pages.Volume"
             xmlns:audio="using:OmniControl.App.Audio"
             x:Class="OmniControl.App.Pages.Volume.AddProgramButton"
             x:DataType="vm:AddProgramMenuViewModel">
    <!-- "Add program..." in the Outputs header: a pop-down list of programs (recently used and installed) with a search box at the top
         and "Browse for a program..." last. Mouse first (AGENTS.md rule 5): the keyboard reaches the button (Enter opens it), the
         search box has it on opening (Enter chooses the first match, Tab walks the rows, Esc closes). The pop-down hangs on a Panel,
         not on the button, so the button's styles do not reach into it. -->
    <Panel x:Name="Holder">
        <FlyoutBase.AttachedFlyout>
            <c:ListMenuFlyout Placement="BottomEdgeAlignedRight" Opened="OnMenuOpened" Closed="OnMenuClosed">
                <StackPanel x:DataType="vm:AddProgramMenuViewModel" KeyDown="OnMenuKeyDown">
                    <TextBox Classes="field" Text="{Binding Query}" Watermark="Search programs…" Margin="0,0,0,4" />
                    <ScrollViewer MaxHeight="{StaticResource OptionListMaxHeight}" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Choices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="audio:ProgramChoice">
                                        <Button Classes="menurow" Click="OnChoiceClick" ToolTip.Tip="{Binding Path}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource MenuGap}">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Classes="muted small" Text="{Binding Source}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="menutext" Text="No match. Browse for a program…" IsVisible="{Binding HasNoMatch}" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Classes="hrule" Margin="0,4" />
                    <Button Classes="menurow" Click="OnBrowseClick">
                        <TextBlock Text="Browse for a program…" />
                    </Button>
                </StackPanel>
            </c:ListMenuFlyout>
        </FlyoutBase.AttachedFlyout>
        <Button Tag="grouptool" Classes="pill cardaction main" Content="Add program…" VerticalAlignment="Center" Click="OnOpenClick"
                ToolTip.Tip="Add a program that is not playing yet: one used before, an installed one, or any .exe" />
    </Panel>
</UserControl>
