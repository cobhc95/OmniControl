<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Pages.Volume"
             xmlns:pages="using:OmniControl.App.Pages"
             x:Class="OmniControl.App.Pages.Volume.VolumePage"
             x:DataType="vm:VolumePageViewModel">
    <StackPanel Spacing="6">
        <StackPanel x:Name="CardsHost" Grid.IsSharedSizeScope="True" Spacing="6">
            <!-- The tabs; on the Mixer tab, the quiet mode words at the right (they open Wiring, where the mode is chosen) -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource WiringColumnGap}">
                <pages:PageTabsView DataContext="{Binding Tabs}" />
                <Button Grid.Column="1" Tag="grouptool" Classes="link small" IsVisible="{Binding ShowsMixer}" Command="{Binding ShowSoundModeCommand}"
                        ToolTip.Tip="The sound mode every row uses (choose it in Wiring)">
                    <TextBlock Text="{Binding ModeIndicator}" />
                </Button>
            </Grid>

            <!-- MIXER: levels, mutes, meters and effects; where each row plays is read only here -->
            <StackPanel Spacing="6" IsVisible="{Binding ShowsMixer}">
                <Border Classes="groupPanel" x:DataType="vm:VolumeGroup" DataContext="{Binding Outputs}">
                    <StackPanel Spacing="6">
                        <pages:GroupHeader />
                        <ListBox Classes="rows compact" ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}" />
                    </StackPanel>
                </Border>

                <Border Classes="groupPanel" x:DataType="vm:VolumeGroup" DataContext="{Binding Inputs}">
                    <StackPanel Spacing="6">
                        <pages:GroupHeader />
                        <ListBox Classes="rows compact" ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- WIRING: the sound mode, the cable status and combining on top; where each source plays and the cable it uses; combined devices -->
            <StackPanel Spacing="6" IsVisible="{Binding ShowsWiring}">
                <WrapPanel Classes="toolbar">
                    <vm:SoundModeButton DataContext="{Binding SoundMode}" />
                    <Border Classes="tag" Classes.good="{Binding CableStatus.IsGood}" Classes.caution="{Binding CableStatus.IsCaution}"
                            IsVisible="{Binding HasCableStatus}" ToolTip.Tip="{Binding CableStatus.Tip}">
                        <TextBlock Text="{Binding CableStatus.Text}" />
                    </Border>
                    <Button Tag="grouptool" Classes="pill" Content="{Binding CableSetup.Label}" Command="{Binding CableSetup.Command}"
                            ToolTip.Tip="{Binding CableSetup.Tip}" IsVisible="{Binding HasCableSetup}" />
                    <Button Tag="grouptool" Classes="pill" Content="+ Combine devices" Command="{Binding CombineCommand}"
                            IsEnabled="{Binding CombineGate.IsAvailable}" ToolTip.Tip="{Binding CombineGate.Reason}" ToolTip.ShowOnDisabled="True" />
                </WrapPanel>

                <vm:WiringTable DataContext="{Binding WiringOutputs}" />
                <vm:WiringTable DataContext="{Binding WiringInputs}" />

                <Border Classes="groupPanel">
                    <StackPanel Spacing="6">
                        <pages:GroupHeader DataContext="{Binding CombinedDevices}" />
                        <StackPanel IsVisible="{Binding CombinedDevices.IsExpanded}" Spacing="6">
                            <!-- Fast mode can't run combined devices: one calm sentence and the one Switch -->
                            <WrapPanel Classes="toolbar" IsVisible="{Binding !CombineGate.IsAvailable}" Margin="{StaticResource WiringHeaderInset}">
                                <TextBlock Classes="hint" Text="{Binding CombineGate.Note}" />
                                <Button Tag="grouptool" Classes="link small" IsVisible="{Binding CombineGate.CanSwitch}" Command="{Binding CombineGate.SwitchCommand}">
                                    <TextBlock Text="{Binding CombineGate.SwitchLabel}" />
                                </Button>
                            </WrapPanel>
                            <TextBlock Classes="hint" Margin="{StaticResource WiringHeaderInset}" IsVisible="{Binding !CombinedDevices.Items.Count}"
                                       Text="None yet" ToolTip.Tip="+ Combine devices joins speakers or microphones." />
                            <ListBox Classes="rows compact" ItemsSource="{Binding CombinedDevices.Items}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
