<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Pages.Volume"
             x:Class="OmniControl.App.Pages.Volume.MixerRow"
             x:DataType="vm:MixerItem">
    <!-- One row: program | FX | pan | volume | mute. The controls are declared left to right, which is also the keyboard order
         (Left/Right walk them in this order, starting on the FX button). -->
    <Grid ColumnDefinitions="*,Auto,92,150,Auto,Auto" ColumnSpacing="10" Margin="0,3" Opacity="{Binding RowOpacity}" VerticalAlignment="Center">
        <!-- FX: ONE button split in half (label | power) inside a single rounded frame; the frame turns green when the chain is on -->
        <Border Grid.Column="1" Classes="fxsplit" Classes.on="{Binding FxOn}" CornerRadius="6" BorderThickness="1" Height="30"
                ClipToBounds="True" VerticalAlignment="Center">
            <Grid ColumnDefinitions="Auto,1,Auto">
                <Button Tag="scope" Classes="fxflat" Content="{Binding FxText}" Command="{Binding OpenFxCommand}"
                        MinWidth="44" Padding="10,0" ToolTip.Tip="Open the FX chain" />
                <Border Grid.Column="1" Classes="fxdivider" Width="1" />
                <Button Grid.Column="2" Tag="scope" Classes="fxflat fxpower" Classes.on="{Binding FxOn}" Command="{Binding ToggleFxCommand}"
                        MinWidth="32" Padding="0" ToolTip.Tip="FX chain on or off">
                    <Path Data="M12,3 L12,12 M7.2,6.5 A7,7 0 1 0 16.8,6.5" StrokeThickness="2" StrokeLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
            <Slider Minimum="-100" Maximum="100" Value="{Binding Pan}" MinWidth="40" ToolTip.Tip="Pan (left to right)" />
            <TextBlock Grid.Column="1" Text="{Binding PanText}" Classes="muted" MinWidth="26" TextAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Column="3" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
            <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" MinWidth="60" ToolTip.Tip="Volume" />
            <TextBlock Grid.Column="1" Text="{Binding Volume}" Classes="muted" MinWidth="24" TextAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <Button Grid.Column="4" Tag="scope" Classes="scope mute" Classes.on="{Binding Muted}" Content="M" Command="{Binding ToggleMuteCommand}"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center"
                Height="30" MinHeight="30" MinWidth="30" Padding="0" ToolTip.Tip="Mute" />

        <vm:LevelMeter Grid.Column="5" Model="{Binding Meter}" VerticalAlignment="Center" ToolTip.Tip="Output level" />

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
            <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource BrushAccentSoft}" VerticalAlignment="Center">
                <Grid>
                    <Image Source="{Binding Icon}" Width="20" Height="20" IsVisible="{Binding HasIcon}" />
                    <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding NoIcon}" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
