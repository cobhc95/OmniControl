<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Pages"
             xmlns:vm="using:OmniControl.App.Pages.Volume"
             x:Class="OmniControl.App.Pages.Volume.VolumeSlider"
             x:DataType="vm:VolumeRow" VerticalAlignment="Center">
    <!-- A row's level: the slider (double-click resets to full) and its value, which can be typed in -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
        <Slider Classes="compact" Minimum="0" Maximum="100" Value="{Binding Volume}" pages:SliderReset.Value="100" ToolTip.Tip="{Binding VolumeTip}" />
        <pages:NumberText Grid.Column="1" Value="{Binding Volume}" Minimum="0" Maximum="100" VerticalAlignment="Center">
            <TextBlock Text="{Binding Volume}" Classes="muted" MinWidth="24" TextAlignment="Right" VerticalAlignment="Center" />
        </pages:NumberText>
    </Grid>
</UserControl>
