<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Pages.Volume"
             x:Class="OmniControl.App.Pages.Volume.RouteButton"
             x:DataType="vm:RouteChoice" VerticalAlignment="Center">
    <!-- "Method: Automatic v" in a program's or the master's sentence and its pop-down: one card per way the effects can run (a cable,
         recording, Equalizer APO), then the one step that fixes what a greyed card lacks. -->
    <FlyoutBase.AttachedFlyout>
        <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="optionmenu" Opened="OnOpened" Closed="OnClosed">
            <StackPanel x:DataType="vm:RouteChoice" Spacing="6">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:RouteCard">
                            <Button Classes="optioncard" Classes.selected="{Binding IsSelected}" Command="{Binding PickCommand}" IsEnabled="{Binding IsAvailable}"
                                    ToolTip.Tip="{Binding Tip}" ToolTip.ShowOnDisabled="True">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Classes="hint small" Text="{Binding Description}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="pill cardaction" Classes.main="{Binding Fix.Main}" Content="{Binding Fix.Label}" Command="{Binding Fix.Command}"
                        ToolTip.Tip="{Binding Fix.Tip}" IsVisible="{Binding HasFix}" HorizontalAlignment="Left" />
            </StackPanel>
        </Flyout>
    </FlyoutBase.AttachedFlyout>

    <Button x:Name="MethodButton" Tag="scope" Classes="link small" ToolTip.Tip="{Binding Tip}" Click="OnClick">
        <StackPanel Orientation="Horizontal" Spacing="3">
            <TextBlock Text="{Binding ButtonText}" />
            <PathIcon Data="{DynamicResource ChevronDownIcon}" Width="{StaticResource ChevronSize}" Height="{StaticResource ChevronSize}" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
</UserControl>
