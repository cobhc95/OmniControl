<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Pages"
             xmlns:vm="using:OmniControl.App.Pages.Volume"
             x:Class="OmniControl.App.Pages.Volume.VolumeRowView"
             x:DataType="vm:VolumeRow">
    <!-- Every Volume row (master, program, microphone, combined device): icon | name and sentence | pan | level | mute | meter | FX | remove.
         The device words open the Wiring tab at this row (where they are changed); the effects link and the FX button open the row's FX
         window. Controls are declared left to right, which is also the keyboard order (Left/Right walk them: the sentence's links first).
         Columns are the same on every row so levels, mutes and meters line up. -->
    <Grid ColumnSpacing="6" Opacity="{Binding RowOpacity}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="*" MinWidth="64" MaxWidth="100" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="VolumeMute" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="VolumeMeter" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="VolumeOpen" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="VolumeRemove" />
        </Grid.ColumnDefinitions>

        <!-- Icon, name, and the sentence: "→ <devices> · <effects>" (the underlined words are controls) and the engine's status -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
            <vm:RowIcon />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                <WrapPanel Classes="sentence">
                    <TextBlock Text="{Binding Lead}" IsVisible="{Binding HasLead}" />
                    <TextBlock Text=" · " IsVisible="{Binding HasLead}" />
                    <TextBlock Text="{Binding RouteArrow}" IsVisible="{Binding HasRoute}" Margin="0,0,3,0" />
                    <Button Tag="scope" Classes="link" IsVisible="{Binding HasRoute}" Command="{Binding ShowWiringCommand}"
                            ToolTip.Tip="Change this in the Wiring tab">
                        <TextBlock Text="{Binding RouteText}" />
                    </Button>
                    <TextBlock Text=" · " IsVisible="{Binding ShowsRouteSeparator}" />
                    <Button Tag="scope" Classes="link" IsVisible="{Binding HasEffects}" Command="{Binding OpenWindowCommand}"
                            IsEnabled="{Binding EffectsGate.IsAvailable}" ToolTip.Tip="{Binding EffectsGate.Reason}" ToolTip.ShowOnDisabled="True">
                        <TextBlock Text="{Binding EffectsText}" />
                    </Button>
                    <Button Tag="scope" Classes="link small" Margin="4,0,0,0" ToolTip.Tip="{Binding EffectsGate.Reason}"
                            IsVisible="{Binding ShowsEffectsSwitch}" Command="{Binding EffectsGate.SwitchCommand}">
                        <TextBlock Text="Switch" />
                    </Button>
                    <TextBlock Text=" · " IsVisible="{Binding ShowsStatus}" />
                    <TextBlock Classes="status" Text="{Binding Status}" IsVisible="{Binding ShowsStatus}" ToolTip.Tip="{Binding ModeLine}" />
                    <!-- The one step that fixes what the status says is missing (a microphone in Fast mode: Choose devices) -->
                    <Button Tag="scope" Classes="link small" Margin="4,0,0,0" IsVisible="{Binding HasFix}" Command="{Binding Fix.Command}"
                            ToolTip.Tip="{Binding Fix.Tip}">
                        <TextBlock Text="{Binding Fix.Label}" />
                    </Button>
                    <!-- Fast mode can't record a program on this PC: the reason, Switch to Full control, and the Test that checks again -->
                    <Border Classes="tag caution" Margin="6,0,0,0" IsVisible="{Binding ShowsCaptureCaution}"
                            ToolTip.Tip="Fast mode records the program to run its effects. Test checks again.">
                        <TextBlock Text="{Binding CaptureGate.Reason}" TextWrapping="Wrap" />
                    </Border>
                    <Button Tag="scope" Classes="link small" Margin="4,0,0,0" IsVisible="{Binding ShowsCaptureCaution}"
                            Command="{Binding CaptureGate.SwitchCommand}" ToolTip.Tip="Runs the effects through the virtual cable instead">
                        <TextBlock Text="Switch to Full control" />
                    </Button>
                    <Button Tag="scope" Classes="link small" Margin="4,0,0,0" Command="{Binding RunTestCommand}" IsVisible="{Binding ShowsTest}"
                            ToolTip.Tip="Plays a few seconds through the effects, checks the original can be muted, measures the delay">
                        <TextBlock Text="Test" />
                    </Button>
                    <TextBlock Text="{Binding TestNote}" Margin="4,0,0,0" TextWrapping="Wrap" IsVisible="{Binding HasTestNote}" />
                </WrapPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalAlignment="Center" IsVisible="{Binding HasPan}">
            <Slider Classes="compact" Minimum="-100" Maximum="100" Value="{Binding Pan}" pages:SliderReset.Value="0" ToolTip.Tip="Pan (left to right)" />
            <TextBlock Grid.Column="1" Text="{Binding PanText}" Classes="muted" MinWidth="26" TextAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <vm:VolumeSlider Grid.Column="2" IsVisible="{Binding HasVolume}" />

        <Button Grid.Column="3" Tag="scope" Classes="scope mute" Classes.on="{Binding Muted}" Content="M" Command="{Binding ToggleMuteCommand}"
                ToolTip.Tip="Mute" IsVisible="{Binding HasVolume}" />

        <vm:LevelMeter Grid.Column="4" Model="{Binding Meter}" VerticalAlignment="Center" ToolTip.Tip="Level" />

        <Button Grid.Column="5" Tag="scope" Classes="pill" Content="FX" Command="{Binding OpenWindowCommand}" IsVisible="{Binding HasEffects}"
                IsEnabled="{Binding EffectsGate.IsAvailable}" ToolTip.Tip="Opens this row's FX window" VerticalAlignment="Center" />

        <Button Grid.Column="6" Tag="scope" Classes="pill glyph" Content="×" Command="{Binding RemoveCommand}" IsVisible="{Binding CanForget}"
                ToolTip.Tip="Remove (forgets its settings)" VerticalAlignment="Center" />
    </Grid>
</UserControl>
