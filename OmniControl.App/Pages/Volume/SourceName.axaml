<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Pages.Volume"
             x:Class="OmniControl.App.Pages.Volume.SourceName"
             x:DataType="vm:VolumeRow" VerticalAlignment="Center">
    <!-- The Source column of the Wiring tab (a table row, a combined device card): the row's icon and its name, trimmed -->
    <StackPanel Orientation="Horizontal" Spacing="{StaticResource MenuGap}">
        <vm:RowIcon />
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   MaxWidth="{StaticResource WiringSourceMaxWidth}" ToolTip.Tip="{Binding Name}" />
    </StackPanel>
</UserControl>
