<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Pages"
             x:Class="OmniControl.App.Pages.GroupHeader"
             x:DataType="pages:CardGroup">
    <Button Classes="groupHeader" Tag="grouphdr" Click="OnClick" ToolTip.Tip="{Binding Tip}">
        <Grid ColumnDefinitions="Auto,Auto,*">
            <PathIcon Classes="chev" Classes.collapsed="{Binding !IsExpanded}" Data="{StaticResource ChevronDownIcon}"
                      Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Classes="strong" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
            <!-- The summary either follows the name (a group that wants it beside the title) or sits at the right edge -->
            <TextBlock Grid.Column="2" Text="{Binding ShownSummary}" Classes="muted" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" IsVisible="{Binding SummaryBesideName}" />
            <TextBlock Grid.Column="2" Text="{Binding ShownSummary}" Classes="muted" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                       IsVisible="{Binding !SummaryBesideName}" />
        </Grid>
    </Button>
</UserControl>
