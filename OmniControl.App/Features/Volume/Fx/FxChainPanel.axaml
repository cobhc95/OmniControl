<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Features.Volume.Fx"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             x:Class="OmniControl.App.Features.Volume.Fx.FxChainPanel"
             x:DataType="vm:FxChainViewModel" FontSize="12">
    <UserControl.Styles>
        <Style Selector="CheckBox"><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector="CheckBox /template/ ContentPresenter"><Setter Property="FontSize" Value="12" /></Style>
        <Style Selector="ListBox.fxlist > ListBoxItem" x:DataType="vm:FxSlotViewModel"><Setter Property="IsVisible" Value="{Binding Shown}" /></Style>
        <Style Selector="Border.pane"><Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" /></Style>
    </UserControl.Styles>
    <!-- The FX window's two panes (TabForge style): the chain on the left, the selected effect's editor on the right -->
    <Grid x:Name="Panes" Grid.IsSharedSizeScope="True">
        <!-- The list's width is set in code (the saved width, else FxChainListWidth) and dragged at the splitter between the panes -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="{StaticResource FxChainListMinWidth}" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="{StaticResource FxEditorMinWidth}" />
        </Grid.ColumnDefinitions>

        <!-- Left: the chain in signal order -->
        <Grid RowDefinitions="*,Auto" RowSpacing="{StaticResource GapLarge}">
            <Border Grid.Row="0" Classes="pane">
                <Grid>
                    <ListBox x:Name="SlotList" Classes="fxlist" SelectionMode="Multiple" ItemsSource="{Binding Slots}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FxSlotViewModel">
                                <Panel>
                                    <!-- An effect: inside a folder it is indented under the folder's accent bar; outside every folder (while folders exist) it says "all devices" -->
                                    <Grid ColumnSpacing="{StaticResource GapLarge}" VerticalAlignment="Center" IsVisible="{Binding IsEffect}"
                                          ToolTip.Tip="{Binding Name, StringFormat='{}{0}: double-click for its own window, drag to reorder'}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FxSlotNumber" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FxSlotTag" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" Classes="muted" TextAlignment="Right" VerticalAlignment="Center"
                                                   ToolTip.Tip="Order in the chain, top to bottom" />
                                        <Border Grid.Column="1" Classes="chainindent" IsVisible="{Binding IsChild}" />
                                        <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" ToolTip.Tip="On or bypassed" MinWidth="0" />
                                        <TextBlock Grid.Column="3" Text="{Binding Tag}" Classes="muted small" VerticalAlignment="Center" ToolTip.Tip="{Binding KindText}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="all devices" Classes="chainhint" VerticalAlignment="Center" IsVisible="{Binding ShowsAllDevices}"
                                                   ToolTip.Tip="Runs for every device (it is outside every device folder)" />
                                    </Grid>
                                    <!-- A device folder (docs/mockups/fx-device-folders.html): chevron, on tick, glyph, device name over its method tag, effect count -->
                                    <Grid Classes="chainfolder" Classes.dim="{Binding Folder.Dim, FallbackValue=False}" ColumnSpacing="{StaticResource GapLarge}" VerticalAlignment="Center"
                                          IsVisible="{Binding IsFolder}" ToolTip.Tip="Device folder: its effects run only while this device plays">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="FxSlotNumber" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" Classes="muted" TextAlignment="Right" VerticalAlignment="Center"
                                                   ToolTip.Tip="Order in the chain, top to bottom" />
                                        <Button Grid.Column="1" Classes="step chainchevron" Command="{Binding Folder.ToggleExpandedCommand}" ToolTip.Tip="Show or hide the folder's effects">
                                            <Panel>
                                                <PathIcon Data="{DynamicResource ChevronDownIcon}" Width="{StaticResource ChipGlyphSize}" Height="{StaticResource ChipGlyphSize}"
                                                          IsVisible="{Binding Folder.Expanded, FallbackValue=True}" />
                                                <PathIcon Data="{DynamicResource ChevronRightIcon}" Width="{StaticResource ChipGlyphSize}" Height="{StaticResource ChipGlyphSize}"
                                                          IsVisible="{Binding !Folder.Expanded, FallbackValue=False}" />
                                            </Panel>
                                        </Button>
                                        <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" ToolTip.Tip="The folder on or bypassed" MinWidth="0" />
                                        <c:IconGlyph Grid.Column="3" Classes="chainfolder" Classes.playing="{Binding Folder.Playing}" Classes.cable="{Binding Folder.IsCable}"
                                                     LibraryId="device-speaker" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding Folder.DeviceName}" TextTrimming="CharacterEllipsis" Classes="strong" />
                                            <c:TagView DataContext="{Binding Folder.RowTag}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="5" Text="{Binding Folder.Count}" Classes="muted" VerticalAlignment="Center" ToolTip.Tip="Effects in this folder" />
                                    </Grid>
                                </Panel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border x:Name="SelectionBand" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1">
                        <Border Background="{DynamicResource BrushAccent}" Opacity="0.15" />
                    </Border>
                    <TextBlock Text="Empty chain." Classes="muted" TextWrapping="Wrap"
                               IsVisible="{Binding IsEmpty}" Margin="10" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <!-- Add and Remove, then the host's own buttons on the same line (the FX window's Forget program) -->
            <WrapPanel Grid.Row="1" Classes="toolbar">
                <Button x:Name="AddButton" Classes="pill" Content="Add…" Click="OnAddClick" ToolTip.Tip="Add an effect to the end of the chain (Ctrl+N)" />
                <Button Classes="pill" Command="{Binding AddFolderCommand}" IsVisible="{Binding CanAddFolder}"
                        ToolTip.Tip="Add a device folder: the effects in it run only while that device plays">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}">
                        <c:IconGlyph Classes="pillglyph" LibraryId="device-speaker-plus" VerticalAlignment="Center" />
                        <TextBlock Text="Device folder" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="pill" Content="Remove" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove the selected effects; a device folder goes with its effects (Delete)" />
                <ContentPresenter x:Name="ToolsHost" />
            </WrapPanel>
        </Grid>

        <!-- Right: the selected effect's editor (cards, the equaliser, a plug-in's settings list or its own window) with all the
             height; its controls (preset, wet, on, Parameters, Scale, Pop out) are in the FX window's toolbar -->
        <GridSplitter x:Name="PaneSplitter" Grid.Column="1" Classes="pane" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      ToolTip.Tip="Drag to resize the effect list" />
        <Border Grid.Column="2" Classes="pane" Padding="6">
            <Grid>
                <vm:FxFolderEditor DataContext="{Binding Selected}" IsVisible="{Binding $parent[UserControl].DataContext.ShowsFolder}" />
                <Panel IsVisible="{Binding ShowsCards}">
                    <vm:EffectEditorView x:Name="EditorView" DataContext="{Binding Selected}" />
                </Panel>
                <vm:PluginEditorArea x:Name="PluginArea" Editor="{Binding PluginEditor}" IsVisible="{Binding ShowsPluginEditor}"
                                     UserScale="{Binding Selected.ScaleFactor, FallbackValue=1}" />
                <StackPanel IsVisible="{Binding HasHint}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource GapLarge}" MaxWidth="360">
                    <TextBlock Text="{Binding Hint}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Classes="pill" Content="Put back" Command="{Binding PutBackCommand}" IsVisible="{Binding CanPutBack}"
                            HorizontalAlignment="Center" ToolTip.Tip="Closes the effect's own window and shows its editor here" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
