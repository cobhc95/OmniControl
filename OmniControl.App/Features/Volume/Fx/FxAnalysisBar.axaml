<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fx="using:OmniControl.App.Features.Volume.Fx"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             x:Class="OmniControl.App.Features.Volume.Fx.FxAnalysisBar"
             x:DataType="fx:FxAnalysisViewModel">
    <!-- The FX window toolbar's response thumbnail (owner-approved "Design A", at the toolbar's right end; Peak and Latency sit beside it
         in the toolbar and fold away when it is narrow). The larger graph is a pop-up under the thumbnail's right edge, over the panes,
         so nothing underneath moves; it always shows the numbers. -->
    <Panel>
        <Button x:Name="Thumb" Classes="graphthumb" AutomationProperties.Name="Total response of the chain">
            <fx:ResponseThumb />
        </Button>
        <Popup x:Name="Enlarged" PlacementTarget="{Binding #Thumb}" Placement="BottomEdgeAlignedRight"
               VerticalOffset="{StaticResource MenuOffset}" IsLightDismissEnabled="False">
            <FlyoutPresenter x:Name="EnlargedPanel" Classes="graphmenu">
                <StackPanel Spacing="{StaticResource FxGraphPanelSpacing}">
                    <fx:ResponseGraph Height="{StaticResource FxGraphHeight}" />
                    <!-- one wrapping line under the graph: the numbers, the measurement's facts as tags, the reference curve's words, "Measuring…" -->
                    <WrapPanel Margin="{StaticResource MenuTextInset}" ItemSpacing="{StaticResource MenuTagGap}" LineSpacing="{StaticResource MenuTagGap}">
                        <fx:FxAnalysisNumbers ShowsPeakFrequency="True" VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding Notes}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="{StaticResource MenuTagGap}" LineSpacing="{StaticResource MenuTagGap}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><c:TagView /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="menutext" Margin="0" Text="{x:Static fx:FxAnalysisViewModel.ReferenceText}" IsVisible="{Binding IsMeasured}" VerticalAlignment="Center" />
                        <TextBlock Classes="menutext" Margin="0" Text="Measuring…" IsVisible="{Binding IsMeasuring}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Classes="menutext" Text="{x:Static fx:FxAnalysisViewModel.NoteText}" IsVisible="{Binding HasNote}"
                               ToolTip.Tip="{Binding NoteTip}" />
                </StackPanel>
            </FlyoutPresenter>
        </Popup>
    </Panel>
</UserControl>
