<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fx="using:OmniControl.App.Features.Volume.Fx"
             x:Class="OmniControl.App.Features.Volume.Fx.FxAnalysisBar"
             x:DataType="fx:FxAnalysisViewModel">
    <!-- The FX window toolbar's response thumbnail (owner-approved "Design A", at the toolbar's right end; Peak and Latency sit beside it
         in the toolbar and fold away when it is narrow). The larger graph is a pop-up under the thumbnail's right edge, over the panes,
         so nothing underneath moves; it always shows the numbers. -->
    <Panel>
        <Button x:Name="Thumb" Classes="graphthumb" AutomationProperties.Name="Total response of the chain">
            <fx:ResponseThumb />
        </Button>
        <Popup x:Name="Enlarged" PlacementTarget="{Binding #Thumb}" Placement="BottomEdgeAlignedRight"
               VerticalOffset="{StaticResource MenuOffset}" IsLightDismissEnabled="False">
            <FlyoutPresenter x:Name="EnlargedPanel" Classes="graphmenu">
                <StackPanel Spacing="{StaticResource FxGraphPanelSpacing}">
                    <fx:ResponseGraph Height="{StaticResource FxGraphHeight}" />
                    <fx:FxAnalysisNumbers ShowsPeakFrequency="True" Margin="{StaticResource MenuTextInset}" />
                    <TextBlock Classes="menutext" Text="{x:Static fx:FxAnalysisViewModel.NoteText}" IsVisible="{Binding HasNote}"
                               ToolTip.Tip="{Binding NoteTip}" />
                </StackPanel>
            </FlyoutPresenter>
        </Popup>
    </Panel>
</UserControl>
