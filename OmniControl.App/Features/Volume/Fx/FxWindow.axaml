<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
        xmlns:fx="using:OmniControl.App.Features.Volume.Fx"
        xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
        x:Class="OmniControl.App.Features.Volume.Fx.FxWindow"
        x:DataType="fx:FxWindowViewModel"
        Title="{Binding Title}" Topmost="{Binding KeepOnTop}" Width="860" Height="540" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterScreen" FontSize="12">
    <Window.Styles>
        <Style Selector="MenuItem"><Setter Property="FontSize" Value="12" /></Style>
    </Window.Styles>
    <!-- TabForge-style FX chain window (owner-approved layout): menu bar; ONE toolbar row (the row's effects switch, the selected
         effect's preset, wet, on, Parameters, Scale and Pop out, then Peak / Latency and the response thumbnail at the right end; the
         less used controls fold into "…" and the numbers drop out when narrow); the chain list and the selected effect's editor with
         all the remaining height; ONE thin status strip with what the effects engine does with this chain -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Classes="barstrip" BorderThickness="0,0,0,1">
            <Menu FontSize="12">
                <MenuItem Header="_FX">
                    <MenuItem Header="Add effect…" Click="OnAddClick" InputGesture="Ctrl+N" />
                    <MenuItem Header="Remove" Command="{Binding Chain.RemoveCommand}" InputGesture="Delete" />
                    <MenuItem Header="Copy" Command="{Binding Chain.CopyCommand}" InputGesture="Ctrl+C" />
                    <MenuItem Header="Paste" Command="{Binding Chain.PasteCommand}" InputGesture="Ctrl+V" />
                    <MenuItem Header="Move up" Command="{Binding Chain.MoveUpCommand}" InputGesture="Alt+Up" />
                    <MenuItem Header="Move down" Command="{Binding Chain.MoveDownCommand}" InputGesture="Alt+Down" />
                    <Separator />
                    <MenuItem Header="Save chain…" Click="OnSaveChainClick" InputGesture="Ctrl+S" />
                    <MenuItem Header="Load chain…" Click="OnLoadChainClick" InputGesture="Ctrl+O" />
                    <Separator />
                    <MenuItem Header="Pop out effect window" Command="{Binding Chain.PopOutCommand}" IsEnabled="{Binding Chain.CanPopOut}" />
                    <MenuItem Header="Put effect window back" Command="{Binding Chain.PutBackCommand}" IsEnabled="{Binding Chain.CanPutBack}" />
                    <Separator />
                    <MenuItem Header="Parameters (plain list)" ToggleType="CheckBox" IsChecked="{Binding Chain.Selected.ShowsParameters}"
                              IsEnabled="{Binding Chain.Selected.CanShowParameters, FallbackValue=False}" />
                    <MenuItem Header="Smaller editor" Command="{Binding Chain.Selected.ScaleDownCommand}" InputGesture="Ctrl+OemMinus"
                              IsEnabled="{Binding Chain.Selected.CanScale, FallbackValue=False}" />
                    <MenuItem Header="Larger editor" Command="{Binding Chain.Selected.ScaleUpCommand}" InputGesture="Ctrl+OemPlus"
                              IsEnabled="{Binding Chain.Selected.CanScale, FallbackValue=False}" />
                    <MenuItem Header="Editor at 100 %" Command="{Binding Chain.Selected.ScaleResetCommand}" InputGesture="Ctrl+D0"
                              IsEnabled="{Binding Chain.Selected.CanScale, FallbackValue=False}" />
                    <Separator />
                    <MenuItem Header="Close" Command="{Binding CloseWindowCommand}" InputGesture="Escape" />
                </MenuItem>
                <MenuItem Header="_Options">
                    <MenuItem Header="Chain on" ToggleType="CheckBox" IsChecked="{Binding FxOn}" />
                    <!-- A program's output device: one radio entry per device (the Volume page's Wiring tab offers several) -->
                    <MenuItem Header="Plays on" IsVisible="{Binding IsProgram}" ItemsSource="{Binding OutputChoices}">
                        <MenuItem.ItemTemplate>
                            <DataTemplate x:DataType="fx:OutputChoice"><TextBlock Text="{Binding Name}" /></DataTemplate>
                        </MenuItem.ItemTemplate>
                        <MenuItem.ItemContainerTheme>
                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="ToggleType" Value="Radio" />
                                <Setter Property="IsChecked" Value="{Binding IsChosen, Mode=OneWay}" />
                                <Setter Property="Command" Value="{Binding Choose}" />
                            </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                    </MenuItem>
                    <MenuItem Header="Keep on top" ToggleType="CheckBox" IsChecked="{Binding KeepOnTop}" ToolTip.Tip="Also above other programs" />
                    <MenuItem Header="{Binding KeepFxInPlaceText}" ToggleType="CheckBox" IsChecked="{Binding KeepFxInPlace}" ToolTip.Tip="{Binding KeepFxInPlaceTip}" />
                    <Separator />
                    <MenuItem Header="Keyboard shortcuts…" Click="OnShortcutsClick" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- The toolbar: the selected effect's controls are hidden while nothing is selected -->
        <Border Grid.Row="1" Classes="toolrow">
            <!-- Fluent sizes its switch to at least 154 px wide; in the toolbar it takes only the knob and its words -->
            <Border.Resources><x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double></Border.Resources>
            <fx:FoldingRow Spacing="{DynamicResource ToolRowGap}">
                <ToggleSwitch IsChecked="{Binding FxOn}" OnContent="Effects on" OffContent="Effects off"
                              ToolTip.Tip="The whole chain on or off" />
                <c:PresetPicker DataContext="{Binding Chain.Selected.PresetChoice}" IsVisible="{Binding $parent[Window].DataContext.Chain.Selected.HasPresets, FallbackValue=False}"
                                ToolTip.Tip="Preset of the selected effect" />
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource ToolRowInnerGap}" IsVisible="{Binding Chain.ShowsEffectTools}"
                            ToolTip.Tip="Wet mix: how much processed sound is heard">
                    <TextBlock Text="Wet" Classes="muted" VerticalAlignment="Center" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding Chain.Selected.Wet}"
                            pages:SliderReset.Value="{Binding Chain.Selected.DefaultWet}" Width="{DynamicResource FxToolWetWidth}" />
                    <TextBlock Text="{Binding Chain.Selected.Wet}" Classes="slidervalue" MinWidth="{DynamicResource FxToolValueWidth}" />
                </StackPanel>
                <CheckBox Content="On" IsChecked="{Binding Chain.Selected.Enabled}" IsVisible="{Binding Chain.ShowsEffectTools}"
                          ToolTip.Tip="The selected effect on, or bypassed (Space in the list)" />
                <Button Classes="pill" Classes.custom="{Binding Chain.Selected.ShowsParameters}" Content="Parameters" fx:FoldingRow.FoldLevel="2"
                        Command="{Binding Chain.Selected.ToggleParametersCommand}" IsEnabled="{Binding Chain.Selected.CanShowParameters}"
                        IsVisible="{Binding Chain.ShowsEffectTools}" ToolTip.Tip="{Binding Chain.Selected.ParametersTip}" ToolTip.ShowOnDisabled="True" />
                <ComboBox Classes="tool" ItemsSource="{x:Static fx:EditorScale.Texts}" SelectedItem="{Binding Chain.Selected.ScaleText}" fx:FoldingRow.FoldLevel="2"
                          IsEnabled="{Binding Chain.Selected.CanScale}" IsVisible="{Binding Chain.ShowsEffectTools}"
                          ToolTip.Tip="{Binding Chain.Selected.ScaleTip}" ToolTip.ShowOnDisabled="True" />
                <Button Classes="pill" Content="{Binding Chain.PopText}" Command="{Binding Chain.TogglePopOutSelectedCommand}" fx:FoldingRow.FoldLevel="2"
                        IsVisible="{Binding Chain.ShowsEffectTools}" ToolTip.Tip="{Binding Chain.PopTip}" />
                <!-- What folded at the narrowest width: Parameters, Scale and Pop out as a menu (mouse first, the master menu look) -->
                <Button Classes="pill" Content="…" fx:FoldingRow.ShowsWhenFolded="2" IsVisible="{Binding Chain.ShowsEffectTools}"
                        ToolTip.Tip="Parameters, Scale, Pop out">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Parameters (plain list)" ToggleType="CheckBox" IsChecked="{Binding Chain.Selected.ShowsParameters}"
                                      IsEnabled="{Binding Chain.Selected.CanShowParameters, FallbackValue=False}" />
                            <MenuItem Header="Smaller editor" Command="{Binding Chain.Selected.ScaleDownCommand}" InputGesture="Ctrl+OemMinus"
                                      IsEnabled="{Binding Chain.Selected.CanScale, FallbackValue=False}" />
                            <MenuItem Header="Larger editor" Command="{Binding Chain.Selected.ScaleUpCommand}" InputGesture="Ctrl+OemPlus"
                                      IsEnabled="{Binding Chain.Selected.CanScale, FallbackValue=False}" />
                            <MenuItem Header="Editor at 100 %" Command="{Binding Chain.Selected.ScaleResetCommand}" InputGesture="Ctrl+D0"
                                      IsEnabled="{Binding Chain.Selected.CanScale, FallbackValue=False}" />
                            <Separator />
                            <MenuItem Header="{Binding Chain.PopText}" Command="{Binding Chain.TogglePopOutSelectedCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Panel fx:FoldingRow.Fill="True" />
                <fx:FxAnalysisNumbers Classes="stacked" DataContext="{Binding Analysis}" fx:FoldingRow.FoldLevel="1" VerticalAlignment="Center" />
                <fx:FxAnalysisBar x:Name="Analysis" DataContext="{Binding Analysis}" VerticalAlignment="Center" />
            </fx:FoldingRow>
        </Border>

        <fx:FxChainPanel x:Name="FxView" Grid.Row="2" Margin="{DynamicResource FxPanesMargin}" DataContext="{Binding Chain}"
                      ListWidth="{Binding $parent[Window].DataContext.ChainListWidth, Mode=TwoWay}">
            <fx:FxChainPanel.ListTools>
                <Button x:Name="ForgetButton" Classes="pill" Content="Forget" Command="{Binding ForgetCommand}" IsVisible="{Binding CanForget}"
                        ToolTip.Tip="Forget this program (row, effects and settings)" />
            </fx:FxChainPanel.ListTools>
        </fx:FxChainPanel>

        <!-- The status strip: the engine line (the same line a Volume row shows as its status's
             tooltip: running, waiting, not installed, failed and why), "Put back" while Equalizer APO's config is left without OmniControl's
             line, a tag when that config runs effects of its own, and the selected effect's "Runs in ..." note when it fits -->
        <Border Grid.Row="3" Classes="statusstrip">
            <fx:FoldingRow Spacing="{DynamicResource StatusStripGap}">
                <TextBlock Classes="statusline" Text="{Binding EngineText}" ToolTip.Tip="{Binding EngineText}" fx:FoldingRow.Fill="True" />
                <Button Classes="link small" Content="Put back" Command="{Binding PutBackCommand}" IsVisible="{Binding ShowsPutBack}" VerticalAlignment="Center"
                        ToolTip.Tip="Put OmniControl's line back into Equalizer APO's config" />
                <c:TagView DataContext="{Binding OwnApoEffects}" IsVisible="{Binding $parent[Window].DataContext.OwnApoEffects, Converter={x:Static ObjectConverters.IsNotNull}}"
                           fx:FoldingRow.FoldLevel="1" VerticalAlignment="Center" />
                <c:TagView DataContext="{Binding DisplayFed}" IsVisible="{Binding $parent[Window].DataContext.DisplayFed, Converter={x:Static ObjectConverters.IsNotNull}}"
                           fx:FoldingRow.FoldLevel="1" VerticalAlignment="Center" />
                <TextBlock Classes="statusline" Text="{Binding Chain.Selected.RunsNote}" IsVisible="{Binding Chain.HasSelection}" fx:FoldingRow.FoldLevel="1"
                           ToolTip.Tip="{Binding Chain.Selected.RunsDetail}" />
            </fx:FoldingRow>
        </Border>
    </Grid>
</Window>
