<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fx="using:OmniControl.App.Features.Volume.Fx"
             x:Class="OmniControl.App.Features.Volume.Fx.FxAnalysisNumbers"
             x:DataType="fx:FxAnalysisViewModel">
    <!-- The FX window's live numbers (the toolbar, as two tiny stacked lines with the class "stacked", and the larger graph): a muted
         label, then the value; each says on its tooltip what it is and where it comes from. The Peak value turns to the caution colour
         above the default scale. -->
    <UserControl.Styles>
        <!-- Live numbers (StackPanel.stats of StackPanel.stat): a muted label, then the value in the normal colour and a little heavier;
             TextBlock.statvalue.caution = a value past a warning point (the Peak above the default scale) -->
        <Style Selector="StackPanel.stats"><Setter Property="Orientation" Value="Horizontal" /><Setter Property="Spacing" Value="10" /></Style>
        <Style Selector="StackPanel.stat"><Setter Property="Orientation" Value="Horizontal" /><Setter Property="Spacing" Value="3" /></Style>
        <Style Selector="TextBlock.statlabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.statvalue">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.statvalue.caution"><Setter Property="Foreground" Value="{DynamicResource BrushCaution}" /></Style>
        <!-- fx|FxAnalysisNumbers.stacked: the numbers as tiny stacked lines beside the thumbnail in a toolbar (the larger graph keeps them in a row) -->
        <Style Selector="fx|FxAnalysisNumbers.stacked StackPanel.stats"><Setter Property="Orientation" Value="Vertical" /><Setter Property="Spacing" Value="0" /></Style>
        <Style Selector="fx|FxAnalysisNumbers.stacked TextBlock.statlabel, fx|FxAnalysisNumbers.stacked TextBlock.statvalue">
            <Setter Property="FontSize" Value="{StaticResource FxStatsSmallFontSize}" />
            <Setter Property="LineHeight" Value="{StaticResource FxStatsSmallLineHeight}" />
        </Style>
    </UserControl.Styles>
    <StackPanel Classes="stats">
        <StackPanel Classes="stat" ToolTip.Tip="{Binding PeakTip}">
            <TextBlock Classes="statlabel" Text="Peak" />
            <TextBlock Classes="statvalue" Classes.caution="{Binding PeakIsHigh}" Text="{Binding PeakText}" />
            <TextBlock Classes="statvalue" Text="{Binding PeakAtText}" IsVisible="{Binding ShowsPeakFrequency, RelativeSource={RelativeSource AncestorType=fx:FxAnalysisNumbers}}" />
        </StackPanel>
        <StackPanel Classes="stat" ToolTip.Tip="{Binding LatencyTip}">
            <TextBlock Classes="statlabel" Text="Latency" />
            <TextBlock Classes="statvalue" Text="{Binding LatencyText}" />
        </StackPanel>
    </StackPanel>
</UserControl>
