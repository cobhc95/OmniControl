<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fx="using:OmniControl.App.Features.Volume.Fx"
             x:Class="OmniControl.App.Features.Volume.Fx.FxAnalysisNumbers"
             x:DataType="fx:FxAnalysisViewModel">
    <!-- The FX window's live numbers (the toolbar, as two tiny stacked lines with the class "stacked", and the larger graph): a muted
         label, then the value; each says on its tooltip what it is and where it comes from. The Peak value turns to the caution colour
         above the default scale. -->
    <StackPanel Classes="stats">
        <StackPanel Classes="stat" ToolTip.Tip="{Binding PeakTip}">
            <TextBlock Classes="statlabel" Text="Peak" />
            <TextBlock Classes="statvalue" Classes.caution="{Binding PeakIsHigh}" Text="{Binding PeakText}" />
            <TextBlock Classes="statvalue" Text="{Binding PeakAtText}" IsVisible="{Binding $parent[UserControl].ShowsPeakFrequency}" />
        </StackPanel>
        <StackPanel Classes="stat" ToolTip.Tip="{Binding LatencyTip}">
            <TextBlock Classes="statlabel" Text="Latency" />
            <TextBlock Classes="statvalue" Text="{Binding LatencyText}" />
        </StackPanel>
    </StackPanel>
</UserControl>
