<Window Classes="dialog" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:OmniControl.App.Features.Volume.Fx.Plugins"
        xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
        x:Class="OmniControl.App.Features.Volume.Fx.Plugins.AddEffectWindow"
        x:DataType="p:AddEffectViewModel"
        Title="Add effect" Width="580" Height="520" MinWidth="440" MinHeight="360" FontSize="12"
        WindowStartupLocation="CenterOwner">
    <DockPanel Grid.IsSharedSizeScope="True">
        <!-- The window's foot: the scan and load pills at the left, Add and Cancel at the right (the master foot and button widths) -->
        <Border DockPanel.Dock="Bottom" Classes="footer">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                <Button x:Name="ScanButton" Tag="scope" Classes="pill cardaction" Content="{Binding ScanText}" Command="{Binding ScanCommand}" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="LoadButton" Tag="scope" Classes="pill cardaction" Content="Load VST file…" Click="OnLoadClick" VerticalAlignment="Center" />
                <Button Grid.Column="3" x:Name="AddButton" Tag="scope" Classes="scope usebtn" Content="Add" Click="OnAddClick" IsEnabled="{Binding CanAdd}" />
                <Button Grid.Column="4" Tag="scope" Classes="primary close" Content="Cancel" Click="OnCancelClick" />
            </Grid>
        </Border>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" MinHeight="16" Margin="12,0,12,6" />
    <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="12,12,12,6" Grid.IsSharedSizeScope="True">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="SearchBox" Classes="field search" Text="{Binding Query}" Watermark="Search effects and plug-ins" VerticalContentAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Width="120" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Classes="pane edged">
            <Grid>
                <ListBox x:Name="ResultList" Classes="fxlist" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="p:PluginEntry">
                            <Grid ColumnSpacing="10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Fmt" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Format}" Classes="muted small" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                    <c:IconGlyph LibraryId="{Binding Icon}" Width="16" Height="16" IsVisible="{Binding Icon, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
    </DockPanel>
</Window>
