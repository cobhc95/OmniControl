<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             xmlns:vm="using:OmniControl.App.Features.Volume.Fx"
             x:Class="OmniControl.App.Features.Volume.Fx.EqPanelRow"
             x:DataType="vm:EqPanelItem">
    <!-- Parametric equaliser editor (design C, docs/mockups/eq-design-c.html): the band list at the left (tab-like rows that share the
         graph's height, at least BandRowsPanel.MinRowHeight each, scrolling beyond that; "+ Add band" under it), the graph in the middle,
         the equaliser's OVERALL gain as a vertical slider at the right; under them the selected band's Type, Frequency, Bandwidth and Gain, then the buttons and view switches. -->
    <StackPanel Spacing="{StaticResource GapLarge}" Margin="0,4" TextElement.FontSize="{StaticResource EqFontSize}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource GapLarge}" RowDefinitions="230">
            <Grid RowDefinitions="*,Auto" RowSpacing="3" Width="{StaticResource BandListWidth}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="BandList" ItemsSource="{Binding Bands}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vm:BandRowsPanel ViewportHeight="{Binding $parent[ScrollViewer].Viewport.Height}" SelectedIndex="{Binding SelectedIndex}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:EqBandItem">
                                <Button Classes="bandrow" Classes.on="{Binding IsSelected}" Classes.off="{Binding IsBypassed}"
                                        Command="{Binding SelectCommand}">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="{StaticResource Gap}">
                                        <Border Classes="bandbar" Margin="0,2" />
                                        <vm:BandDot Grid.Column="1" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Number}" FontSize="{StaticResource EqFontSize}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding ListFreq}" Classes="muted" FontSize="{StaticResource EqFontSize}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Row="1" Classes="pill cardaction main" Tag="scope" Content="+ Add band" Command="{Binding AddBandCommand}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" MinHeight="30" FontSize="{StaticResource EqFontSize}" />
            </Grid>

            <vm:EqGraph Grid.Column="1" />

            <!-- The overall gain (the "Overall gain" setting of the effect): maximum at the top, minimum at the bottom, double-click puts it back to its default -->
            <Grid Grid.Column="2" DataContext="{Binding OverallGain}" RowDefinitions="Auto,*,Auto,Auto" Width="{StaticResource EqGainColumnWidth}">
                <TextBlock Text="{Binding Maximum}" Classes="muted" FontSize="{StaticResource EqFontSize}" HorizontalAlignment="Center" />
                <Slider Grid.Row="1" Classes="vband" HorizontalAlignment="Center"
                        Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                        Value="{Binding Value}" pages:SliderReset.Value="{Binding ResetValue}" />
                <TextBlock Grid.Row="2" Text="{Binding Minimum}" Classes="muted" FontSize="{StaticResource EqFontSize}" HorizontalAlignment="Center" />
                <pages:NumberText Grid.Row="3" DataContext="{Binding $parent[UserControl].DataContext}" Value="{Binding OverallGainTyped}"
                                  Minimum="{Binding OverallGain.Minimum}" Maximum="{Binding OverallGain.Maximum}" Decimals="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding OverallGainText}" FontSize="{StaticResource EqFontSize}" HorizontalAlignment="Center" />
                </pages:NumberText>
            </Grid>
        </Grid>

        <pages:EmptyListRow Text="No bands: the sound passes unchanged." IsVisible="{Binding !HasBands}" />

        <!-- The selected band's Type, Frequency and Bandwidth (its gain is the slider above) -->
        <StackPanel IsVisible="{Binding HasBands}">
            <vm:EqBandRow DataContext="{Binding Selected}" />
        </StackPanel>

        <WrapPanel Orientation="Horizontal">
            <Button Classes="pill cardaction" Tag="scope" Content="Remove band" Command="{Binding RemoveBandCommand}" Margin="0,0,6,4" VerticalAlignment="Center" />
            <Button Classes="pill cardaction" Tag="scope" Content="Reset defaults" Command="{Binding ResetDefaultsCommand}" Margin="0,0,16,4" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}" Margin="0,0,12,4">
                <TextBlock Text="Grid" VerticalAlignment="Center" />
                <ToggleSwitch FontSize="{StaticResource EqFontSize}" IsChecked="{Binding ShowGrid}" OnContent="On" OffContent="Off" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}" Margin="0,0,12,4">
                <TextBlock Text="Phase" VerticalAlignment="Center" />
                <ToggleSwitch FontSize="{StaticResource EqFontSize}" IsChecked="{Binding ShowPhase}" OnContent="On" OffContent="Off" VerticalAlignment="Center" />
            </StackPanel>
        </WrapPanel>
    </StackPanel>
</UserControl>
