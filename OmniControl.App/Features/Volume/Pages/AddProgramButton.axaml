<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             xmlns:vm="using:OmniControl.App.Features.Volume.Pages"
             x:Class="OmniControl.App.Features.Volume.Pages.AddProgramButton"
             x:DataType="vm:AddProgramMenuViewModel">
    <!-- "Add program..." in the Outputs header: a pop-down list of programs (recently used and installed) with a search box at the top
         and "Browse for a program..." last. Mouse first (AGENTS.md rule 5): the keyboard reaches the button (Enter opens it), the
         search box has it on opening (Enter chooses the first match, Tab walks the rows, Esc closes). The pop-down hangs on a Panel,
         not on the button, so the button's styles do not reach into it. -->
    <Panel x:Name="Holder">
        <FlyoutBase.AttachedFlyout>
            <c:ListMenuFlyout Placement="BottomEdgeAlignedRight" Opened="OnMenuOpened" Closed="OnMenuClosed">
                <StackPanel x:DataType="vm:AddProgramMenuViewModel" KeyDown="OnMenuKeyDown">
                    <TextBox Classes="field search" Text="{Binding Query}" Watermark="Search programs…" Margin="0,0,0,4" />
                    <ScrollViewer MaxHeight="{StaticResource OptionListMaxHeight}" HorizontalScrollBarVisibility="Disabled">
                        <c:MenuRowList ItemsSource="{Binding Rows}" Picked="OnPicked" />
                    </ScrollViewer>
                    <c:MenuRowList x:Name="BrowseRow" />
                </StackPanel>
            </c:ListMenuFlyout>
        </FlyoutBase.AttachedFlyout>
        <Button Tag="grouptool" Classes="pill cardaction main" Content="Add program…" VerticalAlignment="Center" Click="OnOpenClick"
                ToolTip.Tip="Add a program that is not playing yet: one used before, an installed one, or any .exe" />
    </Panel>
</UserControl>
