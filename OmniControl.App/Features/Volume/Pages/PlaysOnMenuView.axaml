<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             xmlns:vm="using:OmniControl.App.Features.Volume.Pages"
             x:Class="OmniControl.App.Features.Volume.Pages.PlaysOnMenuView"
             x:DataType="vm:PlaysOnMenu">
    <!-- The one "Plays on" menu (both tabs: a Wiring cell's menu and a Mixer row's Plays on chip), the content of a FlyoutPresenter.listmenu:
         the shared menu rows (PlaysOnMenu.Rows: one per device, the accent bar at the ones in use when the menu marks them, its tag, greyed
         with its reason where it can't be used; the gate's note). Mouse first (AGENTS.md rule 5): the host closes the menu after a pick
         (Picked) and on Esc. -->
    <c:MenuRowList Title="{Binding Title}" ItemsSource="{Binding Rows}" />
</UserControl>
