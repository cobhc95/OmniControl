<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Features.Volume.Pages"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             x:Class="OmniControl.App.Features.Volume.Pages.MemberLevelView"
             x:DataType="vm:MemberLevelMenu">
    <!-- The pop-down of a combined microphone's member chip (inside a FlyoutPresenter.listmenu): the member's name, its level in the
         mix (the master slider, 0-200 %, double-click resets, wheel and typing from the shared pieces) and Mute (Button.pill, .custom while
         muted). Mouse first (AGENTS.md rule 5). -->
    <StackPanel Spacing="{StaticResource MenuGap}">
        <TextBlock Classes="menutext" Text="{Binding Name}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource MenuGap}" Margin="{StaticResource MenuTextInset}">
            <c:SliderField Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Level}" ResetValue="{Binding ResetValue}"
                           Text="{Binding LevelText}" ValueGap="{StaticResource MenuGap}" ToolTip.Tip="Its level in the mix" />
            <Button Grid.Column="1" Classes="pill" Classes.custom="{Binding Muted}" Content="{Binding MuteText}" Command="{Binding ToggleMuteCommand}"
                    ToolTip.Tip="Leaves it out of the mix" VerticalAlignment="Center" />
        </Grid>
    </StackPanel>
</UserControl>
