<Window Classes="dialog" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="using:OmniControl.App.Features.Volume.Pages.ApoDevices"
        xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
        x:Class="OmniControl.App.Features.Volume.Pages.ApoDevices.ApoDevicesWindow"
        x:DataType="ad:ApoDevicesViewModel"
        Title="Equalizer APO devices" Width="660" Height="460" MinWidth="460" MinHeight="300"
        CanResize="True" WindowStartupLocation="CenterOwner">
    <!-- Title and tag; Device | Status | Action headings; the devices grouped Playback then Recording, each its connector over its device
         name, one status line over one muted detail line, and its Details / Install / Uninstall pills (one shared width), a thin rule
         between rows and the plain confirmation opening under the pressed row; Device Selector's troubleshooting panel for the selected
         installed device; the footer's switch for it and Close. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="12" RowSpacing="8" Grid.IsSharedSizeScope="True">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="title" Text="Equalizer APO devices" VerticalAlignment="Center" />
            <Border Classes="tag" VerticalAlignment="Center">
                <TextBlock Text="{Binding ManagedTag}" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="{StaticResource MenuGap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Actions" />
            </Grid.ColumnDefinitions>
            <Button Classes="menurow" Focusable="False" IsHitTestVisible="False">
                <Grid ColumnSpacing="{StaticResource MenuGap}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Device" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Classes="hint small" Text="Device" />
                    <TextBlock Grid.Column="1" Classes="hint small" Text="Status" />
                </Grid>
            </Button>
            <TextBlock Grid.Column="1" Classes="hint small" Text="Action" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="ad:ApoDeviceHeading">
                        <TextBlock Classes="navheading" Text="{Binding Text}" Margin="8,6,0,2" />
                    </DataTemplate>
                    <DataTemplate DataType="ad:ApoDeviceRow">
                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="{StaticResource MenuGap}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Actions" />
                                </Grid.ColumnDefinitions>
                                <Button Classes="menurow" Classes.chosen="{Binding IsSelected}" Focusable="False" Command="{Binding SelectCommand}">
                                    <Grid ColumnSpacing="{StaticResource MenuGap}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="Device" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Connector}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="hint small" Text="{Binding Device}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Classes.goodtext="{Binding IsGood}"
                                                       Classes.badtext="{Binding IsBad}" Classes.accenttext="{Binding IsWorking}" Classes.muted="{Binding IsPlain}" />
                                            <TextBlock Classes="hint small" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                       IsVisible="{Binding HasDetail}" ToolTip.Tip="{Binding Detail}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Grid Grid.Column="1" ColumnSpacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Act" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Act" />
                                    </Grid.ColumnDefinitions>
                                    <Button Classes="pill cardaction" Content="Details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            IsVisible="{Binding ShowsDetails}" IsEnabled="{Binding CanAct}" Command="{Binding ShowDetailsCommand}"
                                            ToolTip.Tip="The device's record: install modes tried, each check's result, the log" />
                                    <Button Grid.Column="1" Classes="pill cardaction" Content="Install" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            IsVisible="{Binding CanInstall}" IsEnabled="{Binding CanAct}" Command="{Binding ActCommand}" />
                                    <Button Grid.Column="1" Classes="pill cardaction" Content="Uninstall" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                            IsVisible="{Binding CanUninstall}" IsEnabled="{Binding CanAct}" Command="{Binding ActCommand}" />
                                </Grid>
                            </Grid>
                            <Border Classes="pane" Padding="12,8" IsVisible="{Binding IsConfirming}">
                                <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="2">
                                    <TextBlock Classes="strong" Text="{Binding ConfirmTitle}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Classes="hint small" Text="{Binding ConfirmText}" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Grid.RowSpan="2" Classes="pill cardaction" Content="Cancel" Command="{Binding CancelCommand}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Grid.RowSpan="2" Classes="pill cardaction main" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Classes="hrule" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </ScrollViewer>

        <Panel Grid.Row="3">
            <TextBlock Classes="hint" Text="Select an installed device to see its options." IsVisible="{Binding ShowsPick}" Margin="8,0,0,0" />
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4" Margin="8,0,0,0" IsVisible="{Binding ShowsOptions}">
                <TextBlock Text="Pre-mix:" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" Content="Install APO" IsChecked="{Binding InstallPreMix}" />
                <CheckBox Grid.Column="2" Content="Use original APO" IsChecked="{Binding UseOriginalPreMix}" IsEnabled="{Binding CanOriginalPreMix}" />
                <CheckBox Grid.Column="3" Content="Auto:" IsChecked="{Binding AutoAdjust}"
                          ToolTip.Tip="Automatically adjust install mode if problems with current mode are detected" />
                <c:ChipMenu Grid.Column="4" Classes="dropbox" ChipAlignment="Left" Text="{Binding ModeText}" MenuOpened="OnModeMenuOpened" VerticalAlignment="Center">
                    <c:ChipMenu.Menu>
                        <c:MenuRowList />
                    </c:ChipMenu.Menu>
                </c:ChipMenu>
                <TextBlock Grid.Row="1" Text="Post-mix:" VerticalAlignment="Center" IsEnabled="{Binding CanPostMix}" />
                <CheckBox Grid.Row="1" Grid.Column="1" Content="Install APO" IsChecked="{Binding InstallPostMix}" IsEnabled="{Binding CanPostMix}" />
                <CheckBox Grid.Row="1" Grid.Column="2" Content="Use original APO" IsChecked="{Binding UseOriginalPostMix}" IsEnabled="{Binding CanOriginalPostMix}" />
                <CheckBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Content="Allow silent buffer modification" IsChecked="{Binding AllowSilentBuffer}"
                          ToolTip.Tip="Allows to change silent input buffers to audible output buffers, so that delayed audio can be played. CAUTION: Some sound card drivers can produce unwanted sounds when this is enabled." />
            </Grid>
        </Panel>

        <Border Grid.Row="4" Classes="footer">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <CheckBox Content="Troubleshooting options" IsChecked="{Binding Troubleshooting}" />
                <Button Grid.Column="2" Classes="pill" Content="Close" Click="OnCloseClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
