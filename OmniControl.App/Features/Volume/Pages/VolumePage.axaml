<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Features.Volume.Pages"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             xmlns:restore="using:OmniControl.App.Shared.Ui.Restore"
             xmlns:easy="using:OmniControl.App.Features.Volume.Pages.Easy"
             x:Class="OmniControl.App.Features.Volume.Pages.VolumePage"
             x:DataType="vm:VolumePageViewModel">
    <StackPanel Spacing="6">
        <!-- The title line: the page's name and the Easy | Advanced switch (the choice is kept between tabs and runs) -->
        <pages:PageTitleLine Title="{Binding Title}">
            <pages:PageTitleLine.Middle>
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Tag="grouptool" Classes="pill" Classes.custom="{Binding IsEasy}" Content="Easy" Command="{Binding ShowEasyCommand}"
                            ToolTip.Tip="A simple page: the volume, a few sound choices, and guided setup" />
                    <Button Tag="grouptool" Classes="pill" Classes.custom="{Binding IsAdvanced}" Content="Advanced" Command="{Binding ShowAdvancedCommand}"
                            ToolTip.Tip="Every control: the Mixer, Wiring, presets and effects" />
                </StackPanel>
            </pages:PageTitleLine.Middle>
            <pages:PageTitleLine.Right>
                <Panel>
                    <!-- Easy: puts the audio settings back to the defaults (asks first; "Undo" follows on the Easy page's line) -->
                    <Button Tag="grouptool" Classes="pill" Content="Restore defaults"
                            IsVisible="{Binding IsEasy}" Command="{Binding Easy.RestoreDefaultsCommand}" ToolTip.Tip="{Binding Easy.RestoreTip}" ToolTip.ShowOnDisabled="True" />
                    <!-- Advanced: the same audio reset, through the shared Restore defaults control (the Easy view keeps its own button and line) -->
                    <Panel IsVisible="{Binding IsAdvanced}"><restore:RestoreBar DataContext="{Binding Restorer}" /></Panel>
                </Panel>
            </pages:PageTitleLine.Right>
        </pages:PageTitleLine>

        <!-- EASY: the welcome, the Sound screen and the Easy page (new; reads and writes through the Advanced rows and the same services) -->
        <Panel x:Name="EasyHost" IsVisible="{Binding IsEasy}">
            <easy:EasyView DataContext="{Binding Easy}" />
        </Panel>

        <!-- ADVANCED: the Mixer and Wiring tabs -->
        <StackPanel x:Name="CardsHost" Grid.IsSharedSizeScope="True" Spacing="6" IsVisible="{Binding IsAdvanced}">
            <!-- The tabs, and the Volume presets' preset picker at the right (the same control on both tabs, one view-model; the shared Controls/PresetPicker, as on the Mouse and Displays group lines) -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource WiringColumnGap}">
                <pages:PageTabsView DataContext="{Binding Tabs}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource MenuGap}" VerticalAlignment="Center">
                    <!-- Wiring tab only: the cable status and setup action, to the left of the presets, which stay at the same place on both tabs -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource MenuGap}" VerticalAlignment="Center" IsVisible="{Binding ShowsWiring}">
                        <c:TagView DataContext="{Binding CableStatus}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center" />
                        <Button Tag="grouptool" Classes="pill" Content="{Binding CableSetup.Label}" Command="{Binding CableSetup.Command}"
                                ToolTip.Tip="{Binding CableSetup.Tip}" IsVisible="{Binding HasCableSetup}" />
                    </StackPanel>
                    <c:PresetPicker DataContext="{Binding PresetChoice}" />
                </StackPanel>
            </Grid>

            <!-- MIXER: one row per source in columns (docs/mockups/mixer-rows-knobs.html), the small column headings above each group's rows -->
            <StackPanel Spacing="6" IsVisible="{Binding ShowsMixer}">
                <!-- The Outputs header: name and the programs' count (trimmed first when narrow), then "Show closed" and "Add program" -->
                <pages:GroupCard Group="{Binding Outputs}">
                    <pages:GroupCard.Tools>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource MenuGap}" VerticalAlignment="Center" IsVisible="{Binding Outputs.HasProgramTools}">
                            <TextBlock Classes="muted small" Text="Show closed" VerticalAlignment="Center" />
                            <ToggleSwitch Classes="tool plain" Tag="grouptool" IsChecked="{Binding Outputs.ProgramTools.ShowClosed}"
                                          ToolTip.Tip="List remembered programs that are not open. Hidden ones keep their effects and return when opened." />
                            <vm:AddProgramButton DataContext="{Binding Outputs.ProgramTools.Add}" />
                        </StackPanel>
                    </pages:GroupCard.Tools>
                    <StackPanel Spacing="6" x:DataType="vm:VolumeGroup" DataContext="{Binding Outputs}">
                        <vm:MixerHeadings />
                        <ListBox Classes="rows compact" ItemsSource="{Binding Items}" />
                    </StackPanel>
                </pages:GroupCard>

                <pages:GroupCard Group="{Binding Inputs}">
                    <StackPanel Spacing="6" x:DataType="vm:VolumeGroup" DataContext="{Binding Inputs}">
                        <vm:MixerHeadings />
                        <ListBox Classes="rows compact" ItemsSource="{Binding Items}" />
                    </StackPanel>
                </pages:GroupCard>
            </StackPanel>

            <!-- WIRING: where each source plays and the cable it uses (combined devices are rows, "+ Combine ..." in a table header); the cable status sits in the tab row above -->
            <StackPanel Spacing="6" IsVisible="{Binding ShowsWiring}">
                <vm:WiringTable DataContext="{Binding WiringOutputs}" />
                <vm:WiringTable DataContext="{Binding WiringInputs}" />
                <vm:CableTable DataContext="{Binding WiringCables}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
