<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             xmlns:vm="using:OmniControl.App.Features.Volume.Pages"
             x:Class="OmniControl.App.Features.Volume.Pages.RowIcon"
             x:DataType="vm:VolumeRow" VerticalAlignment="Center">
    <!-- A Volume row's icon tile: the program's picture, else a library icon (microphone, combined device), else its initial.
         Each fills the tile's inner square and centres itself in it (sizes and weights in the Border.rowicon styles).
         Shared by the Mixer row, the Wiring row and the combined device card. -->
    <Border Classes="rowicon">
        <Panel>
            <Image Source="{Binding Picture}" IsVisible="{Binding HasPicture}" />
            <c:IconGlyph LibraryId="{Binding Icon}" IsVisible="{Binding HasIcon}" />
            <TextBlock Text="{Binding Initial}" IsVisible="{Binding ShowsInitial}" />
        </Panel>
    </Border>
</UserControl>
