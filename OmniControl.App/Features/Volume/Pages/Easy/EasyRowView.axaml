<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Features.Volume.Pages"
             xmlns:easy="using:OmniControl.App.Features.Volume.Pages.Easy"
             x:Class="OmniControl.App.Features.Volume.Pages.Easy.EasyRowView"
             x:DataType="easy:EasyRow">
    <!-- One app or microphone of the Easy page: icon, name and state ("playing", "not open"), the level (slider and value), Mute and Sound.
         The Sound drawer opens under the line. The row's own VolumeRow is the data of the first four, so Advanced shows the same values. -->
    <StackPanel Spacing="4" Opacity="{Binding Row.RowOpacity}">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" MinWidth="110" MaxWidth="220" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="EasyMute" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="EasySound" />
            </Grid.ColumnDefinitions>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                <vm:RowIcon DataContext="{Binding Row}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                    <TextBlock Classes="strong" Text="{Binding Row.Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Row.Name}" />
                    <WrapPanel Classes="sentence">
                        <TextBlock Text="{Binding State}" Classes="hint small" />
                        <TextBlock Text=" · " Classes="hint small" IsVisible="{Binding Sound.IsActive}" />
                        <TextBlock Text="{Binding Sound.Name}" Classes="accenttext small" IsVisible="{Binding Sound.IsActive}" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
            <vm:VolumeSlider Grid.Column="1" DataContext="{Binding Row}" />
            <Button Grid.Column="2" Tag="grouptool" Classes="scope mute" Classes.on="{Binding Row.Muted}" Content="M" Command="{Binding Row.ToggleMuteCommand}"
                    ToolTip.Tip="Mute" VerticalAlignment="Center" />
            <easy:SoundChip Grid.Column="3" ToolTip.Tip="Presets and five sliders for this one" VerticalAlignment="Center" />
        </Grid>
        <easy:EasyDrawerView IsVisible="{Binding Sound.IsOpen}" Margin="30,2,0,4" />
    </StackPanel>
</UserControl>
