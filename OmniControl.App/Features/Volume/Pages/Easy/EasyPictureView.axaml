<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:easy="using:OmniControl.App.Features.Volume.Pages.Easy"
             xmlns:col="using:System.Collections"
             x:Class="OmniControl.App.Features.Volume.Pages.Easy.EasyPictureView"
             x:DataType="col:IEnumerable">
    <!-- A tiny flow picture ("All apps → One EQ → Speakers"): its DataContext is the list of PictureStep. Green = Equalizer APO, accent =
         OmniControl's own engine. Used by the goal cards and by the setup screens, so every picture is drawn alike. -->
    <ItemsControl ItemsSource="{Binding}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="easy:PictureStep">
                <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,0,3,3">
                    <TextBlock Text="→" Classes="muted small" VerticalAlignment="Center" IsVisible="{Binding ArrowBefore}" />
                    <Border Classes="tag" Classes.good="{Binding IsApo}" Classes.selected="{Binding IsOwn}">
                        <TextBlock Text="{Binding Text}" />
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
