<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:easy="using:OmniControl.App.Features.Volume.Pages.Easy"
             x:Class="OmniControl.App.Features.Volume.Pages.Easy.EasyDrawerView"
             x:DataType="easy:EasyRow">
    <!-- The Sound drawer of a row (the master's, a program's or a microphone's): when its sound cannot be applied, one line says why with the
         step that fixes it; then the chips, curve and five sliders (greyed in that case); the engine's own short status; "More controls"
         opens the full effects window of the row. -->
    <StackPanel Spacing="{StaticResource Gap}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource GapLarge}" IsVisible="{Binding !Sound.Availability.IsAvailable}">
            <TextBlock Classes="hint" Text="{Binding Sound.Availability.Reason}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Tag="grouptool" Classes="pill" IsVisible="{Binding Row.HasFix}" Command="{Binding Row.Fix.Command}"
                    Content="{Binding Row.Fix.Label}" ToolTip.Tip="{Binding Row.Fix.Tip}" VerticalAlignment="Center" />
        </Grid>
        <easy:EasySoundView DataContext="{Binding Sound}" ShowsChips="False" />
        <TextBlock Classes="hint small" Text="{Binding Sound.Note}" IsVisible="{Binding Sound.HasNote}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource GapLarge}">
            <TextBlock Classes="hint small" Text="{Binding Row.Status}" IsVisible="{Binding Row.ShowsStatus}" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Row.EngineLine}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Tag="grouptool" Classes="link" Command="{Binding Sound.OpenFullCommand}" VerticalAlignment="Center">
                <TextBlock Text="More controls…" />
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
