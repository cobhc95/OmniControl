<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             xmlns:vm="using:OmniControl.App.Features.Volume.Pages"
             xmlns:easy="using:OmniControl.App.Features.Volume.Pages.Easy"
             x:Class="OmniControl.App.Features.Volume.Pages.Easy.EasyPageView"
             x:DataType="easy:EasyViewModel">
    <!-- The Easy page (docs/mockups/easy-mode.html section 5): the "Everything" card (big master level, Mute, Sound drawer), one card with the
         apps and microphones and "Add program", and the footer (what is set up, Set up again, Fix it). No cables, methods or wiring here. -->
    <StackPanel Spacing="{StaticResource Gap}" Grid.IsSharedSizeScope="True">
        <pages:GroupCard Group="{Binding EverythingGroup}">
            <pages:GroupCard.ContentTemplate><DataTemplate x:DataType="easy:EasyViewModel">
                <StackPanel Spacing="{StaticResource Gap}" Margin="0,4">
                    <Grid ColumnSpacing="{StaticResource GapLarge}" DataContext="{Binding Master}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="EasyMute" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="EasySound" />
                        </Grid.ColumnDefinitions>
                        <c:SliderField DataContext="{Binding Row}" Minimum="0" Maximum="100" Value="{Binding Volume}" ResetValue="100"
                                       Text="{Binding Volume}" ValueMinWidth="28" ToolTip.Tip="{Binding VolumeTip}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Tag="grouptool" Classes="scope mute" Classes.on="{Binding Row.Muted}" Content="M" Command="{Binding Row.ToggleMuteCommand}"
                                ToolTip.Tip="Mute" VerticalAlignment="Center" />
                        <easy:SoundChip Grid.Column="2" ToolTip.Tip="Presets and five sliders for everything" VerticalAlignment="Center" />
                    </Grid>
                    <pages:CardLayout IsVisible="{Binding Master.Sound.IsOpen}">
                        <DataTemplate x:DataType="easy:EasyViewModel"><easy:EasyDrawerView DataContext="{Binding Master}" /></DataTemplate>
                    </pages:CardLayout>
                </StackPanel>
            </DataTemplate></pages:GroupCard.ContentTemplate>
        </pages:GroupCard>

        <pages:GroupCard Group="{Binding AppsGroup}">
            <pages:GroupCard.Tools>
                <vm:AddProgramButton DataContext="{Binding AddProgram}" />
            </pages:GroupCard.Tools>
            <pages:GroupCard.ContentTemplate><DataTemplate x:DataType="easy:EasyViewModel">
                <StackPanel Spacing="{StaticResource Gap}" Margin="0,4">
                    <pages:EmptyListRow Text="Nothing is playing. Apps appear here when they do." IsVisible="{Binding !HasApps}" />
                    <ItemsControl ItemsSource="{Binding Apps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="{StaticResource Gap}" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="easy:EasyRow">
                                <easy:EasyRowView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DataTemplate></pages:GroupCard.ContentTemplate>
        </pages:GroupCard>

        <!-- The footer: what is set up on the left; Set up again and Fix it on the right (it wraps when the window is narrow) -->
        <WrapPanel Classes="toolbar">
            <Border Classes="tag good" IsVisible="{Binding IsSetUp}" VerticalAlignment="Center"><TextBlock Text="Set up" /></Border>
            <Border Classes="tag" IsVisible="{Binding !IsSetUp}" VerticalAlignment="Center"><TextBlock Text="Not set up yet" /></Border>
            <TextBlock Text="{Binding SetUpText}" Classes="muted small" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Tag="grouptool" Classes="pill" Content="Set up again" Command="{Binding SetUpAgainCommand}" />
            <Button Tag="grouptool" Classes="pill" Content="Something not working? Fix it" Command="{Binding FixItCommand}"
                    ToolTip.Tip="Checks the rows above and starts the step that is missing, or says what to do" />
        </WrapPanel>
        <TextBlock Classes="hint small" Text="{Binding FixNote}" IsVisible="{Binding HasFixNote}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
