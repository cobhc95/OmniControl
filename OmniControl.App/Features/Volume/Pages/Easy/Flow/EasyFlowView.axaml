<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             xmlns:vm="using:OmniControl.App.Features.Volume.Pages"
             xmlns:easy="using:OmniControl.App.Features.Volume.Pages.Easy"
             xmlns:flow="using:OmniControl.App.Features.Volume.Pages.Easy.Flow"
             x:Class="OmniControl.App.Features.Volume.Pages.Easy.Flow.EasyFlowView"
             x:DataType="flow:EasyFlowViewModel">
    <!-- One goal's guided setup, a small window-like page inside the Easy host: a progress strip (Goal · questions · Engine · Setup · Done, ticking as
         it goes), then the screen of the current step. Question screens ask (a ticked list, look chips, a name, or the Sound drawer); the
         Setup screen is a checklist that ticks by itself; "All set" says what was done. Back and Next under every screen but the last. -->
    <UserControl.Resources>
        <!-- One line of a checklist (also the extra lines of the All set screen): the shared line view -->
        <DataTemplate x:Key="CheckLine" x:DataType="flow:EasyCheckItem"><flow:EasyCheckLineView /></DataTemplate>
    </UserControl.Resources>
    <Border Classes="groupPanel">
        <StackPanel Spacing="8" Margin="0,4">
            <ItemsControl ItemsSource="{Binding Strip}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="flow:EasyStripItem">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,6,0">
                            <TextBlock Text="✓" Classes="accenttext small" IsVisible="{Binding IsDone}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" Classes="strong small" Classes.accenttext="{Binding IsCurrent}" Classes.muted="{Binding !IsCurrent}" VerticalAlignment="Center" />
                            <TextBlock Text="·" Classes="muted small" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- A question screen -->
            <StackPanel Spacing="6" IsVisible="{Binding IsQuestion}">
                <StackPanel Spacing="6" DataContext="{Binding Question}" x:DataType="flow:EasyQuestionViewModel">
                    <TextBlock Classes="strong" Text="{Binding Prompt}" />
                    <TextBlock Classes="hint" Text="{Binding Hint}" TextWrapping="Wrap" />
                    <Panel IsVisible="{Binding ShowsChoices}"><c:OptionList DataContext="{Binding Choices}" /></Panel>
                    <Panel IsVisible="{Binding ShowsAddProgram}" HorizontalAlignment="Left"><vm:AddProgramButton DataContext="{Binding AddProgram}" /></Panel>
                    <c:ChoiceChips ItemsSource="{Binding Looks}" IsVisible="{Binding ShowsLooks}" />
                    <TextBox Classes="field" IsVisible="{Binding ShowsName}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="{Binding NamePlaceholder}" MaxLength="64" />
                    <Panel IsVisible="{Binding ShowsSound}"><easy:EasySoundView DataContext="{Binding Sound}" /></Panel>
                    <TextBlock Classes="hint small" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <!-- The Engine step: two cards (the master option card look, selected = accent edge); a way the goal does not offer is greyed with its
                 reason in place of its facts line; the "Get" button sits under its card and greys once the way is installed -->
            <StackPanel Spacing="6" IsVisible="{Binding IsEngine}">
                <TextBlock Classes="strong" Text="{Binding EnginePrompt}" />
                <TextBlock Classes="hint" Text="{Binding EngineHint}" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding EngineCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="flow:EasyEngineItem">
                            <StackPanel Spacing="4" Margin="0,0,6,0">
                                <Button Tag="grouptool" Classes="optioncard" Classes.selected="{Binding IsSelected}" Command="{Binding PickCommand}"
                                        IsEnabled="{Binding IsAvailable}" VerticalAlignment="Stretch">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="strong" Text="{Binding Name}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Facts}" Classes="hint small" TextWrapping="Wrap" />
                                        <Border Classes="tag" Classes.good="{Binding TagIsGood}" Classes.caution="{Binding TagIsCaution}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Tag}" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                                <Button Tag="grouptool" Classes="pill cardaction" Content="{Binding GetLabel}" Command="{Binding GetCommand}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="hint small" Text="{Binding EngineProblem}" IsVisible="{Binding HasEngineProblem}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- The setup checklist -->
            <StackPanel Spacing="6" IsVisible="{Binding IsSetup}">
                <TextBlock Classes="strong" Text="Setting it up" />
                <ItemsControl ItemsSource="{Binding Pictures}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="flow:EasyPictureRow">
                            <easy:EasyPictureView DataContext="{Binding Steps}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource CheckLine}" />
            </StackPanel>

            <!-- All set -->
            <StackPanel Spacing="6" IsVisible="{Binding IsDone}">
                <TextBlock Classes="strong" Text="{Binding DoneHeadline}" />
                <ItemsControl ItemsSource="{Binding DoneLines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Extras}" ItemTemplate="{StaticResource CheckLine}" />
            </StackPanel>

            <TextBlock Classes="hint small" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" />
            <TextBlock Classes="hint small" Text="{Binding StuckNote}" IsVisible="{Binding HasStuckNote}" TextWrapping="Wrap" />

            <!-- Inside a run of several goals, "Continue with the next goal" leaves one that cannot be finished (nothing more is applied for it) -->
            <WrapPanel IsVisible="{Binding !IsDone}">
                <Button Tag="grouptool" Classes="pill" Content="Back" Command="{Binding BackCommand}" Margin="0,0,6,0" />
                <Button Tag="grouptool" Classes="pill" Content="{Binding SkipLabel}" Command="{Binding SkipGoalCommand}" IsVisible="{Binding IsSequence}" Margin="0,0,6,0" />
                <Button Tag="grouptool" Classes="usebtn scope" Content="Next" Command="{Binding NextCommand}" ToolTip.Tip="{Binding NextTip}" />
            </WrapPanel>
            <WrapPanel IsVisible="{Binding IsDone}">
                <Button Tag="grouptool" Classes="pill" Content="Set up something else" Command="{Binding SetUpSomethingElseCommand}" IsVisible="{Binding !IsSequence}" Margin="0,0,6,0" />
                <Button Tag="grouptool" Classes="usebtn scope" Content="Next goal" Command="{Binding NextGoalCommand}" IsVisible="{Binding HasNextGoal}" />
                <Button Tag="grouptool" Classes="usebtn scope" Content="Go to Volume" Command="{Binding GoToVolumeCommand}" IsVisible="{Binding !HasNextGoal}" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
