<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             xmlns:vm="using:OmniControl.App.Features.Volume.Pages"
             x:Class="OmniControl.App.Features.Volume.Pages.MethodButton"
             x:DataType="vm:VolumeRow">
    <!-- A Mixer row's Method chip (docs/mockups/mixer-rows-knobs.html): the method its sound goes through now, coloured
         (Button.selector.method + .apo / .cable / .recording), its tooltip the row's long line. On the master, a program and a microphone it opens the
         Method pop-down: one card per way the effects can run (greyed with the reason where it can't work now; every
         card), the one step that fixes what a greyed card lacks, on the master and a microphone "Equalizer APO devices…" and the VB-CABLE steps
         under a Border.hrule, and a program's recording Test
         with its result. A row with no choice (combined speakers) shows the chip as words only (Border.selector.method). -->
    <FlyoutBase.AttachedFlyout>
        <c:ListMenuFlyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="optionmenu" Opened="OnOpened" Closed="OnClosed">
            <StackPanel x:DataType="vm:VolumeRow" Spacing="{StaticResource Gap}">
                <TextBlock Classes="strong" Text="{Binding RouteChoice.Title}" />
                <ItemsControl ItemsSource="{Binding RouteChoice.Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Spacing="{StaticResource GapSmall}" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:RouteCard">
                            <Button Classes="optioncard" Classes.selected="{Binding IsSelected}" Command="{Binding PickCommand}" IsEnabled="{Binding IsAvailable}"
                                    ToolTip.Tip="{Binding Tip}" ToolTip.ShowOnDisabled="True">
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource MenuGap}">
                                        <TextBlock Classes="strong" Text="{Binding Name}" />
                                        <TextBlock Classes="hint small" Text="{Binding Label}" IsVisible="{Binding HasLabel}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Classes="hint small" Text="{Binding Description}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="pill cardaction" Classes.main="{Binding RouteChoice.Fix.Main}" Content="{Binding RouteChoice.Fix.Label}"
                        Command="{Binding RouteChoice.Fix.Command}" ToolTip.Tip="{Binding RouteChoice.Fix.Tip}" IsVisible="{Binding RouteChoice.HasFix}"
                        HorizontalAlignment="Left" />
                <StackPanel Spacing="{StaticResource Gap}" IsVisible="{Binding RouteChoice.HasSteps}">
                    <Border Classes="hrule" />
                    <ItemsControl ItemsSource="{Binding RouteChoice.Steps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:CardAction">
                                <Button Classes="pill cardaction" Classes.main="{Binding Main}" Content="{Binding Label}" Command="{Binding Command}"
                                        ToolTip.Tip="{Binding Tip}" Margin="0,0,6,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <!-- A program's recording Test: dimmed with the reason while it is not playing; its result beside it -->
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource MenuGap}" IsVisible="{Binding ShowsTest}">
                    <Button Classes="pill cardaction" Content="Test recording" Command="{Binding RunTestCommand}" IsEnabled="{Binding CanRunTest}"
                            ToolTip.Tip="{Binding TestButtonTip}" ToolTip.ShowOnDisabled="True" />
                    <TextBlock Classes="hint small" Text="{Binding TestNote}" IsVisible="{Binding HasTestNote}" ToolTip.Tip="{Binding TestTip}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </c:ListMenuFlyout>
    </FlyoutBase.AttachedFlyout>

    <Panel>
        <Button x:Name="Chip" Tag="scope" Classes="selector method" Classes.apo="{Binding Method.IsApo}" Classes.cable="{Binding Method.IsCable}"
                Classes.risk="{Binding Method.IsRisk}" Classes.recording="{Binding Method.IsRecording}" IsVisible="{Binding HasMethodMenu}" ToolTip.Tip="{Binding EngineLine}"
                ToolTip.ShowOnDisabled="True" Click="OnClick">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource GapSmall}">
                <TextBlock Text="{Binding Method.Label}" />
                <PathIcon Grid.Column="1" Data="{StaticResource ChevronDownIcon}" />
            </Grid>
        </Button>
        <Border Classes="selector method" Classes.apo="{Binding Method.IsApo}" Classes.cable="{Binding Method.IsCable}"
                Classes.risk="{Binding Method.IsRisk}" Classes.recording="{Binding Method.IsRecording}" IsVisible="{Binding !HasMethodMenu}" ToolTip.Tip="{Binding EngineLine}">
            <TextBlock Text="{Binding Method.Label}" />
        </Border>
    </Panel>
</UserControl>
