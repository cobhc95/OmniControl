<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             xmlns:ctl="using:OmniControl.App.Shared.Ui.Controls"
             xmlns:vm="using:OmniControl.App.Features.Volume.Pages"
             x:Class="OmniControl.App.Features.Volume.Pages.VolumeRowView"
             x:DataType="vm:VolumeRow">
    <!-- Every Mixer row (master, program, microphone, combined device; built to docs/mockups/mixer-rows-knobs.html):
         icon | name and its state word | Plays on | Method (its fact line under it) | pan knob | volume knob | mute | FX | remove | meter.
         The Plays on and Method chips share row 1 (one line); the fact line is row 2 under the Method chip; every other cell spans both rows and centres.
         The name and the two pickers share the spare width (trimmed); the knobs, meter, mute, FX and remove keep their sizes in shared
         columns (Mixer*, the same in MixerHeadings), so nothing is squeezed at the narrowest window and every row lines up. Controls are
         declared left to right, which is also the keyboard order (Left/Right walk them; Enter opens a picker or starts turning a knob). -->
    <Grid ColumnSpacing="{StaticResource MixerColumnGap}" Opacity="{Binding RowOpacity}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="MixerIcon" />
            <ColumnDefinition Width="10*" />
            <ColumnDefinition Width="11*" />
            <ColumnDefinition Width="11*" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="MixerPan" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="MixerVolume" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="MixerMute" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="MixerListen" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="MixerFx" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="MixerRemove" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="MixerMeter" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <vm:RowIcon Grid.RowSpan="2" />

        <!-- The name and the small state word under it ("playing", "not open", "default") -->
        <StackPanel Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" MinWidth="0">
            <TextBlock Classes="strong" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
            <TextBlock Classes="muted small" Text="{Binding StateWord}" IsVisible="{Binding HasStateWord}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <vm:PlaysOnButton Grid.Column="2" VerticalAlignment="Top" />

        <!-- The Method chip and the one short fact under it (with its one link: the step that fixes what is missing) -->
        <vm:MethodButton Grid.Column="3" VerticalAlignment="Top" />
        <Grid Grid.Column="3" Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                <TextBlock Classes="muted small" Text="{Binding FactLine}" ToolTip.Tip="{Binding FactTip}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Tag="scope" Classes="link small" IsVisible="{Binding HasFactLink}" Command="{Binding FactLink.Command}"
                        ToolTip.Tip="{Binding FactLink.Tip}">
                    <TextBlock Text="{Binding FactLink.Label}" />
                </Button>
        </Grid>

        <ctl:Knob Grid.Column="4" Grid.RowSpan="2" Minimum="-100" Maximum="100" FromCentre="True" Value="{Binding Pan}" Text="{Binding PanText}"
                  pages:SliderReset.Value="{x:Static vm:VolumeRow.PanReset}" ToolTip.Tip="{Binding PanTip}" IsVisible="{Binding HasPan}" />

        <ctl:Knob Grid.Column="5" Grid.RowSpan="2" Minimum="0" Maximum="100" Value="{Binding Volume}" Text="{Binding Volume}"
                  pages:SliderReset.Value="{x:Static vm:VolumeRow.VolumeReset}" ToolTip.Tip="{Binding VolumeValueTip}" IsVisible="{Binding HasVolume}" />

        <vm:LevelMeter Grid.Column="10" Grid.RowSpan="2" Model="{Binding Meter}" VerticalAlignment="Center" ToolTip.Tip="Level" />

        <Button Grid.Column="6" Grid.RowSpan="2" Tag="scope" Classes="scope mute" Classes.on="{Binding Muted}" Content="M" Command="{Binding ToggleMuteCommand}"
                ToolTip.Tip="Mute" IsVisible="{Binding HasVolume}" />

        <!-- Listen (microphones only, docs/mockups/mic-listen.html): Windows' own "Listen to this device"; click toggles, right-click picks the output -->
        <Button Grid.Column="7" Grid.RowSpan="2" Tag="scope" Classes="scope mute listen" Classes.on="{Binding Listening}" Command="{Binding ToggleListenCommand}"
                ToolTip.Tip="{Binding ListenTip}" IsVisible="{Binding HasListen}" ContextRequested="OnListenContext">
            <Path Classes="glyph" Data="{DynamicResource Icon.headphones}" />
        </Button>

        <!-- FX: lit (Button.pill.glow) while effects run; opens the row's FX window, or closes it when it is open -->
        <Button Grid.Column="8" Grid.RowSpan="2" Tag="scope" Classes="pill" Classes.glow="{Binding FxRuns}" Content="FX" Command="{Binding ToggleWindowCommand}"
                IsVisible="{Binding HasEffects}" ToolTip.Tip="{Binding FxTip}" ToolTip.ShowOnDisabled="True"
                VerticalAlignment="Center" />

        <Button Grid.Column="9" Grid.RowSpan="2" Tag="scope" Classes="removebadge" Command="{Binding RemoveCommand}" IsVisible="{Binding CanForget}"
                ToolTip.Tip="Remove (forgets its settings)" VerticalAlignment="Center">
            <Path Classes="glyph" Data="{StaticResource CrossIcon}" />
        </Button>
    </Grid>
</UserControl>
