<Window Classes="dialog" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OmniControl.App.Features.Volume.Pages"
        xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
        x:Class="OmniControl.App.Features.Volume.Pages.CombineWindow"
        x:DataType="vm:CombineDeviceViewModel"
        Title="{Binding Heading}" Width="460" MinWidth="360" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner">
    <!-- Name, kind (only for a new device opened for either kind), what the kind does, member devices (with a note while too few are
         ticked), the cable it gets or uses, or why a new device can't be made now (with the step that gets
         what is missing; Create is dimmed then), Cancel / Create or Save. Esc = Cancel. -->
    <StackPanel Margin="12" Spacing="10">
        <TextBlock Classes="title" Text="{Binding Heading}" />
        <TextBox x:Name="NameBox" Classes="field" Watermark="Name (e.g. Living room)" Text="{Binding Name}" />
        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowsKind}">
            <Button Classes="pill" Classes.custom="{Binding IsSpeakers}" Content="Speakers" Command="{Binding ChooseSpeakersCommand}"
                          IsEnabled="{Binding CanChooseSpeakers}" ToolTip.Tip="{Binding SpeakersReason}" ToolTip.ShowOnDisabled="True" />
            <Button Classes="pill" Classes.custom="{Binding IsMicrophones}" Content="Microphones" Command="{Binding ChooseMicrophonesCommand}"
                          IsEnabled="{Binding CanChooseMicrophones}" ToolTip.Tip="{Binding MicrophonesReason}" ToolTip.ShowOnDisabled="True" />
        </StackPanel>
        <TextBlock Classes="hint" Text="{Binding Hint}" TextWrapping="Wrap" />
        <TextBlock Classes="hint" Text="{Binding TickNote}" IsVisible="{Binding HasTickNote}" />
        <c:OptionList x:Name="MemberList" DataContext="{Binding Members}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding Cable.Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="pill cardaction" Classes.main="{Binding Cable.Setup.Main}" Content="{Binding Cable.Setup.Label}"
                    Command="{Binding Cable.Setup.Command}" ToolTip.Tip="{Binding Cable.Setup.Tip}" IsVisible="{Binding HasCableSetup}" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="usebtn scope" Tag="scope" Content="{Binding ConfirmText}" IsEnabled="{Binding CanCreate}" Click="OnCreateClick" />
            <Button Classes="primary close" Content="Cancel" Click="OnCancelClick" />
        </StackPanel>
    </StackPanel>
</Window>
