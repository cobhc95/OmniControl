<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Features.Automation.Pages"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             xmlns:hk="using:OmniControl.App.Features.Hotkeys"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             x:Class="OmniControl.App.Features.Automation.Pages.AutomationRuleRow"
             x:DataType="vm:AutomationItem">
    <!-- One rule: its switch, its name and a delete cross on the first line; the sentence of blocks (Styles/Blocks.axaml) on the second;
         its facts as tags (Border.tag) on the third, with the one fix link a tag may need under them. Every block opens the shared picker; a hotkey block opens its capture pop-down (the Popup below). -->
    <!-- A preset's rule also shows its preset kind after the name and, under the sentence, what happens when it ends with the link to the Presets window;
         a feature's rule (From other pages) its page's title and "Made on the <page> page · Open". -->
    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="{StaticResource GapLarge}" Margin="0,2,0,4">
        <ToggleSwitch Classes="plain" IsChecked="{Binding IsOn}" VerticalAlignment="Center" />
        <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Gap}" HorizontalAlignment="Left">
            <TextBox Classes="field" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Watermark="Name" MaxWidth="320" MinWidth="160" />
            <Panel Grid.Column="1" IsVisible="{Binding OriginTag, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center">
                <c:TagView DataContext="{Binding OriginTag}" />
            </Panel>
        </Grid>
        <Button Grid.Column="2" Classes="pill glyph closex" Click="OnDeleteClick" ToolTip.Tip="Delete">
            <Path Classes="glyph" Data="{StaticResource CrossIcon}" />
        </Button>

        <ItemsControl x:Name="SentenceHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Sentence}" Margin="0,4,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.DataTemplates>
                <DataTemplate DataType="pages:SentenceWord">
                    <TextBlock Classes="blockword" Text="{Binding Text}" />
                </DataTemplate>
                <DataTemplate DataType="pages:SentenceBlock">
                    <Button Classes="block" Click="OnBlockClick" ToolTip.Tip="Change it (Enter); Delete removes it">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Text}" />
                            <Button Classes="blockx" Click="OnRemoveClick" ToolTip.Tip="Remove">
                                <Path Classes="glyph" Data="{StaticResource CrossIcon}" />
                            </Button>
                        </StackPanel>
                    </Button>
                </DataTemplate>
                <DataTemplate DataType="pages:SentenceHotkey">
                    <Button Classes="block" Classes.capturing="{Binding Capturing}" Click="OnHotkeyClick" Loaded="OnHotkeyBlockLoaded"
                            ToolTip.Tip="Set the keys; Delete removes it">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}">
                            <TextBlock Text="I press" />
                            <hk:KeycapRow Parts="{Binding Keys}" VerticalAlignment="Center" />
                            <Button Classes="blockx" Click="OnRemoveClick" ToolTip.Tip="Remove">
                                <Path Classes="glyph" Data="{StaticResource CrossIcon}" />
                            </Button>
                        </StackPanel>
                    </Button>
                </DataTemplate>
                <DataTemplate DataType="pages:SentenceLink">
                    <Button Classes="blockjoin" Content="{Binding Text}" ToolTip.Tip="Change how this joins the part before it">
                        <Button.Flyout>
                            <c:ListMenuFlyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel x:DataType="pages:SentenceLink">
                                    <c:MenuRowList ItemsSource="{Binding Rows}" Picked="OnLinkPicked" />
                                    <Border Classes="hrule" Margin="{StaticResource MenuRuleMargin}" IsVisible="{Binding HasAmount}" />
                                    <Grid IsVisible="{Binding HasAmount}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource GapLarge}"
                                          Margin="{StaticResource MenuTextInset}">
                                        <TextBlock Text="{Binding Amount.Label}" Classes="menutext" Margin="0" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" MinWidth="140" Minimum="{Binding Amount.Minimum}" Maximum="{Binding Amount.Maximum}"
                                                Value="{Binding Amount.Value}" pages:SliderReset.Value="{Binding Amount.Standard}" />
                                        <pages:NumberText Grid.Column="2" Classes="plain" Value="{Binding Amount.Value}" Minimum="{Binding Amount.Minimum}"
                                                          Maximum="{Binding Amount.Maximum}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Amount.Text}" Classes="slidervalue" MinWidth="40" />
                                        </pages:NumberText>
                                    </Grid>
                                </StackPanel>
                            </c:ListMenuFlyout>
                        </Button.Flyout>
                    </Button>
                </DataTemplate>
                <DataTemplate DataType="pages:SentenceAdd">
                    <Button Classes="blockadd" Content="{Binding Text}" Click="OnAddClick" />
                </DataTemplate>
            </ItemsControl.DataTemplates>
        </ItemsControl>

        <WrapPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" IsVisible="{Binding HasOrigin}" Margin="0,4,0,0">
            <TextBlock Classes="muted" Text="{Binding OriginWords}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Classes="link small" Command="{Binding OpenOriginCommand}" VerticalAlignment="Center">
                <TextBlock Text="{Binding OriginLink}" />
            </Button>
        </WrapPanel>

        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2">
            <ItemsControl ItemsSource="{Binding Tags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <c:TagView Margin="0,0,4,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- The one fix for "Needs Start with Windows": puts OmniControl in Windows' start-up list, as App settings' switch does. -->
            <Button Classes="link small" Command="{Binding TurnOnStartupCommand}" IsVisible="{Binding NeedsStartup}" HorizontalAlignment="Left"
                    ToolTip.Tip="Adds OmniControl to Windows' start-up list, so &quot;At log in&quot; runs when you sign in.">
                <TextBlock Text="Turn on Start with Windows" />
            </Button>
        </StackPanel>

        <!-- The capture pop-down under the "I press" block (placed on it when the block is drawn): live keycaps of the held keys and
             the dashed slot of the key still to press; the shortcut is saved when the main key is released. Focus stays on the block,
             so the keys reach the row (HotkeyCapture). -->
        <Popup x:Name="CapturePopup" Placement="BottomEdgeAlignedLeft" VerticalOffset="{StaticResource MenuOffset}" IsLightDismissEnabled="False">
            <FlyoutPresenter Classes="capturemenu">
                <StackPanel Spacing="{StaticResource GapLarge}">
                    <Panel>
                        <Border Classes="capturebox" />
                        <hk:KeycapRow Parts="{Binding CaptureKeys}" HorizontalAlignment="Center" Margin="0,14" />
                    </Panel>
                    <TextBlock Classes="menutext" Text="{Binding CaptureNote}" HorizontalAlignment="Center" Margin="0" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}" HorizontalAlignment="Center">
                        <Button Classes="pill cardaction" Content="Clear" Focusable="False" Click="OnCaptureClearClick" />
                        <Button Classes="pill cardaction" Content="Cancel" Focusable="False" Click="OnCaptureCancelClick" />
                    </StackPanel>
                </StackPanel>
            </FlyoutPresenter>
        </Popup>
    </Grid>
</UserControl>
