<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Features.OtherPcs.Pages"
             x:Class="OmniControl.App.Features.OtherPcs.Pages.ReachChecklist"
             x:DataType="vm:ReachHelp">
    <!-- "Can't reach it on this network?" / "Not showing?" (docs/mockups/other-pcs-checklist.html): the title, this PC's live rows and the reminders about the other PC,
         each list under an optional small heading, as the shared Checklist. Shown under an offline paired PC and under the empty list of PCs open to pairing. -->
    <StackPanel x:Name="Root" Spacing="{StaticResource Gap}">
        <TextBlock Classes="strong" Text="{Binding Title}" TextWrapping="Wrap" />
        <TextBlock Classes="hint small" Text="{Binding ThisHeading}" IsVisible="{Binding HasThisHeading}" />
        <vm:Checklist Items="{Binding ThisPc}" />
        <TextBlock Classes="hint small" Text="{Binding OtherHeading}" IsVisible="{Binding HasOtherHeading}" />
        <vm:Checklist Items="{Binding OtherPc}" />
    </StackPanel>
</UserControl>
