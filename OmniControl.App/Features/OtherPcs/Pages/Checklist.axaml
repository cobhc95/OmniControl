<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Features.OtherPcs.Pages"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             xmlns:svc="using:OmniControl.App.Shared.Services"
             x:Class="OmniControl.App.Features.OtherPcs.Pages.Checklist">
    <!-- THE checklist: one row per check with its mark (tick, caution, or a dot for a reminder), words, right-side tag and its one fix. Used by the Pair a PC
         panel, a paired PC's "Set up Tailscale for this PC" stage and "Can't reach it on this network?" (ReachChecklist); Items are CheckItems. -->
    <ItemsControl x:Name="List">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CheckItem">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource Gap}" MinHeight="24">
                    <Panel Width="{StaticResource MenuGlyphSize}" VerticalAlignment="Center">
                        <Path Classes="glyph tickmark" Data="{StaticResource TickIcon}" IsVisible="{Binding IsOk}" />
                        <c:IconGlyph Classes="cautionmark" LibraryId="alert" IsVisible="{Binding IsFailed}" />
                        <Ellipse Classes="pendingdot" IsVisible="{Binding IsPending}" />
                    </Panel>
                    <TextBlock Grid.Column="1" Text="{Binding Words}" TextWrapping="Wrap" ToolTip.Tip="{Binding Tip}" VerticalAlignment="Center" />
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Tags}" VerticalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:TagItem"><c:TagView /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Column="3" Classes="link" Command="{Binding FixCommand}" IsVisible="{Binding FixIsLink}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FixText}" />
                    </Button>
                    <Button Grid.Column="3" Classes="pill" Content="{Binding FixText}" Command="{Binding FixCommand}" IsVisible="{Binding FixIsPill}" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
