<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Features.Settings.Pages"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             xmlns:restore="using:OmniControl.App.Shared.Ui.Restore"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             x:Class="OmniControl.App.Features.Settings.Pages.AppSettingsPage"
             x:DataType="vm:AppSettingsPageViewModel">
    <StackPanel Spacing="{StaticResource Gap}">
        <StackPanel x:Name="CardsHost" Grid.IsSharedSizeScope="True">
            <pages:GroupCard Group="{Binding Appearance}">
                <pages:GroupCard.ContentTemplate><DataTemplate x:DataType="vm:AppSettingsPageViewModel">
                    <ListBox Classes="rows compact cards" ItemsSource="{Binding AppearanceItems}"></ListBox>
                </DataTemplate></pages:GroupCard.ContentTemplate>
            </pages:GroupCard>
            <pages:GroupCard Group="{Binding StartAndClose}">
                <pages:GroupCard.ContentTemplate><DataTemplate x:DataType="vm:AppSettingsPageViewModel">
                    <ListBox Classes="rows compact cards" ItemsSource="{Binding StartItems}"></ListBox>
                </DataTemplate></pages:GroupCard.ContentTemplate>
            </pages:GroupCard>
            <!-- Features: the header's "Ready-made" chip (the shared menu-choice chip) and Turn all on pill; half-width switch cards, then one muted line -->
            <pages:GroupCard Group="{Binding FeatureGroup}">
                <pages:GroupCard.Tools>
                    <c:ChipMenu Text="{Binding ReadyMade.Text}" ChipToolTip="{Binding ReadyMade.Tip}" pages:MenuChoiceLink.Item="{Binding ReadyMade}" VerticalAlignment="Center" />
                    <Button Classes="pill" Tag="grouptool" Content="Turn all on" Command="{Binding TurnAllOnCommand}" VerticalAlignment="Center"
                            ToolTip.Tip="Switch every feature on" />
                </pages:GroupCard.Tools>
                <pages:GroupCard.ContentTemplate><DataTemplate x:DataType="vm:AppSettingsPageViewModel">
                    <StackPanel Spacing="{StaticResource GapSmall}">
                        <ListBox Classes="rows compact cards" ItemsSource="{Binding FeatureItems}"></ListBox>
                        <TextBlock Classes="hint" Text="{Binding FeaturesNote}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate></pages:GroupCard.ContentTemplate>
            </pages:GroupCard>
            <pages:GroupCard Group="{Binding YourData}">
                <pages:GroupCard.ContentTemplate><DataTemplate x:DataType="vm:AppSettingsPageViewModel">
                    <ListBox Classes="rows compact cards" ItemsSource="{Binding DataItems}"></ListBox>
                </DataTemplate></pages:GroupCard.ContentTemplate>
            </pages:GroupCard>
            <pages:GroupCard Group="{Binding PlugIns}" IsVisible="{Binding HasPlugins}">
                <pages:GroupCard.ContentTemplate><DataTemplate x:DataType="vm:AppSettingsPageViewModel">
                    <ListBox Classes="rows compact cards" ItemsSource="{Binding PluginItems}"></ListBox>
                </DataTemplate></pages:GroupCard.ContentTemplate>
            </pages:GroupCard>
            <!-- Updates and about: "Check now" is the pill at the right of the title line (the master group-tool pill) -->
            <pages:GroupCard Group="{Binding UpdatesAndAbout}">
                <pages:GroupCard.Tools>
                    <Button Classes="pill" Tag="grouptool" Content="Check now" Command="{Binding CheckNowCommand}" VerticalAlignment="Center"
                            ToolTip.Tip="Look for a newer version now" />
                </pages:GroupCard.Tools>
                <pages:GroupCard.ContentTemplate><DataTemplate x:DataType="vm:AppSettingsPageViewModel">
                    <ListBox Classes="rows compact cards" ItemsSource="{Binding UpdateItems}"></ListBox>
                </DataTemplate></pages:GroupCard.ContentTemplate>
            </pages:GroupCard>
        </StackPanel>
        <restore:RestoreLine DataContext="{Binding RestoreAll}" HorizontalAlignment="Left" />
        <TextBlock Classes="hint" Text="{Binding StartupNote}" IsVisible="{Binding StartupNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
