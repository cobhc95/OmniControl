<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             xmlns:p="using:OmniControl.App.Features.Settings.Pages"
             x:Class="OmniControl.App.Features.Settings.Pages.AccentEditor"
             x:DataType="p:AccentEditorModel">
    <!-- The accent colour editor (an optionmenu pop-down under the Accent colour gallery, mouse first): THE colour editor with Intensity and its
         muted caption under its sliders; under a thin line, a live preview of accent pieces. Every change is used at once. -->
    <StackPanel Spacing="{StaticResource GapLarge}">
        <c:ColourEditor>
            <c:ColourEditor.Extra>
                <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Gap}" ColumnSpacing="{StaticResource GapLarge}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ColourEditorLabel" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Intensity" VerticalAlignment="Center" ToolTip.Tip="For every accent choice: softer, Windows' own, or stronger" />
                    <c:SliderField Grid.Column="1" Minimum="0" Maximum="{Binding IntensityMax}" Value="{Binding Intensity}" ResetValue="{Binding IntensityReset}" Text="{Binding IntensityText}" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="menutext" TextWrapping="Wrap"
                               Text="How much the colour is lightened on the dark theme and darkened on the light one." />
                </Grid>
            </c:ColourEditor.Extra>
        </c:ColourEditor>
        <Border Classes="hrule" />
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="{StaticResource Gap}" ToolTip.Tip="Preview">
            <Button Classes="primary close" Content="Close" Command="{Binding CloseCommand}" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" Classes="plain" IsChecked="True" Focusable="False" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="tile on" Width="{StaticResource TrayTileHeight}" Focusable="False">
                <c:IconGlyph LibraryId="home" />
            </Button>
            <Button Grid.Column="3" Classes="pill accentline" Content="Open OmniControl" Focusable="False" VerticalAlignment="Center" />
            <Slider Grid.Column="4" Minimum="0" Maximum="100" Value="60" Focusable="False" VerticalAlignment="Center" />
        </Grid>
    </StackPanel>
</UserControl>
