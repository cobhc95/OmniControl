<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:picker="using:OmniControl.App.Features.Hotkeys.Picker"
             xmlns:ctl="using:OmniControl.App.Shared.Ui.Controls"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             xmlns:hk="using:OmniControl.App.Features.Hotkeys"
             x:Class="OmniControl.App.Features.Hotkeys.Picker.PickerMenu"
             x:DataType="picker:PickerModel">
    <!-- Three panes (docs/mockups/action-picker-three-pane.html): sections | entries | settings of the highlighted entry (always shown, live).
         Keyboard focus stays in the search box, or in the focus holder while the keys are in the settings; the lists only show the highlight, which the model moves. -->
    <Grid RowDefinitions="Auto,*,Auto">
        <TextBox x:Name="Search" Classes="field search" Text="{Binding Query}" Watermark="{Binding SearchHint}" Margin="8" ToolTip.Tip="{Binding SearchTip}" />

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,1.3*">
            <!-- Pane 1: the sections (the main window's sidebar look) -->
            <!-- "Only with a hotkey" sits at the foot of the sections of a list of actions (never of triggers, conditions...) -->
            <Border Classes="sidebarpanel" BorderThickness="0,1,1,0" MinWidth="{DynamicResource PickerSectionsMinWidth}">
                <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="14,4,14,8">
                    <CheckBox Content="Only with a hotkey" IsChecked="{Binding OnlyWithKey}" IsVisible="{Binding ShowsKeyFilter}" Focusable="False" />
                    <CheckBox Content="In panel only" IsChecked="{Binding OnlyInPanel}" IsVisible="{Binding HasPanel}" Focusable="False" />
                </StackPanel>
                <ListBox x:Name="SectionList" Classes="nav" Focusable="False" Margin="0,8,4,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding Sections}" SelectedIndex="{Binding SectionHighlight}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="picker:SectionRow">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Data="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" IsVisible="{Binding HasIcon}" />
                                <PathIcon Data="{StaticResource Icon.star}" Width="16" Height="16" VerticalAlignment="Center" IsVisible="{Binding IsFavourites}" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </DockPanel>
            </Border>

            <!-- Pane 2: the entries of the section (or the matches of the search), a small heading above each group -->
            <Border Grid.Column="1" MinWidth="{DynamicResource PickerEntriesMinWidth}" BorderBrush="{DynamicResource BrushDivider}" BorderThickness="0,1,1,0">
                <ListBox x:Name="ActionList" Classes="pick active" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding Actions}" SelectedIndex="{Binding ActionIndex}">
                    <!-- Virtualised: only the rows on screen are made. The model keeps one collection and changes it row by row (ListDiff),
                         never swapping it, so a recycled row always draws the entry it holds now (a swapped list left a ghost row) -->
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <!-- A group heading is its own row: no hover, no highlight, no click -->
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem" x:DataType="picker:PickerRow">
                            <Setter Property="IsHitTestVisible" Value="{Binding !IsHeading}" />
                            <Setter Property="Focusable" Value="{Binding !IsHeading}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="picker:PickerRow">
                            <StackPanel Background="Transparent" ToolTip.Tip="{Binding Unavailable}">
                                <TextBlock Classes="hint small" Text="{Binding Text}" IsVisible="{Binding IsHeading}" Margin="0,4,0,2" />
                                <!-- A greyed entry (Grid.unavailable) says why under its name and cannot be picked -->
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource GapLarge}" IsVisible="{Binding !IsHeading}" Classes.unavailable="{Binding !IsAvailable}">
                                    <!-- The entry's own glyph, else its section's icon -->
                                    <ctl:IconGlyph Source="{Binding Icon}" IsVisible="{Binding HasIcon}" />
                                    <!-- The name takes its room first: the hint and the keycaps follow it on the line, or drop to a second line when it is short of room -->
                                    <WrapPanel Grid.Column="1" ItemSpacing="{StaticResource GapLarge}" LineSpacing="2" VerticalAlignment="Center">
                                        <StackPanel VerticalAlignment="Center" IsVisible="{Binding IsEntry}">
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="hint small" Text="{Binding Unavailable}" IsVisible="{Binding !IsAvailable}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Classes="blockadd small" Content="{Binding Text}" HorizontalAlignment="Left" Focusable="False"
                                                IsVisible="{Binding IsCommand}" Click="OnRowCommandClick" />
                                        <TextBlock Text="{Binding Hint}" Classes="muted small" VerticalAlignment="Center" IsVisible="{Binding ShowsHint}" />
                                        <ctl:RemoteSectionTag Label="{Binding Remote}" />
                                        <Border Classes="tag good" IsVisible="{Binding HasTag}" VerticalAlignment="Center"><TextBlock Text="{Binding Tag}" /></Border>
                                        <!-- A family's directions and their keys in a few words (one line for Up and Down, Next and Previous...) -->
                                        <TextBlock Text="{Binding Summary}" Classes="muted small" VerticalAlignment="Center" IsVisible="{Binding HasSummary}" />
                                        <!-- The entry's keys as keycaps, or a muted "no key" (the Actions and hotkeys window) -->
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Gap}" VerticalAlignment="Center">
                                            <ItemsControl ItemsSource="{Binding Keycaps}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="{StaticResource Gap}" LineSpacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate><hk:KeycapRow Classes="small" Parts="{Binding}" /></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Classes="muted small" Text="no key" IsVisible="{Binding ShowsNoKey}" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <Border Grid.Column="2" Classes="tag selected" IsVisible="{Binding InPanel}" VerticalAlignment="Center"><TextBlock Text="In panel ✓" /></Border>
                                    <!-- The favourite star: filled in the accent when starred, else shown only on the hovered or highlighted row; a click toggles it without picking -->
                                    <Button Grid.Column="3" Classes="pin star" Classes.on="{Binding IsFavourite}" IsVisible="{Binding CanStar}" Focusable="False"
                                            ToolTip.Tip="{Binding StarTip}" Click="OnRowStarClick">
                                        <Path Classes="glyph" Data="{StaticResource Icon.star}" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Pane 3: the highlighted entry's settings -->
            <Border Grid.Column="2" MinWidth="{DynamicResource PickerSettingsMinWidth}" BorderBrush="{DynamicResource BrushDivider}" BorderThickness="0,1,0,0">
                <Grid RowDefinitions="Auto,*" Margin="0,10,0,0">
                    <Border x:Name="SettingsFocus" Width="1" Height="1" Focusable="True" HorizontalAlignment="Left" Opacity="0" />
                    <!-- The title and the entry's favourite star (Up from the first setting reaches it; Enter or Space toggles) -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource GapLarge}" Margin="14,0,14,6">
                        <TextBlock Classes="strong" Text="{Binding SettingsTitle}" HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="TitleStar" Grid.Column="1" Classes="pin star" Classes.on="{Binding ActiveIsFavourite}" IsVisible="{Binding ShowsTitleStar}"
                                ToolTip.Tip="{Binding ActiveStarTip}" Click="OnTitleStarClick">
                            <Path Classes="glyph" Data="{StaticResource Icon.star}" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- The Actions and hotkeys window: the action's keys first, then Run now and Show on its page, then its settings -->
                            <!-- One block for the entry, or one per direction when it is a family (docs/mockups/grouped-actions.html) -->
                            <ItemsControl x:Name="HotkeyPart" ItemsSource="{Binding HotkeyBlocks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><picker:ActionHotkeysView /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ListBox x:Name="OptionList" Classes="pick" Classes.active="{Binding InSettings}" Focusable="False"
                                     ItemsSource="{Binding OptionItems}" SelectedIndex="{Binding OptionIndex}">
                                <!-- Not virtualised: a handful of rows inside the pane's own scroll viewer. A virtualised list reuses the previous
                                     action's rows when the settings are cleared and refilled, and two actions' settings drew on top of each other -->
                                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <!-- One template per kind of row, chosen when the row is built: a recycled row never keeps the other kind's controls -->
                                    <picker:OptionTemplateSelector>
                                        <picker:OptionTemplateSelector.Inline>
                                            <DataTemplate DataType="picker:OptionItem">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinHeight="30" Opacity="{Binding Opacity}" ToolTip.Tip="{Binding Tip}">
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                    <TextBlock Classes="hint small" Text="{Binding Hint}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" />
                                                    <Border Classes="tag caution" IsVisible="{Binding HasTag}" HorizontalAlignment="Left"><TextBlock Text="{Binding Tag}" /></Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Gap}" VerticalAlignment="Center" IsVisible="{Binding IsStepper}" pages:ValueWheel.Selector="True">
                                                    <Button Classes="pill glyph" Tag="-1" Focusable="False" Click="OnOptionStepClick"><Path Classes="glyph" Data="{StaticResource ChevronLeftIcon}" /></Button>
                                                    <Panel MinWidth="100" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Display}" TextAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsTyping}"
                                                                   DoubleTapped="OnNumberDoubleTapped" />
                                                        <TextBox Classes="field" Text="{Binding Typed}" TextAlignment="Center" Width="90" HorizontalAlignment="Center"
                                                                 IsVisible="{Binding IsTyping}" LostFocus="OnNumberLostFocus" />
                                                    </Panel>
                                                    <Button Classes="pill glyph" Tag="1" Focusable="False" Click="OnOptionStepClick"><Path Classes="glyph" Data="{StaticResource ChevronRightIcon}" /></Button>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOn}" OnContent="On" OffContent="Off" Focusable="False"
                                                              IsVisible="{Binding IsToggle}" IsEnabled="{Binding Available}" VerticalAlignment="Center" />
                                            </Grid>
                                            </DataTemplate>
                                        </picker:OptionTemplateSelector.Inline>
                                        <picker:OptionTemplateSelector.Block>
                                            <DataTemplate DataType="picker:OptionItem">
                                            <StackPanel Spacing="{StaticResource GapSmall}" Margin="0,2">
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" IsVisible="{Binding IsLabel}" />
                                                <!-- a group's heading (ActionOption.Heading), as the entries' group headings; its note a muted line under it -->
                                                <TextBlock Classes="hint small strong" Text="{Binding Label}" IsVisible="{Binding IsHeading}" Margin="0,6,0,0" />
                                                <TextBlock Classes="hint small" Text="{Binding Hint}" IsVisible="{Binding HasHeadingNote}" />
                                                <TextBox Classes="field" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" Watermark="{Binding Hint}"
                                                         IsVisible="{Binding IsText}" />
                                                <Border Classes="tag caution" IsVisible="{Binding HasTag}" HorizontalAlignment="Left"><TextBlock Text="{Binding Tag}" TextWrapping="Wrap" /></Border>
                                                <ctl:PathField Text="{Binding Value}" Kind="{Binding PathKind}" Hint="{Binding Hint}" PickerTitle="{Binding PickerTitle}"
                                                               IsVisible="{Binding IsPath}" />
                                                <ctl:PointField Value="{Binding Value}" IsVisible="{Binding IsPoint}" />
                                                <!-- an editor of its own (the power plan editor): its view is picked by its view-model's type (DataTemplates above) -->
                                                <ContentControl Content="{Binding PanelModel}" IsVisible="{Binding IsPanel}" />
                                            </StackPanel>
                                            </DataTemplate>
                                        </picker:OptionTemplateSelector.Block>
                                    </picker:OptionTemplateSelector>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Classes="muted small" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" Margin="14,4" />
                            <StackPanel Margin="14,4,14,8" Spacing="{StaticResource Gap}" IsVisible="{Binding ActiveInPanel}">
                                <TextBlock Classes="muted small" Text="{Binding PanelNote}" TextWrapping="Wrap" />
                                <Button Classes="pill" Content="Remove from panel" HorizontalAlignment="Left" Focusable="False" Click="OnRemoveFromPanelClick" />
                            </StackPanel>
                            <Button Classes="pill" Classes.custom="{Binding OnFootButton}" Content="{Binding FootText}" IsVisible="{Binding HasFootButton}" Focusable="False"
                                    HorizontalAlignment="Left" Margin="14,8,14,8" Click="OnFootButtonClick" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- The foot: the only confirm, "Use for <target>", when a button, gesture or rule step is being given its action; Close in both modes.
             The picker's keys are in the Keyboard shortcuts of the pages that open it (PickerModel.KeyHelp) -->
        <Border Grid.Row="2" Classes="footer">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapLarge}" HorizontalAlignment="Right">
                <Button Classes="scope usebtn" Tag="scope" Content="{Binding UseText}" IsEnabled="{Binding CanUse}" IsVisible="{Binding IsPicking}" Focusable="False" Click="OnUseClick" />
                <Button Classes="primary close" Content="Close" Focusable="False" Click="OnCloseClick" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
