<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:picker="using:OmniControl.App.Features.Hotkeys.Picker"
             xmlns:hk="using:OmniControl.App.Features.Hotkeys"
             x:Class="OmniControl.App.Features.Hotkeys.Picker.ActionHotkeysView"
             x:DataType="picker:ActionHotkeys"
             IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
    <!-- The top of the settings pane in the Actions and hotkeys window (docs/mockups/actions-and-hotkeys.html): "Hotkey" and one shared
         HotkeyBox per key, each with its remove cross and, when the key pressed is another action's, the caution tag "Also on: ..." with
         "Move here"; then "+ add key", "Suggest" and the action's devices; the one sentence of a refused key; then Run now, Show on its page and Change icon…. -->
    <StackPanel Spacing="6" Margin="14,0,14,8">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <TextBlock Text="{Binding Label}" VerticalAlignment="Top" Margin="0,6,0,0" />
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Slots}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="picker:HotkeyKeySlot">
                        <WrapPanel>
                            <hk:HotkeyBox Margin="0,0,6,0" ToolTip.Tip="Double-click or Enter, then press the keys; Backspace removes the key" />
                            <Button Classes="pill glyph closex" Command="{Binding RemoveCommand}" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip.Tip="Remove this key">
                                <Path Classes="glyph" Data="{StaticResource CrossIcon}" />
                            </Button>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding HasConflict}">
                                <Border Classes="tag caution"><TextBlock Text="{Binding Conflict}" /></Border>
                                <Button Classes="link" Content="Move here" Command="{Binding MoveHereCommand}" VerticalAlignment="Center"
                                        ToolTip.Tip="Take this key from the other action and give it to this one" />
                            </StackPanel>
                        </WrapPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        <WrapPanel>
            <Button Classes="blockadd small" Content="+ add key" Command="{Binding AddKeyCommand}" Margin="0,0,6,4" />
            <Button Classes="pill" Content="Suggest" Command="{Binding SuggestCommand}" IsVisible="{Binding CanSuggest}" Margin="0,0,6,4"
                    ToolTip.Tip="{Binding SuggestTip}" />
            <StackPanel IsVisible="{Binding IsLead}"><hk:HotkeyRow DataContext="{Binding Action}" IsVisible="{Binding HasDevices}" Margin="0,0,0,4" /></StackPanel>
        </WrapPanel>
        <TextBlock Classes="cautiontext" Text="{Binding Refusal}" IsVisible="{Binding HasRefusal}" TextWrapping="Wrap" />
        <WrapPanel>
            <Button Classes="pill" Content="Run now" Command="{Binding RunCommand}" Margin="0,0,6,0" ToolTip.Tip="Run this action now" />
            <Button Classes="pill" Content="Show on its page" Command="{Binding ShowCommand}" Margin="0,0,6,0" IsVisible="{Binding IsLead}" />
            <Button Classes="pill" Content="Change icon…" Click="OnChangeIconClick" IsVisible="{Binding IsLead}" ToolTip.Tip="Pick the icon this action shows (the tray panel, the lists)" />
        </WrapPanel>
    </StackPanel>
</UserControl>
