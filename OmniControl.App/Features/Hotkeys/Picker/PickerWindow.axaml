<Window Classes="dialog" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:picker="using:OmniControl.App.Features.Hotkeys.Picker"
        xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
        xmlns:restore="using:OmniControl.App.Shared.Ui.Restore"
        x:Class="OmniControl.App.Features.Hotkeys.Picker.PickerWindow"
        Title="Choose" Width="{DynamicResource PickerWindowWidth}" Height="{DynamicResource PickerWindowHeight}"
        MinWidth="{DynamicResource PickerWindowMinWidth}" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <!-- The Actions and hotkeys window only (docs/mockups/actions-and-hotkeys.html): one thin top bar with its name, the shortcut set
             (the shared preset picker), Clear all and Restore defaults -->
        <Border x:Name="ManageBar" DockPanel.Dock="Top" Classes="barstrip" BorderThickness="0,0,0,1" Padding="12,6" IsVisible="False"
                x:DataType="picker:ActionsWindowService">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Classes="strong" Text="{Binding $parent[Window].Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <!-- docs/mockups/hotkeys-master-switch.html: muted name and a switch with the On/Off words, left of the preset picker -->
                    <StackPanel Orientation="Horizontal" Spacing="6" DataContext="{Binding HotkeysSwitch}"
                                ToolTip.Tip="Off pauses every keyboard hotkey; the keys are kept. Mouse buttons, gestures and rules keep working.">
                        <TextBlock Classes="muted" Text="{Binding Label}" VerticalAlignment="Center" />
                        <ToggleSwitch IsChecked="{Binding IsOn}" OnContent="On" OffContent="Off" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <c:PresetPicker DataContext="{Binding SetChoice}" />
                    <Button Classes="pill" Content="Clear all" Command="{Binding ClearAllCommand}" VerticalAlignment="Center"
                            ToolTip.Tip="Remove every shortcut in the set now in use (it asks first)" />
                    <restore:RestoreBar DataContext="{Binding Restorer}" />
                </StackPanel>
            </Grid>
        </Border>
        <picker:PickerMenu x:Name="Menu" />
    </DockPanel>
</Window>
