<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Features.Osd.Pages"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             x:Class="OmniControl.App.Features.Osd.Pages.OsdPage"
             x:DataType="vm:OsdPageViewModel">
    <StackPanel Spacing="{StaticResource Gap}">
        <StackPanel x:Name="CardsHost" Grid.IsSharedSizeScope="True">
            <ListBox Classes="rows compact cards" ItemsSource="{Binding Primary}"></ListBox>

            <pages:GroupCard Group="{Binding Customize}">
                <pages:GroupCard.ContentTemplate><DataTemplate x:DataType="vm:OsdPageViewModel">
                    <ListBox Classes="rows compact cards" ItemsSource="{Binding Customize.Items}"></ListBox>
                </DataTemplate></pages:GroupCard.ContentTemplate>
            </pages:GroupCard>

            <pages:GroupCard Group="{Binding Elements}">
                <pages:GroupCard.ContentTemplate><DataTemplate x:DataType="vm:OsdPageViewModel">
                    <ListBox Classes="rows compact cards" ItemsSource="{Binding Elements.Items}"></ListBox>
                </DataTemplate></pages:GroupCard.ContentTemplate>
            </pages:GroupCard>

        </StackPanel>
    </StackPanel>
</UserControl>
