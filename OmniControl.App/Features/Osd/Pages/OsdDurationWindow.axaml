<Window Classes="dialog" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OmniControl.App.Features.Osd.Pages"
        xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
        xmlns:osd="using:OmniControl.App.Features.Osd"
        xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
        x:Class="OmniControl.App.Features.Osd.Pages.OsdDurationWindow"
        x:DataType="vm:OsdDurationViewModel"
        Title="OSD duration" Width="420" MinWidth="340" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner">
    <!-- OSD duration (docs/mockups/osd-duration.html): "Everything else" (bold) with its typeable seconds (the page's Duration card, one setting),
         the muted heading, then one row per exception: grip (drag to reorder), the chip choosing "App: ..." or "Event: ..." (the shared ChipMenu and
         its listmenu, filled when it opens), the typeable seconds and the remove cross; "+ add exception" under them; the foot: Close only.
         Every change applies at once. -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="12" RowSpacing="{StaticResource GapLarge}">
        <TextBlock Classes="title" Text="OSD duration" />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource GapLarge}">
            <TextBlock Classes="strong" Text="Everything else" VerticalAlignment="Center" />
            <pages:NumberText Grid.Column="1" Value="{Binding EverythingElse}" Minimum="{x:Static osd:OsdDuration.MinSeconds}" Maximum="{x:Static osd:OsdDuration.MaxSeconds}"
                              Decimals="{x:Static osd:OsdDuration.Decimals}" VerticalAlignment="Center" ToolTip.Tip="How long a pop-up stays when no exception matches it">
                <TextBlock Classes="muted" Text="{Binding EverythingElseText}" MinWidth="{StaticResource SliderValueMinWidth}" TextAlignment="Right" />
            </pages:NumberText>
        </Grid>
        <TextBlock Grid.Row="2" Classes="navheading" Text="EXCEPTIONS · first match wins" Margin="0,4,0,0" />
        <Panel Grid.Row="3">
            <pages:EmptyListRow Text="No exceptions: every pop-up stays for the time above." IsVisible="{Binding HasNoRows}" />
            <ListBox x:Name="ExceptionRows" Classes="rows compact" ItemsSource="{Binding Rows}" IsVisible="{Binding !HasNoRows}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:OsdDurationRowItem">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="{StaticResource GapLarge}">
                            <PathIcon Classes="grip" Data="{DynamicResource GripIcon}" VerticalAlignment="Center" ToolTip.Tip="Drag to change the order" />
                            <c:ChipMenu Grid.Column="1" ChipTag="scope" ChipAlignment="Stretch" Text="{Binding Text}" MenuOpened="OnChipMenuOpened"
                                        ChipToolTip="The app that caused the pop-up, or what it shows" VerticalAlignment="Center" />
                            <pages:NumberText Grid.Column="2" Value="{Binding Seconds}" Minimum="{x:Static osd:OsdDuration.MinSeconds}" Maximum="{x:Static osd:OsdDuration.MaxSeconds}"
                                              Decimals="{x:Static osd:OsdDuration.Decimals}" VerticalAlignment="Center">
                                <TextBlock Classes="muted" Text="{Binding SecondsText}" MinWidth="{StaticResource SliderValueMinWidth}" TextAlignment="Right" />
                            </pages:NumberText>
                            <Button Grid.Column="3" Tag="scope" Classes="removebadge" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this exception" VerticalAlignment="Center">
                                <Path Classes="glyph" Data="{StaticResource CrossIcon}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Panel>
        <Button Grid.Row="4" Classes="blockadd small" Content="+ add exception" Command="{Binding AddExceptionCommand}" HorizontalAlignment="Left" />
        <Border Grid.Row="5" Classes="footer">
            <Button Classes="primary close" Content="Close" HorizontalAlignment="Right" Click="OnCloseClick" />
        </Border>
    </Grid>
</Window>
