<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="using:OmniControl.App.Features.Resources.Gadget"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             xmlns:p="using:OmniControl.App.Features.Resources.Pages"
             xmlns:s="using:OmniControl.App.Shared.Services"
             x:Class="OmniControl.App.Features.Resources.Gadget.GadgetTabView"
             x:DataType="g:GadgetSettingsModel">
    <!-- The Resources page's Taskbar gadget tab: "Show on taskbar", then the Position and Font cards, then the Ready-made layouts, What it shows,
         Weather, Size and spacing, Numbers and units, Hover details and Clicks group cards. -->
    <StackPanel Spacing="{StaticResource Gap}" Grid.IsSharedSizeScope="True">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource GapLarge}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource MenuGap}" VerticalAlignment="Center">
                <TextBlock Classes="muted" Text="Show on taskbar" VerticalAlignment="Center" />
                <ToggleSwitch Tag="grouptool" IsChecked="{Binding Shown}" OnContent="On" OffContent="Off" VerticalAlignment="Center" />
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" ItemSpacing="{StaticResource GapLarge}" LineSpacing="{StaticResource Gap}">
            <ListBox Classes="rows compact" ItemsSource="{Binding PositionCard}" VerticalAlignment="Center" />
            <!-- A long font name trims in the chip rather than widening the line -->
            <ListBox Classes="rows compact" ItemsSource="{Binding FontCard}" VerticalAlignment="Center" MaxWidth="{StaticResource ChoiceMaxWidth}" />
            </WrapPanel>
        </Grid>

        <StackPanel>
            <pages:GroupCard Group="{Binding LayoutsGroup}">
                <pages:GroupCard.Tools>
                    <c:PresetPicker DataContext="{Binding LayoutChoice}" />
                </pages:GroupCard.Tools>
                <pages:GroupCard.ContentTemplate><DataTemplate x:DataType="g:GadgetSettingsModel">
                    <g:GadgetLayoutsView DataContext="{Binding Gallery}" />
                </DataTemplate></pages:GroupCard.ContentTemplate>
            </pages:GroupCard>

            <pages:GroupCard Group="{Binding ReadingsGroup}">
                <pages:GroupCard.Tools>
                    <c:ChoiceChip DataContext="{Binding LabelChoice}" />
                </pages:GroupCard.Tools>
                <pages:GroupCard.ContentTemplate><DataTemplate x:DataType="g:GadgetSettingsModel">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="{StaticResource MenuGap}" Margin="{StaticResource RowHeadingInset}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GadgetGrip" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GadgetTick" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GadgetLabel" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GadgetIconColour" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GadgetTextColour" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GadgetWarn" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="GadgetColour" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="2" Classes="muted small" Text="Reading" />
                            <TextBlock Grid.Column="3" Classes="muted small" Text="Label" />
                            <TextBlock Grid.Column="4" Classes="muted small" Text="Icon colour" />
                            <TextBlock Grid.Column="5" Classes="muted small" Text="Text colour" />
                            <TextBlock Grid.Column="6" Classes="muted small" Text="Warn at" />
                            <TextBlock Grid.Column="7" Classes="muted small" Text="Warn colour" />
                        </Grid>
                        <ListBox Grid.Row="1" Classes="rows compact" ItemsSource="{Binding Rows}" Loaded="OnRowsLoaded">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="g:GadgetRowItem">
                                    <Grid ColumnSpacing="{StaticResource MenuGap}" Opacity="{Binding Opacity}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="GadgetGrip" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="GadgetTick" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="GadgetLabel" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="GadgetIconColour" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="GadgetTextColour" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="GadgetWarn" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="GadgetColour" />
                                        </Grid.ColumnDefinitions>
                                        <PathIcon Classes="grip" Data="{StaticResource GripIcon}" VerticalAlignment="Center" ToolTip.Tip="Drag to change the order" />
                                        <CheckBox Grid.Column="1" Tag="scope" IsChecked="{Binding Shown}" VerticalAlignment="Center" ToolTip.Tip="Show on the taskbar" />
                                        <!-- Under its name: a temperature's sensor chip (THE sensor chip and menu of the Readings tab), the GPU readings' graphics card chip, the speeds' network adapter chip -->
                                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <c:ChipMenu ChipTag="scope" ChipAlignment="Left" Text="{Binding Sensor.Text}" ChipToolTip="{Binding Sensor.Tip}" IsVisible="{Binding HasSensor}"
                                                        pages:MenuChoiceLink.Title="{x:Static p:SensorMenu.Title}" pages:MenuChoiceLink.Item="{Binding Sensor}" />
                                            <c:ChipMenu ChipTag="scope" ChipAlignment="Left" Text="{Binding Gpu.Text}" ChipToolTip="{Binding Gpu.Tip}" IsVisible="{Binding HasGpu}"
                                                        pages:MenuChoiceLink.Title="{x:Static p:GpuMenu.Title}" pages:MenuChoiceLink.Item="{Binding Gpu}" />
                                            <c:ChipMenu ChipTag="scope" ChipAlignment="Left" Text="{Binding Adapter.Text}" ChipToolTip="{Binding Adapter.Tip}" IsVisible="{Binding HasAdapter}"
                                                        pages:MenuChoiceLink.Title="{x:Static p:NetworkAdapterMenu.ReadingTitle}" pages:MenuChoiceLink.Item="{Binding Adapter}" />
                                        </StackPanel>
                                        <Button Grid.Column="3" Classes="scope" Tag="scope" MinWidth="{StaticResource GadgetLabelWidth}" VerticalAlignment="Center"
                                                MaxWidth="{StaticResource GadgetLabelMaxWidth}" ToolTip.Tip="Edit the label: words and icons, and the gap after it">
                                            <Panel ClipToBounds="True">
                                                <g:GadgetLabelView Label="{Binding Label}" Spacing="2" />
                                                <TextBlock Classes="muted" Text="none" IsVisible="{Binding !HasLabel}" />
                                            </Panel>
                                            <Button.Flyout>
                                                <c:ListMenuFlyout Placement="BottomEdgeAlignedLeft">
                                                    <g:GadgetLabelEditor />
                                                </c:ListMenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                        <c:ChipMenu Grid.Column="4" Classes="dropbox" ChipTag="scope" ChipAlignment="Left" VerticalAlignment="Center" Swatch="{Binding IconSwatch}"
                                                    ChipToolTip="Icon colour: every icon of the label" IsEnabled="{Binding HasIcon}" MenuOpened="OnSwatchMenuOpened">
                                            <c:ChipMenu.Menu>
                                                <c:SwatchList IsMenu="True" ItemsSource="{Binding AllIconColours}" />
                                            </c:ChipMenu.Menu>
                                        </c:ChipMenu>
                                        <c:ChipMenu Grid.Column="5" Classes="dropbox" ChipTag="scope" ChipAlignment="Left" VerticalAlignment="Center" Swatch="{Binding TextSwatch}"
                                                    ChipToolTip="{Binding TextSwatch.Tip, StringFormat='Text colour: {0}'}" MenuOpened="OnSwatchMenuOpened">
                                            <c:ChipMenu.Menu>
                                                <c:SwatchMenu ItemsSource="{Binding TextColours}" EditorText="{x:Static s:AccentService.CustomEditorLabel}" EditorClicked="OnCustomTextColour" />
                                            </c:ChipMenu.Menu>
                                        </c:ChipMenu>
                                        <pages:NumberText Grid.Column="6" Value="{Binding WarnAt}" Minimum="0" Maximum="{Binding WarnMax}" VerticalAlignment="Center"
                                                          Typing="{Binding WarnTyping}" IsVisible="{Binding HasWarn}" ToolTip.Tip="{Binding WarnTip}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource GapSmall}" MinWidth="{StaticResource SliderValueMinWidth}">
                                                <TextBlock Text="{Binding WarnText}" Classes.muted="{Binding IsWarnOff}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding WarnUnit}" IsVisible="{Binding !IsWarnOff}" />
                                            </Grid>
                                        </pages:NumberText>
                                        <c:ChipMenu Grid.Column="7" Classes="dropbox" ChipTag="scope" ChipAlignment="Left" VerticalAlignment="Center" Swatch="{Binding WarnSwatch}"
                                                    ChipToolTip="{Binding WarnSwatch.Tip, StringFormat='Warn colour: {0}'}" IsVisible="{Binding HasWarn}" MenuOpened="OnSwatchMenuOpened">
                                            <c:ChipMenu.Menu>
                                                <c:SwatchList IsMenu="True" ItemsSource="{Binding Colours}" />
                                            </c:ChipMenu.Menu>
                                        </c:ChipMenu>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DataTemplate></pages:GroupCard.ContentTemplate>
            </pages:GroupCard>
            <pages:GroupCard Group="{Binding Weather.Group}">
                <pages:GroupCard.ContentTemplate><DataTemplate x:DataType="g:GadgetSettingsModel">
                    <StackPanel Spacing="{StaticResource GapSmall}">
                        <ListBox Classes="rows compact cards" ItemsSource="{Binding Weather.Group.Items}" />
                        <Border Classes="statusstrip">
                            <TextBlock Classes="statusline" Classes.failed="{Binding Weather.Failed}" Text="{Binding Weather.Status}" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>
                </DataTemplate></pages:GroupCard.ContentTemplate>
            </pages:GroupCard>
            <pages:GroupCard Group="{Binding Display.Layout}">
                <pages:GroupCard.ContentTemplate><DataTemplate x:DataType="g:GadgetSettingsModel">
                    <ListBox Classes="rows compact cards" ItemsSource="{Binding Display.Layout.Items}" />
                </DataTemplate></pages:GroupCard.ContentTemplate>
            </pages:GroupCard>
            <pages:GroupCard Group="{Binding Display.Numbers}">
                <pages:GroupCard.ContentTemplate><DataTemplate x:DataType="g:GadgetSettingsModel">
                    <ListBox Classes="rows compact cards" ItemsSource="{Binding Display.Numbers.Items}" />
                </DataTemplate></pages:GroupCard.ContentTemplate>
            </pages:GroupCard>
            <pages:GroupCard Group="{Binding Hover.Group}">
                <pages:GroupCard.ContentTemplate><DataTemplate x:DataType="g:GadgetSettingsModel">
                    <StackPanel Spacing="{StaticResource GapSmall}">
                        <ListBox Classes="rows compact cards" ItemsSource="{Binding Hover.Group.Items}" />
                        <TextBlock Classes="hint" Text="{Binding Hover.Note}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate></pages:GroupCard.ContentTemplate>
            </pages:GroupCard>
            <pages:GroupCard Group="{Binding Display.Behaviour}">
                <pages:GroupCard.ContentTemplate><DataTemplate x:DataType="g:GadgetSettingsModel">
                    <ListBox Classes="rows compact cards" ItemsSource="{Binding Display.Behaviour.Items}" />
                </DataTemplate></pages:GroupCard.ContentTemplate>
            </pages:GroupCard>
        </StackPanel>
    </StackPanel>
</UserControl>
