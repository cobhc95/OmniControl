<Window Classes="dialog" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:g="using:OmniControl.App.Features.Input.Pages.Gestures"
        xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
        x:Class="OmniControl.App.Features.Input.Pages.Gestures.RuleEditorWindow"
        x:DataType="g:RuleEditorViewModel"
        Title="{Binding Title}" Width="640" MinWidth="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
    <!-- A custom rule: its name, the sentence of blocks (Styles/Blocks.axaml), the Layer and Rate limit cards, what is worth knowing,
         and Test / Copy details / Delete rule / Close. Everything applies at once. -->
    <StackPanel Margin="12" Spacing="10">
        <TextBlock Classes="section" Text="{Binding Title}" Margin="0" />
        <TextBox x:Name="NameBox" Classes="field" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Watermark="Name (optional)" />

        <Border Classes="groupPanel" Padding="8,8,8,2">
            <ItemsControl x:Name="SentenceHost" ItemsSource="{Binding Sentence}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="pages:SentenceWord">
                        <TextBlock Classes="blockword" Text="{Binding Text}" />
                    </DataTemplate>
                    <DataTemplate DataType="pages:SentenceBlock">
                        <Button Classes="block" Click="OnBlockClick" ToolTip.Tip="Change it (Enter); Delete removes it">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Text}" />
                                <Button Classes="blockx" Click="OnRemoveClick" ToolTip.Tip="Remove">
                                    <Path Classes="glyph" Data="{StaticResource CrossIcon}" />
                                </Button>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                    <DataTemplate DataType="pages:SentenceJoin">
                        <Button Classes="blockjoin" Content="{Binding Text}" Click="OnJoinClick"
                                ToolTip.Tip="and: all must hold. or: any one is enough." />
                    </DataTemplate>
                    <DataTemplate DataType="pages:SentenceAdd">
                        <Button Classes="blockadd" Content="{Binding Text}" Click="OnAddClick" />
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </Border>

        <ListBox x:Name="SettingsList" Classes="rows compact cards" ItemsSource="{Binding Settings}"></ListBox>

        <ItemsControl ItemsSource="{Binding Notes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Classes="tag" Classes.caution="{Binding IsCaution}" Classes.risk="{Binding IsRisk}" HorizontalAlignment="Left" Margin="0,0,0,4">
                        <TextBlock Text="{Binding Tip}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="{StaticResource GapLarge}">
            <Button Classes="pill cardaction" Content="Test" IsEnabled="{Binding CanTest}" Click="OnTestClick" ToolTip.Tip="Run it once now, at the pointer" />
            <Button Grid.Column="1" Classes="pill cardaction" Content="Copy details" IsVisible="{Binding HasFailure}" Click="OnCopyClick" />
            <Button Grid.Column="2" Classes="pill cardaction" Content="Delete rule" Click="OnDeleteClick" />
            <Button Grid.Column="4" Classes="primary" Content="Close" Click="OnCloseClick" />
        </Grid>
    </StackPanel>
</Window>
