<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gestures="using:OmniControl.App.Features.Input.Pages.Gestures"
             xmlns:ctl="using:OmniControl.App.Shared.Ui.Controls"
             x:Class="OmniControl.App.Features.Input.Pages.Gestures.GestureRow"
             x:DataType="gestures:GestureItem">
    <!-- Half-width card, one line: the switch, the trigger's name (muted while off), a pill with the action (opens the action window)
         and a cogwheel (the apps it works in, and the action's settings). As on the mouse button card, the pill takes the space left
         after the name, so a long action name wraps inside the pill instead of squeezing the name. -->
    <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4" Margin="0,1">
        <ToggleSwitch Classes="plain" IsChecked="{Binding IsOn}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="cardlabel" Classes.muted="{Binding !IsOn}" Text="{Binding Label}" />
        <Button x:Name="Picker" Grid.Column="2" Classes="pill" Classes.custom="{Binding IsOn}" Tag="scope" Click="OnPickerClick">
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" />
        </Button>
        <ctl:ScopeCog x:Name="CogPart" Grid.Column="3" Scope="{Binding Scope}" ShowsSettings="{Binding HasOptions}"
                      CogTip="Which apps this works in, and the action's settings" SettingsClicked="OnCogClick" />
        <Border Grid.Row="1" Grid.ColumnSpan="4" Classes="tag" HorizontalAlignment="Left" IsVisible="{Binding ShowsScopeTag}"
                ToolTip.Tip="This gesture works in different apps than its group">
            <TextBlock Text="{Binding ScopeTagText}" />
        </Border>
    </Grid>
</UserControl>
