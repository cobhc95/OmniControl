<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             xmlns:vm="using:OmniControl.App.Features.Devices.Pages"
             x:Class="OmniControl.App.Features.Devices.Pages.KeepRunningMenu">
    <!-- THE Keep running menu (docs/mockups/emulator-chip.html), one view for both places that show it: setup step 1's "Keep running" chip and
         the Simulation row's emulator chip (right-click). Optional rows at its top (Close now or Start, Show), a thin line, then the three
         choices, the idle minutes, a thin line and Start with Windows. Its rows come from the SimulationViewModel in Bind. -->
    <StackPanel>
        <StackPanel x:Name="ActionPart">
            <c:MenuRowList x:Name="ActionRows" />
            <Border Classes="hrule" Margin="0,4" />
        </StackPanel>
        <c:MenuRowList x:Name="KeepRows" Title="Keep running" />
        <Grid x:Name="IdleRow" x:DataType="vm:SimulationViewModel" ColumnDefinitions="*,Auto" Margin="0,2">
            <TextBlock Classes="menutext" Text="Idle minutes (double-click to type)" VerticalAlignment="Center" />
            <pages:NumberText Grid.Column="1" Value="{Binding IdleMinutes}" Minimum="1" Maximum="1440" VerticalAlignment="Center" Margin="6,0">
                <TextBlock Text="{Binding IdleMinutes}" />
            </pages:NumberText>
        </Grid>
        <Border Classes="hrule" Margin="0,4" />
        <c:MenuRowList x:Name="KeepSwitches" />
    </StackPanel>
</UserControl>
