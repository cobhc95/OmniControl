<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Features.Devices.Pages"
             x:Class="OmniControl.App.Features.Devices.Pages.SetupStage">
    <!-- One numbered set-up stage (docs/mockups/smart-devices-setup-vs-ready.html part 2): a header line (number tag: green when done, caution
         while open and to do, plain otherwise; the title; a tick when done; the muted summary while folded) that opens it, and its body while
         it is the open one, inside Border.stage.open (accent outline). The body keeps the device's data context. -->
    <Border Classes="stage" Classes.open="{Binding Stage.IsOpen, RelativeSource={RelativeSource AncestorType=vm:SetupStage}}">
        <StackPanel Spacing="6">
            <Button Classes="groupHeader" Command="{Binding Stage.OpenCommand, RelativeSource={RelativeSource AncestorType=vm:SetupStage}}" ToolTip.Tip="{Binding Stage.Summary, RelativeSource={RelativeSource AncestorType=vm:SetupStage}}">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6">
                    <Border Classes="tag" Classes.good="{Binding Stage.IsDone, RelativeSource={RelativeSource AncestorType=vm:SetupStage}}" Classes.caution="{Binding Stage.IsCurrent, RelativeSource={RelativeSource AncestorType=vm:SetupStage}}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Stage.NumberText, RelativeSource={RelativeSource AncestorType=vm:SetupStage}}" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Stage.Title, RelativeSource={RelativeSource AncestorType=vm:SetupStage}}" VerticalAlignment="Center" />
                    <Path Grid.Column="2" Classes="glyph tickmark" Data="{StaticResource TickIcon}" IsVisible="{Binding Stage.IsDone, RelativeSource={RelativeSource AncestorType=vm:SetupStage}}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Classes="hint small" Text="{Binding Stage.Summary, RelativeSource={RelativeSource AncestorType=vm:SetupStage}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               IsVisible="{Binding !Stage.IsOpen, RelativeSource={RelativeSource AncestorType=vm:SetupStage}}" />
                </Grid>
            </Button>
            <ContentPresenter Content="{Binding Body, RelativeSource={RelativeSource AncestorType=vm:SetupStage}}" IsVisible="{Binding Stage.IsOpen, RelativeSource={RelativeSource AncestorType=vm:SetupStage}}" />
        </StackPanel>
    </Border>
</UserControl>
