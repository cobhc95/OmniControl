<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             xmlns:vm="using:OmniControl.App.Features.Devices.Pages"
             xmlns:pages="using:OmniControl.App.Shared.Ui.Pages"
             x:Class="OmniControl.App.Features.Devices.Pages.SimulationSteps"
             x:DataType="vm:SimulationViewModel">
    <!-- The set-up's stage 3 "Steps" (docs/mockups/devices-simulation.html section 2, inside smart-devices-setup-vs-ready.html): Start recording,
         then the steps as an editable sentence list: grip, number, "Wait for" [block] "- tap it" (wrapping), Re-pick, Test and a remove cross;
         the reason a step failed or what it still needs on a line under it. Click a block to edit it; Delete or the cross removes it,
         right-click opens Copy, Cut, Paste below, Duplicate and Delete; drag the grip to reorder. "+ add step" lists the step kinds. A failed
         step is outlined red (Border.steprow.failed). The last Tap is the device's switch. -->
    <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Classes="hint small" TextWrapping="Wrap" Text="{Binding Help}" IsVisible="{Binding HasHelp}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="pill" Content="{Binding RecordLabel}" Command="{Binding RecordCommand}" ToolTip.ShowOnDisabled="True"
                        ToolTip.Tip="{Binding RecordTip}" />
            </Grid>

            <ListBox x:Name="StepList" Classes="rows compact" SelectionMode="Multiple" ItemsSource="{Binding Rows}" IsVisible="{Binding HasSteps}" KeyDown="OnStepKeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SimStepItem">
                        <Border Classes="steprow" Classes.failed="{Binding IsFailed}">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                <PathIcon Classes="grip" Data="{DynamicResource GripIcon}" VerticalAlignment="Center" ToolTip.Tip="Drag to reorder" />
                                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding NumberText}" VerticalAlignment="Center" />
                                <WrapPanel Grid.Column="2" ItemSpacing="6" LineSpacing="4" VerticalAlignment="Center">
                                    <TextBlock Classes="blockword" Text="{Binding Lead}" VerticalAlignment="Center" />
                                    <Button Classes="block" ToolTip.Tip="Change it. Right-click for more; Delete removes the step.">
                                        <Button.Flyout>
                                            <c:ListMenuFlyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="optionmenu">
                                                <StackPanel x:DataType="vm:SimStepItem" Spacing="6">
                                                    <ItemsControl ItemsSource="{Binding Fields}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:StepFieldItem">
                                                                <StackPanel Spacing="2" Margin="0,0,0,4">
                                                                    <TextBlock Classes="hint small" Text="{Binding Label}" />
                                                                    <TextBox Classes="field" Text="{Binding Value}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Classes="hint small" Text="Pressing Back has nothing to set." IsVisible="{Binding !HasFields}" />
                                                </StackPanel>
                                            </c:ListMenuFlyout>
                                        </Button.Flyout>
                                        <TextBlock Text="{Binding Target}" TextWrapping="Wrap" ToolTip.Tip="{Binding TargetTip}" />
                                    </Button>
                                    <TextBlock Classes="muted" Text="{Binding Tail}" IsVisible="{Binding HasTail}" VerticalAlignment="Center" />
                                </WrapPanel>
                                <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4" Classes="hint small" Classes.cautiontext="{Binding ShowsCaution}" Text="{Binding Note}"
                                           IsVisible="{Binding HasNote}" TextWrapping="Wrap" />
                                <Button Grid.Column="3" Classes="link small" Command="{Binding RePickCommand}" IsVisible="{Binding CanRePick}" ToolTip.Tip="{Binding RePickTip}">
                                    <TextBlock Text="{Binding RePickText}" />
                                </Button>
                                <Button Grid.Column="4" Classes="link small" Command="{Binding TestCommand}" ToolTip.Tip="Runs only this step on the emulator.">
                                    <TextBlock Text="Test" />
                                </Button>
                                <Button Grid.Column="5" Classes="blockx" Command="{Binding RemoveCommand}" Margin="0" ToolTip.Tip="Remove this step">
                                    <Path Classes="glyph" Data="{StaticResource CrossIcon}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <pages:EmptyListRow IsVisible="{Binding !HasSteps}" Text="No steps yet." LinkText="Start recording" Command="{Binding RecordCommand}" />

            <Button x:Name="AddButton" Classes="blockadd small" Content="+ add step" HorizontalAlignment="Left" Click="OnAddClick" />
            <Border Classes="statusstrip" IsVisible="{Binding IsRecording}">
                <TextBlock Classes="statusline" Text="{x:Static vm:SimulationViewModel.RecordingLine}" />
            </Border>
    </StackPanel>
</UserControl>
