<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.Features.Devices.Pages"
             xmlns:c="using:OmniControl.App.Shared.Ui.Controls"
             xmlns:svc="using:OmniControl.App.Shared.Services"
             x:Class="OmniControl.App.Features.Devices.Pages.DeviceImport"
             x:DataType="vm:DeviceImportViewModel">
    <!-- The body of the "Import from another PC" group (docs/mockups/import-devices.html): per paired PC a sub-heading (its name, a tag online or
         last seen, a muted note) and one full-width row per device (tick, icon, name, the ways it is reached at the right; a device already here is
         dimmed with an "already here" tag); the foot has "Include scripts" (a caution option) and the Import pill. With no PC paired: one sentence
         and a pill to the Other PCs page. -->
    <StackPanel Spacing="8">
        <ItemsControl ItemsSource="{Binding Pcs}" IsVisible="{Binding HasPcs}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ImportPcItem">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="strong" Text="{Binding Name}" VerticalAlignment="Center" />
                            <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="svc:TagItem"><c:TagView /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="muted" Text="{Binding Note}" IsVisible="{Binding HasNote}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <ListBox x:Name="Rows" Classes="pick compact" ItemsSource="{Binding Devices}" KeyDown="OnRowsKeyDown">
                            <ListBox.Styles>
                                <Style Selector="ListBox.pick > ListBoxItem" x:DataType="vm:ImportDeviceItem"><Setter Property="IsEnabled" Value="{Binding CanTick}" /></Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ImportDeviceItem">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{StaticResource MenuGap}" Background="Transparent" Tapped="OnRowTapped">
                                        <Border Classes="tickbox" Classes.checked="{Binding IsChecked}" VerticalAlignment="Center">
                                            <Path Classes="tick" Data="{StaticResource TickIcon}" IsVisible="{Binding IsChecked}" />
                                        </Border>
                                        <c:IconGlyph Grid.Column="1" LibraryId="{Binding Icon}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Classes="muted" Text="{Binding Methods}" VerticalAlignment="Center" />
                                            <ItemsControl ItemsSource="{Binding Tags}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="svc:TagItem"><c:TagView /></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="6" IsVisible="{Binding NoPcs}">
            <TextBlock TextWrapping="Wrap" Text="No other PC is paired yet. Pair the PC that already has your devices, then import them here." />
            <Button Classes="pill" Content="Go to Other PCs" Command="{Binding GoToOtherPcsCommand}" HorizontalAlignment="Left" />
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" IsVisible="{Binding HasPcs}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ToggleSwitch Classes="plain" IsChecked="{Binding IncludeScripts}" VerticalAlignment="Center"
                              ToolTip.Tip="Also copies the command templates you wrote, which the devices use. They run on this PC when a device is switched: turn this on only for a PC you trust." />
                <TextBlock Text="Include scripts" VerticalAlignment="Center" />
                <Border Classes="tag caution" IsVisible="{Binding IncludeScripts}"><TextBlock Text="runs commands" /></Border>
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="hint small" Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="pill accentline" Content="{Binding ImportText}" Command="{Binding ImportCommand}" VerticalAlignment="Center" />
        </Grid>
    </StackPanel>
</UserControl>
