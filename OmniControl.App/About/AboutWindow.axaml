<Window Classes="dialog" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:about="using:OmniControl.App.About"
        x:Class="OmniControl.App.About.AboutWindow"
        x:DataType="about:AboutViewModel"
        Title="About and credits" Width="640" Height="600" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterScreen">
    <!-- OmniControl's notice, then one card per credited project (from NOTICE.txt), then Close. Up/Down walk the cards, Esc closes. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8" Margin="12">
        <TextBlock Classes="title" Text="{Binding Version}" />
        <TextBlock Grid.Row="1" Classes="hint" Text="{Binding Notice}" />
        <ListBox Grid.Row="2" x:Name="CreditList" Classes="rows compact" ItemsSource="{Binding Entries}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="about:CreditCard">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                            <WrapPanel>
                                <TextBlock Classes="strong" Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Border Classes="tag" VerticalAlignment="Center"><TextBlock Text="{Binding Licence}" TextWrapping="Wrap" /></Border>
                            </WrapPanel>
                            <TextBlock Classes="muted" Text="{Binding Version}" TextWrapping="Wrap" />
                            <TextBlock Classes="hint" Text="{Binding Copyright}" />
                            <TextBlock Classes="hint" Text="{Binding UsedFor}" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="pill" Tag="scope" Content="Website" Command="{Binding OpenCommand}"
                                ToolTip.Tip="{Binding Website}" VerticalAlignment="Top" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="3" Classes="primary" Content="Close" HorizontalAlignment="Right" Click="OnCloseClick" />
    </Grid>
</Window>
