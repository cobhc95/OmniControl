<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OmniControl.App.Views.ValueSlider"
             Focusable="True" Height="30" MinWidth="120">
  <Border x:Name="FocusFrame" BorderThickness="2" BorderBrush="Transparent" CornerRadius="6" Padding="4,0">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
      <TextBlock x:Name="LabelText" Grid.Column="0" Classes="row" VerticalAlignment="Center" />
      <Grid x:Name="TrackHost" Grid.Column="1" Background="Transparent" Height="24" VerticalAlignment="Center" MinWidth="60">
        <Border Height="6" CornerRadius="3" Background="{DynamicResource BrushBorder}" VerticalAlignment="Center" />
        <Border x:Name="Fill" Height="6" CornerRadius="3" Background="{DynamicResource BrushAccent}" VerticalAlignment="Center" HorizontalAlignment="Left" />
        <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8" BorderThickness="2"
                BorderBrush="{DynamicResource BrushAccent}" Background="{DynamicResource BrushWhite}"
                VerticalAlignment="Center" HorizontalAlignment="Left" />
      </Grid>
      <TextBox x:Name="ValueBox" Grid.Column="2" Width="52" MinHeight="0" Padding="6,3" FontSize="12"
               TextAlignment="Right" VerticalAlignment="Center" VerticalContentAlignment="Center" />
    </Grid>
  </Border>
</UserControl>
