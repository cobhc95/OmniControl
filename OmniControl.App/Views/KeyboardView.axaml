<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.ViewModels"
             x:Name="Root"
             x:Class="OmniControl.App.Views.KeyboardView"
             x:DataType="vm:KeyboardViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="2">
        <TextBlock Classes="h1" Text="Keyboard" />
        <TextBlock Classes="sub13" Text="Rebind what keys do. Press Change, then press the new key — this does NOT install global hotkeys (see the Hotkeys tab)." TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="mock" Content="Reset to defaults" Command="{Binding ResetCommand}" Padding="12,7"/>
        <Button Classes="dark" Content="Apply" Command="{Binding ChangeRowCommand}" IsEnabled="False" Padding="12,7"/>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10">
        <Border Classes="card" Padding="14">
          <StackPanel Spacing="0">
            <TextBlock Classes="lbl" Margin="0,0,0,6" Text="KEYS &amp; MEDIA KEYS"/>
            <ItemsControl x:Name="KeyRowsList" ItemsSource="{Binding KeyRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KeyRow">
                  <Border Classes="rowline" Padding="0,10">
                    <Grid ColumnDefinitions="170,*,Auto" ColumnSpacing="12">
                      <TextBlock Classes="row" Text="{Binding KeyName}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Border Classes="key" VerticalAlignment="Center">
                          <TextBlock Classes="mono" Text="{Binding KeyText}"/>
                        </Border>
                        <Button Classes="key" VerticalAlignment="Center" Content="{Binding ActionText}" x:CompileBindings="False" Command="{Binding #Root.DataContext.ChangeRowCommand}" CommandParameter="{Binding}" ToolTip.Tip="Click to cycle this action"/>
                      </StackPanel>
                      <Button Grid.Column="2" Classes="mini" Content="Change" VerticalAlignment="Center" x:CompileBindings="False" Command="{Binding #Root.DataContext.StartRecCommand}" CommandParameter="{Binding}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="14" IsVisible="{Binding IsRecording}">
          <StackPanel Spacing="8">
            <TextBlock Classes="lbl" Text="{Binding RecordingFor, StringFormat='RECORDING FOR: {0}'}"/>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <Border Background="{DynamicResource BrushWhite}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="2" CornerRadius="7" Padding="12,9" VerticalAlignment="Center">
                <TextBlock Foreground="{DynamicResource BrushAccentDark}" Text="{Binding RecorderText}" HorizontalAlignment="Center"/>
              </Border>
              <Button Grid.Column="1" Classes="mock" Content="Cancel" Command="{Binding CancelCommand}" VerticalAlignment="Center"/>
              <Button Grid.Column="2" Classes="dark" Content="Save" Command="{Binding SaveCommand}" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Classes="sub13" TextWrapping="Wrap" Text="{Binding StatusText}"/>
        <TextBlock Classes="sub13" TextWrapping="Wrap" Text="Binds apply in-app immediately. For global shortcuts that run OmniControl commands anywhere (even outside the app), use the Hotkeys tab."/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
