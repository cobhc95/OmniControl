        xmlns:views="using:OmniControl.App.Views"
        x:Class="OmniControl.App.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="OmniControl"
        Width="820" Height="560" MinWidth="820" MinHeight="560" CanResize="True"
        WindowStartupLocation="CenterScreen">
    <views:ShellView />
</Window>
