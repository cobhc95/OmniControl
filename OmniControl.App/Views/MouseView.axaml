<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniControl.App.ViewModels" xmlns:views="using:OmniControl.App.Views"
             x:Name="Root"
             x:Class="OmniControl.App.Views.MouseView"
             x:DataType="vm:MouseViewModel">
  <UserControl.Styles>
    <Style Selector="views|ValueSlider TextBox#ValueBox"><Setter Property="Width" Value="52"/></Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="230,*" ColumnSpacing="14">
    <Border Classes="card" Padding="14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="mock" Content="Add profile" Command="{Binding AddProfileCommand}" />
            <Button Classes="mock" Content="Delete" Command="{Binding DeleteProfileCommand}" />
          </StackPanel>
          <TextBlock Classes="sub12" FontSize="11" Text="Focus a profile with Tab, Enter to select. New profiles inherit button map." TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Classes="lbl" Text="PROFILES" />
          <ListBox x:Name="ProfilesList" Classes="mon" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" SelectionMode="Single">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MouseProfile">
                <StackPanel>
                  <TextBlock Classes="tt" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="tile" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Classes="card" Padding="14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0">
          <Border Classes="div" />
          <TextBlock Classes="sub12" TextWrapping="Wrap" Text="{Binding StatusText}" />
        </StackPanel>
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Classes="h1" Text="{Binding SelectedProfile.Name, StringFormat='{}{0} profile'}" />
              <TextBlock Classes="sub13" Text="Click a button to change its action · every row is a real button." />
            </StackPanel>
            <Button Grid.Column="1" Classes="dark" Content="Apply" Command="{Binding ApplyCommand}" VerticalAlignment="Center" />
          </Grid>

          <ItemsControl ItemsSource="{Binding ButtonRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MouseButtonRow">
                <Border Classes="rowline" Padding="0,10">
                  <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="12">
                    <TextBlock Classes="row" Text="{Binding ButtonName}" />
                    <TextBlock Grid.Column="1" Classes="sub13" Text="{Binding ActionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Classes="mini" Content="Change" x:CompileBindings="False" Command="{Binding #Root.DataContext.ChangeRowCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="lbl" Margin="0,4,0,0" Text="POINTER SPEED" />
          <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
            <TextBlock Classes="row" Text="Sensitivity" />
            <views:ValueSlider x:Name="SensitivitySlider" Grid.Column="1" Minimum="1" Maximum="11" Value="{Binding Sensitivity}" DefaultValue="7" />
          </Grid>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
