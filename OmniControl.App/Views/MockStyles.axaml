<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource BrushText}"/><Setter Property="FontSize" Value="13"/></Style>
  <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="TextBlock.sub13"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/></Style>
  <Style Selector="TextBlock.sub12"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/></Style>
  <Style Selector="TextBlock.lbl"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="LetterSpacing" Value="0.06"/><Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/></Style>
  <Style Selector="TextBlock.tt"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="TextBlock.tile"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource BrushTextTile}"/><Setter Property="Margin" Value="0,3,0,0"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style Selector="TextBlock.row"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource BrushTextRow}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource BrushTextRow}"/></Style>

  <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource BrushCard}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/></Style>
  <Style Selector="Border.item"><Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,10"/></Style>
  <Style Selector="Border.item.sel"><Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/></Style>
  <Style Selector="Border.div"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{DynamicResource BrushDivider}"/></Style>
  <Style Selector="Border.rowline"><Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style Selector="Border.key"><Setter Property="Background" Value="{DynamicResource BrushKey}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="7,3"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
  <Style Selector="Border.input"><Setter Property="Background" Value="{DynamicResource BrushSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="12,9"/></Style>
  <Style Selector="Border.pill"><Setter Property="CornerRadius" Value="4"/><Setter Property="Padding" Value="6,2"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="Border.chip"><Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="10,6"/></Style>
  <Style Selector="Border.toggle"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="20"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Background" Value="{DynamicResource BrushAccent}"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
  <Style Selector="Border.toggle.off"><Setter Property="Background" Value="{DynamicResource BrushToggleOff}"/></Style>
  <Style Selector="Border.toggle > Ellipse"><Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/><Setter Property="Fill" Value="{DynamicResource BrushWhite}"/><Setter Property="Margin" Value="2"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
  <Style Selector="Border.toggle.off > Ellipse"><Setter Property="HorizontalAlignment" Value="Left"/></Style>

  <Style Selector="ToggleButton.switch"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="20"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Background" Value="{DynamicResource BrushAccent}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="ToggleButton.switch:unchecked"><Setter Property="Background" Value="{DynamicResource BrushToggleOff}"/></Style>
  <Style Selector="ToggleButton.switch /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="0"/></Style>
  <Style Selector="Button.toggleBtn"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>

  <Style Selector="Button.scene"><Setter Property="Background" Value="{DynamicResource BrushBg}"/><Setter Property="Foreground" Value="{DynamicResource BrushText}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="11"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style Selector="Button.scene:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHoverSoft}"/></Style>
  <Style Selector="Button.scene.sel"><Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/></Style>

  <Style Selector="Button.mock"><Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/><Setter Property="Foreground" Value="{DynamicResource BrushText}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="12,7"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="0"/></Style>
  <Style Selector="Button.mini"><Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}"/><Setter Property="Foreground" Value="{DynamicResource BrushText}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="0"/></Style>
  <Style Selector="Button.dark"><Setter Property="Background" Value="{DynamicResource BrushAccent}"/><Setter Property="Foreground" Value="{DynamicResource BrushWhite}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="18,9"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinHeight" Value="0"/></Style>
  <Style Selector="Button.dark:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushDarkHover}"/><Setter Property="Foreground" Value="{DynamicResource BrushWhite}"/></Style>
  <Style Selector="Button.danger"><Setter Property="Background" Value="{DynamicResource BrushDangerBg}"/><Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushDangerBorder}"/></Style>
  <Style Selector="Button.seg"><Setter Property="Background" Value="{DynamicResource BrushSurface}"/><Setter Property="Foreground" Value="{DynamicResource BrushTextRow}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="0"/><Setter Property="Padding" Value="12,7"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="0"/></Style>
  <Style Selector="Button.seg.on"><Setter Property="Background" Value="{DynamicResource BrushAccent}"/><Setter Property="Foreground" Value="{DynamicResource BrushWhite}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>

  <Style Selector="Slider /template/ Thumb"><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Background" Value="{DynamicResource BrushWhite}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/><Setter Property="BorderThickness" Value="2"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style Selector="ProgressBar.bar"><Setter Property="Height" Value="6"/><Setter Property="MinHeight" Value="6"/><Setter Property="Background" Value="{DynamicResource BrushDivider}"/><Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/><Setter Property="CornerRadius" Value="3"/><Setter Property="VerticalAlignment" Value="Center"/></Style>

  <Style Selector="ListBox.mon"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/></Style>
  <Style Selector="ListBox.mon ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="ListBox.mon ListBoxItem /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Padding" Value="12,10"/><Setter Property="CornerRadius" Value="8"/><Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{DynamicResource BrushCard}"/></Style>
  <Style Selector="ListBox.mon ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHoverSoft}"/></Style>
  <Style Selector="ListBox.mon ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushAccentSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="ListBox.log"><Setter Property="Background" Value="{DynamicResource BrushSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style Selector="ListBox.log ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/></Style>
  <Style Selector="ListBox.log TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource BrushTextRow}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style Selector="TextBox.cmd"><Setter Property="Background" Value="{DynamicResource BrushSurface}"/><Setter Property="Foreground" Value="{DynamicResource BrushText}"/><Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="0"/></Style>
</Styles>
