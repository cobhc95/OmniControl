<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hk="using:OmniControl.App.Hotkeys"
             x:Class="OmniControl.App.Hotkeys.HotkeyBox"
             x:DataType="hk:HotkeyTarget">
    <!-- The one hotkey capture box (the Actions and hotkeys window's keys, the preset manager's shortcut column): a double-click (or Enter)
         listens for the keys, previewing the ones held; the shortcut is taken when its main key is released; Esc, leaving the box or a click
         elsewhere stops listening and keeps the old key. The listening look (the pulse) is TextBox.listening in Theme.axaml. Its width is
         HotkeyBoxWidth (App.axaml). -->
    <TextBox Classes="field" IsReadOnly="True" Text="{Binding DisplayText}" Watermark="{Binding HotkeyHint}"
             Classes.listening="{Binding IsListening}" Width="{StaticResource HotkeyBoxWidth}"
             VerticalAlignment="Center"
             DoubleTapped="OnHotkeyDoubleTapped" KeyUp="OnHotkeyKeyUp" LostFocus="OnHotkeyLostFocus" />
</UserControl>
