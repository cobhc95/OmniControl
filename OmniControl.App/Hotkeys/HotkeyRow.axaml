<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hk="using:OmniControl.App.Hotkeys"
             x:Class="OmniControl.App.Hotkeys.HotkeyRow"
             x:DataType="hk:HotkeyAction">
    <Grid ColumnDefinitions="150,190" ColumnSpacing="12">
        <TextBox Classes="field" IsReadOnly="True" Text="{Binding Gesture}" Watermark="{Binding HotkeyHint}"
                 Classes.listening="{Binding IsListening}"
                 VerticalAlignment="Center"
                 DoubleTapped="OnHotkeyDoubleTapped" LostFocus="OnHotkeyLostFocus" />

        <Button Grid.Column="1" Tag="scope" Classes="scope" IsVisible="{Binding HasDevices}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding ScopeSummary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <PathIcon Grid.Column="1" Data="{DynamicResource ChevronDownIcon}" Width="10" Height="10" Margin="8,0,0,0" />
            </Grid>
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft" Opened="OnFlyoutOpened" Closed="OnFlyoutClosed" FlyoutPresenterClasses="scopemenu">
                    <StackPanel x:DataType="hk:HotkeyAction">
                        <ItemsControl ItemsSource="{Binding Chips}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="hk:ScopeChip">
                                    <ToggleButton Classes="menuitem" Content="{Binding Name}" IsChecked="{Binding IsOn}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No devices detected." Classes="muted" Margin="12,8" IsVisible="{Binding ShowEmptyNote}" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
    </Grid>
</UserControl>
