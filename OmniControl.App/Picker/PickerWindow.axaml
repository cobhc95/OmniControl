<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:picker="using:OmniControl.App.Picker"
        x:Class="OmniControl.App.Picker.PickerWindow"
        Title="Choose" Width="640" Height="520" MinWidth="460" MinHeight="360"
        Background="{DynamicResource BrushBackground}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <picker:PickerMenu x:Name="Menu" />
</Window>
