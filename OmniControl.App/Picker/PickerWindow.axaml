<Window Classes="dialog" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:picker="using:OmniControl.App.Picker"
        x:Class="OmniControl.App.Picker.PickerWindow"
        Title="Choose" Width="880" Height="560" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <picker:PickerMenu x:Name="Menu" />
</Window>
