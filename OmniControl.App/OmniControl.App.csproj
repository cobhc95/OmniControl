<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>OmniControl.App</RootNamespace>
    <AssemblyName>OmniControl</AssemblyName>
    <Version>0.3.2</Version>
    <ApplicationIcon>Assets\OmniControl.ico</ApplicationIcon>
    <!-- No profile-guided tier: it re-compiles hot code (the pop-up, the hooks) a second time, with slower instrumented code in
         between, during the first minutes of use. Plain tiering stays: quick start-up, optimised after 30 calls. -->
    <TieredPGO>false</TieredPGO>
    <!-- Every build carries its own .NET, so the app runs on a PC with nothing installed; the output stays in the standard folder. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <!-- Bindings are compiled (checked at build, no reflection when they run); every view names its x:DataType. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- Download size. Release builds make no pdbs; the rest acts on publish only (tools\release.ps1), a plain build stays untrimmed.
       Cautious trim: unused assemblies are dropped, used ones kept whole (copyused, so run-time bindings and reflection keep working);
       only the Windows SDK projection is trimmed to the members used. COM interop and reflection JSON stay on (trimming turns them off);
       trim warnings are silenced (thousands, about member trimming that is not done). LeaveOutOfPublish = files nothing loads: the
       alternative garbage collectors, HTTP/3, debugger and dump helpers, LibreHardwareMonitor's Linux helpers and symbol files
       (ANGLE is kept for App settings' "Use GPU drawing", Program.cs).
       Precompiled (ReadyToRun, less JIT at start) only ReadyToRunOnly: the app and Avalonia.Base, about 4.8 MB more in the Setup, and
       LibreHardwareMonitorLib (less JIT when its sensors open), 1.3 MB more installed, about 0.5 MB in the Setup.
       Memory: the workstation garbage collector, collecting in the background, told to keep the heap small (ConserveMemory 5 of 9,
       Gen0MaxBudget below). -->
  <PropertyGroup>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <PublishReadyToRun>true</PublishReadyToRun>
    <ReadyToRunOnly>^(OmniControl|Avalonia\.Base|LibreHardwareMonitorLib)$</ReadyToRunOnly>
    <LeaveOutOfPublish>^(clrgc|clrgcexp|msquic|Microsoft\.DiaSymReader\.Native\.amd64|mscordbi|mscordaccore.*|libMonoPosixHelper|MonoPosixHelper)\.dll$|^createdump\.exe$|\.pdb$</LeaveOutOfPublish>
  </PropertyGroup>

  <Target Name="KeepUsedAssembliesWhole" AfterTargets="PrepareForILLink">
    <ItemGroup>
      <ManagedAssemblyToLink Condition="'%(Filename)' != 'Microsoft.Windows.SDK.NET'" TrimMode="copyused" />
    </ItemGroup>
  </Target>

  <Target Name="ReadyToRunOnlyChosen" BeforeTargets="_PrepareForReadyToRunCompilation">
    <ItemGroup>
      <_R2RCandidate Include="@(ResolvedFileToPublish->WithMetadataValue('PostprocessAssembly', 'true'))" />
      <PublishReadyToRunExclude Include="%(_R2RCandidate.Filename)%(_R2RCandidate.Extension)" Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(_R2RCandidate.Filename)', '$(ReadyToRunOnly)'))" />
    </ItemGroup>
  </Target>

  <Target Name="LeaveOutUnusedFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '$(LeaveOutOfPublish)'))" />
    </ItemGroup>
  </Target>

  <Import Project="OptionalFiles.targets" />

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <!-- At most 6 MB allocated between two young collections (a PC with a large CPU cache otherwise gets tens of MB). -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="6291456" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The one credits list (also shown in the About window) and the licence ship inside the app and next to it. -->
    <AvaloniaResource Include="..\NOTICE.txt" Link="Assets\NOTICE.txt" />
    <None Include="..\NOTICE.txt;..\LICENSE" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <!-- Windows Packet Filter's official Windows 10+ x64 driver files, unmodified, with their licence: Setup's optional task and the app's
         "Install Windows Packet Filter…" install them (Core/Engine/Resources/PacketFilterSetup). -->
    <None Include="..\third_party\windows-packet-filter\driver\*" CopyToOutputDirectory="PreserveNewest" Link="windows-packet-filter\%(Filename)%(Extension)" />
    <!-- Equalizer APO's official 1.4.2 x64 installer, unmodified, with its licences: run by Setup's task or the app's "Install Equalizer
         APO…" (Core/Engine/Apo/ApoInstaller, which retypes the folder and file name). -->
    <None Include="..\third_party\equalizer-apo\*" CopyToOutputDirectory="PreserveNewest" Link="equalizer-apo\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Win32" Version="11.3.6" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniControl.Core\OmniControl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The headless tests (tests/OmniControl.Tests) check the route planner and the effects chain, which are internal; the README
         screenshot tool (tools/Screenshots) makes internal view-models with sample data. -->
    <InternalsVisibleTo Include="OmniControl.Tests" />
    <InternalsVisibleTo Include="OmniControl.Screenshots" />
  </ItemGroup>

</Project>
