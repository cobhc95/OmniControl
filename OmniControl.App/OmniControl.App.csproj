<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>OmniControl.App</RootNamespace>
    <AssemblyName>OmniControl</AssemblyName>
    <Version>0.2.1</Version>
    <ApplicationIcon>Assets\OmniControl.ico</ApplicationIcon>
    <!-- No profile-guided tier: it re-compiles hot code (the pop-up, the hooks) a second time, with slower instrumented code in
         between, during the first minutes of use. Plain tiering stays: quick start-up, optimised after 30 calls. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The one credits list (also shown in the About window) and the licence ship inside the app and next to it. -->
    <AvaloniaResource Include="..\NOTICE.txt" Link="Assets\NOTICE.txt" />
    <None Include="..\NOTICE.txt;..\LICENSE" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <!-- Built by native/EqualizerAPO/build.ps1 (OmniControl APO and its two DLLs) and placed by the owner (the unmodified VB-CABLE
         package, the unmodified Equalizer APO installer); all optional, copied next to the app when present. -->
    <None Include="apo\*.dll" CopyToOutputDirectory="PreserveNewest" Link="apo\%(Filename)%(Extension)" />
    <None Include="..\third_party\vbcable\**" Exclude="..\third_party\vbcable\README.md" CopyToOutputDirectory="PreserveNewest" Link="third_party\vbcable\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\third_party\equalizerapo\**" Exclude="..\third_party\equalizerapo\README.md" CopyToOutputDirectory="PreserveNewest" Link="third_party\equalizerapo\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="3.1.512801" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniControl.Core\OmniControl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The headless tests (tests/OmniControl.Tests) check the route planner and the effects chain, which are internal. -->
    <InternalsVisibleTo Include="OmniControl.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <!-- The hidden screenshot export (docs: HANDOVER.md, developer section) is a Debug-only tool: none of it is compiled into a release. -->
    <Compile Remove="Showcase\**" />
  </ItemGroup>

</Project>
