<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- MASTER designs of a table window (the Volume page's setup table) and of a round number: Border.badge (accent filled = the live
         setup, on the Sound mode button and the table's current row; .quiet = outlined), Border.tablegroup (a group header band),
         Button.tablerow (a clickable row: a divider under it, hover tint, .current = "you are here", disabled = greyed with its reason in
         the tooltip), TextBlock.cautiontext (a caution fact in words). Sizes in App.axaml (Badge*, Table*). Included after Theme.axaml. -->
    <!-- Badge: a small round number. Filled in the accent = the live setup (the Sound mode button, the table's current row); .quiet = outlined. -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource BadgeRadius}" />
        <Setter Property="MinWidth" Value="{DynamicResource BadgeSize}" />
        <Setter Property="Height" Value="{DynamicResource BadgeSize}" />
        <Setter Property="Padding" Value="3,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrushBackground}" />
        <Setter Property="FontSize" Value="{DynamicResource BadgeFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge.quiet">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushHoverEdge}" />
    </Style>
    <Style Selector="Border.badge.quiet > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
    </Style>

    <!-- A table window (the setup table): group header bands, and rows that can be clicked; .current = "you are here" -->
    <Style Selector="Border.tablegroup">
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
        <Setter Property="Padding" Value="{DynamicResource TableCellPadding}" />
    </Style>
    <Style Selector="Button.tablerow">
        <Setter Property="Padding" Value="{DynamicResource TableCellPadding}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.tablerow /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Button.tablerow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
    </Style>
    <Style Selector="Button.tablerow.current /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentEdge}" />
    </Style>
    <Style Selector="Button.tablerow:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.tablerow:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.tablerow.current:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
    </Style>
    <!-- A caution fact said in words (the setup table's limited master effects), the tags' caution colour -->
    <Style Selector="TextBlock.cautiontext"><Setter Property="Foreground" Value="{DynamicResource BrushCaution}" /></Style>
</Styles>
