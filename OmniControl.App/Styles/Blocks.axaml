<Styles xmlns="https://github.com/avaloniaui"
        xmlns:c="using:OmniControl.App.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- MASTER designs of a sentence made of blocks (the custom rule editor: "If [right click] [over the taskbar] [and] [Ctrl held] [+], then [...] [+]").
         Included after Theme.axaml (which is near its 700-line limit), so these win over its general button hover; Menus.axaml follows.
           Button.block      one picked part of the sentence: a tinted rounded block; click changes it. Holds its text and a Button.blockx.
           Button.blockx     the small cross inside a block that removes it (mouse only; Delete does the same from the keyboard)
           Button.blockjoin  the word between parts that can be flipped ("and" / "or")
           Button.blockadd   a dashed outline that adds a part ("+ condition", "+ then", or an empty slot to fill)
         The border is always 1 px, so hover and keyboard focus only change colours and never move the text. -->
    <Style Selector="Button.block, Button.blockjoin, Button.blockadd">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.block /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.block:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentEdge}" />
    </Style>
    <Style Selector="Button.block:focus-visible /template/ ContentPresenter#PART_ContentPresenter, Button.block:focus-visible:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.block TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxWidth" Value="{DynamicResource SentenceLinkMaxWidth}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.blockx">
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="6,0,-4,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.blockx /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
    </Style>
    <Style Selector="Button.blockx > Path.glyph">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Stroke" Value="{Binding $parent[ContentPresenter].Foreground}" />
    </Style>
    <Style Selector="Button.blockx:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
    </Style>

    <Style Selector="Button.blockjoin /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.blockjoin:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.blockjoin:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
    </Style>

    <!-- The dashed outline is drawn by a rectangle under the content, since a border cannot be dashed; its corners follow the button's
         CornerRadius, so the chip-sized variant (Button.blockadd.small in Menus.axaml) is as round as a chip -->
    <Style Selector="Button.blockadd">
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Rectangle x:Name="Dash" Stroke="{DynamicResource BrushHoverEdge}" StrokeThickness="1" StrokeDashArray="3,2"
                               RadiusX="{Binding CornerRadius.TopLeft, RelativeSource={RelativeSource TemplatedParent}}"
                               RadiusY="{Binding CornerRadius.TopLeft, RelativeSource={RelativeSource TemplatedParent}}" />
                    <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                      CornerRadius="{TemplateBinding CornerRadius}" Background="Transparent"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.blockadd:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.blockadd:pointerover /template/ Rectangle#Dash, Button.blockadd:focus-visible /template/ Rectangle#Dash">
        <Setter Property="Stroke" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.blockadd:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
    </Style>

    <!-- The dashed outline of an empty list's row (Pages/EmptyListRow) -->
    <Style Selector="Rectangle.emptydash">
        <Setter Property="Stroke" Value="{DynamicResource BrushHoverEdge}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeDashArray" Value="3,2" />
        <Setter Property="RadiusX" Value="8" />
        <Setter Property="RadiusY" Value="8" />
    </Style>

    <!-- The block of a hotkey trigger while its capture pop-down is open: accent edge -->
    <Style Selector="Button.block.capturing /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>

    <!-- MASTER keycap (a key of a shown shortcut; the Shortcuts boxes can adopt it later): a raised key with a thicker lower edge.
         Rectangle.keyslot + TextBlock.keyslot = the key still to press, a dashed accent slot. Border.capturebox = the ring behind
         live keycaps while a shortcut is being captured, with the same pulse as TextBox.listening (Theme.axaml). -->
    <Style Selector="Border.keycap">
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushHoverEdge}" />
        <Setter Property="BorderThickness" Value="1,1,1,2" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="7,1" />
    </Style>
    <Style Selector="Border.keycap > TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Compact keycaps for lists: a KeycapRow with class small (the picker's entry rows) -->
    <Style Selector="UserControl.small Border.keycap">
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="UserControl.small Border.keycap > TextBlock">
        <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="UserControl.small TextBlock.muted">
        <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="Rectangle.keyslot">
        <Setter Property="Stroke" Value="{DynamicResource BrushAccent}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeDashArray" Value="3,2" />
        <Setter Property="RadiusX" Value="5" />
        <Setter Property="RadiusY" Value="5" />
    </Style>
    <Style Selector="TextBlock.keyslot">
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="10,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.capturebox">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="CornerRadius" Value="8" />
        <Style.Animations>
            <Animation Duration="0:0:0.8" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- One step of a simulated device's recording (Pages/Devices/SimulationSteps): the sentence's row; a failed step is outlined red (1 px always, so nothing moves) -->
    <Style Selector="Border.steprow">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="4,2" />
    </Style>
    <Style Selector="Border.steprow.failed"><Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" /></Style>

    <!-- One numbered stage of a device's set-up (Pages/Devices/SetupStage): folded = a plain line; .open = outlined in the accent. The 1 px
         edge and the padding are always there, so opening a stage never moves its header. Path.glyph.tickmark = a small drawn tick after a
         done stage's title or on a pill whose job is done ("It's on now"). -->
    <Style Selector="Border.stage">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="{DynamicResource StagePadding}" />
    </Style>
    <Style Selector="Border.stage.open"><Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" /></Style>

    <!-- A smart device's icon square (Pages/Devices/DeviceIconView, docs/mockups/device-icons.html): Border.devicon = the neutral square
         (its lit colour wash is a second square the view lays over it), IconGlyph.devglyph = its icon (muted, centred; the lit glyph takes
         the device's colour). Button.devicon = the square that can be clicked (the detail header's): no wash of its own,
         a dashed accent edge (Rectangle.iconedge) on hover and keyboard focus. Nothing moves. -->
    <Style Selector="Border.devicon">
        <Setter Property="Width" Value="{DynamicResource DeviceIconSize}" />
        <Setter Property="Height" Value="{DynamicResource DeviceIconSize}" />
        <Setter Property="CornerRadius" Value="{DynamicResource DeviceIconCorner}" />
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.devicon">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DeviceIconCorner}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.devicon:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.devicon:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Rectangle.iconedge">
        <Setter Property="Stroke" Value="{DynamicResource BrushAccent}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeDashArray" Value="3,2" />
        <Setter Property="RadiusX" Value="6" />
        <Setter Property="RadiusY" Value="6" />
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Button.devicon:pointerover Rectangle.iconedge, Button.devicon:focus-visible Rectangle.iconedge"><Setter Property="Opacity" Value="1" /></Style>
    <!-- THE icon glyph (Controls/IconGlyph): its size where the context sets none; its colour is the inherited foreground.
         Button.iconcell = one cell of the icon picker's grids (Icons/IconPickerWindow): 34 px, the master hover; .selected = accent wash and edge.
         The 1 px edge is always there, so selecting or hovering changes colours only. -->
    <Style Selector="c|IconGlyph">
        <Setter Property="Width" Value="{DynamicResource IconGlyphSize}" />
        <Setter Property="Height" Value="{DynamicResource IconGlyphSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="c|IconGlyph.cardicon">
        <Setter Property="Width" Value="{DynamicResource CardIconSize}" />
        <Setter Property="Height" Value="{DynamicResource CardIconSize}" />
    </Style>
    <Style Selector="Button.iconcell">
        <Setter Property="Width" Value="{DynamicResource IconCellSize}" />
        <Setter Property="Height" Value="{DynamicResource IconCellSize}" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource DeviceIconCorner}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.iconcell > c|IconGlyph">
        <Setter Property="Width" Value="{DynamicResource IconCellGlyph}" />
        <Setter Property="Height" Value="{DynamicResource IconCellGlyph}" />
    </Style>
    <Style Selector="c|IconGlyph.devglyph">
        <Setter Property="Width" Value="{DynamicResource DeviceIconGlyph}" />
        <Setter Property="Height" Value="{DynamicResource DeviceIconGlyph}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.iconcell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.iconcell.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentEdge}" />
    </Style>
    <Style Selector="Button.iconcell.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Path.glyph.tickmark">
        <Setter Property="Width" Value="{DynamicResource MenuGlyphSize}" />
        <Setter Property="Height" Value="{DynamicResource MenuGlyphSize}" />
        <Setter Property="StrokeThickness" Value="1.75" />
    </Style>

    <!-- The plain words of the sentence ("If", "then") -->
    <Style Selector="TextBlock.blockword">
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
</Styles>
