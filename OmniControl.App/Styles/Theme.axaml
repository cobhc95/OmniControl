  <SolidColorBrush x:Key="BrushWarnBorder" Color="{DynamicResource ColorWarnBorder}"/>
  <SolidColorBrush x:Key="BrushSurfaceAlt" Color="{DynamicResource ColorSurfaceAlt}"/>
  <SolidColorBrush x:Key="BrushHoverSoft" Color="{DynamicResource ColorHoverSoft}"/>
  <SolidColorBrush x:Key="BrushBadge" Color="{DynamicResource ColorBadge}"/>
  <SolidColorBrush x:Key="BrushSurface" Color="{DynamicResource ColorSurface}"/>
  <SolidColorBrush x:Key="BrushDangerPill" Color="{DynamicResource ColorDangerPill}"/>
  <SolidColorBrush x:Key="BrushSwatchRed" Color="{DynamicResource ColorSwatchRed}"/>
  <SolidColorBrush x:Key="BrushSwatchYellow" Color="{DynamicResource ColorSwatchYellow}"/>
  <SolidColorBrush x:Key="BrushDangerBg" Color="{DynamicResource ColorDangerBg}"/>
  <SolidColorBrush x:Key="BrushWarnBg" Color="{DynamicResource ColorWarnBg}"/>
  <SolidColorBrush x:Key="BrushWhite" Color="{DynamicResource ColorWhite}"/>
