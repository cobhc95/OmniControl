<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="ColorRail">#1C2230</Color>
  <Color x:Key="ColorText">#E8ECF4</Color>
  <Color x:Key="ColorAccentDark">#8FC3FF</Color>
  <Color x:Key="ColorRailHover">#262E40</Color>
  <Color x:Key="ColorLog">#2A2F3A</Color>
  <Color x:Key="ColorDarkHover">#2B3447</Color>
  <Color x:Key="ColorRailSelected">#2F4F8F</Color>
