<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:OmniControl.App.Services"
        xmlns:pages="using:OmniControl.App.Pages"
        xmlns:hk="using:OmniControl.App.Hotkeys"
        xmlns:vol="using:OmniControl.App.Pages.Volume">


    <!-- The card list: a list of setting cards that pairs half-width cards two per row (used with "rows compact") -->
    <Style Selector="ListBox.cards">
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><pages:HalfPanel /></ItemsPanelTemplate></Setter>
    </Style>

    <!-- A side panel or a top bar of a window: the sidebar tint with a divider edge (the side that shows it is the control's BorderThickness) -->
    <Style Selector="Border.sidebarpanel, Border.barstrip">
        <Setter Property="Background" Value="{DynamicResource BrushSidebar}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
    </Style>
    <!-- A boxed pane inside a window (the FX chain list and editor, the add-effect list); .edged draws its divider outline -->
    <Style Selector="Border.pane">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource BrushSidebar}" />
    </Style>
    <Style Selector="Border.pane.edged"><Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" /></Style>

    <!-- Focus is shown with the accent colour, not the default white outline -->
    <Style Selector="ToggleSwitch, ToggleSwitch:focus, ToggleSwitch:focus-visible, Button, ToggleButton, ListBoxItem, ComboBoxItem, ComboBox, TextBox, CheckBox, Button:focus-visible, ToggleButton:focus-visible, ListBoxItem:focus-visible, ComboBoxItem:focus-visible, ComboBox:focus-visible, TextBox:focus-visible, CheckBox:focus-visible, Button:focus, ToggleButton:focus">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <!-- Being inside a card (an editor has focus): accent border and a darker field -->
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement, TextBox:focus:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{DynamicResource BrushBackground}" />
    </Style>
    <Style Selector="ComboBox:focus /template/ Border#Background, ComboBox:focus:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.scope:focus-visible /template/ ContentPresenter#PART_ContentPresenter, Button.scope:focus-visible:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{DynamicResource BrushBackground}" />
    </Style>
    <Style Selector="ToggleSwitch:focus /template/ Border#OuterBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ToggleSwitch:pointerover /template/ Border#OuterBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Slider:focus /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Slider.active /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
        <Setter Property="RenderTransform" Value="scale(1.4)" />
    </Style>

    <!-- Gallery cards (style, colours): no box of their own, the card around them shows hover and keyboard focus; the arrow buttons are flat -->
    <Style Selector="Border.gallery"><Setter Property="Padding" Value="4,2" /></Style>
    <!-- Placement of the centred editors on a page: the control sits in the middle of its card, over the label column -->
    <Style Selector="pages|GalleryRow Border.gallery">
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="300" />
    </Style>
    <Style Selector="ComboBox.choice">
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Width" Value="220" />
    </Style>

    <!-- Search results (ListBox.results): the title column takes what the editors leave, the editors share one right-hand column,
         so the controls that do not stretch hug the right edge. Declared after the page placement above so it overrides it. -->
    <Style Selector="ListBox.results pages|GalleryRow Border.gallery">
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="MinWidth" Value="0" />
    </Style>
    <!-- Half-width choice card: the drop-down fills the room beside the label instead of sitting centred at a fixed width -->
    <Style Selector="ComboBox.choice.half">
        <Setter Property="Grid.ColumnSpan" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Width" Value="NaN" />
    </Style>
    <Style Selector="ListBox.results ComboBox.choice">
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="Grid.ColumnSpan" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="ListBox.results ComboBox.choice.half"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
    <Style Selector="ListBox.results pages|ToggleRow, ListBox.results hk|HotkeyRow">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <!-- Colour dots in a gallery card can be clicked: the one under the pointer grows a little -->
    <Style Selector="Border.swatch:pointerover"><Setter Property="RenderTransform" Value="scale(1.25)" /></Style>
    <!-- MASTER CONTROLS (AGENTS.md "Master design elements"): a control picks one of these classes and styles nothing by hand.
         Buttons:
           primary        the one accent action of a window (Close, Done)
           pill           small outlined action beside a card's name (action pills, Refresh, Switch to, Clear, Install); .custom = remapped or open; .glow (RowControls.axaml) = lit FX,
                          .glyph = one-character pill (a row's show-effects arrow, its remove cross)
           link           underlined words that are a control inside a sentence or line (a Mixer row's Switch or fix link); .small = the small link
           tab            a page's tab (Pages/PageTabsView: Mixer, Wiring): muted words; .selected = accent words on a 2 px accent underline
           chipx          a chosen value that can be taken away (words and an x; a Wiring row's devices): a quiet 22 px pill (Menus.axaml)
           menurow        a flat full-width row of a menu-like pop-down (FlyoutPresenter.listmenu: a device to add, a step to take); TextBlock.menutext = its title or a note (Menus.axaml)
           optioncard     a selectable card in a pop-down (FlyoutPresenter.optionmenu; the Method menu): name, description; .selected = the current choice
           pill cog       round cogwheel beside a pill or on a group header
           pill cardaction  an action inside a pop-down card (Install, Remove, Preview changes, Test); .main = the accent-outlined action that does the job (Install)
           scope          field-like picker or action button (device picker, Add program, Choose...); .mute / .usebtn are its mixer and confirm variants
           step           flat arrow beside a gallery
           groupHeader    the clickable header of a group panel
           graphthumb     a drawn graph that opens a larger one (the FX window's response thumbnail; Styles/Graphs.axaml)
         Caution words: Styles/Tables.axaml (TextBlock.cautiontext = a caution fact in words)
         Tags:    Border.tag (a small fact pill, quiet: plain = neutral fact, .good green, .caution yellow (sparingly), .risk red (a real failure only, never a method's fact), .selected accent; its own faint brushes BrushTag*, BrushAccentEdge)
         Sliders: Styles/Sliders.axaml (Slider.compact = the Easy rows' level; Slider.vband = the master vertical slider, a graphic; Knob: Knobs.axaml
                  equaliser's band, .large for few bands); their focus and hover stay here; scroll bars: one master, Styles/ScrollBars.axaml
         Lists:   Controls/OptionList (a ticked list, ListBox.pick.compact; Border.tickbox = its tick (.checked)); Border.hrule = a thin line between parts of a pop-down; FlyoutPresenter.listmenu = a narrow menu pop-down;
                  Grid.unavailable / StackPanel.unavailable = a greyed entry (master picker, Shortcuts action). Menus, chips, ticks: Menus.axaml; Button.selector: RowControls.axaml.
                  List row styles use "ListBox.x > ListBoxItem" (direct items only) so a list inside a pop-down opened from a row never takes the page rows' look.
         Blocks:  Styles/Blocks.axaml (a sentence of blocks, the rule editor: Button.block, .blockx, .blockjoin, .blockadd, TextBlock.blockword);
                  Button.blockadd.small = the same dashed "+ add" at chip size, after a row of chips (Menus.axaml)
         Volume rows: Border.rowicon (the icon tile), Path.glyph (a stroked row icon), WrapPanel.sentence (the line under a row's name; TextBlock.status
                  = the engine's words in it), WrapPanel.toolbar (a line of controls that wraps: the Wiring tab's top bar)
         Numbers: StackPanel.stats of StackPanel.stat, TextBlock.statlabel + TextBlock.statvalue (.caution) = live numbers beside a graph (Graphs.axaml);
                  FlyoutPresenter.graphmenu = a pop-down holding a larger graph (Menus.axaml)
         Fields:  TextBox.field (in a card or window; .code = monospace several-line code, a saved script), TextBox.bar + ComboBox.bar (top search bar), TextBox.typednumber (a typed slider value),
                  ComboBox.choice (centred in a card), ComboBox.tool (on a group header's line). -->
    <Style Selector="Button.step">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.step:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
    </Style>

    <!-- Shortcut groups: one panel per feature with a clickable header that collapses it -->
    <Style Selector="Border.groupPanel">
        <Setter Property="Background" Value="{DynamicResource BrushSidebar}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,3,8,2" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <!-- The group card: the panel, its header line with the tools at the right, the body (both tools and body follow the group's open/closed state) -->
    <Style Selector="pages|GroupCard">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Classes="groupPanel">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <pages:GroupHeader DataContext="{TemplateBinding Group}" />
                            <ItemsControl Grid.Column="1" ItemsSource="{TemplateBinding Tools}" Margin="0,0,8,0" VerticalAlignment="Center"
                                          IsVisible="{Binding Group.IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          IsVisible="{Binding Group.IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.groupHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.groupHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.groupHeader:focus /template/ ContentPresenter#PART_ContentPresenter, Button.groupHeader:focus:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
    </Style>
    <Style Selector="PathIcon.chev">
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
        <Setter Property="Transitions">
            <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" /></Transitions>
        </Setter>
    </Style>
    <Style Selector="PathIcon.chev.collapsed">
        <Setter Property="RenderTransform" Value="rotate(-90deg)" />
    </Style>

    <!-- Hover feedback for the mouse (keyboard focus uses the accent border) -->
    <Style Selector="ListBox.nav > ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
    </Style>
    <Style Selector="ListBox.rows > ListBoxItem:pointerover:not(:focus-within) /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushHoverEdge}" />
    </Style>
    <Style Selector="ListBox.rows > ListBoxItem:focus-within:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
    </Style>
    <Style Selector="Button.scope:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background, TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushHoverEdge}" />
    </Style>

    <!-- Every window: the app background and the app icon (set once, never per window) -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BrushBackground}" />
        <Setter Property="Icon" Value="avares://OmniControl/Assets/OmniControl.ico" />
    </Style>

    <!-- The page title line: the name, a slot beside it, a slot at the right -->
    <Style Selector="pages|PageTitleLine">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="14" Margin="0,0,0,4">
                    <TextBlock Text="{TemplateBinding Title}" Classes="title" VerticalAlignment="Center" />
                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Middle}" VerticalAlignment="Center" />
                    <ContentPresenter Grid.Column="2" Content="{TemplateBinding Right}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Text roles -->
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="22" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,12,0,4" /></Style>
    <!-- A name or heading in a row: the semi-bold weight, nothing else -->
    <Style Selector="TextBlock.strong"><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource BrushMuted}" /></Style>
    <!-- A grey caption that carries state or a limit (a start-up note, "None yet"); never keyboard instructions (AGENTS.md principle 12) -->
    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Text box inside a card, flyout or window; the top search bar (TextBox.bar / ComboBox.bar) is taller and sits on the sidebar colour -->
    <Style Selector="TextBox.field">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- A field holding code (a saved script): monospace, several lines (Tab still moves on, so the keyboard is never trapped), long lines scroll sideways rather than wrap -->
    <Style Selector="TextBox.field.code">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="TextBox.bar, ComboBox.bar">
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="{DynamicResource BrushSidebar}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
    </Style>
    <!-- Drop-down placed on a group header's line (the mouse layer picker) -->
    <Style Selector="ComboBox.tool">
        <Setter Property="MinWidth" Value="130" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- A slider's value while it is typed in (Pages/NumberText.cs): small enough to stay inside the card's row -->
    <Style Selector="TextBox.typednumber">
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Sidebar navigation items -->
    <Style Selector="ListBox.nav"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBox.nav > ListBoxItem">
        <Setter Property="Padding" Value="24,7,16,7" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <!-- A sidebar group heading (NavHeading): small, muted capitals; its container is neither clickable nor focusable, so no hover or focus look applies -->
    <Style Selector="ListBox.nav > ListBoxItem.navheading">
        <Setter Property="Padding" Value="24,10,16,2" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="TextBlock.navheading">
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="LetterSpacing" Value="0.7" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem:selected PathIcon"><Setter Property="Foreground" Value="{DynamicResource BrushAccent}" /></Style>

    <!-- Tighter rows (shortcut cards) -->
    <Style Selector="ListBox.rows.compact > ListBoxItem">
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- A card that cannot be used right now (a monitor that does not report the control): greyed out; its tooltip says why -->
    <Style Selector="UserControl.card:disabled"><Setter Property="Opacity" Value="0.45" /></Style>

    <!-- A group inside a group (a monitor inside "Hardware"): a lighter panel, set in from the left -->
    <Style Selector="Border.subgroupPanel">
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="6,2,6,2" />
        <Setter Property="Margin" Value="14,0,0,4" />
    </Style>
    <!-- The panel is already tinted with the hover brush, so its header's hover needs the stronger one to show -->
    <Style Selector="Border.subgroupPanel Button.groupHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
    </Style>

    <!-- Device picker button (hotkey scope) -->
    <Style Selector="Button.scope">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.scope /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushSidebar}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.scope:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <!-- The small square mute button of a Volume row ("M"), the same height as the FX split button -->
    <Style Selector="Button.scope.mute">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- The preset manager (Pages/Presets): the group card it was opened at is outlined in the accent (the 1 px edge stays, so nothing
         moves); a section with no presets is dimmed in its left pane; a row's drag grip is muted -->
    <Style Selector="Border.groupPanel.target"><Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" /></Style>
    <Style Selector="ListBox.nav > ListBoxItem:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
    <Style Selector="PathIcon.grip"><Setter Property="Foreground" Value="{DynamicResource BrushMuted}" /><Setter Property="Width" Value="10" /><Setter Property="Height" Value="14" /></Style>
    <Style Selector="TextBlock.accenttext"><Setter Property="Foreground" Value="{DynamicResource BrushAccent}" /></Style>

    <!-- A mouse button card lights for a moment when the real button is pressed -->
    <Style Selector="Border.flash.lit">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>

    <!-- "Use this action": the mouse hover and the keyboard highlight share the master hover look (no border change, so the text never moves) -->
    <Style Selector="Button.scope.usebtn"><Setter Property="Padding" Value="12,4" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="Button.scope.usebtn TextBlock"><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="Button.usebtn:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.usebtn.picked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>

    <!-- Mixer row: mute lights in the accent, the FX power button lights green when the chain is on -->
    <Style Selector="Button.scope.mute.on /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>

    <!-- Parametric equaliser band row (Button.bandrow, a tab-like row of the band list): outlined, flat; the selected one is raised with a 3 px accent
         bar at its left edge (an inner Border.bandbar, so the text never moves); a bypassed band is dimmed and struck through (.off) -->
    <Style Selector="Button.bandrow">
        <Setter Property="Padding" Value="0,0,8,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushHoverEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.bandrow.on /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushHoverEdge}" />
    </Style>
    <Style Selector="Button.bandrow:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.bandrow:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Border.bandbar"><Setter Property="Width" Value="3" /><Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="2" /></Style>
    <Style Selector="Button.bandrow.on Border.bandbar"><Setter Property="Background" Value="{DynamicResource BrushAccent}" /></Style>
    <Style Selector="Button.bandrow.off > Grid"><Setter Property="Opacity" Value="0.45" /></Style>
    <Style Selector="Button.bandrow.off TextBlock"><Setter Property="TextDecorations" Value="Strikethrough" /></Style>

    <!-- Action picker lists: focus stays in the search box, so the highlight is the selection; the side the keys act on is stronger -->
    <Style Selector="ListBox.pick"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="ListBox.pick > ListBoxItem">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox.pick > ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
    </Style>
    <Style Selector="ListBox.pick > ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
    </Style>
    <!-- Compact rows (Controls/OptionList): flat menu rows (MenuRow* in App.axaml), the same as Button.menurow; hover and the
         highlighted entry share one wash (the list moves the highlight to the row under the pointer), no border, so nothing moves -->
    <Style Selector="ListBox.pick.compact > ListBoxItem">
        <Setter Property="Padding" Value="{DynamicResource MenuRowPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource MenuRowHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource MenuRowCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.pick.compact > ListBoxItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
    </Style>
    <Style Selector="ListBox.pick.active > ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>

    <!-- Label of a compact (one-line, half-width) card: wraps to a second line rather than being cut off, and the tight line
         height keeps two lines inside the card's normal height. Use it instead of a plain trimmed label on such cards. -->
    <Style Selector="TextBlock.cardlabel">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="LineHeight" Value="12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Action pill on a mouse button's card: quiet outline for "Default", accent tint once remapped -->
    <Style Selector="Button.pill">
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="13" />
    </Style>
    <!-- Long action names wrap to two lines inside the pill (two lines of 11 plus the 1px borders fit the 24px height); the text block is centred itself because a plain-string Content is stretched by its presenter and would otherwise sit at the top -->
    <Style Selector="Button.pill TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="LineHeight" Value="11" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.pill /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
        <Setter Property="CornerRadius" Value="13" />
    </Style>
    <Style Selector="Button.pill.custom /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <!-- The cogwheel beside an action: a round version of the pill; lit while the keyboard is on it -->
    <Style Selector="Button.pill.cog"><Setter Property="Padding" Value="7,0" /><Setter Property="MinWidth" Value="24" /></Style>
    <!-- A one-character pill (the - and + arrows of a number setting) -->
    <Style Selector="Button.pill.glyph"><Setter Property="Padding" Value="9,0" /></Style>
    <!-- The drawn cross of a remove button takes the button's own text colour (so it greys, hovers and focuses with it) -->
    <Style Selector="Button.pill.glyph > Path.glyph">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="Stroke" Value="{Binding $parent[ContentPresenter].Foreground}" />
    </Style>
    <Style Selector="Button.pill.cog.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.pill.custom:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
    </Style>
    <Style Selector="Button.pill:focus-visible /template/ ContentPresenter#PART_ContentPresenter, Button.pill:focus-visible:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- A destructive action pill (Button.pill.danger: Wipe all...): red words and edge, so it never looks like a routine action; hover and focus as every pill -->
    <Style Selector="Button.pill.danger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
    </Style>
    <Style Selector="Button.pill.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
    </Style>

    <!-- Action inside a pop-down card (Button.pill.cardaction: Install, Remove, Preview changes, Test): the quiet pill is too faint on a tinted
         card, so the text takes the normal colour and the edge a clear grey; .main (the one action that does the job, Install) is outlined in the accent -->
    <Style Selector="Button.pill.cardaction /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushHoverEdge}" />
    </Style>
    <Style Selector="Button.pill.cardaction.main /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.pill.cardaction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.pill.cardaction.main:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
    </Style>
    <Style Selector="Button.pill.cardaction:focus-visible /template/ ContentPresenter#PART_ContentPresenter, Button.pill.cardaction:focus-visible:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>


    <!-- The smaller text of a pop-down card (its description and notes) -->
    <Style Selector="TextBlock.small"><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="Button.optioncard">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.optioncard /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.optioncard.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentEdge}" />
    </Style>
    <Style Selector="Button.optioncard:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>

    <!-- Tag: a small fact pill. The colour is on the wash and the edge; the text keeps the normal colour so it reads in both themes. -->
    <Style Selector="Border.tag">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
    </Style>
    <Style Selector="Border.tag TextBlock"><Setter Property="FontSize" Value="10.5" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextAlignment" Value="Center" /></Style>
    <Style Selector="Border.tag.good"><Setter Property="Background" Value="{DynamicResource BrushTagGoodSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource BrushTagGood}" /></Style>
    <Style Selector="Border.tag.caution"><Setter Property="Background" Value="{DynamicResource BrushTagCautionSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource BrushTagCaution}" /></Style>
    <Style Selector="Border.tag.risk"><Setter Property="Background" Value="{DynamicResource BrushTagRiskSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource BrushTagRisk}" /></Style>
    <Style Selector="Border.tag.selected"><Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource BrushAccentEdge}" /></Style>



    <!-- Hotkey box while it waits for keys: accent border and a slow flash -->
    <Style Selector="TextBox.listening /template/ Border#PART_BorderElement, TextBox.listening:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Style.Animations>
            <Animation Duration="0:0:0.8" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Primary button -->
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource BrushAccent}" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushAccent}" /><Setter Property="Foreground" Value="White" /><Setter Property="Opacity" Value="0.88" /></Style>

    <!-- Display rows (keyboard friendly) -->
    <Style Selector="ListBox.rows"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBox.rows > ListBoxItem">
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
    </Style>
    <Style Selector="ListBox.rows > ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushSidebar}" /></Style>
    <Style Selector="ListBox.rows > ListBoxItem:focus-within /template/ ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" /><Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" /></Style>
    <!-- FX chain list (TabForge style): flat rows inside a bordered box, the selected effect filled with the accent -->
    <Style Selector="ListBox.fxlist"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBox.fxlist > ListBoxItem">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox.fxlist > ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
    </Style>
    <Style Selector="ListBox.fxlist > ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
    </Style>
    <Style Selector="ListBox.fxlist > ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
    </Style>

    <!-- A thin upright line between two parts of a card (FX split button, a slider and its switch) -->
    <Style Selector="Border.divider"><Setter Property="Background" Value="{DynamicResource BrushDivider}" /><Setter Property="Width" Value="1" /></Style>

    <!-- Hover for the individual elements inside cards (sliders, switches, check boxes, plain buttons), listed last so they win.
         Rule 5 in AGENTS.md: every clickable element needs its own hover; add new element types here. -->
    <Style Selector="Slider:pointerover /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
        <Setter Property="RenderTransform" Value="scale(1.2)" />
    </Style>
    <Style Selector="Slider.active:pointerover /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
        <Setter Property="RenderTransform" Value="scale(1.4)" />
    </Style>
    <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
    </Style>
    <Style Selector="Button:not(.scope):not(.groupHeader):not(.step):not(.primary):pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <!-- Lit (on) buttons keep their lit look but still react to the mouse -->
    <Style Selector="Button.scope.mute.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>

    <!-- A control inside a sentence (Button.link): looks like underlined words, its size never changes; hover and keyboard focus colour it in the accent -->
    <Style Selector="Button.link">
        <Setter Property="Padding" Value="1,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="3" />
        <!-- A link's content is always a TextBlock (never a string): a string is drawn by the ContentPresenter itself and the underline
             below could not reach it, and a ContentTemplate would turn a TextBlock content into its type name -->
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- Only the link's own words: '>' is the logical child, and a content TextBlock's logical parent is the Button itself (not its
         presenter). A pop-down opened from a link sits deeper under it in the logical tree, so a descendant selector would underline it. -->
    <Style Selector="Button.link > TextBlock">
        <Setter Property="TextDecorations" Value="Underline" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxWidth" Value="{DynamicResource SentenceLinkMaxWidth}" />
    </Style>
    <Style Selector="Button.link.small"><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.link:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.link:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
    <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>

    <!-- A page's tab (Button.tab, Pages/PageTabsView): muted words with a 2 px line under them that is transparent until the tab is open;
         open = accent words on an accent line. The weight never changes, so the tabs never move; hover is the master button hover (its
         wash on the words' presenter), keyboard focus the accent wash. Hover comes before .selected so an open tab keeps its accent. -->
    <Style Selector="Button.tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{DynamicResource TabPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource TabCornerRadius}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel>
                    <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                      Background="{TemplateBinding Background}"
                                      CornerRadius="{TemplateBinding CornerRadius}" />
                    <Border x:Name="Underline" Height="{DynamicResource TabUnderlineHeight}" Background="Transparent" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    <!-- The words' colours are set on the presenter: Fluent's button theme colours it there on hover and press, after the template -->
    <Style Selector="Button.tab /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource BrushMuted}" /></Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" /></Style>
    <Style Selector="Button.tab.selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource BrushAccent}" /></Style>
    <Style Selector="Button.tab.selected /template/ Border#Underline"><Setter Property="Background" Value="{DynamicResource BrushAccent}" /></Style>
    <Style Selector="Button.tab:focus-visible /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" /></Style>

    <!-- A Volume row: the icon tile, a stroked icon in it, the sentence under the name (small, muted), the engine's words in it -->
    <Style Selector="Border.rowicon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
    </Style>
    <Style Selector="Path.glyph">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>
    <Style Selector="WrapPanel.sentence > TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource BrushMuted}" /></Style>
    <Style Selector="WrapPanel.sentence > Button.link"><Setter Property="FontSize" Value="11" /></Style>
    <Style Selector="TextBlock.status"><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="MaxWidth" Value="{DynamicResource SentenceLinkMaxWidth}" /></Style>
    <!-- A line of controls that wraps when narrow, with the same gap after each -->
    <Style Selector="WrapPanel.toolbar > Control">
        <Setter Property="Margin" Value="0,0,8,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Search results never show a row's remove button (×) -->
    <Style Selector="ListBox.results vol|VolumeRowView Button.glyph, ListBox.results vol|WiringRowView Button.glyph">
        <Setter Property="IsVisible" Value="False" />
    </Style>

</Styles>
