  <Color x:Key="ColorRailText">#C6CDDB</Color>
  <Color x:Key="ColorToggleOff">#C9CED8</Color>
  <Color x:Key="ColorKeyBorder">#C9D0DC</Color>
  <Color x:Key="ColorBadgeBlueBg">#1E3A5F</Color>
  <Color x:Key="ColorBorder">#2E364A</Color>
  <Color x:Key="ColorBadgeGreenBg">#24402A</Color>
  <Color x:Key="ColorDangerBorder">#5A2B3A</Color>
  <Color x:Key="ColorDivider">#2E364A</Color>
  <Color x:Key="ColorAccentSoft">#23314F</Color>
  <Color x:Key="ColorBg">#141824</Color>
  <Color x:Key="ColorKey">#11141B</Color>
  <Color x:Key="ColorWarnBorder">#5A4A1E</Color>
  <Color x:Key="ColorSurfaceAlt">#212A3E</Color>
  <Color x:Key="ColorHoverSoft">#212A3E</Color>
  <Color x:Key="ColorBadge">#F5D27A</Color>
  <Color x:Key="ColorSurface">#11141B</Color>
  <Color x:Key="ColorDangerPill">#3A1F28</Color>
  <Color x:Key="ColorSwatchRed">#FF8A8A</Color>
  <Color x:Key="ColorSwatchYellow">#FFD27A</Color>
  <Color x:Key="ColorDangerBg">#3A1F28</Color>
  <Color x:Key="ColorWarnBg">#2E2410</Color>
  <Color x:Key="ColorWhite">#FFFFFF</Color>
  <Color x:Key="ColorCard">#1B2030</Color>
  <SolidColorBrush x:Key="BrushRail" Color="{DynamicResource ColorRail}"/>
  <SolidColorBrush x:Key="BrushText" Color="{DynamicResource ColorText}"/>
  <SolidColorBrush x:Key="BrushAccentDark" Color="{DynamicResource ColorAccentDark}"/>
  <SolidColorBrush x:Key="BrushRailHover" Color="{DynamicResource ColorRailHover}"/>
  <SolidColorBrush x:Key="BrushLog" Color="{DynamicResource ColorLog}"/>
  <SolidColorBrush x:Key="BrushDarkHover" Color="{DynamicResource ColorDarkHover}"/>
  <SolidColorBrush x:Key="BrushRailSelected" Color="{DynamicResource ColorRailSelected}"/>
  <SolidColorBrush x:Key="BrushBadgeGreenFg" Color="{DynamicResource ColorBadgeGreenFg}"/>
  <SolidColorBrush x:Key="BrushTextRow" Color="{DynamicResource ColorTextRow}"/>
  <SolidColorBrush x:Key="BrushRailTrack" Color="{DynamicResource ColorRailTrack}"/>
  <SolidColorBrush x:Key="BrushAccent" Color="{DynamicResource ColorAccent}"/>
  <SolidColorBrush x:Key="BrushTextTile" Color="{DynamicResource ColorTextTile}"/>
  <SolidColorBrush x:Key="BrushBadgeBg" Color="{DynamicResource ColorBadgeBg}"/>
