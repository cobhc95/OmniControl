  <Color x:Key="ColorTextRow">#C6CDDB</Color>
  <Color x:Key="ColorRailTrack">#3A4358</Color>
  <Color x:Key="ColorAccent">#4D8DFF</Color>
  <Color x:Key="ColorTextTile">#9AA4B8</Color>
  <Color x:Key="ColorBadgeBg">#5A4A1E</Color>
  <Color x:Key="ColorTextMuted">#9AA4B8</Color>
  <Color x:Key="ColorWarnTextDark">#FFD27A</Color>
  <Color x:Key="ColorRailSelectedBar">#8FC3FF</Color>
  <Color x:Key="ColorWarnText">#FFD27A</Color>
  <Color x:Key="ColorRailIcon">#9AA4B8</Color>
  <Color x:Key="ColorDanger">#FF9B9B</Color>
