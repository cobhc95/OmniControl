  <SolidColorBrush x:Key="BrushWarnText" Color="{DynamicResource ColorWarnText}"/>
  <SolidColorBrush x:Key="BrushRailIcon" Color="{DynamicResource ColorRailIcon}"/>
  <SolidColorBrush x:Key="BrushDanger" Color="{DynamicResource ColorDanger}"/>
  <SolidColorBrush x:Key="BrushBorderStrong" Color="{DynamicResource ColorBorderStrong}"/>
