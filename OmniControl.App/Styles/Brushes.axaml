<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:OmniControl.App.Services">
    <!-- The theme colours and shared icons (both theme dictionaries; risk colours come from Services/Palette.cs, accent colours from
         AccentService). Split out of Theme.axaml, which holds the master control designs; included before it in App.axaml. -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BrushBackground" Color="{x:Static svc:Palette.DarkBackground}" />
                    <SolidColorBrush x:Key="BrushSidebar" Color="#1C1C1C" />
                    <SolidColorBrush x:Key="BrushDivider" Color="#2E2E2E" />
                    <SolidColorBrush x:Key="BrushMuted" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="BrushHover" Color="#2F2F2F" />
                    <SolidColorBrush x:Key="BrushHoverEdge" Color="#707070" />
                    <SolidColorBrush x:Key="BrushHoverStrong" Color="#454545" />
                    <!-- Scroll bars (Styles/ScrollBars.axaml): a track that reads as a track, a thumb that stands out from it -->
                    <SolidColorBrush x:Key="BrushScrollTrack" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="BrushScrollThumb" Color="#7A7A7A" />
                    <!-- "On" green (an FX chain that is switched on), and its brighter hover -->
                    <SolidColorBrush x:Key="BrushOn" Color="{x:Static svc:Palette.On}" />
                    <SolidColorBrush x:Key="BrushOnHover" Color="#6BE07A" />
                    <!-- Risk colours (tags, warnings): green = BrushOn, caution yellow, danger red; each with a see-through wash -->
                    <SolidColorBrush x:Key="BrushCaution" Color="{x:Static svc:Palette.Caution}" />
                    <SolidColorBrush x:Key="BrushDanger" Color="{x:Static svc:Palette.Danger}" />
                    <SolidColorBrush x:Key="BrushCautionSoft" Color="{x:Static svc:Palette.Caution}" Opacity="{x:Static svc:Palette.WashOpacity}" />
                    <!-- Tags only: the same colours, fainter (edge and wash), so a tag is read at a glance without shouting -->
                    <SolidColorBrush x:Key="BrushTagGood" Color="{x:Static svc:Palette.On}" Opacity="{x:Static svc:Palette.TagEdgeOpacity}" />
                    <SolidColorBrush x:Key="BrushTagCaution" Color="{x:Static svc:Palette.Caution}" Opacity="{x:Static svc:Palette.TagEdgeOpacity}" />
                    <SolidColorBrush x:Key="BrushTagRisk" Color="{x:Static svc:Palette.Danger}" Opacity="{x:Static svc:Palette.TagEdgeOpacity}" />
                    <SolidColorBrush x:Key="BrushTagGoodSoft" Color="{x:Static svc:Palette.On}" Opacity="{x:Static svc:Palette.TagWashOpacity}" />
                    <SolidColorBrush x:Key="BrushTagCautionSoft" Color="{x:Static svc:Palette.Caution}" Opacity="{x:Static svc:Palette.TagWashOpacity}" />
                    <SolidColorBrush x:Key="BrushTagRiskSoft" Color="{x:Static svc:Palette.Danger}" Opacity="{x:Static svc:Palette.TagWashOpacity}" />
                    <!-- The cable blue (a Mixer row's Method chip for a cable or the cable bus): the words, and the chip's faint edge -->
                    <SolidColorBrush x:Key="BrushCable" Color="{x:Static svc:Palette.Cable}" />
                    <SolidColorBrush x:Key="BrushTagCable" Color="{x:Static svc:Palette.Cable}" Opacity="{x:Static svc:Palette.TagEdgeOpacity}" />
                    <!-- The parametric equaliser's band colours (Fx/EqBandColors.cs cycles through them by band number) -->
                    <SolidColorBrush x:Key="BrushBand1" Color="#E8873A" />
                    <SolidColorBrush x:Key="BrushBand2" Color="#4FA3D9" />
                    <SolidColorBrush x:Key="BrushBand3" Color="#6BBF7A" />
                    <SolidColorBrush x:Key="BrushBand4" Color="#C77DD6" />
                    <SolidColorBrush x:Key="BrushBand5" Color="#D9B84F" />
                    <SolidColorBrush x:Key="BrushBand6" Color="#E06C75" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BrushBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BrushSidebar" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="BrushDivider" Color="#DDDDDD" />
                    <SolidColorBrush x:Key="BrushMuted" Color="#6B6B6B" />
                    <SolidColorBrush x:Key="BrushHover" Color="#EAEAEA" />
                    <SolidColorBrush x:Key="BrushHoverEdge" Color="#B5B5B5" />
                    <SolidColorBrush x:Key="BrushHoverStrong" Color="#D2D2D2" />
                    <SolidColorBrush x:Key="BrushScrollTrack" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="BrushScrollThumb" Color="#8F8F8F" />
                    <SolidColorBrush x:Key="BrushOn" Color="{x:Static svc:Palette.On}" />
                    <SolidColorBrush x:Key="BrushOnHover" Color="#6BE07A" />
                    <SolidColorBrush x:Key="BrushCaution" Color="{x:Static svc:Palette.CautionInk}" />
                    <SolidColorBrush x:Key="BrushDanger" Color="{x:Static svc:Palette.Danger}" />
                    <SolidColorBrush x:Key="BrushCautionSoft" Color="{x:Static svc:Palette.Caution}" Opacity="{x:Static svc:Palette.WashOpacity}" />
                    <SolidColorBrush x:Key="BrushTagGood" Color="{x:Static svc:Palette.On}" Opacity="{x:Static svc:Palette.TagEdgeOpacity}" />
                    <SolidColorBrush x:Key="BrushTagCaution" Color="{x:Static svc:Palette.CautionInk}" Opacity="{x:Static svc:Palette.TagEdgeOpacity}" />
                    <SolidColorBrush x:Key="BrushTagRisk" Color="{x:Static svc:Palette.Danger}" Opacity="{x:Static svc:Palette.TagEdgeOpacity}" />
                    <SolidColorBrush x:Key="BrushTagGoodSoft" Color="{x:Static svc:Palette.On}" Opacity="{x:Static svc:Palette.TagWashOpacity}" />
                    <SolidColorBrush x:Key="BrushTagCautionSoft" Color="{x:Static svc:Palette.Caution}" Opacity="{x:Static svc:Palette.TagWashOpacity}" />
                    <SolidColorBrush x:Key="BrushTagRiskSoft" Color="{x:Static svc:Palette.Danger}" Opacity="{x:Static svc:Palette.TagWashOpacity}" />
                    <SolidColorBrush x:Key="BrushCable" Color="{x:Static svc:Palette.CableInk}" />
                    <SolidColorBrush x:Key="BrushTagCable" Color="{x:Static svc:Palette.CableInk}" Opacity="{x:Static svc:Palette.TagEdgeOpacity}" />
                    <SolidColorBrush x:Key="BrushBand1" Color="#C96A1F" />
                    <SolidColorBrush x:Key="BrushBand2" Color="#2A7FB8" />
                    <SolidColorBrush x:Key="BrushBand3" Color="#3C9A4E" />
                    <SolidColorBrush x:Key="BrushBand4" Color="#A455B5" />
                    <SolidColorBrush x:Key="BrushBand5" Color="#A88620" />
                    <SolidColorBrush x:Key="BrushBand6" Color="#C94B57" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- The small down arrow of a button that opens a list or pop-down -->
            <StreamGeometry x:Key="ChevronDownIcon">M6,9 L12,16 L18,9 Z</StreamGeometry>
            <!-- Two arrows chasing round: a button that reads the state again (Check now) -->
            <StreamGeometry x:Key="RefreshIcon">M19,8 A8,8 0 0 0 5,9 M19,4 V8 H15 M5,16 A8,8 0 0 0 19,15 M5,20 V16 H9</StreamGeometry>
            <!-- The left and right arrows of a gallery's steppers -->
            <StreamGeometry x:Key="ChevronLeftIcon">M15,5 L8,12 L15,19 Z</StreamGeometry>
            <StreamGeometry x:Key="ChevronRightIcon">M9,5 L16,12 L9,19 Z</StreamGeometry>
            <!-- A tick: an option list's checked entry, the entry in use in a "Plays on" menu -->
            <StreamGeometry x:Key="TickIcon">M5,12 L10,17 L19,7</StreamGeometry>
            <!-- A cross: take this away (remove chips and buttons) -->
            <StreamGeometry x:Key="CrossIcon">M6,6 L18,18 M18,6 L6,18</StreamGeometry>
            <!-- An eye: hold to show a password (Controls/PasswordField) -->
            <StreamGeometry x:Key="EyeIcon">M2,12 C5,6.5 19,6.5 22,12 C19,17.5 5,17.5 2,12 Z M12,9.2 A2.8,2.8 0 1 1 12,14.8 A2.8,2.8 0 1 1 12,9.2 Z</StreamGeometry>
            <!-- The six dots of a row that can be dragged to a new place (the preset manager's rows) -->
            <StreamGeometry x:Key="GripIcon">M8,4 h3 v3 h-3 Z M13,4 h3 v3 h-3 Z M8,10.5 h3 v3 h-3 Z M13,10.5 h3 v3 h-3 Z M8,17 h3 v3 h-3 Z M13,17 h3 v3 h-3 Z</StreamGeometry>
            <!-- The screenshot overlay (Screenshot/CaptureOverlay): its drawing tools and its action bar, stroked glyphs on a 24 px grid (OmniControl's own drawings) -->
            <StreamGeometry x:Key="ShotPenIcon">M4,20 L8.5,19 L19,8.5 L15.5,5 L5,15.5 Z M13.5,7 L17,10.5</StreamGeometry>
            <StreamGeometry x:Key="ShotLineIcon">M5,19 L19,5</StreamGeometry>
            <StreamGeometry x:Key="ShotArrowIcon">M5,19 L19,5 M11,5 H19 V13</StreamGeometry>
            <StreamGeometry x:Key="ShotBoxIcon">M4,6 H20 V18 H4 Z</StreamGeometry>
            <StreamGeometry x:Key="ShotMarkerIcon">M9,3 H15 V11 L13,13 H11 L9,11 Z M11,13 V17 L13,16 V13 M4,21 H20</StreamGeometry>
            <StreamGeometry x:Key="ShotTextIcon">M5,7 V4 H19 V7 M12,4 V20 M9,20 H15</StreamGeometry>
            <StreamGeometry x:Key="ShotBlurIcon">M4,4 H20 V20 H4 Z M4,9.3 H20 M4,14.7 H20 M9.3,4 V20 M14.7,4 V20</StreamGeometry>
            <StreamGeometry x:Key="ShotUndoIcon">M9,6 L5,10 L9,14 M5,10 H14 A5,5 0 0 1 14,20 H10</StreamGeometry>
            <StreamGeometry x:Key="ShotSearchIcon">M10,4 A6,6 0 1 0 10,16 A6,6 0 1 0 10,4 Z M14.5,14.5 L20,20</StreamGeometry>
            <StreamGeometry x:Key="ShotQrIcon">M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H16 V16 H14 Z M18,18 H20 V20 H18 Z M18,14 H20 M14,20 H16</StreamGeometry>
            <StreamGeometry x:Key="ShotPrintIcon">M7,9 V4 H17 V9 M7,17 H4 V10 H20 V17 H17 M7,14 H17 V20 H7 Z</StreamGeometry>
            <StreamGeometry x:Key="ShotCopyIcon">M8,8 H19 V20 H8 Z M5,16 V4 H16</StreamGeometry>
            <StreamGeometry x:Key="ShotSaveIcon">M12,4 V15 M7,10 L12,15 L17,10 M5,19 H19</StreamGeometry>
            <StreamGeometry x:Key="ShotBiggerIcon">M3,19 L8.5,5 L14,19 M5.2,14 H11.8 M15,12 H22 M18.5,8.5 V15.5</StreamGeometry>
            <StreamGeometry x:Key="ShotSmallerIcon">M3,19 L8.5,5 L14,19 M5.2,14 H11.8 M15,12 H22</StreamGeometry>
            <!-- Screen recording (Record and Stop are filled red by Button.toolicon.danger) -->
            <StreamGeometry x:Key="VideoCameraIcon">M5,7 H13 A2,2 0 0 1 15,9 V15 A2,2 0 0 1 13,17 H5 A2,2 0 0 1 3,15 V9 A2,2 0 0 1 5,7 Z M15,11 L21,8 V16 L15,13</StreamGeometry>
            <StreamGeometry x:Key="ShotStopIcon">M6,6 H18 V18 H6 Z</StreamGeometry>
            <StreamGeometry x:Key="ShotPauseIcon">M9,5 V19 M15,5 V19</StreamGeometry>
            <StreamGeometry x:Key="ShotResumeIcon">M7,5 L19,12 L7,19 Z</StreamGeometry>
            <StreamGeometry x:Key="ShotMicIcon">M12,3 A3,3 0 0 1 15,6 V11 A3,3 0 0 1 9,11 V6 A3,3 0 0 1 12,3 Z M5.5,11 A6.5,6.5 0 0 0 18.5,11 M12,17.5 V21 M8.5,21 H15.5</StreamGeometry>
            <StreamGeometry x:Key="ShotSoundIcon">M3,9 H7 L12,5 V19 L7,15 H3 Z M15.5,9 A4,4 0 0 1 15.5,15 M18,6 A8,8 0 0 1 18,18</StreamGeometry>
            <!-- The wash over the frozen screen outside the selection: the same in both themes, the picture under it is the user's screen -->
            <SolidColorBrush x:Key="BrushCaptureDim" Color="Black" Opacity="0.45" />
            <!-- The cogwheel icon used beside actions that have settings -->
            <StreamGeometry x:Key="CogIcon">M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 Z M10.5,2 H13.5 L14,4.6 L16,5.6 L18.2,4.1 L20.3,6.2 L18.8,8.4 L19.7,10.5 L22,11 V14 L19.7,14.5 L18.8,16.6 L20.3,18.8 L18.2,20.9 L16,19.4 L14,20.4 L13.5,22 H10.5 L10,20.4 L8,19.4 L5.8,20.9 L3.7,18.8 L5.2,16.6 L4.3,14.5 L2,14 V11 L4.3,10.5 L5.2,8.4 L3.7,6.2 L5.8,4.1 L8,5.6 L10,4.6 Z</StreamGeometry>
        </ResourceDictionary>
    </Styles.Resources>
</Styles>
