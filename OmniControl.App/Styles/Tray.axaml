<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OmniControl.App.Controls">
    <!-- MASTER designs of the tray flyout (Tray/TrayFlyoutWindow, docs/mockups/tray-flyout.html). Sizes: Tray* in App.axaml. Included last. -->

    <!-- The flyout's window: no frame of its own and see-through, so only the rounded panel inside it shows -->
    <Style Selector="Window.trayflyout">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TransparencyLevelHint" Value="Transparent" />
        <Setter Property="SystemDecorations" Value="None" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="Topmost" Value="True" />
        <Setter Property="CanResize" Value="False" />
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
    </Style>

    <!-- The flyout's panel: the window's own background, a thin divider edge, rounded, a fixed width -->
    <Style Selector="Border.flyoutpanel">
        <Setter Property="Width" Value="{DynamicResource TrayFlyoutWidth}" />
        <Setter Property="Padding" Value="{DynamicResource TrayFlyoutPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource TrayFlyoutCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="Background" Value="{DynamicResource BrushBackground}" />
    </Style>

    <!-- A tile: a square of a glyph over a short name. The 1 px edge is always there, so lighting, hover and focus change colours only.
         .on = its state is on (accent wash and edge); with .blockadd (Blocks.axaml) it is the dashed "+ Add" tile -->
    <Style Selector="Button.tile">
        <Setter Property="Width" Value="{DynamicResource TrayTileSize}" />
        <Setter Property="Height" Value="{DynamicResource TrayTileSize}" />
        <Setter Property="Padding" Value="4" />
        <!-- No outer margin: the dashed "+ Add" tile (.blockadd) brings a chip margin that pushed it onto a row of its own -->
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="{DynamicResource TrayTileCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tile > StackPanel"><Setter Property="Spacing" Value="4" /></Style>
    <Style Selector="Button.tile > StackPanel > c|IconGlyph">
        <Setter Property="Width" Value="{DynamicResource TrayGlyphSize}" />
        <Setter Property="Height" Value="{DynamicResource TrayGlyphSize}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tile > StackPanel > TextBlock, Button.tile > TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource MenuSmallFontSize}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.tile.on /template/ ContentPresenter#PART_ContentPresenter, Button.tile.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentEdge}" />
    </Style>
    <Style Selector="Button.tile.on > StackPanel > c|IconGlyph"><Setter Property="Foreground" Value="{DynamicResource BrushAccent}" /></Style>
    <!-- .faded = its state is only the last one known (nothing cheap can read it again): the whole tile is dimmed, lit or not -->
    <Style Selector="Button.tile.faded"><Setter Property="Opacity" Value="{DynamicResource TrayFadedOpacity}" /></Style>
    <!-- The small dot at a tile's top-left corner while its state is read again -->
    <Style Selector="Ellipse.checkdot">
        <Setter Property="Width" Value="{DynamicResource TrayCheckDot}" />
        <Setter Property="Height" Value="{DynamicResource TrayCheckDot}" />
        <Setter Property="Fill" Value="{DynamicResource BrushAccent}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="{DynamicResource TrayCheckDotMargin}" />
    </Style>
    <Style Selector="Button.tile:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>

    <!-- A slider row of the flyout: the name trims at its column's width (a picker's words too), the value is a small fixed column -->
    <Style Selector="Grid.trayslider > TextBlock.trayname">
        <Setter Property="MaxWidth" Value="{DynamicResource TrayNameMaxWidth}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.trayslider > TextBlock.trayvalue">
        <Setter Property="Width" Value="{DynamicResource TrayValueWidth}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.trayslider > c|IconGlyph">
        <Setter Property="Width" Value="{DynamicResource TrayGlyphSize}" />
        <Setter Property="Height" Value="{DynamicResource TrayGlyphSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.trayslider > c|ChipMenu"><Setter Property="MaxWidth" Value="{DynamicResource TrayNameMaxWidth}" /></Style>
</Styles>
