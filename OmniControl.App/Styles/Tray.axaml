<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OmniControl.App.Controls">
    <!-- MASTER designs of the tray flyout (Tray/TrayFlyoutWindow, docs/mockups/tray-flyout.html). Sizes: Tray* in App.axaml. Included last. -->

    <!-- The flyout's window: no frame of its own and see-through, so only the rounded panel inside it shows -->
    <Style Selector="Window.trayflyout">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TransparencyLevelHint" Value="Transparent" />
        <Setter Property="SystemDecorations" Value="None" />
        <Setter Property="Topmost" Value="True" />
        <Setter Property="CanResize" Value="False" />
        <Setter Property="SizeToContent" Value="WidthAndHeight" />
    </Style>

    <!-- The remove badge (docs/mockups/remove-badge.html): THE small remove cross of a tile or a row. A round raised chip with a thin edge
         (RemoveBadgeSize) inside a clickable square (RemoveBadgeHit); the drawn cross (RemoveBadgeCross) is muted and turns red on hover. -->
    <Style Selector="Button.removebadge">
        <Setter Property="Width" Value="{DynamicResource RemoveBadgeHit}" />
        <Setter Property="Height" Value="{DynamicResource RemoveBadgeHit}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <Border Name="PART_Badge" Width="{DynamicResource RemoveBadgeSize}" Height="{DynamicResource RemoveBadgeSize}"
                            CornerRadius="{DynamicResource RemoveBadgeRadius}" BorderThickness="1"
                            Background="{DynamicResource BrushHover}" BorderBrush="{DynamicResource BrushDivider}" />
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.removebadge > Path.glyph">
        <Setter Property="Width" Value="{DynamicResource RemoveBadgeCross}" />
        <Setter Property="Height" Value="{DynamicResource RemoveBadgeCross}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="Button.removebadge:pointerover, Button.removebadge:focus-visible"><Setter Property="Foreground" Value="{DynamicResource BrushDanger}" /></Style>
    <Style Selector="Button.removebadge:pointerover /template/ Border#PART_Badge"><Setter Property="BorderBrush" Value="{DynamicResource BrushHoverEdge}" /></Style>
    <Style Selector="Button.removebadge:focus-visible /template/ Border#PART_Badge"><Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" /></Style>

    <!-- The flyout's panel: the window's own background, a thin divider edge, rounded, a fixed width -->
    <Style Selector="Border.flyoutpanel">
        <Setter Property="Width" Value="{DynamicResource TrayFlyoutWidth}" />
        <Setter Property="Padding" Value="{DynamicResource TrayFlyoutPadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource TrayFlyoutCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="Background" Value="{DynamicResource BrushBackground}" />
    </Style>

    <!-- A tile: a square of a glyph over a short name. The 1 px edge is always there, so lighting, hover and focus change colours only.
         .on = its state is on (accent wash and edge) -->
    <Style Selector="Button.tile">
        <Setter Property="Width" Value="{DynamicResource TrayTileSize}" />
        <Setter Property="Height" Value="{DynamicResource TrayTileSize}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="CornerRadius" Value="{DynamicResource TrayTileCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tile > StackPanel"><Setter Property="Spacing" Value="4" /></Style>
    <Style Selector="Button.tile > StackPanel > c|IconGlyph">
        <Setter Property="Width" Value="{DynamicResource TrayGlyphSize}" />
        <Setter Property="Height" Value="{DynamicResource TrayGlyphSize}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tile > StackPanel > TextBlock, Button.tile > TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource MenuSmallFontSize}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Button.tile > StackPanel > c|WordText"><Setter Property="FitFontSize" Value="{DynamicResource TrayTileFitFontSize}" /></Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.tile.on /template/ ContentPresenter#PART_ContentPresenter, Button.tile.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentEdge}" />
    </Style>
    <Style Selector="Button.tile.on > StackPanel > c|IconGlyph"><Setter Property="Foreground" Value="{DynamicResource BrushAccent}" /></Style>
    <!-- .faded = its state is only the last one known (docs/mockups/tray-tile-states.html): the whole tile is dimmed, lit or not -->
    <Style Selector="Button.tile.faded"><Setter Property="Opacity" Value="{DynamicResource TrayFadedOpacity}" /></Style>
    <!-- The tile's corner mark (top-right, TrayMarkSize): holds ONE of a spinning ring (an action runs), a pulsing grey dot (the state is read),
         a clock (only the last known value) or a red warning (the last action or read failed). It never takes the mouse. -->
    <Style Selector="Panel.tilemark">
        <Setter Property="Width" Value="{DynamicResource TrayMarkSize}" />
        <Setter Property="Height" Value="{DynamicResource TrayMarkSize}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="{DynamicResource TrayMarkMargin}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Panel.tilemark > Ellipse.markring, Button.statepower > Panel > Panel > Ellipse.markring">
        <Setter Property="Stroke" Value="{DynamicResource BrushMuted}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource TrayMarkStroke}" />
    </Style>
    <Style Selector="Panel.tilemark > Path.markarc, Button.statepower > Panel > Panel > Path.markarc">
        <Setter Property="Stroke" Value="{DynamicResource BrushAccent}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource TrayMarkStroke}" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="Width" Value="{DynamicResource TrayMarkSize}" />
        <Setter Property="Height" Value="{DynamicResource TrayMarkSize}" />
        <Setter Property="Data" Value="M5.5,0.75 A4.75,4.75 0 0 1 10.25,5.5" />
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
        <Style.Animations>
            <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Panel.tilemark > Ellipse.markdot">
        <Setter Property="Width" Value="{DynamicResource TrayMarkDot}" />
        <Setter Property="Height" Value="{DynamicResource TrayMarkDot}" />
        <Setter Property="Fill" Value="{DynamicResource BrushMuted}" />
        <Style.Animations>
            <Animation Duration="0:0:0.8" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Panel.tilemark > c|IconGlyph.marknotsure"><Setter Property="Foreground" Value="{DynamicResource BrushMuted}" /></Style>
    <Style Selector="Panel.tilemark > c|IconGlyph.markfailed, Button.statepower > Panel > c|IconGlyph.markfailed"><Setter Property="Foreground" Value="{DynamicResource BrushDanger}" /></Style>
    <!-- Button.statepower (docs/mockups/method-test-button.html): the small round power button at the right of a Smart Devices method row. It shows the
         device's state (grey = off, accent edge and wash = on); its Panel holds ONE of the power glyph, the spinner (an inner Panel with the tile
         mark's Ellipse.markring + Path.markarc) while this method runs, or the red warning glyph (.markfailed) when this method failed.
         Sizes: StatePower* in App.axaml. -->
    <Style Selector="Button.statepower">
        <Setter Property="Width" Value="{DynamicResource StatePowerSize}" />
        <Setter Property="Height" Value="{DynamicResource StatePowerSize}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource StatePowerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
    </Style>
    <Style Selector="Button.statepower /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="CornerRadius" Value="{DynamicResource StatePowerRadius}" />
    </Style>
    <Style Selector="Button.statepower:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <Style Selector="Button.statepower.on"><Setter Property="Foreground" Value="{DynamicResource BrushAccent}" /></Style>
    <Style Selector="Button.statepower.on /template/ ContentPresenter#PART_ContentPresenter, Button.statepower.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentEdge}" />
    </Style>
    <Style Selector="Button.statepower:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>
    <!-- Hover or keyboard focus on a running method's button turns the spinner into a stop square (a click stops that method). -->
    <Style Selector="Button.statepower > Panel > Panel > Path.markstop">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Fill" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="{DynamicResource StatePowerStop}" />
        <Setter Property="Height" Value="{DynamicResource StatePowerStop}" />
    </Style>
    <Style Selector="Button.statepower:pointerover > Panel > Panel > Path.markstop, Button.statepower:focus-visible > Panel > Panel > Path.markstop"><Setter Property="IsVisible" Value="True" /></Style>
    <Style Selector="Button.statepower:pointerover > Panel > Panel > Ellipse.markring, Button.statepower:focus-visible > Panel > Panel > Ellipse.markring, Button.statepower:pointerover > Panel > Panel > Path.markarc, Button.statepower:focus-visible > Panel > Panel > Path.markarc">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.statepower > Panel"><Setter Property="IsHitTestVisible" Value="False" /></Style>
    <Style Selector="Button.statepower > Panel > c|IconGlyph">
        <Setter Property="Width" Value="{DynamicResource StatePowerGlyph}" />
        <Setter Property="Height" Value="{DynamicResource StatePowerGlyph}" />
    </Style>

    <Style Selector="Button.tile:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    </Style>

    <!-- The flyout's foot: a thin rule over the Add and Edit icon buttons and "Open OmniControl" -->
    <Style Selector="Border.trayfoot">
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDivider}" />
        <Setter Property="Padding" Value="0,8,0,0" />
    </Style>
    <!-- Shared pill variants (any Button.pill): .icon = a square-ish pill holding only a drawn glyph; .accentline = accent words and edge.
         A glyph in either takes the button's own text colour (so it hovers and focuses with it). -->
    <Style Selector="Button.pill.icon"><Setter Property="Padding" Value="0" /><Setter Property="Width" Value="{DynamicResource PillIconWidth}" /></Style>
    <Style Selector="Button.pill.icon > c|IconGlyph, Button.pill.icon > Panel > c|IconGlyph, Button.pill.accentline > StackPanel > c|IconGlyph">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="Button.pill.accentline /template/ ContentPresenter#PART_ContentPresenter, Button.pill.accentline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
    </Style>

    <!-- A slider row of the flyout: the name trims at its column's width (a picker's words too), the value is a small fixed column -->
    <Style Selector="Grid.trayslider > TextBlock.trayname">
        <Setter Property="MaxWidth" Value="{DynamicResource TrayNameMaxWidth}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.trayslider > TextBlock.trayvalue">
        <Setter Property="Width" Value="{DynamicResource TrayValueWidth}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.trayslider > c|IconGlyph">
        <Setter Property="Width" Value="{DynamicResource TrayGlyphSize}" />
        <Setter Property="Height" Value="{DynamicResource TrayGlyphSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.trayslider > c|ChipMenu"><Setter Property="MaxWidth" Value="{DynamicResource TrayNameMaxWidth}" /></Style>
</Styles>
