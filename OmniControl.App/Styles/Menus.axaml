<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- MASTER designs of menus and pop-downs, moved out of Theme.axaml (700-line limit) and included after it and Blocks.axaml, so these
         win as they did at the end of Theme.axaml: Avalonia has no selector specificity, the later style wins (a glyph size set before
         Theme's Path.glyph would be overwritten by its 14 px). Sizes: Menu*, TickBox*, Chip* in App.axaml. -->
    <!-- Device picker menu: full-width flat rows, each with its own hover -->
    <Style Selector="FlyoutPresenter.scopemenu">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="190" />
    </Style>
    <Style Selector="ToggleButton.menuitem">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="ToggleButton.menuitem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ToggleButton.menuitem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
    </Style>
    <Style Selector="ToggleButton.menuitem:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
    </Style>
    <Style Selector="ToggleButton.menuitem:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.menuitem:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
    </Style>

    <!-- A pop-down of choice cards (FlyoutPresenter.optionmenu) and its cards (Button.optioncard). The card border is always 2 px,
         so hover, keyboard focus and selection only change colours and never move the text. -->
    <Style Selector="FlyoutPresenter.optionmenu">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Width" Value="{DynamicResource OptionMenuWidth}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <!-- A narrow pop-down that sizes to its content, drawn like a program's menu (a list with a title above and notes and menu rows
         below; the Volume Wiring tab's device menu). Font size and text colour are set here because the pop-down inherits them from the
         control it hangs under in the logical tree -->
    <Style Selector="FlyoutPresenter.listmenu">
        <Setter Property="Padding" Value="{DynamicResource MenuPadding}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="MinWidth" Value="{DynamicResource ListMenuMinWidth}" />
        <Setter Property="MaxWidth" Value="{DynamicResource ListMenuMaxWidth}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- A pop-down that holds a larger graph (the FX window's total response, opened from Button.graphthumb): a fixed width so the graph
         is drawn at its size, no scrolling; font size and text colour set here for the same reason as the list menu's -->
    <Style Selector="FlyoutPresenter.graphmenu">
        <Setter Property="Width" Value="{DynamicResource FxGraphPanelWidth}" />
        <Setter Property="Padding" Value="{DynamicResource FxGraphPanelPadding}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- A thin line across a pop-down or window, between its parts -->
    <Style Selector="Border.hrule">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BrushDivider}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Option list (Controls/OptionList): the tick of an entry (1 px edge; .checked filled in the accent); Grid.unavailable = a greyed entry (the master picker) -->
    <Style Selector="Border.tickbox">
        <Setter Property="Width" Value="{DynamicResource TickBoxSize}" />
        <Setter Property="Height" Value="{DynamicResource TickBoxSize}" />
        <Setter Property="CornerRadius" Value="{DynamicResource TickBoxCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushHoverEdge}" />
    </Style>
    <Style Selector="Border.tickbox.checked"><Setter Property="Background" Value="{DynamicResource BrushAccent}" /><Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" /></Style>
    <Style Selector="Path.tick">
        <Setter Property="Stroke" Value="{DynamicResource BrushBackground}" />
        <Setter Property="StrokeThickness" Value="1.75" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Margin" Value="{DynamicResource TickMargin}" />
    </Style>
    <Style Selector="Grid.unavailable"><Setter Property="Opacity" Value="0.45" /></Style>

    <!-- A row of a menu-like pop-down (Button.menurow: a device to add, "Switch to Full control"): flat, full width, the same height,
         inset and wash as the option list's rows (ListBox.pick.compact), an optional small glyph before the words; its content is
         stretched, so a tag can sit at the right edge (a Grid "*,Auto") -->
    <Style Selector="Button.menurow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource MenuRowPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource MenuRowHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource MenuRowCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.menurow > StackPanel"><Setter Property="Orientation" Value="Horizontal" /><Setter Property="Spacing" Value="{DynamicResource MenuGap}" /></Style>
    <Style Selector="Button.menurow Path.glyph">
        <Setter Property="Width" Value="{DynamicResource MenuGlyphSize}" />
        <Setter Property="Height" Value="{DynamicResource MenuGlyphSize}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.menurow TextBlock"><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="Button.menurow:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.menurow:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.menurow:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" /></Style>
    <Style Selector="Button.menurow:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
    <Style Selector="Button.menurow:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <!-- Words in a menu-like pop-down that are not a choice (its title, a note): small and muted, set in to line up with the rows' words -->
    <Style Selector="TextBlock.menutext">
        <Setter Property="FontSize" Value="{DynamicResource MenuSmallFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="{DynamicResource MenuTextInset}" />
    </Style>

    <!-- Chip: a chosen value that can be taken away (Button.chipx: its words and an x; a Wiring row's devices). A quiet neutral pill (no
         accent edge), the x right after the words; a click anywhere on it takes it away. Mouse only, it never takes focus: the keyboard
         uses the row's menu instead. -->
    <Style Selector="Button.chipx">
        <Setter Property="Padding" Value="{DynamicResource ChipPadding}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="{DynamicResource ChipHeight}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ChipCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource BrushHover}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontSize" Value="{DynamicResource MenuSmallFontSize}" />
    </Style>
    <Style Selector="Button.chipx:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.chipx:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource BrushHoverStrong}" /></Style>
    <Style Selector="Button.chipx > StackPanel"><Setter Property="Orientation" Value="Horizontal" /><Setter Property="Spacing" Value="{DynamicResource ChipGap}" /></Style>
    <Style Selector="Button.chipx TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxWidth" Value="{DynamicResource ChipMaxWidth}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The x: an 8 px cross centred in a 14 px slot (the margin), so it sits tight after the words -->
    <Style Selector="Button.chipx Path.glyph">
        <Setter Property="Width" Value="{DynamicResource ChipGlyphSize}" />
        <Setter Property="Height" Value="{DynamicResource ChipGlyphSize}" />
        <Setter Property="Margin" Value="{DynamicResource ChipGlyphMargin}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The dashed "+ add" chip at the end of a row of chips (Button.blockadd.small: the dashed master of Blocks.axaml at chip size) -->
    <Style Selector="Button.blockadd.small">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="{DynamicResource ChipHeight}" />
        <Setter Property="Padding" Value="{DynamicResource ChipAddPadding}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource ChipCornerRadius}" />
        <Setter Property="FontSize" Value="{DynamicResource MenuSmallFontSize}" />
    </Style>
</Styles>
