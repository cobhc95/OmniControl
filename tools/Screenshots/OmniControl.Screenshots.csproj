<Project Sdk="Microsoft.NET.Sdk">

  <!-- README screenshots, drawn off screen (Avalonia.Headless, Skia) from the real views and view-models fed with sample data.
       A developer tool: not in the solution, not shipped, not in Setup. Run: dotnet run -c Debug (writes docs/screenshots). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.3.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OmniControl.App\OmniControl.App.csproj" />
  </ItemGroup>

</Project>
